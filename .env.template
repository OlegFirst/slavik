# BCM Platform Environment Variables Template
# Copy this to .env and fill in your values
# cp .env.template .env

# ====================================
# AI Services
# ====================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ====================================
# Database (for production - development uses docker defaults)
# ====================================
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# REDIS_URL=redis://host:6379
# NEO4J_URI=bolt://host:7687

# ====================================
# Environment
# ====================================
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# ====================================
# Security (change in production!)
# ====================================
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production
ENCRYPTION_KEY=your-encryption-key-change-in-production

# ====================================
# Service Ports
# ====================================
INTELLIGENT_CORE_PORT=8000
AI_ORCHESTRATOR_PORT=8001
WORKFLOW_ENGINE_PORT=8002
COMMUNITY_INTELLIGENCE_PORT=8003
COLLECTIVE_PORT=8032

# ====================================
# Feature Flags
# ====================================
ENABLE_AI_FEATURES=true
ENABLE_ML_PREDICTIONS=true
ENABLE_COMMUNITY_FEATURES=true
ENABLE_COLLECTIVE_AGENTS=true

# ====================================
# Optional: External services
# ====================================
# SENTRY_DSN=https://...
# SLACK_WEBHOOK=https://hooks.slack.com/...
# DATADOG_API_KEY=...

# ====================================
# Development Settings
# ====================================
AUTO_RELOAD=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ====================================
# Supabase (if using instead of local Postgres)
# ====================================
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-role-key
