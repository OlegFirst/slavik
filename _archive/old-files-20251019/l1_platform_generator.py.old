"""
L1 Platform Service Generator

Generates test scenarios for all L1 platform services using golden_standard_l1.yaml template.

This generator:
1. Reads the service catalog
2. For each platform service, generates a scenario using the L1 template
3. Registers scenarios in the Registry
4. Saves scenarios to filesystem and PostgreSQL
"""

import asyncio
import logging
from pathlib import Path
from typing import List, Dict, Any
import sys

# Add parent directory to path
sys.path.insert(0, str(Path(__file__).parent.parent))

from template_loader import TemplateLoader
from storage.registry import ScenarioRegistry

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)


class L1PlatformGenerator:
    """
    Generator for L1 Platform Service scenarios.

    Generates scenarios for all 46 platform services.
    """

    def __init__(
        self,
        template_loader: TemplateLoader,
        registry: ScenarioRegistry,
        output_dir: str = "generated/l1/services"
    ):
        """
        Initialize generator.

        Args:
            template_loader: TemplateLoader instance
            registry: ScenarioRegistry instance
            output_dir: Directory for generated scenarios
        """
        self.loader = template_loader
        self.registry = registry
        self.output_dir = Path(output_dir)

        # Create output directory
        self.output_dir.mkdir(parents=True, exist_ok=True)

        logger.info(f"L1PlatformGenerator initialized, output: {self.output_dir}")

