    async def generate_one(self, service: Dict[str, Any]) -> Dict[str, Any]:
        """
        Generate scenario for one service.

        Args:
            service: Service definition

        Returns:
            Generated scenario
        """
        # Build context
        context = {
            "service_name": service["name"],
            "port": service["port"],
            "criticality": service["criticality"],
            "subsystem_name": service["subsystem"],
            "internal_dependencies": ", ".join(service.get("internal_dependencies", [])),
            "external_dependencies": ", ".join(service.get("external_dependencies", []))
        }

        # Generate scenario from template
        scenario = self.loader.create_scenario_from_template(
            "golden_standard_l1.yaml",
            context,
            validate=True
        )

        # Add category to meta (for specialized routing later)
        scenario["meta"]["category"] = service.get("category", "general")

        return scenario

    async def generate_all(self) -> List[str]:
        """
        Generate scenarios for all platform services.

        Returns:
            List of generated scenario IDs
        """
        logger.info("Starting L1 Platform Service scenario generation")

        services = self._get_service_catalog()
        logger.info(f"Found {len(services)} platform services to generate")

        generated_ids = []

        for service in services:
            try:
                # Generate scenario
                scenario = await self.generate_one(service)

                # Register in registry
                success = await self.registry.register(scenario)

                if not success:
                    logger.error(f"Failed to register scenario for {service['name']}")
                    continue

                scenario_id = scenario["meta"]["id"]
                generated_ids.append(scenario_id)

                # Save to filesystem
                output_file = self.output_dir / f"{service['name']}.yaml"
                self._save_scenario_to_file(scenario, output_file)

                logger.info(f"✅ Generated and saved: {service['name']} ({scenario_id})")

            except Exception as e:
                logger.error(f"❌ Failed to generate scenario for {service['name']}: {e}", exc_info=True)
                continue

        logger.info(f"\n📊 Generation complete: {len(generated_ids)}/{len(services)} scenarios generated")

        return generated_ids

    def _save_scenario_to_file(self, scenario: Dict[str, Any], filepath: Path):
        """
        Save scenario to YAML file.

        Args:
            scenario: Scenario dictionary
            filepath: Output file path
        """
        import yaml

        with open(filepath, 'w') as f:
            yaml.dump(scenario, f, default_flow_style=False, allow_unicode=True, sort_keys=False)


async def main():
    """Run L1 Platform Generator"""
    print("="*70)
    print("L1 PLATFORM SERVICE GENERATOR")
    print("="*70)

    # Initialize systems
    loader = TemplateLoader(templates_dir="templates")
    registry = ScenarioRegistry()

    # Create generator
    generator = L1PlatformGenerator(loader, registry, output_dir="generated/l1/services")

    # Generate all scenarios
    generated_ids = await generator.generate_all()

    # Get statistics
    stats = await registry.get_statistics()

    print("\n" + "="*70)
    print("GENERATION SUMMARY")
    print("="*70)
    print(f"✅ Total scenarios generated: {len(generated_ids)}")
    print(f"📊 Registry statistics:")
    print(f"   Total scenarios: {stats['total_scenarios']}")
    print(f"   By level: {stats['by_level']}")
    print(f"   By type: {stats.get('by_type', {})}")
    print("\n🎉 L1 Platform generation complete!")


if __name__ == "__main__":
    asyncio.run(main())
