  "architecture_recommendations": {
    "event_naming_standard": {
      "pattern": "{domain}.{entity}.{action}",
      "examples": [
        "bcm.bia.completed",
        "governance.policy.approved",
        "community.case.approved",
        "response.incident.resolved"
      ],
      "rules": [
        "Always use past tense for actions (completed, not complete)",
        "Use singular entity names (incident, not incidents)",
        "Domain should match service name or functional area",
        "Avoid generic names - be specific"
      ]
    },

    "event_driven_design_principles": {
      "publish_and_subscribe": "Every service that publishes events should also subscribe to relevant events",
      "loose_coupling": "Services should not call each other directly - use events for cross-service communication",
      "idempotency": "Event handlers must be idempotent - safe to process same event multiple times",
      "saga_pattern": "Use event choreography for multi-step workflows (BIA → Risk → Planning)",
      "event_sourcing": "Consider event sourcing for audit trail and replay capability"
    },

    "integration_testing": {
      "requirement": "All event publishers must have integration tests that verify subscribers receive events",
      "ci_check": "CI/CD should validate event catalog consistency - no orphaned or broken events",
      "monitoring": "Production monitoring should track event delivery rates, subscriber health"
    },

    "documentation": {
      "requirement": "Every service must document published and subscribed events in README",
      "catalog": "Event catalog should be auto-generated and kept in sync with code",
      "diagrams": "Create event flow diagrams for major workflows (BIA journey, incident response, etc.)"
    }
  },

