  "naming_inconsistencies": {
    "description": "Event naming patterns that cause integration issues",
    "issues": [
      {
        "issue": "Namespace vs generic event names",
        "examples": [
          {
            "publisher": "simulation-service publishes 'bcm.exercise.completed'",
            "subscriber": "governance-service subscribes to 'exercise.completed'",
            "result": "No match - events not delivered"
          },
          {
            "publisher": "response-service publishes 'response.incident.resolved'",
            "subscriber": "governance-service subscribes to 'incident.resolved'",
            "result": "No match - events not delivered"
          }
        ],
        "recommendation": "Establish naming convention: Use namespaced events (domain.entity.action) consistently"
      },
      {
        "issue": "BIA event naming confusion",
        "examples": [
          {
            "publisher": "bia-service publishes 'bcm.bia.started', 'bcm.bia.completed'",
            "subscriber": "workflow_intelligence subscribes to 'process_added', 'dependency_added', 'impact_assessed'",
            "result": "Complete mismatch - no events delivered"
          }
        ],
        "recommendation": "Align BIA event names: Either bia-service emits workflow_intelligence events OR workflow_intelligence subscribes to bcm.bia.* events"
      },
      {
        "issue": "Duplicate event publishers",
        "examples": [
          {
            "event": "training.certified",
            "publishers": [
              "ai-foundation/learning-knowledge/training/programs/training_service.py",
              "platform-services/learning-service/services/training_service.py"
            ],
            "result": "Two services publishing same event - potential conflicts"
          }
        ],
        "recommendation": "Consolidate duplicate publishers - only one service should own each event type"
      },
      {
        "issue": "Wildcard subscriptions not matching",
        "examples": [
          {
            "subscriber": "ai-orchestration subscribes to 'workflow.*'",
            "publishers": "workflow-engine publishes 'bpmn.instance.completed', 'bpmn.task.completed'",
            "result": "Wildcard doesn't match - events not delivered"
          }
        ],
        "recommendation": "Either use consistent prefixes OR subscribe to multiple wildcards (workflow.*, bpmn.*)"
      }
    ]
  },

