{
  "examples": [
    {
      "name": "hackernews-front",
      "description": "Скрапінг головної сторінки Hacker News",
      "url": "https://news.ycombinator.com/",
      "selectors": {
        "stories": {
          "selector": ".titleline",
          "multiple": true,
          "transform": "text"
        },
        "points": {
          "selector": ".score",
          "multiple": true,
          "transform": "number"
        },
        "comments": {
          "selector": "a[href*='item?id=']",
          "multiple": true
        }
      },
      "waitTime": 3000,
      "notes": "Приклад для скрапінгу новин з технологій"
    },
    {
      "name": "github-trending",
      "description": "Трендові репозиторії GitHub",
      "url": "https://github.com/trending",
      "selectors": {
        "repositories": {
          "selector": "h1.h3 a",
          "multiple": true,
          "attribute": "href",
          "transform": "url"
        },
        "descriptions": {
          "selector": "p.col-9",
          "multiple": true,
          "transform": "text"
        },
        "languages": {
          "selector": "[itemprop='programmingLanguage']",
          "multiple": true,
          "transform": "text"
        },
        "stars": {
          "selector": ".octicon-star + a",
          "multiple": true,
          "transform": "text"
        }
      },
      "waitTime": 2000,
      "notes": "Популярні репозиторії за день/тиждень/місяць"
    },
    {
      "name": "weather-example",
      "description": "Приклад скрапінгу погоди (потрібен відповідний сайт)",
      "url": "https://weather.example.com/city",
      "selectors": {
        "temperature": {
          "selector": ".temperature",
          "transform": "number"
        },
        "condition": ".weather-condition",
        "humidity": {
          "selector": ".humidity",
          "transform": "number"
        },
        "forecast": {
          "selector": ".forecast-item",
          "multiple": true
        }
      },
      "waitTime": 5000,
      "notes": "Приклад для погодних даних"
    },
    {
      "name": "quotes-example",
      "description": "Скрапінг цитат з пагінацією",
      "url": "https://quotes.toscrape.com/",
      "selectors": {
        "quote": {
          "selector": ".quote .text",
          "multiple": true,
          "transform": "text"
        },
        "author": {
          "selector": ".quote .author",
          "multiple": true,
          "transform": "text"
        },
        "tags": {
          "selector": ".quote .tags a",
          "multiple": true,
          "transform": "text"
        }
      },
      "pagination": {
        "nextSelector": ".next a",
        "maxPages": 5
      },
      "waitTime": 1000,
      "notes": "Приклад з підтримкою пагінації"
    }
  ],
  "tips": [
    "Перевіряйте robots.txt перед скрапінгом",
    "Використовуйте відповідні затримки між запитами",
    "Тестуйте селектори в браузері перед використанням",
    "Зберігайте резервні копії важливих даних",
    "Відстежуйте зміни структури сайтів"
  ],
  "common_selectors": {
    "titles": ["h1", "h2", ".title", ".headline", "[data-title]"],
    "content": [".content", ".article-body", ".post-content", "main"],
    "dates": ["time", ".date", ".published", "[datetime]"],
    "authors": [".author", ".byline", ".writer", ".creator"],
    "images": ["img", ".image", ".photo", ".thumbnail"],
    "links": ["a[href]", ".link", ".url"],
    "prices": [".price", ".cost", ".amount", "[data-price]"],
    "ratings": [".rating", ".stars", ".score", "[data-rating]"]
  }
}