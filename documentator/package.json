{
  "name": "@anthropic/digital-office",
  "version": "1.0.0",
  "description": "Digital Office - Multi-service platform with MCP integration for Claude",
  "main": "dist/index-new.js",
  "bin": {
    "digital-office": "./dist/index-new.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index-new.js",
    "start:hub": "node dist/index-new.js hub",
    "start:api": "node dist/index-new.js api",
    "start:both": "node dist/index-new.js both",
    "dev": "ts-node src/index-new.ts",
    "setup": "ts-node src/cli/setup-wizard.ts",
    "setup:build": "tsc && node dist/cli/setup-wizard.js",
    "package": "npm run build && npm run package:exe",
    "package:exe": "pkg . --targets node18-win-x64 --output release/DigitalOffice.exe",
    "package:setup": "pkg dist/cli/setup-wizard.js --targets node18-win-x64 --output release/DigitalOfficeSetup.exe",
    "package:all": "npm run build && npm run package:exe && npm run package:setup",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "claude",
    "anthropic",
    "digital-office",
    "services",
    "documentation",
    "reports",
    "templates",
    "automation",
    "multi-service"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anthropics/documentator"
  },
  "homepage": "https://github.com/anthropics/documentator#readme",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "bcrypt": "^5.1.1",
    "chalk": "^4.1.2",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0",
    "helmet": "^7.1.0",
    "inquirer": "^8.2.6",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^2.7.0",
    "ora": "^5.4.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/node-fetch": "^2.6.13",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "pkg": "^5.8.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0"
  },
  "pkg": {
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "release",
    "assets": [
      "data/**/*",
      "src/agents/**/*.json",
      "node_modules/**/*"
    ]
  }
}
