{
  "name": "@anthropic/digital-office",
  "version": "1.0.0",
  "description": "Digital Office - Multi-service platform with MCP integration for Claude",
  "main": "dist/index-new.js",
  "bin": {
    "digital-office": "./dist/index-new.js",
    "digital-office-cli": "./dist/cli/index.js",
    "documentator": "./dist/index.js",
    "documentator-setup": "./dist/setup.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index-new.js",
    "start:hub": "node dist/index-new.js hub",
    "start:api": "node dist/index-new.js api", 
    "start:both": "node dist/index-new.js both",
    "start:legacy": "node dist/index.js",
    "dev": "ts-node src/index-new.ts",
    "dev:legacy": "ts-node src/index.ts",
    "setup": "ts-node src/setup.ts",
    "cli": "ts-node src/cli/index.ts",
    "services": "npm run cli services",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["mcp", "claude", "anthropic", "digital-office", "services", "documentation", "reports", "templates", "automation", "multi-service"],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git", 
    "url": "https://github.com/anthropics/documentator"
  },
  "homepage": "https://github.com/anthropics/documentator#readme",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/uuid": "^9.0.7",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.8",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0"
  }
}