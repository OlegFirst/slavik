# ============================================
# AI-Platform-ISO - COMPREHENSIVE Environment Variables
# ============================================
#
# This is the COMPLETE list of all environment variables used across the platform.
# Collected from: infrastructure, platform_services, intelligent_core, frontend
#
# SECURITY NOTE:
# - 🔒 Secrets (passwords, API keys) should be stored in Supabase Vault
# - See: /infrastructure/security/VAULT_USAGE.md
# - This file is for documentation - real secrets are in Vault
#
# Last updated: 2025-10-19
# Auto-generated from codebase analysis
# ============================================

# ============================================
# 1. ENVIRONMENT & GENERAL
# ============================================

ENVIRONMENT=development
# Options: development, staging, production

DEBUG=false
# Enable debug mode (verbose logging)

LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

NODE_ENV=development
# Node.js environment (for frontend)

# ============================================
# 2. SUPABASE (DATABASE & AUTH)
# ============================================

SUPABASE_URL=https://tpdkhddtbhpoqzzgxfni.supabase.co
# Your Supabase project URL

SUPABASE_ANON_KEY=<anon-key>
# Public anon key (safe to expose in frontend)

SUPABASE_SERVICE_KEY=<service-role-key>
# 🔒 SECRET - Service role key (backend only, has full access)
# Required for: Vault access, RLS bypass
# Location: Supabase Dashboard → Settings → API → service_role

# Aliases (legacy support)
SUPABASE_SERVICE_ROLE_KEY=${SUPABASE_SERVICE_KEY}
SUPABASE_KEY=${SUPABASE_ANON_KEY}

# ============================================
# 3. DATABASE (PostgreSQL via Supabase)
# ============================================

DATABASE_URL=postgresql://postgres.tpdkhddtbhpoqzzgxfni:PASSWORD@aws-1-eu-north-1.pooler.supabase.com:5432/postgres
# 🔒 SECRET - Full database connection string
# Note: Password should come from Vault (database-password)

# Alternative format (individual fields)
POSTGRES_HOST=aws-1-eu-north-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres.tpdkhddtbhpoqzzgxfni
POSTGRES_PASSWORD=<from-vault:database-password>
# 🔒 SECRET - DB password (✅ stored in Vault)
POSTGRES_DB=postgres

# PostgreSQL Aliases
DB_HOST=${POSTGRES_HOST}
DB_PORT=${POSTGRES_PORT}
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_NAME=${POSTGRES_DB}

# PostgreSQL SSL/TLS (for client auth)
PGPASSFILE=~/.pgpass
# Path to .pgpass file (optional)
PGSSLMODE=prefer
# Options: disable, allow, prefer, require, verify-ca, verify-full
PGSSLCERT=<path-to-cert>
PGSSLKEY=<path-to-key>
PGSSLROOTCERT=<path-to-ca>
PGSSLCRL=<path-to-crl>
PGSSLMINPROTOCOLVERSION=TLSv1.2
PGSSLMAXPROTOCOLVERSION=TLSv1.3

# PostgreSQL Environment Variables
PGDATABASE=${POSTGRES_DB}
PGUSER=${POSTGRES_USER}
PGPASSWORD=${POSTGRES_PASSWORD}

# Connection pool settings
DB_POOL_SIZE=20
# Maximum number of connections in pool
POSTGRES_POOL_SIZE=${DB_POOL_SIZE}

DB_MAX_OVERFLOW=10
# Maximum overflow connections beyond pool_size
POSTGRES_MAX_OVERFLOW=${DB_MAX_OVERFLOW}

DB_POOL_TIMEOUT=30
# Timeout for getting connection from pool (seconds)

DB_ECHO=false
# Echo all SQL statements (development only)

MAX_CONNECTIONS_PER_USER=10
# Max connections per user

# ============================================
# 4. AUTHENTICATION & SECURITY
# ============================================

# JWT Configuration
JWT_SECRET=<from-vault:jwt-secret>
# 🔒 SECRET - JWT signing secret (✅ stored in Vault)
# Generate with: openssl rand -hex 32

JWT_ALGORITHM=HS256
# JWT signing algorithm

JWT_SECRET_KEY=${JWT_SECRET}
# Alias for compatibility

ACCESS_TOKEN_EXPIRE_MINUTES=30
# JWT access token lifetime

REFRESH_TOKEN_EXPIRE_DAYS=7
# JWT refresh token lifetime

JWT_EXPIRE_MINUTES=${ACCESS_TOKEN_EXPIRE_MINUTES}
JWT_EXPIRATION_HOURS=24
# Aliases for compatibility

# Encryption (PII/Health Data)
ENCRYPTION_KEY=<from-vault:encryption-key>
# 🔒 SECRET - Master encryption key (AES-256-CBC, 32 bytes)
# ✅ Stored in Supabase Vault
# See: /infrastructure/security/VAULT_USAGE.md

