# ============================================
# VAULT MIGRATION STATUS
# ============================================
#
# ✅ MIGRATED TO SUPABASE VAULT:
# - encryption_key          (security) - PRODUCTION KEY
# - jwt-secret              (auth)
# - anthropic-api-key       (AI)
# - redis-password          (cache)
# - database-password       (DB)
#
# ⚠️ IN VAULT BUT PLACEHOLDER (REPLACE!):
# - smtp_password           (notifications)
# - slack_webhook_url       (notifications)
# - pagerduty_api_key       (escalations)
#
# ❌ NOT YET IN VAULT (SHOULD MIGRATE):
# - OPENAI_API_KEY          (AI fallback)
# - RABBITMQ_PASSWORD       (message queue)
# - TWILIO_AUTH_TOKEN       (SMS notifications)
# - VAULT_TOKEN             (HashiCorp Vault)
# - BCM_API_KEY             (external integrations)
# - TEMPORAL_API_KEY        (workflow engine)
# - QDRANT_API_KEY          (vector DB)
# - GRAFANA_ADMIN_PASSWORD  (monitoring)
# - KEYCLOAK_CLIENT_SECRET  (SSO)
# - S3_ACCESS_KEY           (file storage)
# - S3_SECRET_KEY           (file storage)
#
# See: /infrastructure/security/VAULT_USAGE.md
#
# To migrate a secret to Vault:
#   PGPASSWORD='K@x3ta9V8GK5rnW' psql -h aws-1-eu-north-1.pooler.supabase.com \
#     -U postgres.tpdkhddtbhpoqzzgxfni -d postgres -p 5432 << 'EOF'
#   SELECT vault.create_secret('your-secret-value', 'secret_name', 'Description');
#   EOF
#
# ============================================
