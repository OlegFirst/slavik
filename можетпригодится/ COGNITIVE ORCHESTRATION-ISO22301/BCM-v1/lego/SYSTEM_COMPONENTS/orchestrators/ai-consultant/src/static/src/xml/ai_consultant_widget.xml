<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="bcm_ai_consultant.AIConsultantWidget">
        <div class="ai-consultant-widget">
            <div class="ai-consultant-status" t-attf-class="{{state.isConnected ? 'connected' : 'disconnected'}}">
                <t t-if="state.isConnected">Connected</t>
                <t t-else="">Disconnected</t>
            </div>

            <div class="ai-consultant-chat">
                <t t-foreach="state.messages" t-as="message" t-key="message_index">
                    <div t-attf-class="ai-message {{message.type}}">
                        <div class="ai-message-content">
                            <t t-esc="message.content"/>
                        </div>
                        <t t-if="message.confidence">
                            <div class="ai-confidence-score">
                                Confidence: <t t-esc="message.confidence"/>%
                            </div>
                        </t>
                        <div class="ai-message-timestamp">
                            <t t-esc="message.timestamp.toLocaleTimeString()"/>
                        </div>
                    </div>
                </t>

                <t t-if="!state.messages.length">
                    <div class="text-muted text-center p-3">
                        Start a conversation with AI Consultant
                    </div>
                </t>
            </div>

            <div class="ai-input-container">
                <input type="text"
                       class="form-control"
                       placeholder="Ask AI Consultant..."
                       t-att-value="state.currentMessage"
                       t-on-input="onInputChange"
                       t-on-keypress="onKeyPress"/>
                <button class="btn btn-primary"
                        t-on-click="sendMessage"
                        t-att-disabled="!state.currentMessage.trim()">
                    Send
                </button>
            </div>
        </div>
    </t>

</templates>