<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Knowledge Base Tree View -->
    <record id="view_knowledge_base_tree" model="ir.ui.view">
        <field name="name">bcm.ai.knowledge.base.tree</field>
        <field name="model">bcm.ai.knowledge.base</field>
        <field name="arch" type="xml">
            <list string="Knowledge Base" sample="1">
                <field name="name"/>
                <field name="category"/>
                <field name="knowledge_type"/>
                <field name="source"/>
                <field name="quality_score" widget="quality_score"/>
                <field name="active" widget="boolean"/>
                <field name="last_reviewed"/>
            </list>
        </field>
    </record>

    <!-- Knowledge Base Form View -->
    <record id="view_knowledge_base_form" model="ir.ui.view">
        <field name="name">bcm.ai.knowledge.base.form</field>
        <field name="model">bcm.ai.knowledge.base</field>
        <field name="arch" type="xml">
            <form string="Knowledge Base Entry">
                <header>
                    <button name="action_review_content" string="Review" type="object"
                            class="btn-primary"/>
                    <field name="is_approved" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="knowledge_type"/>
                            <field name="source"/>
                            <field name="quality_score"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="domain_types"/>
                            <field name="reference_url"/>
                            <field name="last_reviewed"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content">
                            <field name="content" widget="html"/>
                        </page>
                        <page string="Keywords &amp; Tags">
                            <group>
                                <field name="keywords"/>
                                <field name="industry_tags"/>
                            </group>
                        </page>
                        <page string="Related Documents">
                            <field name="attachment_ids" widget="many2many_list"/>
                        </page>
                        <page string="Usage Statistics">
                            <group>
                                <field name="usage_count"/>
                                <field name="effectiveness_rating"/>
                                <field name="quality_score"/>
                            </group>
                        </page>
                        <page string="Technical">
                            <group>
                                <field name="structured_data" widget="text"/>
                                <field name="reviewer_id"/>
                                <field name="is_approved"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Knowledge Base Search View -->
    <record id="view_knowledge_base_search" model="ir.ui.view">
        <field name="name">bcm.ai.knowledge.base.search</field>
        <field name="model">bcm.ai.knowledge.base</field>
        <field name="arch" type="xml">
            <search string="Knowledge Base">
                <field name="name"/>
                <field name="category"/>
                <field name="knowledge_type"/>
                <field name="source"/>
                <field name="keywords"/>
                <field name="content" string="Content" filter_domain="[('content', 'ilike', self)]"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="High Priority" name="high_quality_score" domain="[('quality_score', '=', '3')]"/>
                <filter string="ISO 22301" name="iso22301" domain="[('source', 'ilike', '22301')]"/>
                <filter string="Russian" name="russian" domain="[('domain_types', '=', 'ru')]"/>
                <filter string="English" name="english" domain="[('domain_types', '=', 'en')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" domain="[]" context="{'group_by': 'category'}"/>
                    <filter string="Content Type" name="group_knowledge_type" domain="[]" context="{'group_by': 'knowledge_type'}"/>
                    <filter string="ISO Section" name="group_iso" domain="[]" context="{'group_by': 'source'}"/>
                    <filter string="Priority" name="group_quality_score" domain="[]" context="{'group_by': 'quality_score'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_knowledge_base" model="ir.actions.act_window">
        <field name="name">Knowledge Base</field>
        <field name="res_model">bcm.ai.knowledge.base</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_knowledge_base_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Build your AI Knowledge Base!
            </p>
            <p>
                Create a comprehensive knowledge base with ISO 22301 standards,
                best practices, and organizational specific information
                to enhance AI consultant responses.
            </p>
        </field>
    </record>

</odoo>