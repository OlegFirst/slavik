FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for Docker AI integration
RUN apt-get update && apt-get install -y \
    curl \
    jq \
    gcc \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Docker AI Python dependencies
COPY requirements.docker-ai.txt .
RUN pip install --no-cache-dir -r requirements.docker-ai.txt

# Copy application code
COPY . .
COPY ai_agent_router.py .

# Create non-root user
RUN useradd -m -u 1000 aiuser && chown -R aiuser:aiuser /app
USER aiuser

# Environment variables for Docker AI integration
ENV PYTHONPATH=/app
ENV DOCKER_AI_MODE=enabled
ENV MCP_PROTOCOL_VERSION=1.0.0

# Health check for Docker AI compatibility
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Start with Docker AI native configuration
CMD ["python", "main.py"]