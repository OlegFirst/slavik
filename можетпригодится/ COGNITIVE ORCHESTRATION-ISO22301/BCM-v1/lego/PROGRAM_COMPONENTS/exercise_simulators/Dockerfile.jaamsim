# JaamSim Simulation Engine Dockerfile
FROM openjdk:11-jre-slim

LABEL maintainer="BCM Platform Team"
LABEL description="JaamSim simulation engine for BCM exercises"

# Install system dependencies
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    xvfb \
    x11vnc \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Create application directory
WORKDIR /opt/jaamsim

# Download and install JaamSim
RUN wget -O JaamSim2023-03.jar \
    "https://github.com/jaamsim/jaamsim/releases/download/v2023-03/JaamSim2023-03.jar" \
    && chmod +x JaamSim2023-03.jar

# Create directories for simulation data
RUN mkdir -p /opt/jaamsim/{data,models,results,templates}

# Copy BCM simulation templates
COPY templates/ ./templates/
COPY scripts/ ./scripts/

# Set up virtual display
ENV DISPLAY=:99
RUN echo '#!/bin/bash\nXvfb :99 -screen 0 1280x1024x24 &\nexec "$@"' > /usr/local/bin/entrypoint.sh \
    && chmod +x /usr/local/bin/entrypoint.sh

# Create non-root user
RUN adduser --disabled-password --gecos '' --uid 1000 jaamsim
RUN chown -R jaamsim:jaamsim /opt/jaamsim
USER jaamsim

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD java -version || exit 1

# Default command
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["tail", "-f", "/dev/null"]
