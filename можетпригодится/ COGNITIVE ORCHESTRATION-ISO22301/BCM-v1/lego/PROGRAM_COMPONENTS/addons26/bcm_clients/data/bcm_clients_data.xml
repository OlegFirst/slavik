<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron Job for Vault Reindexing -->
        <record id="cron_vault_indexing" model="ir.cron">
            <field name="name">BCM Vault Context Indexing</field>
            <field name="model_id" ref="model_bcm_client_vault"/>
            <field name="state">code</field>
            <field name="code">model.cron_reindex_pending()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- Cron Job for Client Onboarding Nudges -->
        <record id="cron_onboarding_nudges" model="ir.cron">
            <field name="name">BCM Client Onboarding Nudges</field>
            <field name="model_id" ref="model_bcm_client"/>
            <field name="state">code</field>
            <field name="code">
# Отправка напоминаний по этапам онбординга
clients = model.search([('onboarding_stage', '!=', 'live')])
for client in clients:
    # TODO: Логика отправки уведомлений по этапам
    pass
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Server Actions -->
        <record id="action_client_reindex" model="ir.actions.server">
            <field name="name">Reindex Client Context</field>
            <field name="model_id" ref="model_bcm_client"/>
            <field name="binding_model_id" ref="model_bcm_client"/>
            <field name="binding_view_types">form,list</field>
            <field name="state">code</field>
            <field name="code">
for record in records:
    record.action_reindex_context()
            </field>
        </record>

        <record id="action_client_archive" model="ir.actions.server">
            <field name="name">Archive Client</field>
            <field name="model_id" ref="model_bcm_client"/>
            <field name="binding_model_id" ref="model_bcm_client"/>
            <field name="binding_view_types">form,list</field>
            <field name="state">code</field>
            <field name="code">
for record in records:
    record.action_archive_client()
            </field>
        </record>

        <!-- Email Templates -->
        <record id="email_template_client_welcome" model="mail.template">
            <field name="name">BCM Client Welcome</field>
            <field name="model_id" ref="model_bcm_client"/>
            <field name="subject">Welcome to BCM Platform - ${object.name}</field>
            <field name="body_html"><![CDATA[
<div style="margin: 0px; padding: 0px;">
    <p>Dear ${object.name} Team,</p>
    
    <p>Welcome to the BCM Platform! Your organization has been successfully onboarded.</p>
    
    <p><strong>Your BCM Journey Starts Here:</strong></p>
    <ul>
        <li>Current Stage: ${object.onboarding_stage}</li>
        <li>Industry Sector: ${object.sector}</li>
        <li>Data Residency: ${object.data_residency}</li>
    </ul>
    
    <p><strong>Next Steps:</strong></p>
    <ol>
        <li>Complete your Business Impact Analysis (BIA)</li>
        <li>Develop your Business Continuity Plans</li>
        <li>Set up regular exercises and training</li>
    </ol>
    
    <p>Your BCM team will guide you through each step of the process.</p>
    
    <p>Best regards,<br/>
    BCM Platform Team</p>
</div>
            ]]></field>
            <field name="auto_delete">False</field>
        </record>

        <!-- Categories for Business Continuity -->
        <record id="module_category_business_continuity" model="ir.module.category">
            <field name="name">Business Continuity</field>
            <field name="description">Business Continuity Management System</field>
            <field name="sequence">50</field>
        </record>

    </data>
</odoo>
