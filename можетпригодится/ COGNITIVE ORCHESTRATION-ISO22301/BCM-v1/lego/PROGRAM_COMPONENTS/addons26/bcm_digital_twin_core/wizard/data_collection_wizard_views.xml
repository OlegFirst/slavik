<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Service Registration Wizard View -->
        <record id="view_service_registration_wizard_form" model="ir.ui.view">
            <field name="name">bcm.service.registration.wizard.form</field>
            <field name="model">bcm.service.registration.wizard</field>
            <field name="arch" type="xml">
                <form string="Register New Service">
                    <header>
                        <button name="action_test_connection" type="object" string="Test Connection"
                                class="btn-info" attrs="{'invisible': [('service_url', '=', False)]}"/>
                        <button name="action_register_service" type="object" string="Register Service"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Basic Information">
                                <field name="orchestrator_id" required="1"/>
                                <field name="service_name" required="1"/>
                                <field name="service_category" required="1"/>
                                <field name="service_url" required="1"/>
                            </group>
                            <group string="Collection Settings">
                                <field name="collection_method" required="1"/>
                                <field name="priority" required="1"/>
                                <field name="websocket_url" attrs="{'invisible': [('collection_method', '!=', 'websocket')]}"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Authentication" name="auth">
                                <group>
                                    <field name="auth_type" required="1"/>
                                    <field name="api_key" attrs="{'invisible': [('auth_type', '!=', 'api_key')], 'required': [('auth_type', '=', 'api_key')]}"/>
                                    <field name="username" attrs="{'invisible': [('auth_type', '!=', 'basic')], 'required': [('auth_type', '=', 'basic')]}"/>
                                    <field name="password" password="True" attrs="{'invisible': [('auth_type', '!=', 'basic')], 'required': [('auth_type', '=', 'basic')]}"/>
                                    <field name="bearer_token" attrs="{'invisible': [('auth_type', '!=', 'bearer')], 'required': [('auth_type', '=', 'bearer')]}"/>
                                </group>
                            </page>

                            <page string="Data Configuration" name="data">
                                <group>
                                    <field name="data_types" placeholder="incidents, responses, timelines"/>
                                </group>
                            </page>

                            <page string="Testing" name="testing">
                                <group>
                                    <field name="test_connection"/>
                                </group>
                                <separator string="Connection Test Result"/>
                                <field name="connection_test_result" readonly="1" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Collection Setup Wizard View -->
        <record id="view_collection_setup_wizard_form" model="ir.ui.view">
            <field name="name">bcm.collection.setup.wizard.form</field>
            <field name="model">bcm.collection.setup.wizard</field>
            <field name="arch" type="xml">
                <form string="Setup Data Collection">
                    <header>
                        <button name="action_discover_services" type="object" string="Discover Services"
                                class="btn-info" attrs="{'invisible': [('setup_type', '!=', 'quick_start')]}"/>
                        <button name="action_validate_configuration" type="object" string="Validate Configuration"
                                class="btn-warning"/>
                        <button name="action_apply_configuration" type="object" string="Apply Configuration"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Basic Setup">
                                <field name="orchestrator_id" required="1"/>
                                <field name="setup_type" required="1"/>
                            </group>
                            <group string="Performance Settings">
                                <field name="collection_frequency"/>
                                <field name="max_concurrent"/>
                                <field name="rate_limit"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Quick Start" name="quick_start" attrs="{'invisible': [('setup_type', '!=', 'quick_start')]}">
                                <group>
                                    <group string="Service Categories">
                                        <field name="enable_bcm_modules"/>
                                        <field name="enable_ai_services"/>
                                        <field name="enable_integrations"/>
                                        <field name="enable_adapters"/>
                                    </group>
                                    <group string="Discovery Options">
                                        <field name="auto_discover_services"/>
                                        <field name="validate_config"/>
                                        <field name="test_connections"/>
                                    </group>
                                </group>

                                <separator string="Discovered Services"/>
                                <field name="discovered_services" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                            </page>

                            <page string="Custom Configuration" name="custom" attrs="{'invisible': [('setup_type', '!=', 'custom')]}">
                                <field name="custom_services" widget="ace" options="{'mode': 'json'}"
                                       placeholder="Enter custom service configuration in JSON format"/>
                            </page>

                            <page string="Import Configuration" name="import" attrs="{'invisible': [('setup_type', '!=', 'import_config')]}">
                                <group>
                                    <field name="config_file" filename="config_filename"/>
                                    <field name="config_filename" invisible="1"/>
                                </group>
                            </page>

                            <page string="Setup Status" name="status">
                                <field name="setup_status" readonly="1" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Service Registration Wizard Action -->
        <record id="action_service_registration_wizard" model="ir.actions.act_window">
            <field name="name">Register New Service</field>
            <field name="res_model">bcm.service.registration.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_service_registration_wizard_form"/>
        </record>

        <!-- Collection Setup Wizard Action -->
        <record id="action_collection_setup_wizard" model="ir.actions.act_window">
            <field name="name">Setup Data Collection</field>
            <field name="res_model">bcm.collection.setup.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_collection_setup_wizard_form"/>
        </record>

    </data>
</odoo>