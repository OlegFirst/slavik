<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tag Views -->
        <record id="view_bcm_tag_tree" model="ir.ui.view">
            <field name="name">bcm.tag.tree</field>
            <field name="model">bcm.tag</field>
            <field name="arch" type="xml">
                <list string="Tags" editable="bottom">
                    <field name="name"/>
                    <field name="description"/>
                    <field name="color" widget="color"/>
                    <field name="scenario_count"/>
                    <field name="create_uid" readonly="1"/>
                </list>
            </field>
        </record>

        <record id="view_bcm_tag_form" model="ir.ui.view">
            <field name="name">bcm.tag.form</field>
            <field name="model">bcm.tag</field>
            <field name="arch" type="xml">
                <form string="Tag">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_scenarios" type="object" class="oe_stat_button" icon="fa-list">
                                <field name="scenario_count" widget="statbutton" string="Scenarios"/>
                            </button>
                        </div>
                        
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Tag Name"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="color" widget="color"/>
                                <field name="create_uid" readonly="1"/>
                            </group>
                            <group>
                                <field name="scenario_count" readonly="1"/>
                                <field name="create_date" readonly="1"/>
                            </group>
                        </group>
                        
                        <field name="description" placeholder="Description of this tag..."/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Domain Views -->
        <record id="view_bcm_domain_tree" model="ir.ui.view">
            <field name="name">bcm.domain.tree</field>
            <field name="model">bcm.domain</field>
            <field name="arch" type="xml">
                <list string="Domains">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="parent_id"/>
                    <field name="scenario_count"/>
                    <field name="color" widget="color"/>
                    <field name="icon"/>
                </list>
            </field>
        </record>

        <record id="view_bcm_domain_form" model="ir.ui.view">
            <field name="name">bcm.domain.form</field>
            <field name="model">bcm.domain</field>
            <field name="arch" type="xml">
                <form string="Domain">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_scenarios" type="object" class="oe_stat_button" icon="fa-list">
                                <field name="scenario_count" widget="statbutton" string="Scenarios"/>
                            </button>
                        </div>
                        
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Domain Name"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="parent_id"/>
                                <field name="sequence"/>
                            </group>
                            <group>
                                <field name="color" widget="color"/>
                                <field name="icon"/>
                                <field name="scenario_count" readonly="1"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Description">
                                <field name="description" placeholder="Description of this business domain..."/>
                            </page>
                            
                            <page string="Child Domains" invisible="not child_ids">
                                <field name="child_ids">
                                    <list>
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="scenario_count"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Domain Kanban View -->
        <record id="view_bcm_domain_kanban" model="ir.ui.view">
            <field name="name">bcm.domain.kanban</field>
            <field name="model">bcm.domain</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="color"/>
                    <field name="icon"/>
                    <field name="scenario_count"/>
                    
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click" t-att-style="'border-left: 4px solid ' + record.color.value">
                                <div class="o_kanban_image">
                                    <i t-att-class="record.icon.value || 'fa fa-folder'" 
                                       t-att-style="'color: ' + record.color.value"/>
                                </div>
                                
                                <div class="oe_kanban_details">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                    </div>
                                    
                                    <div class="o_kanban_record_body">
                                        <field name="code" class="text-muted"/>
                                    </div>
                                    
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_right">
                                            <span class="badge badge-pill badge-info">
                                                <field name="scenario_count"/> scenarios
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Search Views -->
        <record id="view_bcm_tag_search" model="ir.ui.view">
            <field name="name">bcm.tag.search</field>
            <field name="model">bcm.tag</field>
            <field name="arch" type="xml">
                <search string="Search Tags">
                    <field name="name"/>
                    <field name="description"/>
                    
                    <filter string="Active Tags" name="active" domain="[('active', '=', True)]"/>
                    
                    <group expand="0" string="Group By">
                        <filter string="Creator" name="group_creator" context="{'group_by': 'create_uid'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_bcm_domain_search" model="ir.ui.view">
            <field name="name">bcm.domain.search</field>
            <field name="model">bcm.domain</field>
            <field name="arch" type="xml">
                <search string="Search Domains">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="description"/>
                    
                    <filter string="Root Domains" name="root_domains" domain="[('parent_id', '=', False)]"/>
                    <filter string="Active Domains" name="active" domain="[('active', '=', True)]"/>
                    
                    <group expand="0" string="Group By">
                        <filter string="Parent Domain" name="group_parent" context="{'group_by': 'parent_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Actions -->
        <record id="action_bcm_tag" model="ir.actions.act_window">
            <field name="name">Tags</field>
            <field name="res_model">bcm.tag</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No tags found. Let's create one!
                </p>
                <p>
                    Tags help categorize and organize scenarios for better discoverability.
                </p>
            </field>
        </record>

        <record id="action_bcm_domain" model="ir.actions.act_window">
            <field name="name">Business Domains</field>
            <field name="res_model">bcm.domain</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No domains found. Let's create one!
                </p>
                <p>
                    Business domains help organize scenarios by industry or functional area.
                </p>
            </field>
        </record>

    </data>
</odoo>
