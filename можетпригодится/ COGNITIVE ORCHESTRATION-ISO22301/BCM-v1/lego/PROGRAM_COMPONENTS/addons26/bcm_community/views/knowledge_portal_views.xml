<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- Knowledge Article Form View -->
    <record id="view_bcm_knowledge_article_form" model="ir.ui.view">
        <field name="name">bcm.knowledge.article.form</field>
        <field name="model">bcm.knowledge.article</field>
        <field name="arch" type="xml">
            <form string="Knowledge Article">
                <header>
                    <button name="action_regenerate_with_ai" type="object"
                            string="🤖 Regenerate with AI" class="btn-primary"
                            invisible="article_type != 'ai_generated'"/>

                    <button name="website_publish_button" type="object"
                            string="📢 Publish to Website" class="btn-success"
                            invisible="is_published"/>

                    <field name="is_published" widget="boolean_toggle"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Article Title"/></h1>
                    </div>

                    <group>
                        <group string="Article Information">
                            <field name="category_id" widget="radio"/>
                            <field name="article_type" readonly="1"/>
                            <field name="usefulness_score" readonly="1" widget="gauge"
                                   options="{'max_value': 10, 'style': 'width:160px; height: 120px;'}"/>
                        </group>
                        <group string="Source Information">
                            <field name="source_exercise_id" readonly="1"/>
                            <field name="source_scenario_id" readonly="1"/>
                            <field name="source_forum_topic_id" readonly="1"/>
                        </group>
                    </group>

                    <!-- Article Content -->
                    <group string="Content">
                        <field name="summary" placeholder="Brief article summary..."/>
                        <field name="content" widget="html" options="{'height': 400}"/>
                    </group>

                    <!-- AI Generation (if applicable) -->
                    <group string="AI Generation" invisible="article_type != 'ai_generated'">
                        <field name="ai_prompt" placeholder="AI generation prompt used..."/>
                        <field name="ai_confidence" readonly="1" widget="progressbar"/>
                    </group>

                    <!-- Organization -->
                    <group string="Organization &amp; Relationships">
                        <field name="tags" widget="many2many_tags"/>
                        <field name="iso_clauses" widget="many2many_tags"/>
                        <field name="sequence"/>
                    </group>

                    <!-- Related Content -->
                    <group string="Related Content">
                        <field name="related_scenarios" widget="many2many_tags"/>
                        <field name="related_templates" widget="many2many_tags"/>
                        <field name="parent_article_id"/>
                    </group>

                    <!-- Analytics -->
                    <group string="Analytics" groups="bcm_core.group_bcm_manager">
                        <group>
                            <field name="view_count" readonly="1"/>
                            <field name="bookmark_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="feedback_count" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>

                    <!-- Sub-articles -->
                    <div class="sub-articles" invisible="not child_article_ids">
                        <h3>📄 Sub-articles</h3>
                        <field name="child_article_ids" mode="list">
                            <list>
                                <field name="name"/>
                                <field name="category_id"/>
                                <field name="usefulness_score"/>
                                <field name="is_published"/>
                            </list>
                        </field>
                    </div>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Knowledge Article Tree View -->
    <record id="view_bcm_knowledge_article_tree" model="ir.ui.view">
        <field name="name">bcm.knowledge.article.tree</field>
        <field name="model">bcm.knowledge.article</field>
        <field name="arch" type="xml">
            <list string="Knowledge Articles" sample="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="article_type"/>
                <field name="usefulness_score" widget="badge" decoration-success="usefulness_score >= 8"
                       decoration-warning="usefulness_score >= 6 and usefulness_score &lt; 8"
                       decoration-danger="usefulness_score &lt; 6"/>
                <field name="view_count"/>
                <field name="bookmark_count"/>
                <field name="is_published" widget="boolean_toggle"/>
                <field name="create_date"/>
                <field name="activity_ids" widget="list_activity"/>
            </list>
        </field>
    </record>

    <!-- Knowledge Article Kanban View -->
    <record id="view_bcm_knowledge_article_kanban" model="ir.ui.view">
        <field name="name">bcm.knowledge.article.kanban</field>
        <field name="model">bcm.knowledge.article</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="category_id"/>
                <field name="article_type"/>
                <field name="usefulness_score"/>
                <field name="view_count"/>
                <field name="is_published"/>
                <field name="activity_ids"/>
                <field name="activity_state"/>
                <progressbar field="activity_state" colors='{"planned": "success", "today": "warning", "overdue": "danger"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top mb16">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <span><t t-esc="record.name.value"/></span>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="usefulness_score" widget="priority"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge" t-attf-class="badge-#{record.category.raw_value}">
                                        <t t-esc="record.category.value"/>
                                    </span>
                                    <t t-if="record.article_type.raw_value == 'ai_generated'">
                                        <span class="badge badge-success">
                                            <i class="fa fa-robot"/> AI
                                        </span>
                                    </t>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                    <field name="is_published" widget="boolean_toggle"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Knowledge Article Search View -->
    <record id="view_bcm_knowledge_article_search" model="ir.ui.view">
        <field name="name">bcm.knowledge.article.search</field>
        <field name="model">bcm.knowledge.article</field>
        <field name="arch" type="xml">
            <search string="Knowledge Articles">
                <field name="name" string="Title"/>
                <field name="summary" string="Summary"/>
                <field name="content" string="Content"/>
                <field name="tags" string="Tags"/>
                <field name="iso_clauses" string="ISO Clauses"/>

                <filter string="Published" name="published" domain="[('is_published', '=', True)]"/>
                <filter string="Draft" name="draft" domain="[('is_published', '=', False)]"/>
                <separator/>
                <filter string="AI Generated" name="ai_generated" domain="[('article_type', '=', 'ai_generated')]"/>
                <filter string="Exercise Derived" name="exercise_derived" domain="[('article_type', '=', 'exercise_derived')]"/>
                <filter string="Community Driven" name="community_driven" domain="[('article_type', '=', 'community_driven')]"/>
                <separator/>
                <filter string="High Rating" name="high_rating" domain="[('usefulness_score', '>=', 8)]"/>
                <filter string="Popular" name="popular" domain="[('view_count', '>=', 100)]"/>

                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Article Type" name="group_type" context="{'group_by': 'article_type'}"/>
                    <filter string="Published Status" name="group_published" context="{'group_by': 'is_published'}"/>
                    <filter string="Creation Date" name="group_create_date" context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Knowledge Tag Views -->
    <record id="view_bcm_knowledge_tag_tree" model="ir.ui.view">
        <field name="name">bcm.knowledge.tag.tree</field>
        <field name="model">bcm.knowledge.tag</field>
        <field name="arch" type="xml">
            <list string="Knowledge Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color"/>
                <field name="description"/>
                <field name="article_count" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- ISO Clause Views -->
    <record id="view_bcm_iso_clause_tree" model="ir.ui.view">
        <field name="name">bcm.iso.clause.tree</field>
        <field name="model">bcm.iso.clause</field>
        <field name="arch" type="xml">
            <list string="ISO 22301 Clauses" editable="bottom">
                <field name="name"/>
                <field name="title"/>
                <field name="description"/>
                <field name="article_count" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- Expert Verification Views -->
    <record id="view_bcm_expert_verification_tree" model="ir.ui.view">
        <field name="name">bcm.expert.verification.tree</field>
        <field name="model">bcm.expert.verification</field>
        <field name="arch" type="xml">
            <list string="Expert Verifications">
                <field name="article_id"/>
                <field name="expert_id"/>
                <field name="verification_status"/>
                <field name="confidence_score"/>
                <field name="verification_date"/>
            </list>
        </field>
    </record>

    <record id="view_bcm_expert_verification_form" model="ir.ui.view">
        <field name="name">bcm.expert.verification.form</field>
        <field name="model">bcm.expert.verification</field>
        <field name="arch" type="xml">
            <form string="Expert Verification">
                <header>
                    <field name="verification_status" widget="statusbar"
                           statusbar_visible="pending,approved,rejected,needs_revision"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="article_id"/>
                            <field name="expert_id"/>
                        </group>
                        <group>
                            <field name="verification_date"/>
                            <field name="confidence_score"/>
                        </group>
                    </group>
                    <group string="Comments">
                        <field name="comments" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Knowledge Bookmark Views -->
    <record id="view_bcm_knowledge_bookmark_tree" model="ir.ui.view">
        <field name="name">bcm.knowledge.bookmark.tree</field>
        <field name="model">bcm.knowledge.bookmark</field>
        <field name="arch" type="xml">
            <list string="Knowledge Bookmarks">
                <field name="user_id"/>
                <field name="article_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_bcm_knowledge_article" model="ir.actions.act_window">
        <field name="name">Knowledge Articles</field>
        <field name="res_model">bcm.knowledge.article</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_published': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first knowledge article!
            </p>
            <p>
                Knowledge articles help capture and share important information about business continuity management.
                Articles can be created manually, generated from exercise results, or contributed by the community.
            </p>
        </field>
    </record>

    <record id="action_bcm_knowledge_tag" model="ir.actions.act_window">
        <field name="name">Knowledge Tags</field>
        <field name="res_model">bcm.knowledge.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_bcm_iso_clause" model="ir.actions.act_window">
        <field name="name">ISO 22301 Clauses</field>
        <field name="res_model">bcm.iso.clause</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_bcm_expert_verification" model="ir.actions.act_window">
        <field name="name">Expert Verifications</field>
        <field name="res_model">bcm.expert.verification</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="action_bcm_knowledge_bookmark" model="ir.actions.act_window">
        <field name="name">Knowledge Bookmarks</field>
        <field name="res_model">bcm.knowledge.bookmark</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_bcm_knowledge_root"
              name="Knowledge Base"
              parent="bcm_core.menu_bcm_community_section"
              sequence="10"/>

    <menuitem id="menu_bcm_knowledge_articles"
              name="Articles"
              parent="menu_bcm_knowledge_root"
              action="action_bcm_knowledge_article"
              sequence="10"/>

    <menuitem id="menu_bcm_knowledge_config"
              name="Configuration"
              parent="menu_bcm_knowledge_root"
              sequence="90"/>

    <menuitem id="menu_bcm_knowledge_tags"
              name="Tags"
              parent="menu_bcm_knowledge_config"
              action="action_bcm_knowledge_tag"
              sequence="10"/>

    <menuitem id="menu_bcm_iso_clauses"
              name="ISO 22301 Clauses"
              parent="menu_bcm_knowledge_config"
              action="action_bcm_iso_clause"
              sequence="20"/>

    <menuitem id="menu_bcm_expert_verification"
              name="Expert Verifications"
              parent="menu_bcm_knowledge_root"
              action="action_bcm_expert_verification"
              sequence="50"/>

    <menuitem id="menu_bcm_knowledge_bookmarks"
              name="Bookmarks"
              parent="menu_bcm_knowledge_root"
              action="action_bcm_knowledge_bookmark"
              sequence="60"/>
    </data>
</odoo>