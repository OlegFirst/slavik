<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Groups -->
    <record id="group_digital_twin_user" model="res.groups">
        <field name="name">Digital Twin User</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_digital_twin_analyst" model="res.groups">
        <field name="name">Digital Twin Analyst</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('group_digital_twin_user'))]"/>
    </record>

    <record id="group_digital_twin_manager" model="res.groups">
        <field name="name">Digital Twin Manager</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('group_digital_twin_analyst'))]"/>
    </record>

    <record id="group_digital_twin_admin" model="res.groups">
        <field name="name">Digital Twin Administrator</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('group_digital_twin_manager'))]"/>
    </record>

    <!-- Record Rules -->

    <!-- Organizations - Users see only their organizations -->
    <record id="digital_twin_organization_user_rule" model="ir.rule">
        <field name="name">Digital Twin Organization: User Rule</field>
        <field name="model_id" ref="model_bcm_digital_twin_organization"/>
        <field name="domain_force">[
            '|',
            ('create_uid', '=', user.id),
            ('message_partner_ids', 'in', [user.partner_id.id])
        ]</field>
        <field name="groups" eval="[(4, ref('group_digital_twin_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Analysts can see all organizations but edit only assigned -->
    <record id="digital_twin_organization_analyst_rule" model="ir.rule">
        <field name="name">Digital Twin Organization: Analyst Rule</field>
        <field name="model_id" ref="model_bcm_digital_twin_organization"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_digital_twin_analyst'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Managers have full access to organizations -->
    <record id="digital_twin_organization_manager_rule" model="ir.rule">
        <field name="name">Digital Twin Organization: Manager Rule</field>
        <field name="model_id" ref="model_bcm_digital_twin_organization"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_digital_twin_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Simulations - Users see only their simulations -->
    <record id="digital_twin_simulation_user_rule" model="ir.rule">
        <field name="name">Digital Twin Simulation: User Rule</field>
        <field name="model_id" ref="model_bcm_digital_twin_simulation"/>
        <field name="domain_force">[
            ('create_uid', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('group_digital_twin_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Multi-company Rules -->
    <record id="digital_twin_organization_multi_company_rule" model="ir.rule">
        <field name="name">Digital Twin Organization: Multi-Company</field>
        <field name="model_id" ref="model_bcm_digital_twin_organization"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[
            '|',
            ('company_id', '=', False),
            ('company_id', 'in', company_ids)
        ]</field>
    </record>

    <record id="digital_twin_simulation_multi_company_rule" model="ir.rule">
        <field name="name">Digital Twin Simulation: Multi-Company</field>
        <field name="model_id" ref="model_bcm_digital_twin_simulation"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[
            '|',
            ('company_id', '=', False),
            ('company_id', 'in', company_ids)
        ]</field>
    </record>
</odoo>