<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Demo Digital Twin Organizations -->
    <record id="demo_organization_corporate_1" model="bcm.digital.twin.organization">
        <field name="name">TechCorp Global</field>
        <field name="domain_type">corporate</field>
        <field name="industry_sector">technology</field>
        <field name="description">Leading technology corporation focused on cloud services and digital transformation</field>
        <field name="twin_status">active</field>
        <field name="twin_health_score">85</field>
        <field name="auto_sync_bcm">True</field>
        <field name="enable_ai_analysis">True</field>
        <field name="enable_predictions">True</field>
        <field name="twin_config">{"prediction_horizon": 12, "analysis_depth": "advanced", "sync_frequency": "daily"}</field>
    </record>

    <record id="demo_organization_government_1" model="bcm.digital.twin.organization">
        <field name="name">City Emergency Services</field>
        <field name="domain_type">government</field>
        <field name="industry_sector">public_safety</field>
        <field name="description">Municipal emergency response and crisis management services</field>
        <field name="twin_status">active</field>
        <field name="twin_health_score">92</field>
        <field name="auto_sync_bcm">True</field>
        <field name="enable_ai_analysis">True</field>
        <field name="enable_predictions">True</field>
        <field name="twin_config">{"prediction_horizon": 6, "analysis_depth": "comprehensive", "sync_frequency": "hourly"}</field>
    </record>

    <record id="demo_organization_npo_1" model="bcm.digital.twin.organization">
        <field name="name">Global Health Foundation</field>
        <field name="domain_type">npo</field>
        <field name="industry_sector">healthcare</field>
        <field name="description">International non-profit organization focused on global health initiatives</field>
        <field name="twin_status">configuring</field>
        <field name="twin_health_score">67</field>
        <field name="auto_sync_bcm">True</field>
        <field name="enable_ai_analysis">True</field>
        <field name="enable_predictions">False</field>
        <field name="twin_config">{"prediction_horizon": 3, "analysis_depth": "standard", "sync_frequency": "weekly"}</field>
    </record>

    <record id="demo_organization_infrastructure_1" model="bcm.digital.twin.organization">
        <field name="name">Metro Power Grid</field>
        <field name="domain_type">infrastructure</field>
        <field name="industry_sector">energy</field>
        <field name="description">Metropolitan electrical power distribution network</field>
        <field name="twin_status">active</field>
        <field name="twin_health_score">78</field>
        <field name="auto_sync_bcm">True</field>
        <field name="enable_ai_analysis">True</field>
        <field name="enable_predictions">True</field>
        <field name="twin_config">{"prediction_horizon": 24, "analysis_depth": "deep", "sync_frequency": "realtime"}</field>
    </record>

    <!-- Demo Simulations -->
    <record id="demo_simulation_1" model="bcm.digital.twin.simulation">
        <field name="name">Cybersecurity Incident Response</field>
        <field name="organization_id" ref="demo_organization_corporate_1"/>
        <field name="scenario_type">crisis_response</field>
        <field name="description">Simulation of major cybersecurity breach and response procedures</field>
        <field name="state">completed</field>
        <field name="confidence_score">89</field>
        <field name="execution_time">00:45:30</field>
        <field name="simulation_config">{"attack_vector": "ransomware", "severity": "high", "response_time": 30}</field>
        <field name="results">{"rto_achieved": true, "rpo_within_limits": true, "lessons_learned": ["Improve backup verification", "Enhance incident communication"]}</field>
    </record>

    <record id="demo_simulation_2" model="bcm.digital.twin.simulation">
        <field name="name">Natural Disaster Response</field>
        <field name="organization_id" ref="demo_organization_government_1"/>
        <field name="scenario_type">emergency_response</field>
        <field name="description">Earthquake response simulation for emergency services coordination</field>
        <field name="state">completed</field>
        <field name="confidence_score">94</field>
        <field name="execution_time">01:20:15</field>
        <field name="simulation_config">{"disaster_type": "earthquake", "magnitude": 6.5, "affected_area": "downtown"}</field>
        <field name="results">{"response_time": 8, "resources_mobilized": 85, "casualties_prevented": 120}</field>
    </record>

    <record id="demo_simulation_3" model="bcm.digital.twin.simulation">
        <field name="name">Supply Chain Disruption</field>
        <field name="organization_id" ref="demo_organization_npo_1"/>
        <field name="scenario_type">business_continuity</field>
        <field name="description">Medical supply chain disruption and alternative sourcing simulation</field>
        <field name="state">running</field>
        <field name="confidence_score">72</field>
        <field name="execution_time">00:15:45</field>
        <field name="simulation_config">{"disruption_type": "supplier_failure", "critical_supplies": ["vaccines", "medicines"], "backup_suppliers": 3}</field>
    </record>
</odoo>