<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- BIA Analysis Page -->
        <template id="bcm_bia_analysis" name="BCM BIA Analysis">
            <t t-call="bcm_portal.bcm_portal_base">
                <t t-set="page_name" t-value="'bia'"/>
                
                <!-- BIA Analysis Header -->
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <h5><i class="fa fa-chart-line"/> Business Impact Analysis</h5>
                                        <p class="mb-0 text-muted">Analyze and optimize your critical business processes</p>
                                    </div>
                                    <div class="col-md-4 text-right">
                                        <a href="/my/bcm/bia/new" class="btn btn-primary">
                                            <i class="fa fa-plus"/> New Analysis
                                        </a>
                                        <button class="btn btn-outline-primary" data-toggle="modal" data-target="#aiOptimizeModal">
                                            <i class="fa fa-robot"/> AI Optimize
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- BIA Statistics Cards -->
                <div class="row mt-3">
                    <div class="col-lg-3 col-md-6">
                        <div class="card text-white bg-primary">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-8">
                                        <h6 class="card-title">Total Processes</h6>
                                        <h3 t-esc="bia_data.get('total_processes', 0)"/>
                                    </div>
                                    <div class="col-4 text-right">
                                        <i class="fa fa-cogs fa-2x"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-lg-3 col-md-6">
                        <div class="card text-white bg-danger">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-8">
                                        <h6 class="card-title">Critical</h6>
                                        <h3 t-esc="bia_data.get('critical_processes', 0)"/>
                                    </div>
                                    <div class="col-4 text-right">
                                        <i class="fa fa-exclamation-circle fa-2x"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-lg-3 col-md-6">
                        <div class="card text-white bg-warning">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-8">
                                        <h6 class="card-title">High Risk</h6>
                                        <h3 t-esc="bia_data.get('high_risk_processes', 0)"/>
                                    </div>
                                    <div class="col-4 text-right">
                                        <i class="fa fa-warning fa-2x"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-lg-3 col-md-6">
                        <div class="card text-white bg-info">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-8">
                                        <h6 class="card-title">Annual Risk</h6>
                                        <h3>$<span t-esc="'{:,.0f}'.format(bia_data.get('total_annual_risk', 0))"/>K</h3>
                                    </div>
                                    <div class="col-4 text-right">
                                        <i class="fa fa-dollar-sign fa-2x"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- BIA Process List -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h5><i class="fa fa-list"/> Business Processes</h5>
                            </div>
                            <div class="card-body">
                                <t t-if="processes">
                                    <div class="table-responsive">
                                        <table class="table table-hover">
                                            <thead class="thead-light">
                                                <tr>
                                                    <th>Process Name</th>
                                                    <th>Criticality</th>
                                                    <th>RTO (Hours)</th>
                                                    <th>RPO (Minutes)</th>
                                                    <th>Annual Impact</th>
                                                    <th>AI Analysis</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="processes" t-as="process">
                                                    <tr>
                                                        <td>
                                                            <strong t-esc="process.name"/>
                                                            <br/>
                                                            <small class="text-muted" t-esc="process.description[:50] + '...' if process.description and len(process.description) > 50 else process.description or ''"/>
                                                        </td>
                                                        <td>
                                                            <span t-if="process.criticality == 'critical'" class="badge badge-danger">Critical</span>
                                                            <span t-if="process.criticality == 'high'" class="badge badge-warning">High</span>
                                                            <span t-if="process.criticality == 'medium'" class="badge badge-info">Medium</span>
                                                            <span t-if="process.criticality == 'low'" class="badge badge-secondary">Low</span>
                                                        </td>
                                                        <td>
                                                            <span t-if="process.optimized_rto_hours" class="text-success">
                                                                <strong t-esc="process.optimized_rto_hours"/>
                                                                <small class="text-muted"> (AI)</small>
                                                            </span>
                                                            <span t-else="" class="text-muted">
                                                                <span t-esc="process.industry_id.base_rto_hours if process.industry_id else '24'"/>
                                                                <small> (default)</small>
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <span t-if="process.optimized_rpo_minutes" class="text-success">
                                                                <strong t-esc="process.optimized_rpo_minutes"/>
                                                                <small class="text-muted"> (AI)</small>
                                                            </span>
                                                            <span t-else="" class="text-muted">
                                                                <span t-esc="process.industry_id.base_rpo_minutes if process.industry_id else '240'"/>
                                                                <small> (default)</small>
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <span t-if="process.annual_risk_exposure" class="text-danger">
                                                                $<strong t-esc="'{:,.0f}'.format(process.annual_risk_exposure)"/>
                                                            </span>
                                                            <span t-else="" class="text-muted">
                                                                $<span t-esc="'{:,.0f}'.format(process.annual_revenue_impact or 0)"/>
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <span t-if="process.last_ai_analysis" class="text-success">
                                                                <i class="fa fa-check-circle"/> Analyzed
                                                                <br/>
                                                                <small class="text-muted" t-esc="process.last_ai_analysis.strftime('%m/%d/%Y')"/>
                                                            </span>
                                                            <span t-else="" class="text-warning">
                                                                <i class="fa fa-clock"/> Pending
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <div class="btn-group btn-group-sm">
                                                                <a t-attf-href="/my/bcm/bia/process/{{process.id}}" class="btn btn-outline-primary btn-sm">
                                                                    <i class="fa fa-eye"/> View
                                                                </a>
                                                                <button t-if="not process.last_ai_analysis" class="btn btn-outline-success btn-sm" 
                                                                        onclick="runAIAnalysis({{process.id}})">
                                                                    <i class="fa fa-robot"/> Analyze
                                                                </button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="text-center text-muted py-5">
                                        <i class="fa fa-cogs fa-4x mb-3"/>
                                        <h5>No Business Processes Found</h5>
                                        <p>Start by adding your critical business processes for analysis.</p>
                                        <a href="/my/bcm/bia/new" class="btn btn-primary">
                                            <i class="fa fa-plus"/> Add First Process
                                        </a>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- BIA Charts Row -->
                <div class="row mt-4">
                    <!-- Risk Distribution Chart -->
                    <div class="col-lg-6">
                        <div class="card">
                            <div class="card-header">
                                <h5><i class="fa fa-pie-chart"/> Risk Distribution</h5>
                            </div>
                            <div class="card-body">
                                <canvas id="riskDistributionChart" width="400" height="300"/>
                            </div>
                        </div>
                    </div>
                    
                    <!-- RTO vs RPO Scatter Plot -->
                    <div class="col-lg-6">
                        <div class="card">
                            <div class="card-header">
                                <h5><i class="fa fa-scatter-chart"/> RTO vs RPO Analysis</h5>
                            </div>
                            <div class="card-body">
                                <canvas id="rtoRpoChart" width="400" height="300"/>
                            </div>
                        </div>
                    </div>
                </div>

            </t>
        </template>
        
        <!-- AI Optimization Modal -->
        <template id="ai_optimize_modal">
            <div class="modal fade" id="aiOptimizeModal" tabindex="-1">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                <i class="fa fa-robot"/> AI BIA Optimization
                            </h5>
                            <button type="button" class="close" data-dismiss="modal">
                                <span>×</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <div class="alert alert-info">
                                <i class="fa fa-info-circle"/> 
                                Our AI will analyze all your business processes and optimize RTO/RPO values based on industry best practices and your specific requirements.
                            </div>
                            <form id="aiOptimizationForm">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Risk Tolerance Level</label>
                                            <select class="form-control" name="risk_tolerance">
                                                <option value="0.01">Very Low (1%)</option>
                                                <option value="0.05" selected="">Low (5%)</option>
                                                <option value="0.10">Medium (10%)</option>
                                                <option value="0.20">High (20%)</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Budget Constraint ($)</label>
                                            <input type="number" class="form-control" name="budget_constraint" 
                                                   placeholder="0 for no constraint" min="0"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Analysis Period (Days)</label>
                                            <select class="form-control" name="analysis_period">
                                                <option value="90">3 Months</option>
                                                <option value="180">6 Months</option>
                                                <option value="365" selected="">1 Year</option>
                                                <option value="730">2 Years</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Optimization Focus</label>
                                            <select class="form-control" name="optimization_focus">
                                                <option value="balanced" selected="">Balanced</option>
                                                <option value="cost">Cost Optimization</option>
                                                <option value="performance">Performance Optimization</option>
                                                <option value="compliance">Compliance Focus</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-primary" onclick="startAIOptimization()">
                                <i class="fa fa-rocket"/> Start Optimization
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </template>

    </data>
</odoo>
