<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main BCM Menu -->
    <menuitem id="menu_bcm_root"
              name="BCM"
              web_icon="bcm_project_management,static/description/icon.png"
              sequence="10"/>

    <!-- BCM Project Management Menu -->
    <menuitem id="menu_bcm_projects"
              name="Project Management"
              parent="menu_bcm_root"
              sequence="10"/>

    <!-- Projects Sub-menu -->
    <menuitem id="menu_bcm_projects_all"
              name="All Projects"
              parent="menu_bcm_projects"
              action="project.open_view_project_all"
              sequence="10"/>

    <menuitem id="menu_bcm_projects_dashboard"
              name="BCM Dashboard"
              parent="menu_bcm_projects"
              action="action_bcm_project_dashboard"
              sequence="5"/>

    <menuitem id="menu_bcm_tasks"
              name="Tasks"
              parent="menu_bcm_projects"
              action="project.action_view_task"
              sequence="20"/>

    <!-- BCM Specific Views -->
    <record id="action_bcm_project_dashboard" model="ir.actions.act_window">
        <field name="name">BCM Projects Dashboard</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">dashboard,kanban,tree,form</field>
        <field name="domain">[('bcm_type', '!=', False)]</field>
        <field name="context">{
            'search_default_bcm_projects': 1,
            'default_bcm_type': 'recovery',
        }</field>
        <field name="view_id" ref="view_bcm_project_dashboard"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first BCM Project!
            </p>
            <p>
                BCM Projects help you manage business continuity activities
                with AI-powered insights and automated workflows.
            </p>
        </field>
    </record>

    <record id="action_bcm_recovery_projects" model="ir.actions.act_window">
        <field name="name">Recovery Projects</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('bcm_type', '=', 'recovery')]</field>
        <field name="context">{'default_bcm_type': 'recovery'}</field>
    </record>

    <record id="action_bcm_exercise_projects" model="ir.actions.act_window">
        <field name="name">Exercise Projects</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('bcm_type', '=', 'exercise')]</field>
        <field name="context">{'default_bcm_type': 'exercise'}</field>
    </record>

    <record id="action_bcm_audit_projects" model="ir.actions.act_window">
        <field name="name">Audit Projects</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('bcm_type', '=', 'audit')]</field>
        <field name="context">{'default_bcm_type': 'audit'}</field>
    </record>

    <!-- Project Type Sub-menus -->
    <menuitem id="menu_bcm_recovery_projects"
              name="Recovery Plans"
              parent="menu_bcm_projects"
              action="action_bcm_recovery_projects"
              sequence="30"/>

    <menuitem id="menu_bcm_exercise_projects"
              name="Exercises"
              parent="menu_bcm_projects"
              action="action_bcm_exercise_projects"
              sequence="40"/>

    <menuitem id="menu_bcm_audit_projects"
              name="Audits"
              parent="menu_bcm_projects"
              action="action_bcm_audit_projects"
              sequence="50"/>

    <!-- Configuration Menu -->
    <menuitem id="menu_bcm_config"
              name="Configuration"
              parent="menu_bcm_root"
              sequence="90"/>

    <!-- AI Configuration -->
    <record id="action_bcm_ai_local" model="ir.actions.act_window">
        <field name="name">AI Assistants</field>
        <field name="res_model">bcm.project.ai.local</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <record id="action_bcm_ai_connector" model="ir.actions.act_window">
        <field name="name">AI Connectors</field>
        <field name="res_model">bcm.ai.connector</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_bcm_ai_config"
              name="AI Configuration"
              parent="menu_bcm_config"
              sequence="10"/>

    <menuitem id="menu_bcm_ai_local"
              name="AI Assistants"
              parent="menu_bcm_ai_config"
              action="action_bcm_ai_local"
              sequence="10"
              groups="bcm_project_group_manager"/>

    <menuitem id="menu_bcm_ai_connector"
              name="AI Connectors"
              parent="menu_bcm_ai_config"
              action="action_bcm_ai_connector"
              sequence="20"
              groups="bcm_project_group_manager"/>

    <!-- Project Templates -->
    <record id="action_bcm_project_templates" model="ir.actions.act_window">
        <field name="name">Project Templates</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_template', '=', True)]</field>
        <field name="context">{'default_is_template': True}</field>
    </record>

    <menuitem id="menu_bcm_project_templates"
              name="Project Templates"
              parent="menu_bcm_config"
              action="action_bcm_project_templates"
              sequence="20"
              groups="bcm_project_group_manager"/>

    <!-- Reports Menu -->
    <menuitem id="menu_bcm_reports"
              name="Reports"
              parent="menu_bcm_root"
              sequence="80"/>

    <!-- Health Report -->
    <record id="action_bcm_health_report" model="ir.actions.act_window">
        <field name="name">Project Health Report</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">graph,pivot,tree</field>
        <field name="domain">[('bcm_type', '!=', False)]</field>
        <field name="context">{
            'search_default_group_health': 1,
            'search_default_bcm_projects': 1,
        }</field>
    </record>

    <menuitem id="menu_bcm_health_report"
              name="Health Report"
              parent="menu_bcm_reports"
              action="action_bcm_health_report"
              sequence="10"/>
</odoo>