# Environment Configuration Example
# Copy this file to .env and update the values for your environment

# Application Configuration
VITE_APP_TITLE="BCM Platform v2"
VITE_APP_ENV="development"
VITE_APP_VERSION="2.0.0"

# API Configuration
VITE_API_BASE_URL="http://localhost:8000/api"
VITE_API_VERSION="v1"
VITE_API_TIMEOUT="30000"

# Authentication Configuration
VITE_JWT_EXPIRES_IN="24h"
VITE_REFRESH_TOKEN_EXPIRES_IN="7d"

# Feature Flags
VITE_ENABLE_AI_ASSISTANT="true"
VITE_ENABLE_NOTIFICATIONS="true"
VITE_ENABLE_ANALYTICS="false"
VITE_ENABLE_DEBUG_MODE="false"

# External Service URLs
VITE_DOCUMENTATION_URL="https://docs.bcm.example.com"
VITE_SUPPORT_URL="https://support.bcm.example.com"
VITE_TERMS_URL="https://bcm.example.com/terms"
VITE_PRIVACY_URL="https://bcm.example.com/privacy"

# Analytics (if enabled)
# VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
# VITE_HOTJAR_ID="XXXXXXX"

# Sentry Error Tracking (if enabled)
# VITE_SENTRY_DSN="https://xxxxxxxxxxxxxxxx@sentry.io/xxxxxxx"
# VITE_SENTRY_ENVIRONMENT="development"

# Feature Configuration
VITE_MAX_FILE_SIZE="10485760"  # 10MB in bytes
VITE_ALLOWED_FILE_TYPES="pdf,doc,docx,xls,xlsx,ppt,pptx,txt,csv"
VITE_SESSION_TIMEOUT="3600000"  # 1 hour in milliseconds
VITE_MAX_SEARCH_RESULTS="50"
VITE_DEFAULT_PAGE_SIZE="25"

# Theming
VITE_DEFAULT_THEME="light"
VITE_BRAND_COLOR="#2563eb"
VITE_ENABLE_DARK_MODE="true"

# Localization
VITE_DEFAULT_LOCALE="en"
VITE_SUPPORTED_LOCALES="en,es,fr,de,pt"
VITE_TIMEZONE="UTC"

# Development Only
VITE_MOCK_API="false"
VITE_ENABLE_DEVTOOLS="true"