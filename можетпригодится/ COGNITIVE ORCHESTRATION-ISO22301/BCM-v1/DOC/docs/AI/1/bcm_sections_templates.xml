<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Plans Section -->
        <template id="bcm_plans" name="BCM Plans">
            <t t-call="bcm_portal.bcm_portal_base">
                <t t-set="page_name" t-value="'plans'"/>
                
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <h5><i class="fa fa-file-text"/> Business Continuity Plans</h5>
                                        <p class="mb-0 text-muted">Manage and review your BC plans</p>
                                    </div>
                                    <div class="col-md-4 text-right">
                                        <a href="/my/bcm/plans/new" class="btn btn-primary">
                                            <i class="fa fa-plus"/> New Plan
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                <t t-if="plans">
                                    <div class="row">
                                        <t t-foreach="plans" t-as="plan">
                                            <div class="col-lg-4 col-md-6 mb-3">
                                                <div class="card">
                                                    <div class="card-body">
                                                        <h6 class="card-title" t-esc="plan.name"/>
                                                        <p class="card-text text-muted" t-esc="plan.notes[:100] + '...' if plan.notes and len(plan.notes) > 100 else plan.notes or 'No description'"/>
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <small class="text-muted">
                                                                <span t-if="plan.active" class="badge badge-success">Active</span>
                                                                <span t-else="" class="badge badge-secondary">Inactive</span>
                                                            </small>
                                                            <div class="btn-group btn-group-sm">
                                                                <a t-attf-href="/my/bcm/plans/{{plan.id}}" class="btn btn-outline-primary">View</a>
                                                                <a t-attf-href="/my/bcm/plans/{{plan.id}}/edit" class="btn btn-outline-secondary">Edit</a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="text-center text-muted py-5">
                                        <i class="fa fa-file-text fa-4x mb-3"/>
                                        <h5>No Plans Found</h5>
                                        <p>Start creating your business continuity plans.</p>
                                        <a href="/my/bcm/plans/new" class="btn btn-primary">Create First Plan</a>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Incidents Section -->
        <template id="bcm_incidents" name="BCM Incidents">
            <t t-call="bcm_portal.bcm_portal_base">
                <t t-set="page_name" t-value="'incidents'"/>
                
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <h5><i class="fa fa-exclamation-circle"/> Incident Management</h5>
                                        <p class="mb-0 text-muted">Track and manage business continuity incidents</p>
                                    </div>
                                    <div class="col-md-4 text-right">
                                        <a href="/my/bcm/incidents/report" class="btn btn-danger">
                                            <i class="fa fa-exclamation-triangle"/> Report Incident
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                <t t-if="incidents">
                                    <div class="table-responsive">
                                        <table class="table table-hover">
                                            <thead class="thead-light">
                                                <tr>
                                                    <th>Incident</th>
                                                    <th>Severity</th>
                                                    <th>Status</th>
                                                    <th>Reported</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="incidents" t-as="incident">
                                                    <tr>
                                                        <td>
                                                            <strong t-esc="incident.name"/>
                                                            <br/>
                                                            <small class="text-muted" t-esc="incident.notes[:50] + '...' if incident.notes and len(incident.notes) > 50 else incident.notes or ''"/>
                                                        </td>
                                                        <td>
                                                            <span class="badge badge-danger">High</span>
                                                        </td>
                                                        <td>
                                                            <span t-if="incident.active" class="badge badge-warning">Active</span>
                                                            <span t-else="" class="badge badge-success">Resolved</span>
                                                        </td>
                                                        <td>
                                                            <small t-esc="incident.create_date.strftime('%m/%d/%Y %H:%M') if incident.create_date else ''"/>
                                                        </td>
                                                        <td>
                                                            <a t-attf-href="/my/bcm/incidents/{{incident.id}}" class="btn btn-sm btn-outline-primary">
                                                                View Details
                                                            </a>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="text-center text-muted py-5">
                                        <i class="fa fa-check-circle fa-4x text-success mb-3"/>
                                        <h5>No Active Incidents</h5>
                                        <p>Great! No incidents are currently being tracked.</p>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Exercises Section -->
        <template id="bcm_exercises" name="BCM Exercises">
            <t t-call="bcm_portal.bcm_portal_base">
                <t t-set="page_name" t-value="'exercises'"/>
                
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <h5><i class="fa fa-play-circle"/> Training Exercises</h5>
                                        <p class="mb-0 text-muted">Schedule and participate in BC exercises</p>
                                    </div>
                                    <div class="col-md-4 text-right">
                                        <a href="/my/bcm/exercises/schedule" class="btn btn-success">
                                            <i class="fa fa-calendar-plus"/> Schedule Exercise
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                <t t-if="exercises">
                                    <div class="row">
                                        <t t-foreach="exercises" t-as="exercise">
                                            <div class="col-lg-6 mb-3">
                                                <div class="card">
                                                    <div class="card-body">
                                                        <h6 class="card-title" t-esc="exercise.name"/>
                                                        <p class="card-text text-muted" t-esc="exercise.notes[:80] + '...' if exercise.notes and len(exercise.notes) > 80 else exercise.notes or 'No description'"/>
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <div>
                                                                <span t-if="exercise.active" class="badge badge-primary">Scheduled</span>
                                                                <span t-else="" class="badge badge-success">Completed</span>
                                                            </div>
                                                            <a t-attf-href="/my/bcm/exercises/{{exercise.id}}" class="btn btn-sm btn-outline-primary">
                                                                View Details
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="text-center text-muted py-5">
                                        <i class="fa fa-play-circle fa-4x mb-3"/>
                                        <h5>No Exercises Scheduled</h5>
                                        <p>Regular exercises help maintain BCM readiness.</p>
                                        <a href="/my/bcm/exercises/schedule" class="btn btn-primary">Schedule First Exercise</a>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Audit Section -->
        <template id="bcm_audit" name="BCM Audit">
            <t t-call="bcm_portal.bcm_portal_base">
                <t t-set="page_name" t-value="'audit'"/>
                
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <h5><i class="fa fa-search"/> Audit &amp; Compliance</h5>
                                        <p class="mb-0 text-muted">Monitor compliance and audit activities</p>
                                    </div>
                                    <div class="col-md-4 text-right">
                                        <a href="/my/bcm/audit/new" class="btn btn-info">
                                            <i class="fa fa-plus"/> New Audit
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                <t t-if="audits">
                                    <div class="row">
                                        <t t-foreach="audits" t-as="audit">
                                            <div class="col-lg-4 col-md-6 mb-3">
                                                <div class="card">
                                                    <div class="card-body">
                                                        <h6 class="card-title" t-esc="audit.name"/>
                                                        <p class="card-text text-muted" t-esc="audit.notes[:100] + '...' if audit.notes and len(audit.notes) > 100 else audit.notes or 'No description'"/>
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <span t-if="audit.active" class="badge badge-info">In Progress</span>
                                                            <span t-else="" class="badge badge-secondary">Completed</span>
                                                            <a t-attf-href="/my/bcm/audit/{{audit.id}}" class="btn btn-sm btn-outline-primary">View</a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="text-center text-muted py-5">
                                        <i class="fa fa-search fa-4x mb-3"/>
                                        <h5>No Audits Found</h5>
                                        <p>Track your compliance and audit activities.</p>
                                        <a href="/my/bcm/audit/new" class="btn btn-primary">Start First Audit</a>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Training Section -->
        <template id="bcm_training" name="BCM Training">
            <t t-call="bcm_portal.bcm_portal_base">
                <t t-set="page_name" t-value="'training'"/>
                
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <div class="row align-items-center">
                                    <div class="col-md-8">
                                        <h5><i class="fa fa-graduation-cap"/> Training &amp; Awareness</h5>
                                        <p class="mb-0 text-muted">Manage BCM training programs</p>
                                    </div>
                                    <div class="col-md-4 text-right">
                                        <a href="/my/bcm/training/enroll" class="btn btn-success">
                                            <i class="fa fa-user-plus"/> Enroll in Training
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                <t t-if="trainings">
                                    <div class="row">
                                        <t t-foreach="trainings" t-as="training">
                                            <div class="col-lg-4 col-md-6 mb-3">
                                                <div class="card">
                                                    <div class="card-body">
                                                        <h6 class="card-title" t-esc="training.name"/>
                                                        <p class="card-text text-muted" t-esc="training.notes[:100] + '...' if training.notes and len(training.notes) > 100 else training.notes or 'No description'"/>
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <span t-if="training.active" class="badge badge-success">Available</span>
                                                            <span t-else="" class="badge badge-secondary">Completed</span>
                                                            <a t-attf-href="/my/bcm/training/{{training.id}}" class="btn btn-sm btn-outline-primary">
                                                                <t t-if="training.active">Start</t>
                                                                <t t-else="">Review</t>
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="text-center text-muted py-5">
                                        <i class="fa fa-graduation-cap fa-4x mb-3"/>
                                        <h5>No Training Available</h5>
                                        <p>Training programs help maintain BCM awareness.</p>
                                        <a href="/my/bcm/training/enroll" class="btn btn-primary">Browse Available Training</a>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

    </data>
</odoo>