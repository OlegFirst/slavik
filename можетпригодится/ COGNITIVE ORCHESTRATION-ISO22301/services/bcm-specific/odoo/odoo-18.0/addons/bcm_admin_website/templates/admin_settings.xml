<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="admin_settings_template" name="BCM Admin Settings">
        <t t-call="website.layout">
            <t t-set="title">System Settings</t>
            <div id="wrap">
                <div class="container my-4">
                    <h1><i class="fa fa-cog me-3"></i>System Settings</h1>
                    <p class="text-muted">Configure BCM platform settings</p>

                    <div class="card">
                        <div class="card-body">
                            <h6>System Configuration</h6>
                            <p>AI Enabled: <t t-esc="settings.get('ai_enabled', 'Yes')"/></p>
                            <p>Debug Mode: <t t-esc="settings.get('debug_mode', 'No')"/></p>
                            <a href="/web#menu_id=base.menu_administration" class="btn btn-primary" target="_blank">
                                System Settings
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>