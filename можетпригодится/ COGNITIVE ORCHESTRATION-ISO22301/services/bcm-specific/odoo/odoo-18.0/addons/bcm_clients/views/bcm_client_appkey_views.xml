<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- BCM Client API Key Tree View -->
        <record id="bcm_client_appkey_view_tree" model="ir.ui.view">
            <field name="name">bcm.client.appkey.tree</field>
            <field name="model">bcm.client.appkey</field>
            <field name="arch" type="xml">
                <list string="API Keys" decoration-danger="revoked" decoration-warning="is_expired">
                    <field name="client_id"/>
                    <field name="name"/>
                    <field name="status_display"/>
                    <field name="created_at"/>
                    <field name="valid_until"/>
                    <field name="last_used"/>
                    <field name="usage_count"/>
                    <field name="rate_limit"/>
                    <field name="revoked" invisible="1"/>
                    <field name="is_expired" invisible="1"/>
                </list>
            </field>
        </record>

        <!-- BCM Client API Key Form View -->
        <record id="bcm_client_appkey_view_form" model="ir.ui.view">
            <field name="name">bcm.client.appkey.form</field>
            <field name="model">bcm.client.appkey</field>
            <field name="arch" type="xml">
                <form string="API Key">
                    <header>
                        <button name="action_revoke" type="object" 
                                string="Revoke" class="btn-danger"
                                invisible="revoked == True"/>
                        <button name="action_regenerate" type="object" 
                                string="Regenerate" class="btn-warning"
                                invisible="revoked == True"
                                confirm="This will create a new API key and revoke the current one. Continue?"/>
                        <field name="status_display" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="alert alert-success" role="alert" 
                             invisible="token_display == ''">
                            <strong>API Token Created Successfully!</strong><br/>
                            Please copy and save this token - it will not be shown again:<br/>
                            <code><field name="token_display" readonly="1"/></code>
                        </div>
                        
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="API Key Name"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group string="API Key Information">
                                <field name="client_id"/>
                                <field name="description"/>
                                <field name="created_at"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group string="Validity &amp; Security">
                                <field name="valid_until"/>
                                <field name="revoked"/>
                                <field name="revoke_reason" invisible="revoked == False"/>
                                <field name="rate_limit"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Access Scopes" name="scopes">
                                <field name="scope_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="description"/>
                                    </list>
                                </field>
                            </page>
                            
                            <page string="Usage Statistics" name="usage">
                                <group>
                                    <group string="Usage Metrics">
                                        <field name="usage_count"/>
                                        <field name="last_used"/>
                                        <field name="is_expired"/>
                                        <field name="is_valid"/>
                                    </group>
                                    <group string="Security">
                                        <field name="allowed_ips"/>
                                        <field name="token_hash" groups="base.group_system"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- BCM Client API Key Search View -->
        <record id="bcm_client_appkey_view_search" model="ir.ui.view">
            <field name="name">bcm.client.appkey.search</field>
            <field name="model">bcm.client.appkey</field>
            <field name="arch" type="xml">
                <search string="Search API Keys">
                    <field name="name" string="Key Name"/>
                    <field name="client_id"/>
                    <field name="scope_ids"/>
                    
                    <separator/>
                    <filter string="Active" name="active" 
                            domain="[('active', '=', True)]"/>
                    <filter string="Valid" name="valid" 
                            domain="[('is_valid', '=', True)]"/>
                    <filter string="Expired" name="expired" 
                            domain="[('is_expired', '=', True)]"/>
                    <filter string="Revoked" name="revoked" 
                            domain="[('revoked', '=', True)]"/>
                    
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Client" name="group_client" 
                                domain="[]" context="{'group_by': 'client_id'}"/>
                        <filter string="Status" name="group_status" 
                                domain="[]" context="{'group_by': 'status_display'}"/>
                        <filter string="Creation Month" name="group_month" 
                                domain="[]" context="{'group_by': 'created_at:month'}"/>
                        <filter string="Company" name="group_company" 
                                domain="[]" context="{'group_by': 'company_id'}" 
                                groups="base.group_multi_company"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- BCM Client API Key Action -->
        <record id="bcm_client_appkey_action" model="ir.actions.act_window">
            <field name="name">API Keys</field>
            <field name="res_model">bcm.client.appkey</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_active': 1, 'search_default_valid': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create API Keys for Client Access!
                </p>
                <p>
                    Generate secure API keys for clients to access BCM platform services.
                    You can set access scopes, expiration dates, and IP restrictions.
                </p>
            </field>
        </record>

        <!-- BCM Scope Tree View -->
        <record id="bcm_scope_view_tree" model="ir.ui.view">
            <field name="name">bcm.scope.tree</field>
            <field name="model">bcm.scope</field>
            <field name="arch" type="xml">
                <list string="API Scopes" editable="top">
                    <field name="name"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <!-- BCM Scope Form View -->
        <record id="bcm_scope_view_form" model="ir.ui.view">
            <field name="name">bcm.scope.form</field>
            <field name="model">bcm.scope</field>
            <field name="arch" type="xml">
                <form string="API Scope">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Scope Name"/>
                            </h1>
                        </div>
                        <group>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- BCM Scope Action -->
        <record id="bcm_scope_action" model="ir.actions.act_window">
            <field name="name">API Scopes</field>
            <field name="res_model">bcm.scope</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Define API Access Scopes!
                </p>
                <p>
                    Create and manage API access scopes to control what 
                    client applications can access through the API.
                </p>
            </field>
        </record>

    </data>
</odoo>
