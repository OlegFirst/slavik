<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AI Recommendation Tree View -->
    <record id="view_bcm_ai_recommendation_tree" model="ir.ui.view">
        <field name="name">bcm.ai.recommendation.tree</field>
        <field name="model">bcm.ai.recommendation</field>
        <field name="arch" type="xml">
            <tree string="AI Recommendations">
                <field name="name"/>
                <field name="recommendation_type"/>
                <field name="priority"/>
                <field name="confidence_score" widget="percentage"/>
                <field name="state"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <!-- AI Recommendation Form View -->
    <record id="view_bcm_ai_recommendation_form" model="ir.ui.view">
        <field name="name">bcm.ai.recommendation.form</field>
        <field name="model">bcm.ai.recommendation</field>
        <field name="arch" type="xml">
            <form string="AI Recommendation">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,proposed,accepted,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="recommendation_type"/>
                            <field name="priority"/>
                            <field name="confidence_score" widget="percentage"/>
                        </group>
                        <group>
                            <field name="description"/>
                            <field name="reasoning"/>
                            <field name="impact_analysis"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Intelligent Insight Tree View -->
    <record id="view_bcm_intelligent_insight_tree" model="ir.ui.view">
        <field name="name">bcm.intelligent.insight.tree</field>
        <field name="model">bcm.intelligent.insight</field>
        <field name="arch" type="xml">
            <tree string="Intelligent Insights">
                <field name="name"/>
                <field name="insight_type"/>
                <field name="severity"/>
                <field name="module_name"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <!-- Intelligent Insight Form View -->
    <record id="view_bcm_intelligent_insight_form" model="ir.ui.view">
        <field name="name">bcm.intelligent.insight.form</field>
        <field name="model">bcm.intelligent.insight</field>
        <field name="arch" type="xml">
            <form string="Intelligent Insight">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="insight_type"/>
                            <field name="severity"/>
                            <field name="module_name"/>
                        </group>
                        <group>
                            <field name="insight_data"/>
                            <field name="action_required"/>
                            <field name="created_by"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Details">
                            <field name="description"/>
                        </page>
                        <page string="Actions">
                            <field name="recommended_actions"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_intelligent_base_root"
              name="Intelligent Base"
              parent="bcm_core.menu_bcm_root"
              sequence="70"/>

    <menuitem id="menu_ai_recommendations"
              name="AI Recommendations"
              parent="menu_intelligent_base_root"
              action="action_ai_recommendations"
              sequence="10"/>

    <menuitem id="menu_intelligent_insights"
              name="Intelligent Insights"
              parent="menu_intelligent_base_root"
              action="action_intelligent_insights"
              sequence="20"/>

    <!-- Actions -->
    <record id="action_ai_recommendations" model="ir.actions.act_window">
        <field name="name">AI Recommendations</field>
        <field name="res_model">bcm.ai.recommendation</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_intelligent_insights" model="ir.actions.act_window">
        <field name="name">Intelligent Insights</field>
        <field name="res_model">bcm.intelligent.insight</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>