<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- BCM Incident List View -->
        <record id="view_bcm_incident_tree" model="ir.ui.view">
            <field name="name">bcm.incident.tree</field>
            <field name="model">bcm.incident</field>
            <field name="arch" type="xml">
                <list string="BCM Incidents">
                    <field name="name"/>
                    <field name="severity" decoration-danger="severity=='critical'" decoration-warning="severity=='high'"/>
                    <field name="category"/>
                    <field name="status" decoration-success="status=='resolved'" decoration-info="status=='investigating'"/>
                    <field name="assigned_user_id"/>
                    <field name="reported_date"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <!-- BCM Incident Form View -->
        <record id="view_bcm_incident_form" model="ir.ui.view">
            <field name="name">bcm.incident.form</field>
            <field name="model">bcm.incident</field>
            <field name="arch" type="xml">
                <form string="BCM Incident">
                    <header>
                        <field name="status" widget="statusbar" statusbar_visible="draft,reported,investigating,responding,resolved,closed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Incident Title..."/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="severity"/>
                                <field name="category"/>
                                <field name="assigned_user_id"/>
                            </group>
                            <group>
                                <field name="reported_date"/>
                                <field name="resolved_date"/>
                                <field name="plan_id"/>
                            </group>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                        <notebook>
                            <page string="Response Checklist">
                                <group>
                                    <field name="ai_generated_checklist"/>
                                    <field name="response_checklist" widget="text"/>
                                </group>
                            </page>
                            <page string="Resolution">
                                <group>
                                    <field name="resolution_notes" widget="html"/>
                                </group>
                            </page>
                            <page string="Compliance">
                                <group>
                                    <group>
                                        <field name="iso_clause"/>
                                        <field name="compliance_status"/>
                                    </group>
                                    <group>
                                        <field name="risk_level"/>
                                    </group>
                                </group>
                                <group>
                                    <field name="tag_ids" widget="many2many_tags"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- BCM Incident Search View -->
        <record id="view_bcm_incident_search" model="ir.ui.view">
            <field name="name">bcm.incident.search</field>
            <field name="model">bcm.incident</field>
            <field name="arch" type="xml">
                <search string="Search BCM Incidents">
                    <field name="name"/>
                    <field name="severity"/>
                    <field name="category"/>
                    <field name="assigned_user_id"/>
                    <filter string="Open" name="open" domain="[('status','not in',['resolved','closed'])]"/>
                    <filter string="Critical" name="critical" domain="[('severity','=','critical')]"/>
                    <filter string="High Priority" name="high" domain="[('severity','=','high')]"/>
                    <separator/>
                    <filter string="My Incidents" name="my_incidents" domain="[('assigned_user_id','=',uid)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Severity" name="group_severity" context="{'group_by':'severity'}"/>
                        <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                        <filter string="Category" name="group_category" context="{'group_by':'category'}"/>
                        <filter string="Assigned To" name="group_assigned" context="{'group_by':'assigned_user_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- BCM Incident Action -->
        <record id="action_bcm_incident" model="ir.actions.act_window">
            <field name="name">BCM Incidents</field>
            <field name="res_model">bcm.incident</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_bcm_incident_search"/>
            <field name="context">{'search_default_open': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Report your first BCM Incident
                </p>
                <p>
                    Track and manage business continuity incidents to ensure proper response and resolution.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_bcm_incidents"
                  name="Incidents"
                  parent="menu_bcm_root"
                  action="action_bcm_incident"
                  sequence="30"/>
    </data>
</odoo>