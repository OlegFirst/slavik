<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- AI Orchestrator Default Configuration -->
        <record id="default_ai_config" model="ir.config_parameter">
            <field name="key">bcm_ai_twin_orchestrator.default_analysis_type</field>
            <field name="value">comprehensive</field>
        </record>

        <record id="default_ai_parallel_workers" model="ir.config_parameter">
            <field name="key">bcm_ai_twin_orchestrator.parallel_workers</field>
            <field name="value">5</field>
        </record>

        <record id="default_ai_timeout" model="ir.config_parameter">
            <field name="key">bcm_ai_twin_orchestrator.analysis_timeout</field>
            <field name="value">300</field>
        </record>

        <!-- AI Organs Configuration -->
        <record id="organs_confidence_threshold" model="ir.config_parameter">
            <field name="key">bcm_ai_twin_orchestrator.confidence_threshold</field>
            <field name="value">60.0</field>
        </record>

        <record id="enable_bcm_integration" model="ir.config_parameter">
            <field name="key">bcm_ai_twin_orchestrator.enable_bcm_integration</field>
            <field name="value">True</field>
        </record>

        <record id="enable_simulation_fallback" model="ir.config_parameter">
            <field name="key">bcm_ai_twin_orchestrator.enable_simulation_fallback</field>
            <field name="value">True</field>
        </record>

    </data>
</odoo>