<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- BCM Risk Management Multi-tenant Rules -->
        
        <!-- Risk Assessment Rules -->
        <record id="bcm_risk_assessment_company_rule" model="ir.rule">
            <field name="name">BCM Risk Assessment: Company Rule</field>
            <field name="model_id" ref="model_bcm_risk_assessment"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <!-- Risk Register Rules -->
        <record id="bcm_risk_register_company_rule" model="ir.rule">
