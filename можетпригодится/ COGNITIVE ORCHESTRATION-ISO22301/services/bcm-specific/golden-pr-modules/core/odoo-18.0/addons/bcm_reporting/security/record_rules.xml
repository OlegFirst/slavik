<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- BCM Reporting Multi-tenant Rules -->
        
        <!-- Report Template Rules -->
        <record id="bcm_report_template_company_rule" model="ir.rule">
            <field name="name">BCM Report Template: Company Rule</field>
            <field name="model_id" ref="model_bcm_report_template"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <!-- Report Generation Rules -->
        <record id="bcm_report_generation_company_rule" model="ir.rule">
            <field name="name">BCM Report Generation: Company Rule</field>
            <field name="model_id" ref="model_bcm_report_generation"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <!-- Report Schedule Rules -->
        <record id="bcm_report_schedule_company_rule" model="ir.rule">
            <field name="name">BCM Report Schedule: Company Rule</field>
            <field name="model_id" ref="model_bcm_report_schedule"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <!-- Dashboard Config Rules -->
        <record id="bcm_dashboard_config_company_rule" model="ir.rule">
            <field name="name">BCM Dashboard Config: Company Rule</field>
            <field name="model_id" ref="model_bcm_dashboard_config"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <!-- Portal Dashboard Access -->
        <record id="bcm_dashboard_portal_rule" model="ir.rule">
            <field name="name">BCM Dashboard: Portal Access</field>
            <field name="model_id" ref="model_bcm_dashboard_config"/>
            <field name="domain_force">[
                ('company_id', 'in', user.partner_id.parent_id.company_id.ids),
                ('is_public', '=', True)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
