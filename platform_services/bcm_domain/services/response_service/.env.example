# Response Module - Environment Variables
# ISO 22301:2019 Clause 8.4 - Incident Response
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@host:port/database

# Example with Supabase:
# DATABASE_URL=postgresql+asyncpg://postgres.xxxxx:YOUR_PASSWORD@aws-1-eu-north-1.pooler.supabase.com:5432/postgres

# Service Configuration (optional - has defaults)
# HOST=0.0.0.0
# PORT=8041
# DEBUG=false
# DB_SCHEMA=response
# DB_POOL_SIZE=20

# ISO Configuration (optional - has defaults)
# DEFAULT_RTO_HOURS=4.0
# DEFAULT_RPO_HOURS=1.0
# AUTO_ESCALATE_CRITICAL=true

# JWT Authentication Configuration
# Enable/disable JWT authentication (set to false for development/testing)
JWT_AUTH_ENABLED=true

# JWT Secret Key - MUST be set in production
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-here-change-in-production

# JWT Algorithm (default: HS256)
JWT_ALGORITHM=HS256

# JWT Token Expiration in minutes (default: 30)
JWT_EXPIRATION_MINUTES=30

# Event Bus (optional)
EVENT_BUS_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=response_events
RABBITMQ_QUEUE=response_queue
