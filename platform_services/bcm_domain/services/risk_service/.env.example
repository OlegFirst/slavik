# Risk Management Module - Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@host:port/database

# Example with Supabase:
# DATABASE_URL=postgresql+asyncpg://postgres.xxxxx:YOUR_PASSWORD@aws-1-eu-north-1.pooler.supabase.com:5432/postgres

# Service Configuration (optional - has defaults)
# PORT=8040
# DEBUG=false

# JWT Authentication Configuration
# Enable/disable JWT authentication (set to false for development/testing)
JWT_AUTH_ENABLED=true

# JWT Secret Key - MUST be set in production
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-here-change-in-production

# JWT Algorithm (default: HS256)
JWT_ALGORITHM=HS256

# JWT Token Expiration in minutes (default: 30)
JWT_EXPIRATION_MINUTES=30
