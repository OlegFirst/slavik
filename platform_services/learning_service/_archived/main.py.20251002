        }

    except Exception as e:
        logger.error(f"❌ Award points failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/api/learning/gamification/leaderboard")
async def get_leaderboard(
    tenant_id: str,
    limit: int = 10,
    db: AsyncSession = Depends(get_db)
):
    """Get points leaderboard"""
    try:
        # Get top scorers
        query = select(
            TrainingEnrollment.person_id,
            TrainingEnrollment.person_name,
            func.sum(TrainingEnrollment.points_earned).label('total_points')
        ).filter(
            TrainingEnrollment.tenant_id == tenant_id
        ).group_by(
            TrainingEnrollment.person_id,
            TrainingEnrollment.person_name
        ).order_by(
            func.sum(TrainingEnrollment.points_earned).desc()
        ).limit(limit)

        result = await db.execute(query)
        leaderboard_raw = result.all()

        # Get achievement counts
        leaderboard = []
        for rank, (person_id, person_name, total_points) in enumerate(leaderboard_raw, start=1):
            # Get achievements count
            ach_query = select(func.count()).select_from(UserAchievement).filter(
                UserAchievement.person_id == person_id,
                UserAchievement.tenant_id == tenant_id
            )
            ach_result = await db.execute(ach_query)
            achievements_count = ach_result.scalar()

            # Calculate level
            level_info = calculate_level(total_points or 0)

            leaderboard.append({
                "rank": rank,
                "person_id": person_id,
                "person_name": person_name,
                "total_points": total_points or 0,
                "level": level_info['level'],
                "level_title": level_info['title'],
                "achievements_count": achievements_count or 0
            })

        return {
            "leaderboard": leaderboard,
            "total_entries": len(leaderboard),
            "timestamp": datetime.utcnow().isoformat()
        }

    except Exception as e:
        logger.error(f"❌ Leaderboard failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/api/learning/gamification/achievements/{person_id}")
async def get_person_achievements(
    person_id: str,
    tenant_id: str,
    db: AsyncSession = Depends(get_db)
):
    """Get person's achievements"""
    try:
        query = select(UserAchievement).filter(
            UserAchievement.person_id == person_id,
            UserAchievement.tenant_id == tenant_id
        ).order_by(UserAchievement.earned_date.desc())

        result = await db.execute(query)
        achievements = result.scalars().all()

        return {
            "person_id": person_id,
            "total_achievements": len(achievements),
            "achievements": [
                {
                    "achievement_code": a.achievement_code,
                    "achievement_level": a.achievement_level.value,
                    "points_awarded": a.points_awarded,
                    "earned_date": a.earned_date.isoformat(),
                    "badge_icon": get_badge_icon(a.achievement_code),
                    "badge_color": get_badge_color(a.achievement_level.value)
                }
                for a in achievements
            ]
        }

    except Exception as e:
        logger.error(f"❌ Get achievements failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/api/learning/gamification/streak/{person_id}")
async def get_learning_streak(
    person_id: str,
    tenant_id: str,
    db: AsyncSession = Depends(get_db)
):
    """Get learning streak for person"""
    try:
        # Get all enrollment activity dates
        query = select(TrainingEnrollment.started_date).filter(
            TrainingEnrollment.person_id == person_id,
            TrainingEnrollment.tenant_id == tenant_id,
            TrainingEnrollment.started_date.isnot(None)
        )

        result = await db.execute(query)
        activity_dates = [row[0] for row in result.all()]

        # Calculate streak
        streak_info = calculate_streak(person_id, activity_dates)

        return {
            "person_id": person_id,
            "current_streak": streak_info['current_streak'],
            "longest_streak": streak_info['longest_streak'],
            "is_active": streak_info['is_active'],
            "last_activity": streak_info['last_activity'].isoformat() if streak_info['last_activity'] else None
        }

    except Exception as e:
        logger.error(f"❌ Get streak failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/api/learning/gamification/level/{person_id}")
async def get_person_level(
    person_id: str,
    tenant_id: str,
    db: AsyncSession = Depends(get_db)
):
    """Get person's level and progress"""
    try:
        # Get total points
        query = select(func.sum(TrainingEnrollment.points_earned)).filter(
            TrainingEnrollment.person_id == person_id,
            TrainingEnrollment.tenant_id == tenant_id
        )

        result = await db.execute(query)
        total_points = result.scalar() or 0

        # Calculate level
        level_info = calculate_level(total_points)

        return {
            "person_id": person_id,
            "level": level_info['level'],
            "level_title": level_info['title'],
            "total_points": total_points,
            "next_level_points": level_info['next_level_points'],
            "progress_to_next": level_info['progress_to_next']
        }

    except Exception as e:
        logger.error(f"❌ Get level failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

