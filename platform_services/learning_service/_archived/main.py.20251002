    class Config:
        from_attributes = True

# ===== FASTAPI APP =====

app = FastAPI(
    title="BCM Learning Service",
    description="ISO 22301 Learning Module - Clauses 7.2 & 7.3 | BCI GPG PP2",
    version="1.0.0"
)

# CORS
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# ===== STARTUP/SHUTDOWN =====

@app.on_event("startup")
async def startup_event():
    """Initialize database on startup"""
    logger.info("🚀 Learning Service starting...")
    try:
        await init_db()
        logger.info("✅ Database initialized")
    except Exception as e:
        logger.error(f"❌ Database initialization failed: {e}")

@app.on_event("shutdown")
async def shutdown_event():
    """Cleanup on shutdown"""
    logger.info("👋 Learning Service shutting down...")

# ===== HEALTH CHECK =====

@app.get("/health")
async def health_check():
    """Health check endpoint"""
    return {
        "status": "healthy",
        "service": "learning",
        "version": "1.0.0",
        "timestamp": datetime.utcnow().isoformat()
    }

# ===== TRAINING PROGRAMS ENDPOINTS =====

@app.post("/api/learning/programs", response_model=ProgramResponse, status_code=201)
async def create_training_program(program: ProgramCreate, db: AsyncSession = Depends(get_db)):
    """Create new training program"""
    try:
        # Check for duplicate program_code
        existing = await db.execute(
            select(TrainingProgram).filter(TrainingProgram.program_code == program.program_code)
        )
        if existing.scalar_one_or_none():
            raise HTTPException(status_code=400, detail=f"Program code {program.program_code} already exists")

        # Create program
        db_program = TrainingProgram(
            tenant_id=program.tenant_id,
            program_code=program.program_code,
            program_name=program.program_name,
            description=program.description,
            program_type=program.program_type,
            bci_training_level=program.bci_training_level,
            target_audience=program.target_audience,
            iso_clause=program.iso_clause,
            learning_objectives=program.learning_objectives,
            curriculum=program.curriculum,
            duration_hours=program.duration_hours,
            delivery_method=program.delivery_method,
            assessment_required=program.assessment_required,
            passing_score=program.passing_score,
            certification_awarded=program.certification_awarded,
            status=ProgramStatus.DRAFT,
            enrollment_count=0
        )

        db.add(db_program)
        await db.commit()
        await db.refresh(db_program)

        logger.info(f"✅ Training program created: {db_program.id} - {db_program.program_name}")
        return db_program

    except HTTPException:
        raise
    except Exception as e:
        await db.rollback()
        logger.error(f"❌ Program creation failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/api/learning/programs", response_model=List[ProgramResponse])
async def list_training_programs(
    tenant_id: str,
    status: Optional[ProgramStatus] = None,
    program_type: Optional[str] = None,
    bci_level: Optional[str] = None,
    db: AsyncSession = Depends(get_db)
):
    """List training programs with filters"""
    try:
        query = select(TrainingProgram).filter(TrainingProgram.tenant_id == tenant_id)

        if status:
            query = query.filter(TrainingProgram.status == status)
        if program_type:
            query = query.filter(TrainingProgram.program_type == program_type)
        if bci_level:
            query = query.filter(TrainingProgram.bci_training_level == bci_level)

        result = await db.execute(query)
        programs = result.scalars().all()

        return programs

    except Exception as e:
        logger.error(f"❌ List programs failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/api/learning/programs/{program_id}", response_model=ProgramResponse)
async def get_training_program(program_id: int, db: AsyncSession = Depends(get_db)):
    """Get training program by ID"""
    try:
        result = await db.execute(select(TrainingProgram).filter(TrainingProgram.id == program_id))
        program = result.scalar_one_or_none()

        if not program:
            raise HTTPException(status_code=404, detail="Training program not found")

        return program

    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"❌ Get program failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.patch("/api/learning/programs/{program_id}")
async def update_training_program(
    program_id: int,
    updates: ProgramUpdate,
    db: AsyncSession = Depends(get_db)
):
    """Update training program"""
    try:
        result = await db.execute(select(TrainingProgram).filter(TrainingProgram.id == program_id))
        program = result.scalar_one_or_none()

        if not program:
            raise HTTPException(status_code=404, detail="Training program not found")

        # Update fields
        for field, value in updates.dict(exclude_unset=True).items():
            setattr(program, field, value)

        await db.commit()
        await db.refresh(program)

        logger.info(f"✅ Program updated: {program_id}")
        return program

    except HTTPException:
        raise
    except Exception as e:
        await db.rollback()
        logger.error(f"❌ Update program failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.delete("/api/learning/programs/{program_id}")
async def delete_training_program(program_id: int, db: AsyncSession = Depends(get_db)):
    """Archive training program"""
    try:
        result = await db.execute(select(TrainingProgram).filter(TrainingProgram.id == program_id))
        program = result.scalar_one_or_none()

        if not program:
            raise HTTPException(status_code=404, detail="Training program not found")

        program.status = ProgramStatus.ARCHIVED
        await db.commit()

        logger.info(f"✅ Program archived: {program_id}")
        return {"message": "Program archived successfully"}

    except HTTPException:
        raise
    except Exception as e:
        await db.rollback()
        logger.error(f"❌ Archive program failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

# ===== TRAINING ENROLLMENTS ENDPOINTS =====

@app.post("/api/learning/enrollments", response_model=EnrollmentResponse, status_code=201)
async def enroll_in_training(enrollment: EnrollmentCreate, db: AsyncSession = Depends(get_db)):
    """Enroll person in training program"""
    try:
        # Validate enrollment data
        valid, error = validate_enrollment_data({
            'person_id': enrollment.person_id,
            'person_name': enrollment.person_name,
            'program_id': enrollment.program_id
        })
        if not valid:
            raise HTTPException(status_code=400, detail=error)

        # Check if program exists
        program_result = await db.execute(
            select(TrainingProgram).filter(TrainingProgram.id == enrollment.program_id)
        )
        program = program_result.scalar_one_or_none()
        if not program:
            raise HTTPException(status_code=404, detail="Training program not found")

        # Check for existing enrollment
        existing = await db.execute(
            select(TrainingEnrollment).filter(
                TrainingEnrollment.program_id == enrollment.program_id,
                TrainingEnrollment.person_id == enrollment.person_id,
                TrainingEnrollment.tenant_id == enrollment.tenant_id
            )
        )
        if existing.scalar_one_or_none():
            raise HTTPException(status_code=400, detail="Person already enrolled in this program")

        # Create enrollment
        db_enrollment = TrainingEnrollment(
            tenant_id=enrollment.tenant_id,
            program_id=enrollment.program_id,
            person_id=enrollment.person_id,
            person_name=enrollment.person_name,
            person_email=enrollment.person_email,
            department=enrollment.department,
            enrolled_by=enrollment.enrolled_by,
            enrollment_reason=enrollment.enrollment_reason,
            target_completion_date=enrollment.target_completion_date,
            status=EnrollmentStatus.ENROLLED,
            progress_percentage=0,
            assessment_passed=False,
            certification_issued=False,
            points_earned=0,
            enrolled_date=datetime.utcnow()
        )

        db.add(db_enrollment)

        # Increment enrollment count
        program.enrollment_count += 1

        await db.commit()
        await db.refresh(db_enrollment)

        logger.info(f"✅ Enrollment created: {db_enrollment.person_name} → {program.program_name}")
        return db_enrollment

    except HTTPException:
        raise
    except Exception as e:
        await db.rollback()
        logger.error(f"❌ Enrollment failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.post("/api/learning/enrollments/{enrollment_id}/start")
async def start_training(enrollment_id: int, db: AsyncSession = Depends(get_db)):
    """Start training (transition enrolled → in_progress)"""
    try:
        result = await db.execute(select(TrainingEnrollment).filter(TrainingEnrollment.id == enrollment_id))
        enrollment = result.scalar_one_or_none()

        if not enrollment:
            raise HTTPException(status_code=404, detail="Enrollment not found")

        # Validate transition
        can_start, error = can_start_training(enrollment)
        if not can_start:
            raise HTTPException(status_code=400, detail=error)

        # Transition state
        enrollment.status = EnrollmentStatus.IN_PROGRESS
        enrollment.started_date = datetime.utcnow()

        await db.commit()
        await db.refresh(enrollment)

        logger.info(f"✅ Training started: {enrollment_id}")
        return enrollment

    except HTTPException:
        raise
    except Exception as e:
        await db.rollback()
        logger.error(f"❌ Start training failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.patch("/api/learning/enrollments/{enrollment_id}/progress")
async def update_training_progress(
    enrollment_id: int,
    progress: EnrollmentProgressUpdate,
    db: AsyncSession = Depends(get_db)
):
    """Update training progress"""
    try:
        result = await db.execute(select(TrainingEnrollment).filter(TrainingEnrollment.id == enrollment_id))
        enrollment = result.scalar_one_or_none()

        if not enrollment:
            raise HTTPException(status_code=404, detail="Enrollment not found")

        if enrollment.status not in [EnrollmentStatus.IN_PROGRESS, EnrollmentStatus.ENROLLED]:
            raise HTTPException(status_code=400, detail=f"Cannot update progress in state: {enrollment.status}")

        # Validate progress
        valid, error = validate_progress_update(progress.progress_percentage)
        if not valid:
            raise HTTPException(status_code=400, detail=error)

        # Update fields
        enrollment.progress_percentage = progress.progress_percentage
        if progress.modules_completed:
            enrollment.modules_completed = progress.modules_completed
        if progress.time_spent_minutes:
            enrollment.time_spent_minutes = (enrollment.time_spent_minutes or 0) + progress.time_spent_minutes

        # Auto-transition to in_progress if enrolled
        if enrollment.status == EnrollmentStatus.ENROLLED:
            enrollment.status = EnrollmentStatus.IN_PROGRESS
            enrollment.started_date = datetime.utcnow()

        await db.commit()
        await db.refresh(enrollment)

        logger.info(f"✅ Progress updated: {enrollment_id} → {progress.progress_percentage}%")
        return enrollment

    except HTTPException:
        raise
    except Exception as e:
        await db.rollback()
        logger.error(f"❌ Update progress failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.post("/api/learning/enrollments/{enrollment_id}/complete")
async def complete_training(enrollment_id: int, db: AsyncSession = Depends(get_db)):
    """Complete training (transition in_progress → completed)"""
    try:
        result = await db.execute(select(TrainingEnrollment).filter(TrainingEnrollment.id == enrollment_id))
        enrollment = result.scalar_one_or_none()

        if not enrollment:
            raise HTTPException(status_code=404, detail="Enrollment not found")

        # Validate completion
        can_complete, error = can_complete_training(enrollment, required_progress=100)
        if not can_complete:
            raise HTTPException(status_code=400, detail=error)

        # Transition state
        enrollment.status = EnrollmentStatus.COMPLETED
        enrollment.completion_date = datetime.utcnow()

        # Award completion points
        points_award = award_points(enrollment.person_id, 'training_complete', {
            'enrollment_id': enrollment_id
        })
        enrollment.points_earned += points_award['points']

        await db.commit()
        await db.refresh(enrollment)

        logger.info(f"✅ Training completed: {enrollment_id}")
        return enrollment

    except HTTPException:
        raise
    except Exception as e:
        await db.rollback()
        logger.error(f"❌ Complete training failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.post("/api/learning/enrollments/{enrollment_id}/assess")
async def assess_training(
    enrollment_id: int,
    assessment: EnrollmentAssessment,
    db: AsyncSession = Depends(get_db)
):
    """Submit assessment result"""
    try:
        result = await db.execute(select(TrainingEnrollment).filter(TrainingEnrollment.id == enrollment_id))
        enrollment = result.scalar_one_or_none()

        if not enrollment:
            raise HTTPException(status_code=404, detail="Enrollment not found")

        if enrollment.status != EnrollmentStatus.COMPLETED:
            raise HTTPException(status_code=400, detail="Training must be completed before assessment")

        # Get program for passing score
        program_result = await db.execute(
            select(TrainingProgram).filter(TrainingProgram.id == enrollment.program_id)
        )
        program = program_result.scalar_one_or_none()

        # Validate score
        valid, error = validate_assessment_score(assessment.assessment_score, program.passing_score)
        if not valid:
            raise HTTPException(status_code=400, detail=error)

        # Determine result
        passed = assessment.assessment_score >= program.passing_score
        enrollment.assessment_score = assessment.assessment_score
        enrollment.assessment_passed = passed
        enrollment.assessment_date = assessment.assessment_date or datetime.utcnow()

        # Award points
        if passed:
            points_award = award_points(enrollment.person_id, 'assessment_pass', {
                'score': assessment.assessment_score
            })
            enrollment.points_earned += points_award['points']

            # Excellence bonus
            if assessment.assessment_score >= 90:
                excellence_points = award_points(enrollment.person_id, 'assessment_excellence', {
                    'score': assessment.assessment_score
                })
                enrollment.points_earned += excellence_points['points']
        else:
            enrollment.status = EnrollmentStatus.FAILED

        await db.commit()
        await db.refresh(enrollment)

        logger.info(f"✅ Assessment submitted: {enrollment_id} - Score: {assessment.assessment_score}% - {'PASSED' if passed else 'FAILED'}")
        return enrollment

    except HTTPException:
        raise
    except Exception as e:
        await db.rollback()
        logger.error(f"❌ Assessment failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.post("/api/learning/enrollments/{enrollment_id}/certify")
async def issue_certification(enrollment_id: int, db: AsyncSession = Depends(get_db)):
    """Issue certification (transition completed → certified)"""
    try:
        result = await db.execute(select(TrainingEnrollment).filter(TrainingEnrollment.id == enrollment_id))
        enrollment = result.scalar_one_or_none()

        if not enrollment:
            raise HTTPException(status_code=404, detail="Enrollment not found")

        # Validate certification eligibility
        can_certify, error = can_issue_certification(enrollment)
        if not can_certify:
            raise HTTPException(status_code=400, detail=error)

        # Issue certification
        enrollment.status = EnrollmentStatus.CERTIFIED
        enrollment.certification_issued = True
        enrollment.certification_date = datetime.utcnow()
        enrollment.certification_number = f"BCM-{enrollment.tenant_id[:8]}-{enrollment.id:06d}"

        # Calculate expiry (default 2 years)
        enrollment.certification_expiry_date = datetime.utcnow() + timedelta(days=730)

        # Award certification points
        points_award = award_points(enrollment.person_id, 'certification_earned', {
            'enrollment_id': enrollment_id
        })
        enrollment.points_earned += points_award['points']

        await db.commit()
        await db.refresh(enrollment)

        logger.info(f"✅ Certification issued: {enrollment_id} - {enrollment.certification_number}")
        return enrollment

    except HTTPException:
        raise
    except Exception as e:
        await db.rollback()
        logger.error(f"❌ Certification failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/api/learning/enrollments", response_model=List[EnrollmentResponse])
async def list_enrollments(
    tenant_id: str,
    person_id: Optional[str] = None,
    program_id: Optional[int] = None,
    status: Optional[EnrollmentStatus] = None,
    db: AsyncSession = Depends(get_db)
):
    """List enrollments with filters"""
    try:
        query = select(TrainingEnrollment).filter(TrainingEnrollment.tenant_id == tenant_id)

        if person_id:
            query = query.filter(TrainingEnrollment.person_id == person_id)
        if program_id:
            query = query.filter(TrainingEnrollment.program_id == program_id)
        if status:
            query = query.filter(TrainingEnrollment.status == status)

        result = await db.execute(query)
        enrollments = result.scalars().all()

        return enrollments

    except Exception as e:
        logger.error(f"❌ List enrollments failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

# ===== COMPETENCY ASSESSMENTS ENDPOINTS =====

@app.post("/api/learning/competency", response_model=CompetencyResponse, status_code=201)
async def create_competency_assessment(comp: CompetencyCreate, db: AsyncSession = Depends(get_db)):
    """Create competency assessment (ISO 7.2)"""
    try:
        # Calculate gap
        levels = ["basic", "intermediate", "advanced", "expert"]
        req_idx = levels.index(comp.required_level.value)
        cur_idx = levels.index(comp.current_level.value)
        gap_exists = cur_idx < req_idx

        # Determine gap severity
        gap_severity = None
        if gap_exists:
            gap_size = req_idx - cur_idx
            if gap_size >= 3:
                gap_severity = "critical"
            elif gap_size == 2:
                gap_severity = "high"
            elif gap_size == 1:
                gap_severity = "medium"

        db_comp = CompetencyAssessment(
            tenant_id=comp.tenant_id,
            person_id=comp.person_id,
            person_name=comp.person_name,
            department=comp.department,
            role=comp.role,
            competency_area=comp.competency_area,
            required_level=comp.required_level,
            current_level=comp.current_level,
            gap_exists=gap_exists,
            gap_severity=gap_severity,
            evidence_type=comp.evidence_type,
            evidence_details=comp.evidence_details,
            assessed_by=comp.assessed_by,
            assessment_date=comp.assessment_date or datetime.utcnow(),
            status=AssessmentStatus.COMPLETED,
            training_required=gap_exists
        )

        # Award points for identifying gap
        if gap_exists:
            points_award = award_points(comp.person_id, 'gap_identified', {
                'competency_area': comp.competency_area
            })

        db.add(db_comp)
        await db.commit()
        await db.refresh(db_comp)

        logger.info(f"✅ Competency assessment created: {db_comp.person_name} - {db_comp.competency_area} - Gap: {gap_exists}")
        return db_comp

    except Exception as e:
        await db.rollback()
        logger.error(f"❌ Competency assessment failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/api/learning/competency", response_model=List[CompetencyResponse])
async def list_competency_assessments(
    tenant_id: str,
    person_id: Optional[str] = None,
    gap_exists: Optional[bool] = None,
    competency_area: Optional[str] = None,
    db: AsyncSession = Depends(get_db)
):
    """List competency assessments"""
    try:
        query = select(CompetencyAssessment).filter(CompetencyAssessment.tenant_id == tenant_id)

        if person_id:
            query = query.filter(CompetencyAssessment.person_id == person_id)
        if gap_exists is not None:
            query = query.filter(CompetencyAssessment.gap_exists == gap_exists)
        if competency_area:
            query = query.filter(CompetencyAssessment.competency_area == competency_area)

        result = await db.execute(query)
        assessments = result.scalars().all()

        return assessments

    except Exception as e:
        logger.error(f"❌ List competency assessments failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.get("/api/learning/competency/gaps")
async def get_competency_gaps(
    tenant_id: str,
    severity: Optional[str] = None,
    db: AsyncSession = Depends(get_db)
):
    """Get competency gap analysis report"""
    try:
        query = select(CompetencyAssessment).filter(
            CompetencyAssessment.tenant_id == tenant_id,
            CompetencyAssessment.gap_exists == True
        )

        if severity:
            query = query.filter(CompetencyAssessment.gap_severity == severity)

        result = await db.execute(query)
        gaps = result.scalars().all()

        # Group by person
        gap_report = {}
        for gap in gaps:
            if gap.person_id not in gap_report:
                gap_report[gap.person_id] = {
                    "person_id": gap.person_id,
                    "person_name": gap.person_name,
                    "department": gap.department,
                    "gaps": []
                }

            gap_report[gap.person_id]["gaps"].append({
                "competency_area": gap.competency_area,
                "required_level": gap.required_level.value,
                "current_level": gap.current_level.value,
                "gap_severity": gap.gap_severity,
                "training_required": gap.training_required,
                "recommended_programs": gap.recommended_programs
            })

        return {
            "tenant_id": tenant_id,
            "total_gaps": len(gaps),
            "people_with_gaps": len(gap_report),
            "gap_details": list(gap_report.values()),
            "severity_filter": severity
        }

    except Exception as e:
        logger.error(f"❌ Gap analysis failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

@app.patch("/api/learning/competency/{assessment_id}/close-gap")
async def close_competency_gap(assessment_id: int, db: AsyncSession = Depends(get_db)):
    """Mark competency gap as closed"""
    try:
        result = await db.execute(select(CompetencyAssessment).filter(CompetencyAssessment.id == assessment_id))
        assessment = result.scalar_one_or_none()

        if not assessment:
            raise HTTPException(status_code=404, detail="Competency assessment not found")

        if not assessment.gap_exists:
            raise HTTPException(status_code=400, detail="No gap exists to close")

        # Close gap
        assessment.gap_exists = False
        assessment.gap_severity = None
        assessment.training_required = False
        assessment.gap_closed_date = datetime.utcnow()

        # Award points
        points_award = award_points(assessment.person_id, 'gap_closed', {
            'competency_area': assessment.competency_area
        })

        await db.commit()
        await db.refresh(assessment)

        logger.info(f"✅ Competency gap closed: {assessment_id}")
        return assessment

    except HTTPException:
        raise
    except Exception as e:
        await db.rollback()
        logger.error(f"❌ Close gap failed: {e}")
        raise HTTPException(status_code=500, detail=str(e))

