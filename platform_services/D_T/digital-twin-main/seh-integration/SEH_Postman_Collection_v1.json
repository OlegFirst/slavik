{
  "info": {
    "name": "SEH — Simulation & Impact API",
    "_postman_id": "d1b8f4f0-5a0e-4d8b-bd3e-050219",
    "description": "Collection for /api/v1/sim/run and /api/v1/impact/optimize",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Run Simulation (capacity_sweep)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/sim/run",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "sim",
            "run"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"experiment\": \"capacity_sweep\",\n  \"params\": {\n    \"arrival_rate\": 12,\n    \"service_time\": {\n      \"dist\": \"lognormal\",\n      \"mu\": \"10m\",\n      \"sigma\": 0.5\n    },\n    \"capacity_agents\": [\n      6,\n      8,\n      10\n    ],\n    \"shift_calendar\": {\n      \"Mon-Fri\": \"09:00-17:00\"\n    },\n    \"targets\": {\n      \"sla_target\": 0.95\n    },\n    \"constraints\": {\n      \"budget_max\": 20000\n    }\n  },\n  \"monte_carlo_runs\": 200\n}"
        }
      },
      "response": []
    },
    {
      "name": "Optimize ToC Policy",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/impact/optimize",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "impact",
            "optimize"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"objective\": \"maximize_outcome_cov_per_cost\",\n  \"budget_cap\": 50000,\n  \"decision_variables\": [\n    {\n      \"id\": \"outreach_sms_intensity\",\n      \"min\": 0,\n      \"max\": 3,\n      \"step\": 0.1\n    },\n    {\n      \"id\": \"transport_vouchers_intensity\",\n      \"min\": 0,\n      \"max\": 2,\n      \"step\": 0.1\n    },\n    {\n      \"id\": \"counseling_intensity\",\n      \"min\": 0,\n      \"max\": 2,\n      \"step\": 0.1\n    }\n  ],\n  \"monte_carlo_runs\": 1000\n}"
        }
      },
      "response": []
    }
  ]
}