{
  "name": "digital-twin-mcp-server",
  "version": "2.0.0",
  "description": "MCP Server for Digital Twin Standalone Module",
  "type": "module",
  "main": "digital-twin-mcp-server.js",
  "bin": {
    "digital-twin-mcp": "./digital-twin-mcp-server.js"
  },
  "scripts": {
    "start": "node digital-twin-mcp-server.js",
    "dev": "node --watch digital-twin-mcp-server.js",
    "build": "npm run build:client",
    "build:client": "cd ../client && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  },
  "keywords": [
    "mcp",
    "ai",
    "digital-twin",
    "npo",
    "model-context-protocol"
  ],
  "author": "Digital Twin Development Team",
  "license": "MIT"
}