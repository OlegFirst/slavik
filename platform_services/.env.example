# ============================================================================
# Platform Services - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
#
# Services included:
# - Business Monitoring (Process Analytics, Compliance Monitoring)
# - Living Docs (AI-powered documentation)
# - Community Service (Portal + Marketplace)
# - Simulation (Digital Twin with CRM integrations)
# - Planning & Plans Services
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION (Shared)
# ============================================================================
POSTGRES_DB=bcm_platform
POSTGRES_USER=bcm_user
POSTGRES_PASSWORD=CHANGE_THIS_IN_PRODUCTION
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URLs for services
PLANNING_DATABASE_URL=postgresql+asyncpg://bcm_user:CHANGE_THIS_IN_PRODUCTION@postgres:5432/bcm_platform
PLANS_DATABASE_URL=postgresql+asyncpg://bcm_user:CHANGE_THIS_IN_PRODUCTION@postgres:5432/bcm_platform

# ============================================================================
# REDIS CONFIGURATION (Shared)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# ============================================================================
# EVENTBUS CONFIGURATION (Shared)
# ============================================================================
EVENTBUS_URL=http://eventbus:8001

# ============================================================================
# JWT AUTHENTICATION (Shared)
# ============================================================================
# IMPORTANT: Replace with your actual RSA public key in production
# Generate key pair: ssh-keygen -t rsa -b 4096 -m PEM -f jwtRS256.key
JWT_PUBLIC_KEY=PLACEHOLDER_DEV_MODE
JWT_ALGORITHM=RS256
JWT_AUDIENCE=bcm-platform
JWT_ISSUER=bcm-auth-service
JWT_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_USE_STRONG_RANDOM_STRING
JWT_EXPIRE_MINUTES=30

# ============================================================================
# BUSINESS MONITORING SERVICES
# ============================================================================

# --- Process Analytics Service ---
# Port: 8780
# Purpose: Process mining, bottleneck detection, workflow analytics
PROCESS_ANALYTICS_PORT=8780
PROCESS_ANALYTICS_DB_HOST=postgres
PROCESS_ANALYTICS_DB_PORT=5432
PROCESS_ANALYTICS_DB_NAME=bcm_platform
PROCESS_ANALYTICS_DB_USER=bcm_user
PROCESS_ANALYTICS_DB_PASSWORD=CHANGE_THIS_IN_PRODUCTION

# Redis for caching
PROCESS_ANALYTICS_REDIS_HOST=redis
PROCESS_ANALYTICS_REDIS_PORT=6379
PROCESS_ANALYTICS_REDIS_DB=0

# --- Compliance Monitoring Service ---
# Port: 8779
# Purpose: ISO 22301 compliance tracking, audit management
COMPLIANCE_MONITORING_PORT=8779
COMPLIANCE_DATA_DIR=/var/lib/compliance
PROMETHEUS_SD_DIR=/etc/prometheus/sd_configs
NOTIFICATION_SERVICE_URL=http://notification-service:8035
ALERT_EMAIL=compliance@bcm.example.com

# ============================================================================
# LIVING DOCS SERVICE
# ============================================================================

# --- Living Docs ---
# Port: 8034
# Purpose: AI-powered living documentation with Claude API
LIVING_DOCS_PORT=8034

# REQUIRED: Anthropic API for AI-powered features
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Database
LIVING_DOCS_DB_HOST=postgres
LIVING_DOCS_DB_PORT=5432
LIVING_DOCS_DB_NAME=bcm_platform
LIVING_DOCS_DB_USER=bcm_user
LIVING_DOCS_DB_PASSWORD=CHANGE_THIS_IN_PRODUCTION

# Redis for caching
LIVING_DOCS_REDIS_HOST=redis
LIVING_DOCS_REDIS_PORT=6379
LIVING_DOCS_REDIS_DB=1

# ============================================================================
# COMMUNITY SERVICE
# ============================================================================

# --- Community Portal ---
# Port: 8031
# Purpose: Community portal for BCM specialists
COMMUNITY_PORTAL_PORT=8031
COMMUNITY_PORTAL_DB_HOST=postgres
COMMUNITY_PORTAL_DB_PORT=5432
COMMUNITY_PORTAL_DB_NAME=bcm_platform
COMMUNITY_PORTAL_DB_USER=bcm_user
COMMUNITY_PORTAL_DB_PASSWORD=CHANGE_THIS_IN_PRODUCTION

# --- Community Marketplace ---
# Port: 8032
# Purpose: Marketplace for BCM templates, tools, services
COMMUNITY_MARKETPLACE_PORT=8032
COMMUNITY_MARKETPLACE_DB_HOST=postgres
COMMUNITY_MARKETPLACE_DB_PORT=5432
COMMUNITY_MARKETPLACE_DB_NAME=bcm_platform
COMMUNITY_MARKETPLACE_DB_USER=bcm_user
COMMUNITY_MARKETPLACE_DB_PASSWORD=CHANGE_THIS_IN_PRODUCTION

# ============================================================================
# SIMULATION - DIGITAL TWIN SERVICE
# ============================================================================

# --- Digital Twin Universal Service ---
# Port: 8090 (changed from 8000 to avoid API Gateway conflict)
# Purpose: Universal entity sync with Salesforce, HubSpot, Odoo
DIGITAL_TWIN_PORT=8090
PORT=8090

# PostgreSQL Database
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# Redis Cache
REDIS_DB=2
REDIS_PREFIX=dt:
REDIS_MAX_CONNECTIONS=50

# ============================================================================
# EXTERNAL CRM INTEGRATIONS (Digital Twin)
# ============================================================================

# --- Salesforce Integration ---
# Required for Salesforce sync
SALESFORCE_USERNAME=your-salesforce-username@example.com
SALESFORCE_PASSWORD=your-salesforce-password
SALESFORCE_SECURITY_TOKEN=your-security-token
SALESFORCE_DOMAIN=login
SALESFORCE_API_VERSION=v58.0

# --- HubSpot Integration ---
# Required for HubSpot sync
HUBSPOT_API_KEY=your-hubspot-api-key
HUBSPOT_ACCOUNT_ID=your-account-id

# --- Odoo Integration ---
# Required for Odoo sync
ODOO_URL=http://odoo:8069
ODOO_DB=odoo_db
ODOO_USERNAME=admin
ODOO_PASSWORD=admin

# ============================================================================
# OPTIONAL: AI FEATURES (Digital Twin)
# ============================================================================

# OpenAI for advanced AI features
OPENAI_API_KEY=sk-your-openai-key-here

# ============================================================================
# PLANNING & PLANS SERVICES
# ============================================================================

# Planning Service (ISO 22301 Clause 8.3)
PLANNING_SERVICE_PORT=8011
PLANNING_SERVICE_NAME=planning_service
PLANNING_SERVICE_URL=http://planning-service:8011

# Plans Service (ISO 22301 Clause 8.4)
PLANS_SERVICE_PORT=8023
PLANS_SERVICE_NAME=plans_service

# ============================================================================
# SHARED INFRASTRUCTURE
# ============================================================================

# --- Service Discovery ---
# For automatic service registration
SERVICE_DISCOVERY_URL=http://service-discovery:8080

# --- AI Orchestrator (Optional) ---
AI_ORCHESTRATOR_URL=http://ai-orchestrator:8000

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================
# MONITORING CONFIGURATION
# ============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_IN_PRODUCTION

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
# Set to 'false' in production
ALLOW_DEV_MODE=true

# Session Configuration
SESSION_SECRET=CHANGE_THIS_IN_PRODUCTION_USE_STRONG_RANDOM_STRING

# ============================================================================
# HEALTH CHECK CONFIGURATION
# ============================================================================
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_INTERVAL=30

# ============================================================================
# PRODUCTION SETTINGS
# ============================================================================

# Set to 'production' in production environment
# ENVIRONMENT=production
# DEBUG=false

# Use secure secrets in production
# POSTGRES_PASSWORD=<strong-password>
# JWT_SECRET_KEY=<cryptographically-secure-key>
# SALESFORCE_PASSWORD=<actual-password>
# SALESFORCE_SECURITY_TOKEN=<actual-token>
# ANTHROPIC_API_KEY=sk-ant-<your-real-key>
# OPENAI_API_KEY=sk-<your-real-key>

# Enable SSL/TLS in production
# DB_SSL_MODE=require
# REDIS_SSL=true

# ============================================================================
# NOTES
# ============================================================================
#
# 1. SECURITY: Never commit this file with real credentials to git
# 2. PORTS: All ports are standardized to avoid conflicts
#    - Process Analytics: 8780
#    - Compliance Monitoring: 8779
#    - Living Docs: 8034
#    - Community Portal: 8031
#    - Community Marketplace: 8032
#    - Digital Twin: 8090 (changed from 8000)
#    - Planning Service: 8011
#    - Plans Service: 8023
# 3. DATABASE: All services use shared bcm_platform database
# 4. REDIS: Different DB numbers (0,1,2) for service isolation
# 5. APIs: Anthropic API key required for Living Docs AI features
# 6. CRM: Salesforce/HubSpot/Odoo credentials required for Digital Twin
#
# ============================================================================
