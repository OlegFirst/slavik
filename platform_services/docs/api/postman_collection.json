                  "mode": "raw",
                  "raw": "{\n  \"tenant_id\": \"{{tenant_id}}\",\n  \"name\": \"Payment Processing System\",\n  \"description\": \"Core payment processing for customer transactions\",\n  \"department\": \"Finance Operations\",\n  \"process_owner\": \"jane.smith@company.com\",\n  \"criticality\": \"CRITICAL\",\n  \"rto_hours\": 2,\n  \"rpo_hours\": 1,\n  \"mtpd_hours\": 4,\n  \"financial_impact\": {\n    \"1_hour\": 50000,\n    \"4_hours\": 200000,\n    \"24_hours\": 1200000\n  },\n  \"dependencies\": [\n    {\n      \"type\": \"technology\",\n      \"name\": \"Payment Gateway API\",\n      \"criticality\": 5,\n      \"required\": true\n    }\n  ],\n  \"industry\": \"FINANCIAL_SERVICES\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{base_url}}:{{bia_port}}/api/bia/processes",
                  "host": ["{{base_url}}"],
                  "port": "{{bia_port}}",
                  "path": ["api", "bia", "processes"]
