# 🔥 УБИРАЕМ ВСЕ HARDCODED CREDENTIALS - используем environment variables

# API Configuration
VITE_API_BASE_URL=http://localhost:8888
VITE_API_TIMEOUT=30000
VITE_API_RETRIES=3

# Keycloak Authentication (заменяет localStorage токены)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=bcm-platform
VITE_KEYCLOAK_CLIENT_ID=bcm-admin-panel

# WebSocket Configuration (заменяет hardcoded ws://)
VITE_WS_URL=ws://localhost:8001
VITE_WS_SECURE=false
VITE_DIGITAL_TWIN_WS_URL=ws://localhost:8000/ws/digital-twin

# Database Configuration (убираем Supabase keys из кода)
VITE_DB_API_URL=http://localhost:8069
# НЕ ХРАНИМ SUPABASE KEYS В FRONTEND!
# VITE_SUPABASE_ANON_KEY= # УДАЛЕНО для безопасности

# Security Configuration
VITE_CSRF_ENABLED=true
VITE_HTTPS_ONLY=false
VITE_LOG_LEVEL=info

# Service URLs (заменяет все localhost hardcode)
VITE_ODOO_URL=http://localhost:8069
VITE_AI_ORCHESTRATOR_URL=http://localhost:8000
VITE_BIA_ENGINE_URL=http://localhost:8082
VITE_PROMETHEUS_URL=http://localhost:9090
VITE_GRAFANA_URL=http://localhost:3003
VITE_MODULE_VALIDATOR_URL=http://localhost:5001
VITE_NOTIFICATION_URL=http://localhost:8002
VITE_DEPLOYER_URL=http://localhost:8009
VITE_COMPLIANCE_URL=http://localhost:8084
VITE_DOCUMENT_URL=http://localhost:8083
VITE_SCENARIO_URL=http://localhost:8085
VITE_AI_CONTROL_URL=http://localhost:8200
VITE_GOVERNANCE_URL=http://localhost:8009

# ============================================================================
# 7 USER JOURNEYS PLATFORM - NEW SERVICES
# ============================================================================

# Supabase (User profiles, marketplace, learning data)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Platform Services (existing)
VITE_SYSTEM_BCM_URL=http://localhost:8050
VITE_RISK_SERVICE_URL=http://localhost:8002
VITE_PLANNING_SERVICE_URL=http://localhost:8004

# Stripe (Marketplace payments)
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# Feature Flags (7 Journeys)
VITE_ENABLE_CERTIFICATION_JOURNEY=true
VITE_ENABLE_AUDITOR_JOURNEY=true
VITE_ENABLE_ACADEMY_JOURNEY=true
VITE_ENABLE_DIGITAL_TWIN_JOURNEY=true
VITE_ENABLE_CRISIS_JOURNEY=true
VITE_ENABLE_MARKETPLACE=true
VITE_ENABLE_AI_TUTOR=true

# Production overrides
