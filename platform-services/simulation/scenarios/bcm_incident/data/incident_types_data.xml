            <field name="severity_default">critical</field>
            <field name="rto_default">0.5</field>
            <field name="auto_escalate_after">10</field>
        </record>
        
        <record id="category_financial_impact" model="bcm.incident.category">
            <field name="name">Financial Impact Event</field>
            <field name="code">FIN</field>
            <field name="severity_default">high</field>
            <field name="rto_default">6.0</field>
            <field name="auto_escalate_after">180</field>
        </record>
        
        <record id="category_reputational_risk" model="bcm.incident.category">
            <field name="name">Reputational Risk</field>
            <field name="code">REP</field>
            <field name="severity_default">high</field>
            <field name="rto_default">3.0</field>
            <field name="auto_escalate_after">60</field>
        </record>
        
        <record id="category_regulatory_compliance" model="bcm.incident.category">
            <field name="name">Regulatory Compliance Issue</field>
