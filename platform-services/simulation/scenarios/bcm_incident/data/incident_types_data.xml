<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Incident Categories with AI Configuration -->
        <record id="category_cyber_security" model="bcm.incident.category">
            <field name="name">Cyber Security Incident</field>
            <field name="code">CYBER</field>
            <field name="severity_default">high</field>
            <field name="rto_default">2.0</field>
            <field name="auto_escalate_after">30</field>
        </record>
        
        <record id="category_operational_disruption" model="bcm.incident.category">
            <field name="name">Operational Disruption</field>
            <field name="code">OPS</field>
            <field name="severity_default">medium</field>
            <field name="rto_default">4.0</field>
            <field name="auto_escalate_after">120</field>
        </record>
        
        <record id="category_natural_disaster" model="bcm.incident.category">
            <field name="name">Natural Disaster</field>
            <field name="code">NAT</field>
            <field name="severity_default">critical</field>
            <field name="rto_default">1.0</field>
            <field name="auto_escalate_after">15</field>
        </record>
        
        <record id="category_supply_chain" model="bcm.incident.category">
            <field name="name">Supply Chain Disruption</field>
            <field name="code">SUP</field>
            <field name="severity_default">medium</field>
            <field name="rto_default">8.0</field>
            <field name="auto_escalate_after">240</field>
        </record>
        
        <record id="category_health_safety" model="bcm.incident.category">
            <field name="name">Health &amp; Safety Emergency</field>
