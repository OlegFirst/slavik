            <field name="rto_default">12.0</field>
            <field name="auto_escalate_after">360</field>
        </record>
        
        <record id="category_human_resources" model="bcm.incident.category">
            <field name="name">Human Resources Crisis</field>
            <field name="code">HR</field>
            <field name="severity_default">medium</field>
            <field name="rto_default">24.0</field>
            <field name="auto_escalate_after">480</field>
        </record>
        
        <record id="category_environmental" model="bcm.incident.category">
            <field name="name">Environmental Incident</field>
            <field name="code">ENV</field>
            <field name="severity_default">high</field>
            <field name="rto_default">4.0</field>
            <field name="auto_escalate_after">90</field>
        </record>
        
    </data>
