# Test Environment Configuration

# Database (use test database)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/digital_twin_test

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# JWT (use test secret)
JWT_SECRET_KEY=test-secret-key-for-testing-only-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# External Services (mock)
BIA_ENGINE_URL=http://localhost:8001
SCENARIO_AI_URL=http://localhost:8002

# Logging
LOG_LEVEL=DEBUG
