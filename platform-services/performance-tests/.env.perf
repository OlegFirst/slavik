# Performance Testing Environment Variables
# ==========================================

# Service URLs
BIA_SERVICE_URL=http://localhost:8012
COMPLIANCE_SERVICE_URL=http://localhost:8014
PLANNING_SERVICE_URL=http://localhost:8011
PLANS_SERVICE_URL=http://localhost:8023

# Database
DATABASE_URL=postgresql://bcm_user:bcm_password_change_in_production@localhost:5432/bcm_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# Test Configuration
TEST_TENANT_ID=perf-test-tenant
TEST_USER_ID=perf-test-user
TEST_USER_EMAIL=perf-test@example.com

# Load Test Settings
DEFAULT_USERS=10
DEFAULT_SPAWN_RATE=1
DEFAULT_DURATION_MINUTES=5

# Performance Targets
TARGET_P95_LATENCY_MS=200
TARGET_P99_LATENCY_MS=500
TARGET_THROUGHPUT_RPS=50
TARGET_ERROR_RATE_PERCENT=1

# Monitoring
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000

# Report Generation
REPORT_OUTPUT_DIR=reports
GENERATE_HTML_REPORT=true
GENERATE_PDF_REPORT=false
