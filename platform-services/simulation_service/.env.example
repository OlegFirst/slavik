# Simulation Service - Environment Configuration Template

# ============================================================================
# SERVICE CONFIGURATION
# ============================================================================
PORT=8095
LOG_LEVEL=INFO
ENVIRONMENT=development
SERVICE_NAME=simulation-service
API_VERSION=v1

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL=postgresql://simulation_user:simulation_pass@localhost:5432/simulation_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis (for caching and WebSocket)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ============================================================================
# PLATFORM INTEGRATION
# ============================================================================

# EventBus (REQUIRED)
EVENTBUS_URL=http://localhost:8055
EVENTBUS_REDIS_URL=redis://localhost:6379/1
EVENTBUS_ENABLED=true

# AI Orchestrator
AI_ORCHESTRATOR_URL=http://localhost:8026
AI_ORCHESTRATOR_ENABLED=true

# Workflow Intelligence (PDCA, Case Library)
WORKFLOW_INTELLIGENCE_URL=http://localhost:8037
WORKFLOW_INTELLIGENCE_ENABLED=true

# Knowledge Center
KNOWLEDGE_CENTER_URL=http://localhost:8038
KNOWLEDGE_CENTER_ENABLED=true

# Community Intelligence
COMMUNITY_INTELLIGENCE_URL=http://localhost:8030
COMMUNITY_INTELLIGENCE_ENABLED=true

# Predictive Journey
PREDICTIVE_JOURNEY_URL=http://localhost:8031
PREDICTIVE_JOURNEY_ENABLED=true

# AI Foundation (RAG, LLM, ML)
AI_FOUNDATION_URL=http://localhost:8025
AI_FOUNDATION_ENABLED=true

# Digital Twin (Optional)
DIGITAL_TWIN_URL=http://localhost:8096
DIGITAL_TWIN_ENABLED=false

# ============================================================================
# SIMULATION ENGINES
# ============================================================================

# JaamSim
JAAMSIM_ENABLED=true
JAAMSIM_PATH=/opt/jaamsim
JAAMSIM_JAR=JaamSim2023-03.jar

# SimPy
SIMPY_ENABLED=true

# Working Directory
SIMULATION_WORKING_DIR=/tmp/simulations
SIMULATION_CLEANUP_AFTER_DAYS=7

# Resource Limits
MAX_CONCURRENT_SIMULATIONS=5
MAX_SIMULATION_DURATION_HOURS=8
MAX_MEMORY_PER_SIMULATION_MB=2048
MAX_CPU_CORES_PER_SIMULATION=2

# ============================================================================
# AI/ML CONFIGURATION
# ============================================================================

# LLM Providers
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
MODEL_RUNNER_URL=http://localhost:8088

# Default LLM Model
DEFAULT_LLM_MODEL=gemma3:latest
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=2000

# RAG Configuration
RAG_ENABLED=true
RAG_COLLECTION_NAME=simulation_scenarios
RAG_SIMILARITY_THRESHOLD=0.7

# ML Models
ML_PREDICTION_ENABLED=true
ML_MODEL_PATH=/models/simulation_predictor.pkl

# ============================================================================
# VISUALIZATION CONFIGURATION
# ============================================================================

# WebSocket
WEBSOCKET_PING_INTERVAL=30
WEBSOCKET_PING_TIMEOUT=10

# Dashboard
DASHBOARD_REFRESH_INTERVAL=5
DASHBOARD_MAX_DATAPOINTS=1000

# ============================================================================
# REPORTING CONFIGURATION
# ============================================================================

# Report Storage
REPORT_STORAGE_PATH=/reports
REPORT_RETENTION_DAYS=90

# Templates
REPORT_TEMPLATE_DIR=./analytics/reporting/templates

# PDF Generation
PDF_FONT=Helvetica
PDF_PAGE_SIZE=A4

# ============================================================================
# SECURITY
# ============================================================================

# JWT
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Structured Logging
LOG_FORMAT=json
LOG_OUTPUT=stdout

# Health Checks
HEALTH_CHECK_INTERVAL_SECONDS=30

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Task Specification Generator
SPEC_GENERATOR_ENABLED=true
SPEC_GENERATOR_USE_AI=true

# Scenario Generation
SCENARIO_GENERATOR_ENABLED=true
SCENARIO_GENERATOR_USE_RAG=true
SCENARIO_GENERATOR_USE_COMMUNITY=true

# Analytics
ANALYTICS_ENABLED=true
BENCHMARKING_ENABLED=true
KPI_CALCULATION_ENABLED=true

# Auto-Integration
AUTO_PDCA_ENABLED=true
AUTO_KNOWLEDGE_STORAGE=true
AUTO_COMMUNITY_CONTRIBUTION=true
AUTO_CONTRIBUTION_MIN_QUALITY_SCORE=8.0

# ============================================================================
# DEVELOPMENT/TESTING
# ============================================================================

# Debug Mode
DEBUG=false
RELOAD=false

# Testing
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/simulation_test_db
MOCK_EXTERNAL_SERVICES=false

# Development Tools
ENABLE_API_DOCS=true
ENABLE_OPENAPI=true
