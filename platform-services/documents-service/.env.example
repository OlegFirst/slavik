# Documents Service Environment Configuration

# Service Configuration
SERVICE_NAME=documents
SERVICE_PORT=8024
SERVICE_VERSION=1.0.0

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bcm_platform
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Storage Configuration
STORAGE_PATH=./storage/documents
MAX_FILE_SIZE=104857600  # 100MB in bytes

# EventBus Configuration (RabbitMQ)
EVENTBUS_URL=amqp://guest:guest@localhost:5672/
EVENTBUS_EXCHANGE=bcm_events

# Orchestrator Configuration
ORCHESTRATOR_URL=http://localhost:8002
REGISTER_WITH_ORCHESTRATOR=true

# AI Services Configuration
AI_INTELLIGENCE_URL=http://localhost:8000
OPENAI_API_KEY=  # Optional: For AI summarization

# Retention Configuration
DEFAULT_RETENTION_YEARS=7
ARCHIVE_AFTER_DAYS=365

# Security Configuration
SECRET_KEY=  # Generate with: openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=["*"]
CORS_CREDENTIALS=true
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
