# ==================== SERVICE CONFIGURATION ====================
SERVICE_NAME=validation
SERVICE_VERSION=1.0.0
SERVICE_PORT=8022
LOG_LEVEL=INFO

# ==================== DATABASE ====================
DATABASE_URL=postgresql+asyncpg://bcm_user:bcm_password@localhost:5432/bcm_validation

# ==================== REDIS CACHE ====================
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600
CACHE_ENABLED=true

# ==================== RABBITMQ / EVENT BUS ====================
EVENTBUS_URL=http://localhost:8001
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ==================== ORCHESTRATOR ====================
ORCHESTRATOR_URL=http://localhost:8000

# ==================== AUTHENTICATION ====================
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ==================== CORS ====================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true

# ==================== EXTERNAL SERVICES ====================
# AI Intelligence Service
AI_INTELLIGENCE_URL=http://localhost:8010

# Document Service
DOCUMENT_SERVICE_URL=http://localhost:8024

# Governance Service
GOVERNANCE_SERVICE_URL=http://localhost:8020

# ==================== EMAIL NOTIFICATIONS (Optional) ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=BCM Platform <noreply@example.com>

# ==================== MONITORING ====================
ENABLE_METRICS=true
METRICS_PORT=9090

# ==================== FEATURE FLAGS ====================
ENABLE_AUTO_ALERTS=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_BACKGROUND_TASKS=true
