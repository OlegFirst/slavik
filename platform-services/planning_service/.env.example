# Planning Service Environment Configuration

# Service
SERVICE_NAME=planning_service
SERVICE_PORT=8011

# Database
DATABASE_URL=postgresql+asyncpg://bcm:bcm@localhost:5432/bcm
DB_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379/0

# EventBus
EVENTBUS_URL=http://localhost:8001

# Orchestrator
ORCHESTRATOR_URL=http://localhost:8002

# AI Services
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Vector DB
PINECONE_API_KEY=
PINECONE_INDEX=bcm-knowledge

# JWT Authentication
# Development mode - use dev headers (X-Dev-User, X-Dev-Tenant)
JWT_PUBLIC_KEY=PLACEHOLDER_DEV_MODE
JWT_ALGORITHM=RS256
JWT_AUDIENCE=bcm-platform
JWT_SECRET=your-secret-key-change-in-production

# Production mode - use RSA public key
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----"
# JWT_ALGORITHM=RS256

# Integration Services
BIA_SERVICE_URL=http://localhost:8012
RISK_SERVICE_URL=http://localhost:8006
