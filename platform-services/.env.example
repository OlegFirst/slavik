# BCM Platform Services - Environment Configuration
# Copy this file to .env and update with your actual values

# ===================================
# Database Configuration
# ===================================
POSTGRES_DB=bcm_platform
POSTGRES_USER=bcm_user
POSTGRES_PASSWORD=CHANGE_THIS_IN_PRODUCTION
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database URLs for services
PLANNING_DATABASE_URL=postgresql+asyncpg://bcm_user:CHANGE_THIS_IN_PRODUCTION@postgres:5432/bcm_platform
PLANS_DATABASE_URL=postgresql+asyncpg://bcm_user:CHANGE_THIS_IN_PRODUCTION@postgres:5432/bcm_platform

# ===================================
# Redis Configuration
# ===================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ===================================
# EventBus Configuration
# ===================================
EVENTBUS_URL=http://eventbus:8001

# ===================================
# JWT Authentication
# ===================================
# IMPORTANT: Replace with your actual RSA public key in production
# Generate key pair: ssh-keygen -t rsa -b 4096 -m PEM -f jwtRS256.key
JWT_PUBLIC_KEY=PLACEHOLDER_DEV_MODE
JWT_ALGORITHM=RS256
JWT_AUDIENCE=bcm-platform
JWT_ISSUER=bcm-auth-service

# ===================================
# Service Configuration
# ===================================
# Planning Service (ISO 22301 Clause 8.3)
PLANNING_SERVICE_PORT=8011
PLANNING_SERVICE_NAME=planning_service

# Plans Service (ISO 22301 Clause 8.4)
PLANS_SERVICE_PORT=8023
PLANS_SERVICE_NAME=plans_service
PLANNING_SERVICE_URL=http://planning-service:8011

# ===================================
# CORS Configuration
# ===================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://app.yourdomain.com

# ===================================
# Monitoring Configuration
# ===================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_IN_PRODUCTION

# ===================================
# Application Settings
# ===================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ===================================
# AI Orchestrator (Optional)
# ===================================
AI_ORCHESTRATOR_URL=http://ai-orchestrator:8000
ANTHROPIC_API_KEY=

# ===================================
# Security Settings
# ===================================
# Set to 'false' in production
ALLOW_DEV_MODE=true

# Session Configuration
SESSION_SECRET=CHANGE_THIS_IN_PRODUCTION_USE_STRONG_RANDOM_STRING

# ===================================
# Health Check Configuration
# ===================================
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_INTERVAL=30
