# Database
DATABASE_URL=postgresql://bcm:changeme@postgres:5432/bcm_platform
POSTGRES_USER=bcm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bcm_platform

# Redis
REDIS_URL=redis://redis:6379

# Qdrant Vector Database (Cloud)
QDRANT_URL=https://fa9f6acd-aef9-4ebe-a3f5-f89c62bce378.eu-west-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIn0.XalkCWKEVbNd9P5Bj3f7Y4pPEySIZD3RyCc8EAG5EIE
QDRANT_CLUSTER_ID=fa9f6acd-aef9-4ebe-a3f5-f89c62bce378

# Temporal Cloud (Workflow Engine) - https://cloud.temporal.io
TEMPORAL_NAMESPACE=your-namespace.xxxxx
TEMPORAL_NAMESPACE_ID=your-namespace-id
TEMPORAL_ACCOUNT_ID=your-account-id
TEMPORAL_GRPC_ENDPOINT=your-namespace.xxxxx.tmprl.cloud:7233
TEMPORAL_CLIENT_CERT_PATH=/path/to/client.pem
TEMPORAL_CLIENT_KEY_PATH=/path/to/client.key
TEMPORAL_WEB_URL=https://cloud.temporal.io

# AI Services
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Keycloak (SSO)
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=bcm-platform
KEYCLOAK_CLIENT_ID=bcm-client
KEYCLOAK_CLIENT_SECRET=your-keycloak-secret

# Services URLs
API_GATEWAY_URL=http://api-gateway:3001
EXECUTION_ENGINE_URL=http://execution-engine:8000
INTELLIGENT_CORE_URL=http://intelligent-core:9000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Email (Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@bcm-platform.com

# File Storage
S3_BUCKET=bcm-platform-files
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_REGION=us-east-1

# Monitoring
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3002
GRAFANA_ADMIN_PASSWORD=changeme

# RabbitMQ (Message Queue)
RABBITMQ_URL=amqp://guest:guest@localhost/
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_MANAGEMENT_URL=http://localhost:15672

# HashiCorp Vault (Secrets Manager)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root-token
VAULT_ROOT_TOKEN=root-token

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
