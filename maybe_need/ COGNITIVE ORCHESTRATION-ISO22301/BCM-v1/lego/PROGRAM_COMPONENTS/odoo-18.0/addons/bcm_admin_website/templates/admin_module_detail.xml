<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- BCM Admin Module Detail Template -->
    <template id="admin_module_detail_template" name="BCM Admin Module Detail">
        <t t-call="website.layout">
            <t t-set="title"><t t-esc="module_info.get('title', module_name)"/> - BCM Admin</t>

            <!-- Embedded CSS -->
            <style>
                .bcm-admin-module-detail {
                    background-color: #f8f9fa;
                    min-height: 100vh;
                }

                .admin-header {
                    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
                }
            </style>

            <div id="wrap" class="bcm-admin-module-detail">
                <!-- Header -->
                <div class="admin-header bg-primary text-white py-4">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h1 class="mb-0">
                                    <i class="fa fa-cube me-3"></i>
                                    <t t-esc="module_info.get('title', module_name)"/>
                                </h1>
                                <p class="mb-0 mt-2"><t t-esc="module_info.get('description', '')"/></p>
                            </div>
                            <div class="col-md-4 text-end">
                                <div class="btn-group">
                                    <a href="/bcm/admin/modules" class="btn btn-light">
                                        <i class="fa fa-arrow-left me-1"></i>Back to Modules
                                    </a>
                                    <a t-attf-href="/web#menu_id=&amp;model=#{module_info.get('model', '')}&amp;view_type=list"
                                       class="btn btn-warning" target="_blank">
                                        <i class="fa fa-external-link-alt me-1"></i>Odoo Backend
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Content -->
                <div class="container my-4">
                    <!-- Module Overview -->
                    <div class="row mb-4">
                        <div class="col-md-8">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-white border-bottom">
                                    <h5 class="mb-0">
                                        <i class="fa fa-database me-2 text-primary"></i>
                                        Module Data
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <!-- Data Table -->
                                    <div class="table-responsive">
                                        <table class="table table-hover">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>ID</th>
                                                    <th>Name</th>
                                                    <t t-foreach="module_info.get('fields', [])" t-as="field">
                                                        <th><t t-esc="field.replace('_', ' ').title()"/></th>
                                                    </t>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="module_data" t-as="record">
                                                    <tr>
                                                        <td><t t-esc="record.get('id', '')"/></td>
                                                        <td>
                                                            <strong><t t-esc="record.get('name', '')"/></strong>
                                                        </td>
                                                        <t t-foreach="module_info.get('fields', [])" t-as="field">
                                                            <td>
                                                                <t t-esc="record.get('data', {}).get(field, '-')"/>
                                                            </td>
                                                        </t>
                                                        <td>
                                                            <div class="btn-group btn-group-sm">
                                                                <a t-attf-href="/web#id=#{record.get('id', '')}&amp;model=#{module_info.get('model', '')}&amp;view_type=form"
                                                                   class="btn btn-outline-primary" target="_blank">
                                                                    <i class="fa fa-edit"></i>
                                                                </a>
                                                                <button class="btn btn-outline-secondary"
                                                                        onclick="viewRecord(this)"
                                                                        t-attf-data-record-id="#{record.get('id', '')}">
                                                                    <i class="fa fa-eye"></i>
                                                                </button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                </t>
                                                <!-- No data state -->
                                                <tr t-if="not module_data">
                                                    <td t-attf-colspan="#{len(module_info.get('fields', [])) + 3}" class="text-center py-4">
                                                        <div class="text-muted">
                                                            <i class="fa fa-inbox fa-2x mb-2"></i>
                                                            <p>No records found for this module</p>
                                                            <a t-attf-href="/web#model=#{module_info.get('model', '')}&amp;view_type=form"
                                                               class="btn btn-primary btn-sm" target="_blank">
                                                                <i class="fa fa-plus me-1"></i>Create First Record
                                                            </a>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Module Actions -->
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm mb-3">
                                <div class="card-header bg-white border-bottom">
                                    <h6 class="mb-0">
                                        <i class="fa fa-bolt me-2 text-warning"></i>
                                        Quick Actions
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <div class="d-grid gap-2">
                                        <a t-attf-href="/web#model=#{module_info.get('model', '')}&amp;view_type=form"
                                           class="btn btn-primary" target="_blank">
                                            <i class="fa fa-plus me-1"></i>Create New Record
                                        </a>
                                        <a t-attf-href="/web#menu_id=&amp;model=#{module_info.get('model', '')}&amp;view_type=list"
                                           class="btn btn-outline-secondary" target="_blank">
                                            <i class="fa fa-list me-1"></i>View All Records
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Module Statistics -->
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-white border-bottom">
                                    <h6 class="mb-0">
                                        <i class="fa fa-chart-pie me-2 text-info"></i>
                                        Module Statistics
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <div class="module-stats">
                                        <div class="stat-item d-flex justify-content-between mb-2">
                                            <span>Total Records:</span>
                                            <strong><t t-esc="len(module_data)"/></strong>
                                        </div>
                                        <div class="stat-item d-flex justify-content-between">
                                            <span>Status:</span>
                                            <span class="badge bg-success">Active</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Embedded JavaScript -->
            <script>
                function viewRecord(button) {
                    const recordId = button.getAttribute('data-record-id');
                    alert('Viewing record ID: ' + recordId);
                }
            </script>
        </t>
    </template>
</odoo>