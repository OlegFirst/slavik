<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Main BCM Dashboard -->
        <template id="bcm_dashboard" name="BCM Dashboard">
            <t t-call="bcm_portal.bcm_portal_base">
                <t t-set="page_name" t-value="'bcm_dashboard'"/>
                
                <!-- Dashboard Cards Row 1 -->
                <div class="row">
                    <!-- Status Overview Card -->
                    <div class="col-lg-3 col-md-6">
                        <div class="card">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-8">
                                        <h6 class="card-title text-muted">BCM Status</h6>
                                        <h3 class="card-text">
                                            <span t-if="dashboard_data.get('overall_status') == 'good'" class="text-success">
                                                <i class="fa fa-check-circle"/> Good
                                            </span>
                                            <span t-if="dashboard_data.get('overall_status') == 'warning'" class="text-warning">
                                                <i class="fa fa-exclamation-triangle"/> Warning
                                            </span>
                                            <span t-if="dashboard_data.get('overall_status') == 'critical'" class="text-danger">
                                                <i class="fa fa-exclamation-circle"/> Critical
                                            </span>
                                        </h3>
                                    </div>
                                    <div class="col-4 text-right">
                                        <i class="fa fa-shield fa-2x text-primary"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Active Plans Card -->
                    <div class="col-lg-3 col-md-6">
                        <div class="card">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-8">
                                        <h6 class="card-title text-muted">Active Plans</h6>
                                        <h3 class="card-text text-success" t-esc="dashboard_data.get('active_plans', 0)"/>
                                        <small class="text-muted">of <span t-esc="dashboard_data.get('total_plans', 0)"/> total</small>
                                    </div>
                                    <div class="col-4 text-right">
                                        <i class="fa fa-file-text fa-2x text-success"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Recent Incidents Card -->
                    <div class="col-lg-3 col-md-6">
                        <div class="card">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-8">
                                        <h6 class="card-title text-muted">Recent Incidents</h6>
                                        <h3 class="card-text text-warning" t-esc="dashboard_data.get('recent_incidents', 0)"/>
                                        <small class="text-muted">last 30 days</small>
                                    </div>
                                    <div class="col-4 text-right">
                                        <i class="fa fa-exclamation-circle fa-2x text-warning"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Next Exercise Card -->
                    <div class="col-lg-3 col-md-6">
                        <div class="card">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-8">
                                        <h6 class="card-title text-muted">Next Exercise</h6>
                                        <h3 class="card-text text-info">
                                            <span t-if="dashboard_data.get('next_exercise_days')">
                                                <span t-esc="dashboard_data['next_exercise_days']"/>d
                                            </span>
                                            <span t-else="">
                                                None
                                            </span>
                                        </h3>
                                        <small class="text-muted">days away</small>
                                    </div>
                                    <div class="col-4 text-right">
                                        <i class="fa fa-play-circle fa-2x text-info"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Dashboard Row 2 -->
                <div class="row mt-4">
                    <!-- BIA Summary Chart -->
                    <div class="col-lg-8">
                        <div class="card">
                            <div class="card-header">
                                <h5><i class="fa fa-chart-line"/> Business Impact Analysis Summary</h5>
                            </div>
                            <div class="card-body">
                                <t t-if="dashboard_data.get('bia_summary')">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <canvas id="biaChart" width="400" height="200"/>
                                        </div>
                                        <div class="col-md-6">
                                            <h6>Critical Processes</h6>
                                            <ul class="list-unstyled">
                                                <t t-foreach="dashboard_data['bia_summary']['critical_processes']" t-as="process">
                                                    <li class="mb-2">
                                                        <span class="badge badge-danger mr-2">Critical</span>
                                                        <span t-esc="process['name']"/>
                                                        <small class="text-muted">
                                                            (RTO: <span t-esc="process['rto_hours']"/>h)
                                                        </small>
                                                    </li>
                                                </t>
                                            </ul>
                                        </div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="text-center text-muted">
                                        <i class="fa fa-chart-line fa-4x mb-3"/>
                                        <p>No BIA data available yet.</p>
                                        <a href="/my/bcm/bia" class="btn btn-primary">Start BIA Analysis</a>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Quick Actions &amp; Alerts -->
                    <div class="col-lg-4">
                        <div class="card">
                            <div class="card-header">
                                <h5><i class="fa fa-bolt"/> Quick Actions</h5>
                            </div>
                            <div class="card-body">
                                <div class="list-group list-group-flush">
                                    <a href="/my/bcm/bia/new" class="list-group-item list-group-item-action">
                                        <i class="fa fa-plus text-success"/> Start New BIA
                                    </a>
                                    <a href="/my/bcm/incidents/report" class="list-group-item list-group-item-action">
                                        <i class="fa fa-exclamation-triangle text-warning"/> Report Incident
                                    </a>
                                    <a href="/my/bcm/exercises/schedule" class="list-group-item list-group-item-action">
                                        <i class="fa fa-calendar text-info"/> Schedule Exercise
                                    </a>
                                    <a href="/my/bcm/plans/review" class="list-group-item list-group-item-action">
                                        <i class="fa fa-eye text-primary"/> Review Plans
                                    </a>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Alerts &amp; Notifications -->
                        <div class="card mt-3">
                            <div class="card-header">
                                <h5><i class="fa fa-bell"/> Alerts</h5>
                            </div>
                            <div class="card-body">
                                <t t-if="dashboard_data.get('alerts')">
                                    <t t-foreach="dashboard_data['alerts']" t-as="alert">
                                        <div class="alert alert-sm" t-attf-class="alert-{{alert['type']}}">
                                            <small>
                                                <strong t-esc="alert['title']"/>: 
                                                <span t-esc="alert['message']"/>
                                            </small>
                                        </div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <div class="text-center text-muted">
                                        <i class="fa fa-check-circle fa-2x text-success mb-2"/>
                                        <p class="small">All systems normal</p>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Recent Activity -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h5><i class="fa fa-history"/> Recent Activity</h5>
                            </div>
                            <div class="card-body">
                                <t t-if="dashboard_data.get('recent_activity')">
                                    <div class="table-responsive">
                                        <table class="table table-sm">
                                            <thead>
                                                <tr>
                                                    <th>Date</th>
                                                    <th>Type</th>
                                                    <th>Description</th>
                                                    <th>Status</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="dashboard_data['recent_activity']" t-as="activity">
                                                    <tr>
                                                        <td>
                                                            <small t-esc="activity['date']"/>
                                                        </td>
                                                        <td>
                                                            <span class="badge badge-secondary" t-esc="activity['type']"/>
                                                        </td>
                                                        <td t-esc="activity['description']"/>
                                                        <td>
                                                            <span t-attf-class="badge badge-{{activity['status_class']}}" 
                                                                  t-esc="activity['status']"/>
                                                        </td>
                                                        <td>
                                                            <a t-if="activity.get('url')" 
                                                               t-att-href="activity['url']" 
                                                               class="btn btn-sm btn-outline-primary">
                                                                View
                                                            </a>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="text-center text-muted">
                                        <i class="fa fa-inbox fa-3x mb-3"/>
                                        <p>No recent activity</p>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- AI Assistant Chat Widget -->
                <div class="bcm-chat-widget">
                    <div id="bcm-chat-toggle" class="btn btn-primary btn-lg rounded-circle">
                        <i class="fa fa-comments"/>
                    </div>
                    <div id="bcm-chat-window" class="card d-none">
                        <div class="card-header bg-primary text-white">
                            <h6 class="mb-0">
                                <i class="fa fa-robot"/> BCM AI Assistant
                                <button type="button" class="close text-white" id="bcm-chat-close">
                                    <span>×</span>
                                </button>
                            </h6>
                        </div>
                        <div class="card-body p-0">
                            <div id="bcm-chat-messages" class="p-3" style="height: 300px; overflow-y: auto;">
                                <div class="chat-message bot">
                                    <div class="message-content">
                                        <p>👋 Hello! I'm your BCM AI Assistant. How can I help you today?</p>
                                        <div class="message-suggestions">
                                            <button class="btn btn-sm btn-outline-primary me-1" data-suggestion="What is my current BCM status?">
                                                Current Status
                                            </button>
                                            <button class="btn btn-sm btn-outline-primary me-1" data-suggestion="Show me critical processes">
                                                Critical Processes
                                            </button>
                                            <button class="btn btn-sm btn-outline-primary" data-suggestion="Help with BIA analysis">
                                                BIA Help
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer">
                                <form id="bcm-chat-form">
                                    <div class="input-group">
                                        <input type="text" id="bcm-chat-input" class="form-control" 
                                               placeholder="Ask me anything about BCM..." autocomplete="off"/>
                                        <div class="input-group-append">
                                            <button type="submit" class="btn btn-primary">
                                                <i class="fa fa-paper-plane"/>
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

            </t>
        </template>

    </data>
</odoo>
