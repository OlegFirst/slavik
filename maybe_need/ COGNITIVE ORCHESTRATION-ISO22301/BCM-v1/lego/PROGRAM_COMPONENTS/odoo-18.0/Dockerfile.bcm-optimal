FROM odoo:18.0

USER root

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-dev \
    build-essential \
    postgresql-client \
    netcat-openbsd \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy BCM modules
COPY ./addons/bcm_* /mnt/extra-addons/

# Create optimized installation script
COPY docker-entrypoint-bcm-optimal.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Set environment for BCM platform
ENV DB_HOST=postgres \
    DB_PORT=5432 \
    DB_USER=odoo \
    DB_PASSWORD=postgres123 \
    DB_NAME=bcm_platform \
    BCM_AUTO_INSTALL=true \
    ADMIN_PASSWD=admin123 \
    LIST_DB=false

# Set proper permissions
RUN chown -R odoo:odoo /mnt/extra-addons

USER odoo

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["odoo"]