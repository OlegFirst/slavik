<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- AI Control Dashboard Form View -->
        <record id="view_ai_control_dashboard_form" model="ir.ui.view">
            <field name="name">bcm.ai.control.dashboard.form</field>
            <field name="model">bcm.ai.control.dashboard</field>
            <field name="arch" type="xml">
                <form string="AI Control Dashboard" create="false" delete="false">
                    <header>
                        <button name="action_refresh_organism_status" type="object"
                                string="🔄 Refresh Status" class="btn-primary"/>

                        <button name="action_emergency_organism_override" type="object"
                                string="🚨 Emergency Override" class="btn-danger"
                                confirm="Are you sure you want to activate emergency override?"/>

                        <field name="organism_status" widget="badge"
                               decoration-info="organism_status == 'awakening'"
                               decoration-primary="organism_status == 'learning'"
                               decoration-success="organism_status == 'active'"
                               decoration-warning="organism_status == 'wise'"
                               decoration-muted="organism_status == 'evolving'"/>
                    </header>

                    <sheet>
                        <div class="oe_title">
                            <h1>🧬 Digital BCM Organism Control Center</h1>
                            <div class="o_row">
                                <div class="oe_edit_only">
                                    <field name="name" placeholder="Dashboard Name"/>
                                </div>
                            </div>
                        </div>

                        <!-- Organism Health Overview -->
                        <div class="organism_health_overview">
                            <h3>🏥 Organism Health Status</h3>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="health_metric">
                                        <div class="metric_value">
                                            <field name="overall_health" widget="percentage"/>
                                        </div>
                                        <div class="metric_label">Overall Health</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="health_metric">
                                        <div class="metric_value">
                                            <field name="consciousness_level" widget="percentage"/>
                                        </div>
                                        <div class="metric_label">Consciousness Level</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="health_metric">
                                        <div class="metric_value">
                                            <field name="total_ai_organs"/>
                                        </div>
                                        <div class="metric_label">AI Organs Active</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="health_metric">
                                        <div class="metric_value">
                                            <field name="ai_efficiency_score" widget="percentage"/>
                                        </div>
                                        <div class="metric_label">AI Efficiency</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Memory System Status -->
                        <group string="🧠 Memory System Status">
                            <group>
                                <field name="memory_layer1_status" readonly="1"/>
                                <field name="memory_layer2_status" readonly="1"/>
                                <field name="memory_layer3_status" readonly="1"/>
                            </group>
                            <group>
                                <field name="learning_sessions_today" readonly="1"/>
                                <field name="wisdom_accumulated" readonly="1"/>
                                <field name="pattern_recognition_rate" readonly="1"/>
                            </group>
                        </group>

                        <!-- AI Usage Analytics -->
                        <group string="💰 AI Usage &amp; Cost Analytics">
                            <group>
                                <field name="daily_ai_calls" readonly="1"/>
                                <field name="anthropic_tokens_used" readonly="1"/>
                            </group>
                            <group>
                                <field name="monthly_ai_cost" readonly="1"/>
                                <field name="ai_efficiency_score" readonly="1"/>
                            </group>
                        </group>

                        <!-- Quick Actions -->
                        <group string="🚀 Quick AI Tools Access">
                            <div class="ai_tools_buttons">
                                <button name="action_open_ai_control_center" type="object"
                                        string="🎛️ Professional AI Control Center"
                                        class="btn-primary oe_highlight"/>

                                <button name="action_open_mcp_inspector" type="object"
                                        string="🔍 MCP Inspector"
                                        class="btn-info"/>

                                <button name="action_open_prompt_studio" type="object"
                                        string="📝 Prompt Engineering Studio"
                                        class="btn-success"/>
                            </div>
                        </group>

                        <!-- AI Organs Quick Status -->
                        <group string="🎯 AI Organs Quick Status">
                            <field name="ai_organ_status_ids" mode="kanban" nolabel="1">
                                <kanban>
                                    <field name="name"/>
                                    <field name="organ_type"/>
                                    <field name="status"/>
                                    <field name="health_score"/>
                                    <templates>
                                        <t t-name="kanban-box">
                                            <div class="oe_kanban_card ai_organ_card">
                                                <div class="oe_kanban_content">
                                                    <div class="o_kanban_record_top">
                                                        <strong><t t-esc="record.organ_type.value"/></strong>
                                                        <span class="float-right">
                                                            <t t-esc="record.health_score.value"/>
                                                        </span>
                                                    </div>
                                                    <div class="o_kanban_record_body">
                                                        <span class="badge" t-attf-class="badge-#{record.status.raw_value}">
                                                            <t t-esc="record.status.value"/>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>