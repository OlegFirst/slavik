<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Digital BCM Organism Dashboard -->
        <record id="view_digital_organism_dashboard_form" model="ir.ui.view">
            <field name="name">digital.organism.dashboard.form</field>
            <field name="model">bcm.ai.control.dashboard</field>
            <field name="arch" type="xml">
                <form string="🧬 Digital BCM Organism Control Center">
                    <header>
                        <button name="action_refresh_organism_status" string="🔄 Refresh Status" type="object" class="oe_highlight"/>
                        <button name="action_open_ai_control_center" string="🎛️ Control Center" type="object" class="btn-primary"/>
                        <button name="action_emergency_organism_override" string="🚨 Emergency Override" type="object" class="btn-danger"
                                confirm="This will put the organism in emergency mode. Continue?"/>
                        <field name="organism_status" widget="statusbar" statusbar_visible="awakening,learning,active,wise,evolving"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>🧬 Digital BCM Organism</h1>
                            <h2><field name="name"/></h2>
                        </div>

                        <!-- Organism Vital Signs -->
                        <group string="🧠 Organism Vital Signs">
                            <group>
                                <field name="overall_health" widget="progressbar"/>
                                <field name="consciousness_level" widget="progressbar"/>
                                <field name="total_ai_organs"/>
                            </group>
                            <group>
                                <field name="coordination_success_rate" widget="progressbar"/>
                                <field name="avg_cross_organ_response_time"/>
                                <field name="memory_sync_frequency"/>
                            </group>
                        </group>

                        <!-- Memory System Status -->
                        <group string="🧠 3-Layer Memory System">
                            <group>
                                <field name="memory_layer1_status" widget="badge"/>
                                <field name="memory_layer2_status" widget="badge"/>
                                <field name="memory_layer3_status" widget="badge"/>
                            </group>
                        </group>

                        <!-- AI Usage Analytics -->
                        <group string="📊 AI Usage Analytics">
                            <group>
                                <field name="daily_ai_calls"/>
                                <field name="anthropic_tokens_used"/>
                                <field name="monthly_ai_cost" widget="monetary"/>
                            </group>
                            <group>
                                <field name="ai_efficiency_score" widget="progressbar"/>
                                <field name="learning_sessions_today"/>
                                <field name="wisdom_accumulated" widget="progressbar"/>
                            </group>
                        </group>

                        <!-- Organism Configuration -->
                        <group string="⚙️ Organism Configuration">
                            <group>
                                <field name="organism_personality"/>
                                <field name="inter_organ_communication"/>
                                <field name="memory_synchronization"/>
                            </group>
                            <group>
                                <field name="pattern_sharing"/>
                                <field name="collective_learning"/>
                                <field name="pattern_recognition_rate" widget="progressbar"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- AI Organ Status Kanban -->
        <record id="view_ai_organ_status_kanban" model="ir.ui.view">
            <field name="name">ai.organ.status.kanban</field>
            <field name="model">bcm.ai.organ.status</field>
            <field name="arch" type="xml">
                <kanban default_group_by="status" class="ai_organs_kanban">
                    <field name="name"/>
                    <field name="organ_type"/>
                    <field name="status"/>
                    <field name="health_score"/>
                    <field name="ai_provider"/>
                    <field name="activation_count"/>
                    <field name="avg_response_time"/>
                    <field name="success_rate"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click ai_organ_card">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                            <span class="ai_provider_badge">
                                                <field name="ai_provider"/>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <div class="ai_organ_metrics">
                                            <div class="metric">
                                                <span class="metric_label">Health:</span>
                                                <span class="metric_value">
                                                    <field name="health_score" widget="progressbar"/>
                                                </span>
                                            </div>
                                            <div class="metric">
                                                <span class="metric_label">Activations:</span>
                                                <span class="metric_value">
                                                    <field name="activation_count"/>
                                                </span>
                                            </div>
                                            <div class="metric">
                                                <span class="metric_label">Response:</span>
                                                <span class="metric_value">
                                                    <field name="avg_response_time"/>s
                                                </span>
                                            </div>
                                            <div class="metric">
                                                <span class="metric_label">Success:</span>
                                                <span class="metric_value">
                                                    <field name="success_rate"/>%
                                                </span>
                                            </div>
                                        </div>
                                        <div class="ai_organ_actions">
                                            <button name="action_activate_organ" type="object" class="btn btn-sm btn-success"
                                                    invisible="status == 'active'">
                                                ⚡ Activate
                                            </button>
                                            <button name="action_put_organ_to_sleep" type="object" class="btn btn-sm btn-secondary"
                                                    invisible="status == 'dormant'">
                                                😴 Sleep
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- AI Organ Coordinator Form -->
        <record id="view_ai_organ_coordinator_form" model="ir.ui.view">
            <field name="name">ai.organ.coordinator.form</field>
            <field name="model">bcm.ai.organ.coordinator</field>
            <field name="arch" type="xml">
                <form string="🧬 AI Organ Coordinator">
                    <header>
                        <button name="action_awaken_digital_organism" string="🌅 Awaken Organism" type="object" class="oe_highlight"
                                confirm="This will awaken the Digital BCM Organism. Continue?"/>
                        <button name="action_trigger_organism_evolution" string="🌟 Trigger Evolution" type="object" class="btn-warning"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>🧬 <field name="name"/></h1>
                        </div>

                        <group string="🧠 Organism Consciousness">
                            <group>
                                <field name="consciousness_level" widget="progressbar"/>
                                <field name="organism_personality"/>
                                <field name="organ_count"/>
                            </group>
                            <group>
                                <field name="coordination_success_rate" widget="progressbar"/>
                                <field name="avg_cross_organ_response_time"/>
                                <field name="memory_sync_frequency"/>
                            </group>
                        </group>

                        <group string="🔗 Inter-Organ Communication">
                            <group>
                                <field name="inter_organ_communication"/>
                                <field name="memory_synchronization"/>
                            </group>
                            <group>
                                <field name="pattern_sharing"/>
                                <field name="collective_learning"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="🧠 Collective Wisdom">
                                <group>
                                    <field name="collective_wisdom" widget="text"/>
                                </group>
                            </page>
                            <page string="📊 Active Organs">
                                <group>
                                    <field name="active_organs" widget="text"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Anthropic Integration Form -->
        <record id="view_anthropic_integration_form" model="ir.ui.view">
            <field name="name">anthropic.integration.form</field>
            <field name="model">bcm.anthropic.integration</field>
            <field name="arch" type="xml">
                <form string="🧠 Anthropic Claude Integration">
                    <header>
                        <button name="action_test_anthropic_connection" string="🧪 Test Connection" type="object" class="oe_highlight"/>
                        <button name="action_check_anthropic_credits" string="💰 Check Credits" type="object" class="btn-info"/>
                        <field name="api_health_status" widget="statusbar" statusbar_visible="healthy,degraded,error"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>🧠 <field name="name"/></h1>
                        </div>

                        <group string="⚙️ Anthropic Configuration">
                            <group>
                                <field name="api_key" password="True"/>
                                <field name="model_name"/>
                                <field name="max_tokens"/>
                            </group>
                            <group>
                                <field name="temperature"/>
                                <field name="integration_active"/>
                                <field name="last_api_call"/>
                            </group>
                        </group>

                        <group string="📊 Usage Analytics">
                            <group>
                                <field name="daily_token_usage"/>
                                <field name="monthly_token_usage"/>
                            </group>
                            <group>
                                <field name="daily_cost" widget="monetary"/>
                                <field name="monthly_cost" widget="monetary"/>
                            </group>
                        </group>

                        <group string="🚦 Rate Limiting">
                            <group>
                                <field name="requests_per_minute"/>
                                <field name="daily_request_limit"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Actions -->
        <record id="action_digital_organism_dashboard" model="ir.actions.act_window">
            <field name="name">🧬 Digital BCM Organism</field>
            <field name="res_model">bcm.ai.control.dashboard</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Initialize your Digital BCM Organism
                </p>
                <p>
                    Monitor and control the consciousness and performance of your AI-enhanced BCM platform.
                </p>
            </field>
        </record>

        <record id="action_ai_organ_status" model="ir.actions.act_window">
            <field name="name">🤖 AI Organs Status</field>
            <field name="res_model">bcm.ai.organ.status</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Monitor your AI Organs
                </p>
                <p>
                    Track the status and performance of individual AI organs in your Digital BCM Organism.
                </p>
            </field>
        </record>

        <record id="action_ai_organ_coordinator" model="ir.actions.act_window">
            <field name="name">🧬 AI Organ Coordinator</field>
            <field name="res_model">bcm.ai.organ.coordinator</field>
            <field name="view_mode">form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Control AI Organ Coordination
                </p>
                <p>
                    Manage communication and coordination between AI organs in your Digital BCM Organism.
                </p>
            </field>
        </record>

        <record id="action_anthropic_integration" model="ir.actions.act_window">
            <field name="name">🧠 Anthropic Integration</field>
            <field name="res_model">bcm.anthropic.integration</field>
            <field name="view_mode">form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Configure Anthropic Claude
                </p>
                <p>
                    Setup and monitor integration with Anthropic Claude for strategic governance intelligence.
                </p>
            </field>
        </record>

        <!-- Menu Structure -->
        <menuitem id="menu_digital_organism"
                  name="🧬 Digital BCM Organism"
                  parent="bcm_core.menu_bcm_root"
                  sequence="1"/>

        <menuitem id="menu_organism_dashboard"
                  name="📊 Organism Dashboard"
                  parent="menu_digital_organism"
                  action="action_digital_organism_dashboard"
                  sequence="10"/>

        <menuitem id="menu_ai_organs"
                  name="🤖 AI Organs"
                  parent="menu_digital_organism"
                  action="action_ai_organ_status"
                  sequence="20"/>

        <menuitem id="menu_organ_coordinator"
                  name="🧬 Coordination Center"
                  parent="menu_digital_organism"
                  action="action_ai_organ_coordinator"
                  sequence="30"/>

        <menuitem id="menu_anthropic_integration"
                  name="🧠 Anthropic Integration"
                  parent="menu_digital_organism"
                  action="action_anthropic_integration"
                  sequence="40"
                  groups="bcm_core.group_bcm_manager"/>
    </data>
</odoo>