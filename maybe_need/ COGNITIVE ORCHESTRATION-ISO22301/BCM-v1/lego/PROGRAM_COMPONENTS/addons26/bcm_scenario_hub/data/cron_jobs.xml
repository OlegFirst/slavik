<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- AI Scenario Generation (Daily) -->
        <record id="cron_ai_scenario_generation" model="ir.cron">
            <field name="name">BCM Scenario Hub: AI Generation</field>
            <field name="model_id" ref="model_bcm_scenario"/>
            <field name="state">code</field>
            <field name="code">model.generate_ai_scenarios()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">10</field>
        </record>
        
        <!-- Scenario Rating Update (Hourly) -->
        <record id="cron_rating_update" model="ir.cron">
            <field name="name">BCM Scenario Hub: Update Ratings</field>
            <field name="model_id" ref="model_bcm_scenario_rating"/>
            <field name="state">code</field>
            <field name="code">model.update_scenario_ratings()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
            <field name="priority">8</field>
        </record>
        
        <!-- Review Moderation (Every 30 minutes) -->
        <record id="cron_review_moderation" model="ir.cron">
            <field name="name">BCM Scenario Hub: Review Moderation</field>
            <field name="model_id" ref="model_bcm_scenario_review"/>
            <field name="state">code</field>
            <field name="code">model.moderate_pending_reviews()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">6</field>
        </record>
        
        <!-- Scenario Sync with AI Orchestrator (Every 6 hours) -->
        <record id="cron_ai_orchestrator_sync" model="ir.cron">
            <field name="name">BCM Scenario Hub: AI Orchestrator Sync</field>
            <field name="model_id" ref="model_bcm_scenario"/>
            <field name="state">code</field>
            <field name="code">model.sync_with_ai_orchestrator()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
            <field name="priority">15</field>
        </record>
        
        <!-- Popular Scenarios Report (Weekly) -->
        <record id="cron_popular_scenarios" model="ir.cron">
            <field name="name">BCM Scenario Hub: Popular Scenarios Report</field>
            <field name="model_id" ref="model_bcm_scenario"/>
            <field name="state">code</field>
            <field name="code">model.generate_popular_scenarios_report()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
            <field name="priority">20</field>
        </record>
        
        <!-- Scenario Effectiveness Analysis (Monthly) -->
        <record id="cron_effectiveness_analysis" model="ir.cron">
            <field name="name">BCM Scenario Hub: Effectiveness Analysis</field>
            <field name="model_id" ref="model_bcm_scenario"/>
            <field name="state">code</field>
            <field name="code">model.analyze_scenario_effectiveness()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
            <field name="priority">25</field>
        </record>
    </data>
</odoo>
