<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Root Menu for Incident Management -->
        <menuitem id="menu_bcm_incident_root" 
                  name="Incident Management" 
                  sequence="10"
                  web_icon="bcm_incident_unified,static/description/icon.png"/>
        
        <!-- Dashboard Menu -->
        <menuitem id="menu_bcm_incident_dashboard" 
                  name="Dashboard" 
                  parent="menu_bcm_incident_root" 
                  sequence="1"
                  action="action_bcm_incident_dashboard"/>
        
        <!-- Incidents Menu Group -->
        <menuitem id="menu_bcm_incidents" 
                  name="Incidents" 
                  parent="menu_bcm_incident_root" 
                  sequence="10"/>
        
        <!-- All Incidents -->
        <record id="action_bcm_incident" model="ir.actions.act_window">
            <field name="name">All Incidents</field>
            <field name="res_model">bcm.incident</field>
            <field name="view_mode">kanban,tree,form,calendar,pivot,graph</field>
            <field name="search_view_id" ref="view_bcm_incident_search"/>
            <field name="context">{
                'search_default_active': 1,
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first incident report
                </p>
                <p>
                    Track and manage business continuity incidents with AI-powered
                    recommendations and automated response workflows.
                </p>
            </field>
        </record>
        
        <menuitem id="menu_bcm_incident_all" 
                  name="All Incidents" 
                  parent="menu_bcm_incidents" 
                  sequence="1"
                  action="action_bcm_incident"/>
        
        <!-- My Incidents -->
        <record id="action_bcm_incident_my" model="ir.actions.act_window">
            <field name="name">My Incidents</field>
            <field name="res_model">bcm.incident</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="view_bcm_incident_search"/>
            <field name="context">{
                'search_default_my_incidents': 1,
                'search_default_active': 1,
            }</field>
            <field name="domain">[('assigned_to', '=', uid)]</field>
        </record>
        
        <menuitem id="menu_bcm_incident_my" 
                  name="My Incidents" 
                  parent="menu_bcm_incidents" 
                  sequence="2"
                  action="action_bcm_incident_my"/>
        
        <!-- Critical Incidents -->
        <record id="action_bcm_incident_critical" model="ir.actions.act_window">
            <field name="name">Critical Incidents</field>
            <field name="res_model">bcm.incident</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="view_bcm_incident_search"/>
            <field name="context">{
                'search_default_critical': 1,
                'search_default_active': 1,
            }</field>
            <field name="domain">[('severity', '=', 'critical')]</field>
        </record>
        
        <menuitem id="menu_bcm_incident_critical" 
                  name="Critical Incidents" 
                  parent="menu_bcm_incidents" 
                  sequence="3"
                  action="action_bcm_incident_critical"/>
        
        <!-- Crisis Level Incidents -->
        <record id="action_bcm_incident_crisis" model="ir.actions.act_window">
            <field name="name">Crisis Level Incidents</field>
            <field name="res_model">bcm.incident</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="view_bcm_incident_search"/>
            <field name="context">{
                'search_default_crisis': 1,
                'search_default_active': 1,
            }</field>
            <field name="domain">[('crisis_level', 'in', ['3', '4', '5'])]</field>
        </record>
        
        <menuitem id="menu_bcm_incident_crisis" 
                  name="Crisis Level" 
                  parent="menu_bcm_incidents" 
                  sequence="4"
                  action="action_bcm_incident_crisis"/>
        
        <!-- AI Commander Menu Group -->
        <menuitem id="menu_bcm_ai_commander" 
                  name="AI Commander" 
                  parent="menu_bcm_incident_root" 
                  sequence="20"
                  groups="bcm_incident_unified.group_ai_analyst"/>
        
        <!-- AI Recommendations -->
        <record id="action_bcm_ai_recommendations" model="ir.actions.act_window">
            <field name="name">AI Recommendations</field>
            <field name="res_model">bcm.incident</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_bcm_incident_search"/>
            <field name="context">{
                'search_default_active': 1,
            }</field>
            <field name="domain">[('ai_recommendations', '!=', False)]</field>
        </record>
        
        <menuitem id="menu_bcm_ai_recommendations" 
                  name="AI Recommendations" 
                  parent="menu_bcm_ai_commander" 
                  sequence="1"
                  action="action_bcm_ai_recommendations"/>
        
        <!-- Escalation Predictions -->
        <record id="action_bcm_ai_escalation" model="ir.actions.act_window">
            <field name="name">Escalation Predictions</field>
            <field name="res_model">bcm.incident</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_bcm_incident_search"/>
            <field name="context">{
                'search_default_ai_escalation': 1,
                'search_default_active': 1,
            }</field>
            <field name="domain">[('ai_escalation_prediction', '=', True)]</field>
        </record>
        
        <menuitem id="menu_bcm_ai_escalation" 
                  name="Escalation Predictions" 
                  parent="menu_bcm_ai_commander" 
                  sequence="2"
                  action="action_bcm_ai_escalation"/>
        
        <!-- Response Teams Menu Group -->
        <menuitem id="menu_bcm_response_teams" 
                  name="Response Teams" 
                  parent="menu_bcm_incident_root" 
                  sequence="30"
                  groups="bcm_incident_unified.group_response_team_leader"/>
        
        <!-- Active Response Teams -->
        <record id="action_bcm_response_active" model="ir.actions.act_window">
            <field name="name">Active Response Teams</field>
            <field name="res_model">bcm.incident</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="view_bcm_incident_search"/>
            <field name="context">{
                'search_default_response_active': 1,
                'search_default_active': 1,
            }</field>
            <field name="domain">[('response_team_activated', '=', True)]</field>
        </record>
        
        <menuitem id="menu_bcm_response_active" 
                  name="Active Teams" 
                  parent="menu_bcm_response_teams" 
                  sequence="1"
                  action="action_bcm_response_active"/>
        
        <!-- Mobile Response Menu Group -->
        <menuitem id="menu_bcm_mobile_response" 
                  name="Mobile Response" 
                  parent="menu_bcm_incident_root" 
                  sequence="40"
                  groups="bcm_incident_unified.group_mobile_reporter"/>
        
        <!-- Field Updates -->
        <record id="action_bcm_field_updates" model="ir.actions.act_window">
            <field name="name">Field Updates</field>
            <field name="res_model">bcm.incident.field.update</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
        </record>
        
        <menuitem id="menu_bcm_field_updates" 
                  name="Field Updates" 
                  parent="menu_bcm_mobile_response" 
                  sequence="1"
                  action="action_bcm_field_updates"/>
        
        <!-- GPS Tracking -->
        <record id="action_bcm_gps_tracking" model="ir.actions.act_window">
            <field name="name">GPS Tracking</field>
            <field name="res_model">bcm.incident</field>
            <field name="view_mode">map,tree,form</field>
            <field name="search_view_id" ref="view_bcm_incident_search"/>
            <field name="context">{
                'search_default_active': 1,
            }</field>
            <field name="domain">[('gps_tracking_enabled', '=', True)]</field>
        </record>
        
        <menuitem id="menu_bcm_gps_tracking" 
                  name="GPS Tracking" 
                  parent="menu_bcm_mobile_response" 
                  sequence="2"
                  action="action_bcm_gps_tracking"/>
        
        <!-- Communication Menu Group -->
        <menuitem id="menu_bcm_communication" 
                  name="Communication" 
                  parent="menu_bcm_incident_root" 
                  sequence="50"/>
        
        <!-- Crisis Communications -->
        <record id="action_bcm_crisis_communication" model="ir.actions.act_window">
            <field name="name">Crisis Communications</field>
            <field name="res_model">bcm.crisis.communication.plan</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
        </record>
        
        <menuitem id="menu_bcm_crisis_communication" 
                  name="Crisis Communications" 
                  parent="menu_bcm_communication" 
                  sequence="1"
                  action="action_bcm_crisis_communication"/>
        
        <!-- Stakeholder Notifications -->
        <record id="action_bcm_stakeholder_notifications" model="ir.actions.act_window">
            <field name="name">Stakeholder Notifications</field>
            <field name="res_model">bcm.stakeholder.notification</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
        </record>
        
        <menuitem id="menu_bcm_stakeholder_notifications" 
                  name="Notifications" 
                  parent="menu_bcm_communication" 
                  sequence="2"
                  action="action_bcm_stakeholder_notifications"/>
        
        <!-- Analytics & Reporting Menu Group -->
        <menuitem id="menu_bcm_analytics" 
                  name="Analytics &amp; Reports" 
                  parent="menu_bcm_incident_root" 
                  sequence="60"/>
        
        <!-- Incident Analytics -->
        <record id="action_bcm_incident_analytics" model="ir.actions.act_window">
            <field name="name">Incident Analytics</field>
            <field name="res_model">bcm.incident</field>
            <field name="view_mode">pivot,graph,tree</field>
            <field name="search_view_id" ref="view_bcm_incident_search"/>
            <field name="context">{}</field>
        </record>
        
        <menuitem id="menu_bcm_incident_analytics" 
                  name="Incident Analytics" 
                  parent="menu_bcm_analytics" 
                  sequence="1"
                  action="action_bcm_incident_analytics"/>
        
        <!-- Performance Metrics -->
        <record id="action_bcm_performance_metrics" model="ir.actions.act_window">
            <field name="name">Performance Metrics</field>
            <field name="res_model">bcm.incident</field>
            <field name="view_mode">graph,pivot,tree</field>
            <field name="search_view_id" ref="view_bcm_incident_search"/>
            <field name="context">{
                'search_default_this_month': 1,
            }</field>
        </record>
        
        <menuitem id="menu_bcm_performance_metrics" 
                  name="Performance Metrics" 
                  parent="menu_bcm_analytics" 
                  sequence="2"
                  action="action_bcm_performance_metrics"/>
        
        <!-- Configuration Menu Group -->
        <menuitem id="menu_bcm_configuration" 
                  name="Configuration" 
                  parent="menu_bcm_incident_root" 
                  sequence="70"
                  groups="bcm_incident_unified.group_incident_manager"/>
        
        <!-- Incident Categories -->
        <record id="action_bcm_incident_categories" model="ir.actions.act_window">
            <field name="name">Incident Categories</field>
            <field name="res_model">bcm.incident.category</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
        </record>
        
        <menuitem id="menu_bcm_incident_categories" 
                  name="Categories" 
                  parent="menu_bcm_configuration" 
                  sequence="1"
                  action="action_bcm_incident_categories"/>
        
        <!-- AI Configuration -->
        <menuitem id="menu_bcm_ai_configuration" 
                  name="AI Configuration" 
                  parent="menu_bcm_configuration" 
                  sequence="2"
                  groups="bcm_incident_unified.group_ai_analyst"/>
        
        <!-- Integration Settings -->
        <menuitem id="menu_bcm_integrations" 
                  name="Integrations" 
                  parent="menu_bcm_configuration" 
                  sequence="3"
                  groups="bcm_incident_unified.group_api_integration"/>
        
    </data>
</odoo>