{
  "dashboard": {
    "id": null,
    "title": "BCM Platform - AI Orchestration Dashboard",
    "tags": ["bcm", "ai", "orchestration"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "AI Services Health Status",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"ai_orchestrator\"}",
            "legendFormat": "AI Orchestrator (8000)"
          },
          {
            "expr": "up{job=\"unified_ai\"}",
            "legendFormat": "Unified AI (8090)"
          },
          {
            "expr": "up{job=\"scenario_orchestrator\"}",
            "legendFormat": "Scenario Engine (8085)"
          },
          {
            "expr": "up{job=\"pdca_assistant\"}",
            "legendFormat": "PDCA Assistant (8010)"
          },
          {
            "expr": "up{job=\"mcp_server\"}",
            "legendFormat": "MCP Server (8087)"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "AI Request Volume (per minute)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(ai_requests_total[1m])",
            "legendFormat": "{{service}} requests/min"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "BCM Platform KPIs",
        "type": "stat",
        "targets": [
          {
            "expr": "bcm_bia_coverage_percentage",
            "legendFormat": "BIA Coverage %"
          },
          {
            "expr": "bcm_plans_up_to_date_percentage",
            "legendFormat": "Plans Up-to-Date %"
          },
          {
            "expr": "bcm_incidents_resolved_time_avg",
            "legendFormat": "Avg Resolution Time (hrs)"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 8
        }
      },
      {
        "id": 4,
        "title": "AI Model Performance",
        "type": "graph",
        "targets": [
          {
            "expr": "ai_model_response_time_seconds",
            "legendFormat": "{{model}} response time"
          },
          {
            "expr": "ai_model_accuracy_score",
            "legendFormat": "{{model}} accuracy"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 8
        }
      },
      {
        "id": 5,
        "title": "Recent AI Decisions",
        "type": "table",
        "targets": [
          {
            "expr": "ai_decisions_by_service",
            "format": "table"
          }
        ],
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 8
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}