# BCM API Gateway Configuration Example
# Copy this file to .env and update with your actual values

# ===========================================
# GATEWAY SETTINGS
# ===========================================
GATEWAY_PORT=8888
GATEWAY_HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=true

# ===========================================
# ODOO CONNECTION
# ===========================================
ODOO_URL=http://localhost:8069
ODOO_DB=bcm_db
ODOO_USER=admin
ODOO_PASSWORD=your_odoo_password_here

# ===========================================
# REDIS CACHE
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL=3600

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
JWT_SECRET_KEY=change-this-secret-key-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
API_KEY_HEADER=X-API-Key
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://localhost:5173"]

# ===========================================
# MICROSERVICES URLS
# ===========================================
# AI Services
AI_ORCHESTRATOR_URL=http://localhost:8000
AI_CONTROL_CENTER_URL=http://localhost:8200
UNIFIED_AI_SERVICE_URL=http://localhost:8090
PDCA_ASSISTANT_URL=http://localhost:8010

# Business Services
BIA_ENGINE_URL=http://localhost:8082
COMPLIANCE_CHECKER_URL=http://localhost:8084
DOCUMENT_PROCESSOR_URL=http://localhost:8083
SCENARIO_ORCHESTRATOR_URL=http://localhost:8085
EXERCISE_SIMULATORS_URL=http://localhost:8094

# Infrastructure Services
MODULE_VALIDATOR_URL=http://localhost:5001
NOTIFICATION_SERVICE_URL=http://localhost:8002
DEPLOYER_SERVICE_URL=http://localhost:8009
EVENTBUS_URL=http://localhost:8001
BCM_MCP_SERVER_URL=http://localhost:8087
GITHUB_APP_URL=http://localhost:8011

# Monitoring Services
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3003
GRAFANA_ADAPTER_URL=http://localhost:8008

# ===========================================
# DATABASE (for future use)
# ===========================================
DATABASE_URL=postgresql://bcm_user:bcm_password@localhost:5432/bcm_gateway
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=logs/gateway.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ===========================================
# MONITORING & METRICS
# ===========================================
METRICS_ENABLED=true
METRICS_PORT=9191
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready

# ===========================================
# FEATURE FLAGS
# ===========================================
ENABLE_CACHING=true
ENABLE_AUTHENTICATION=true
ENABLE_RATE_LIMITING=true
ENABLE_METRICS=true
ENABLE_SWAGGER_UI=true
ENABLE_ASYNC_PROCESSING=true

# ===========================================
# TIMEOUTS (in seconds)
# ===========================================
DEFAULT_TIMEOUT=30
ODOO_TIMEOUT=60
SERVICE_TIMEOUT=30
HEALTH_CHECK_TIMEOUT=5

# ===========================================
# RETRY CONFIGURATION
# ===========================================
MAX_RETRIES=3
RETRY_DELAY=1
RETRY_BACKOFF_FACTOR=2