<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- BCM Twin Data Package Views -->

    <!-- Tree View -->
    <record id="view_twin_data_package_tree" model="ir.ui.view">
        <field name="name">bcm.twin.data.package.tree</field>
        <field name="model">bcm.twin.data.package</field>
        <field name="arch" type="xml">
            <tree decoration-success="package_status=='extracted'"
                  decoration-warning="package_status=='compressed'"
                  decoration-danger="package_status=='error'"
                  decoration-info="package_status=='transported'">
                <field name="package_id"/>
                <field name="version"/>
                <field name="content_type"/>
                <field name="compression_type"/>
                <field name="size_original" widget="integer"/>
                <field name="size_compressed" widget="integer"/>
                <field name="compression_ratio" digits="[16,2]"/>
                <field name="compression_percentage" digits="[16,1]" widget="percentage"/>
                <field name="package_status" widget="badge"
                       decoration-success="package_status=='extracted'"
                       decoration-warning="package_status in ['compressed','validated']"
                       decoration-danger="package_status=='error'"
                       decoration-info="package_status=='transported'"/>
                <field name="validation_status" widget="badge"
                       decoration-success="validation_status=='valid'"
                       decoration-danger="validation_status in ['invalid','error']"/>
                <field name="created_by"/>
                <field name="created_date"/>
                <field name="source_twin_id"/>
                <field name="target_twin_id"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_twin_data_package_form" model="ir.ui.view">
        <field name="name">bcm.twin.data.package.form</field>
        <field name="model">bcm.twin.data.package</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compress_test_data"
                            string="Test Compression"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible': [('data_payload', '!=', False)]}"/>
                    <button name="action_validate_package"
                            string="Validate Package"
                            type="object"
                            class="btn-secondary"
                            attrs="{'invisible': [('data_payload', '=', False)]}"/>
                    <button name="action_optimize_transport"
                            string="Optimize Transport"
                            type="object"
                            class="btn-warning"
                            attrs="{'invisible': [('package_status', 'not in', ['compressed','validated'])]}"/>
                    <field name="package_status" widget="statusbar"
                           statusbar_visible="draft,compressed,validated,transported,extracted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_validate_package" icon="fa-shield">
                            <field name="validation_status" widget="statinfo" string="Validation"/>
                        </button>
                        <button class="oe_stat_button" type="object" icon="fa-compress">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="compression_ratio" digits="[16,2]"/>x
                                </span>
                                <span class="o_stat_text">Compression</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" type="object" icon="fa-save">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="compression_percentage" digits="[16,1]"/>%
                                </span>
                                <span class="o_stat_text">Space Saved</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" type="action"
                                name="bcm_digital_twin_core.action_twin_package_extract_wizard"
                                icon="fa-upload" context="{'default_package_id': active_id}"
                                attrs="{'invisible': [('package_status', 'not in', ['compressed','validated'])]}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Extract Package</span>
                            </div>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Error" bg_color="bg-danger"
                            attrs="{'invisible': [('package_status', '!=', 'error')]}"/>
                    <widget name="web_ribbon" title="Valid" bg_color="bg-success"
                            attrs="{'invisible': [('validation_status', '!=', 'valid')]}"/>

                    <div class="oe_title">
                        <h1>
                            <field name="package_id" readonly="1"/>
                        </h1>
                        <h3>
                            <field name="content_type" widget="badge"/>
                            <span class="mx-2">•</span>
                            <field name="compression_type" widget="badge"/>
                        </h3>
                    </div>

                    <group>
                        <group name="package_info" string="Package Information">
                            <field name="version"/>
                            <field name="content_type"/>
                            <field name="network_priority"/>
                            <field name="created_by" readonly="1"/>
                            <field name="created_date" readonly="1"/>
                        </group>
                        <group name="compression_config" string="Compression Configuration">
                            <field name="compression_type"/>
                            <field name="compression_level"
                                   attrs="{'invisible': [('compression_type', '=', 'none')]}"/>
                            <field name="chunk_size"/>
                        </group>
                    </group>

                    <group>
                        <group name="twin_relations" string="Digital Twin Relations">
                            <field name="source_twin_id"/>
                            <field name="target_twin_id"/>
                        </group>
                        <group name="size_metrics" string="Size Metrics">
                            <field name="size_original" widget="integer" readonly="1"/>
                            <field name="size_compressed" widget="integer" readonly="1"/>
                            <field name="compression_ratio" digits="[16,2]" readonly="1"/>
                            <field name="compression_percentage" digits="[16,1]" widget="percentage" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Data Payload" name="data_payload">
                            <group>
                                <field name="data_payload" widget="binary"
                                       attrs="{'readonly': [('package_status', 'in', ['extracted', 'transported'])]}"/>
                                <field name="data_hash" readonly="1"/>
                            </group>
                        </page>

                        <page string="Validation Schema" name="validation_schema">
                            <group>
                                <field name="schema_version"/>
                                <field name="validation_status" readonly="1"/>
                            </group>
                            <field name="validation_schema" widget="ace" options="{'mode': 'json'}"
                                   placeholder="Enter JSON schema for data validation"/>
                        </page>

                        <page string="Transport Metadata" name="transport_metadata">
                            <field name="transport_metadata" widget="ace" options="{'mode': 'json'}"
                                   readonly="1" placeholder="Transport optimization metadata (auto-generated)"/>
                        </page>

                        <page string="Error Information" name="error_info"
                              attrs="{'invisible': [('error_message', '=', False)]}">
                            <field name="error_message" readonly="1" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_twin_data_package_search" model="ir.ui.view">
        <field name="name">bcm.twin.data.package.search</field>
        <field name="model">bcm.twin.data.package</field>
        <field name="arch" type="xml">
            <search>
                <field name="package_id" string="Package ID"/>
                <field name="content_type"/>
                <field name="compression_type"/>
                <field name="source_twin_id"/>
                <field name="target_twin_id"/>
                <field name="created_by"/>

                <filter string="My Packages" name="my_packages"
                        domain="[('created_by', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="draft"
                        domain="[('package_status', '=', 'draft')]"/>
                <filter string="Compressed" name="compressed"
                        domain="[('package_status', '=', 'compressed')]"/>
                <filter string="Validated" name="validated"
                        domain="[('package_status', '=', 'validated')]"/>
                <filter string="Extracted" name="extracted"
                        domain="[('package_status', '=', 'extracted')]"/>
                <filter string="Error" name="error"
                        domain="[('package_status', '=', 'error')]"/>
                <separator/>
                <filter string="High Priority" name="high_priority"
                        domain="[('network_priority', '=', 'high')]"/>
                <filter string="Critical Priority" name="critical_priority"
                        domain="[('network_priority', '=', 'critical')]"/>
                <separator/>
                <filter string="Valid" name="valid"
                        domain="[('validation_status', '=', 'valid')]"/>
                <filter string="Invalid" name="invalid"
                        domain="[('validation_status', 'in', ['invalid', 'error'])]"/>

                <group expand="0" string="Group By">
                    <filter string="Content Type" name="group_content_type"
                            context="{'group_by': 'content_type'}"/>
                    <filter string="Compression Type" name="group_compression_type"
                            context="{'group_by': 'compression_type'}"/>
                    <filter string="Package Status" name="group_package_status"
                            context="{'group_by': 'package_status'}"/>
                    <filter string="Validation Status" name="group_validation_status"
                            context="{'group_by': 'validation_status'}"/>
                    <filter string="Network Priority" name="group_network_priority"
                            context="{'group_by': 'network_priority'}"/>
                    <filter string="Created By" name="group_created_by"
                            context="{'group_by': 'created_by'}"/>
                    <filter string="Creation Date" name="group_created_date"
                            context="{'group_by': 'created_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_twin_data_package_kanban" model="ir.ui.view">
        <field name="name">bcm.twin.data.package.kanban</field>
        <field name="model">bcm.twin.data.package</field>
        <field name="arch" type="xml">
            <kanban default_group_by="package_status" class="o_kanban_small_column">
                <field name="package_id"/>
                <field name="content_type"/>
                <field name="compression_type"/>
                <field name="package_status"/>
                <field name="validation_status"/>
                <field name="size_original"/>
                <field name="size_compressed"/>
                <field name="compression_ratio"/>
                <field name="compression_percentage"/>
                <field name="network_priority"/>
                <field name="created_by"/>
                <field name="created_date"/>
                <field name="source_twin_id"/>
                <field name="target_twin_id"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb-2">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="package_id"/>
                                        </strong>
                                        <small class="o_kanban_record_subtitle text-muted">
                                            <field name="content_type"/>
                                        </small>
                                    </div>
                                    <div class="o_kanban_manage_button_section">
                                        <a class="o_kanban_manage_toggle_button" href="#">
                                            <i class="fa fa-ellipsis-v" role="img" aria-label="Manage" title="Manage"/>
                                        </a>
                                    </div>
                                </div>

                                <div class="o_kanban_record_body">
                                    <div class="row">
                                        <div class="col-6">
                                            <span class="badge badge-pill badge-info">
                                                <field name="compression_type"/>
                                            </span>
                                        </div>
                                        <div class="col-6 text-right">
                                            <span t-if="record.compression_ratio.raw_value > 1"
                                                  class="badge badge-pill badge-success">
                                                <t t-esc="record.compression_ratio.value"/>x
                                            </span>
                                        </div>
                                    </div>

                                    <div class="row mt-1">
                                        <div class="col-12">
                                            <small class="text-muted">
                                                Size: <t t-esc="record.size_original.value"/> →
                                                <t t-esc="record.size_compressed.value"/> bytes
                                            </small>
                                        </div>
                                    </div>

                                    <div class="row mt-1">
                                        <div class="col-6">
                                            <span t-if="record.validation_status.raw_value == 'valid'"
                                                  class="badge badge-pill badge-success">Valid</span>
                                            <span t-if="record.validation_status.raw_value == 'invalid'"
                                                  class="badge badge-pill badge-danger">Invalid</span>
                                            <span t-if="record.validation_status.raw_value == 'pending'"
                                                  class="badge badge-pill badge-warning">Pending</span>
                                        </div>
                                        <div class="col-6 text-right">
                                            <span t-if="record.network_priority.raw_value == 'critical'"
                                                  class="badge badge-pill badge-danger">Critical</span>
                                            <span t-if="record.network_priority.raw_value == 'high'"
                                                  class="badge badge-pill badge-warning">High</span>
                                            <span t-if="record.network_priority.raw_value == 'normal'"
                                                  class="badge badge-pill badge-secondary">Normal</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <small class="text-muted">
                                            <field name="created_by"/>
                                        </small>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <small class="text-muted">
                                            <field name="created_date" widget="date"/>
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <div class="oe_kanban_manage_button_section">
                                <div class="o_kanban_manage_buttons">
                                    <button name="action_validate_package" type="object"
                                            class="btn btn-sm btn-secondary">Validate</button>
                                    <button name="action_optimize_transport" type="object"
                                            class="btn btn-sm btn-primary">Optimize</button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_twin_data_package" model="ir.actions.act_window">
        <field name="name">Data Packages</field>
        <field name="res_model">bcm.twin.data.package</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first digital twin data package!
            </p>
            <p>
                Data packages allow you to compress, validate, and transport
                digital twin data efficiently across your 70+ microservices architecture.
            </p>
        </field>
    </record>

    <!-- Graph View for Analytics -->
    <record id="view_twin_data_package_graph" model="ir.ui.view">
        <field name="name">bcm.twin.data.package.graph</field>
        <field name="model">bcm.twin.data.package</field>
        <field name="arch" type="xml">
            <graph string="Package Analytics" type="bar">
                <field name="compression_type" type="row"/>
                <field name="compression_ratio" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View for Analysis -->
    <record id="view_twin_data_package_pivot" model="ir.ui.view">
        <field name="name">bcm.twin.data.package.pivot</field>
        <field name="model">bcm.twin.data.package</field>
        <field name="arch" type="xml">
            <pivot string="Package Analysis">
                <field name="content_type" type="row"/>
                <field name="compression_type" type="col"/>
                <field name="size_original" type="measure"/>
                <field name="size_compressed" type="measure"/>
                <field name="compression_ratio" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Analytics Action -->
    <record id="action_twin_data_package_analytics" model="ir.actions.act_window">
        <field name="name">Package Analytics</field>
        <field name="res_model">bcm.twin.data.package</field>
        <field name="view_mode">graph,pivot</field>
        <field name="context">{'search_default_group_compression_type': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No package data to analyze yet!
            </p>
            <p>
                Create some data packages to see compression efficiency
                and performance analytics.
            </p>
        </field>
    </record>

</odoo>