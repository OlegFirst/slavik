<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Cron Jobs for Personal Digital Twin -->
        <record id="cron_sync_personal_twins" model="ir.cron">
            <field name="name">Sync Personal Digital Twins</field>
            <field name="model_id" ref="model_bcm_personal_digital_twin"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_all_twins()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="priority">5</field>
        </record>

        <record id="cron_analyze_patterns" model="ir.cron">
            <field name="name">Analyze Personal Twin Patterns</field>
            <field name="model_id" ref="model_bcm_personal_digital_twin"/>
            <field name="state">code</field>
            <field name="code">model.cron_analyze_patterns()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="priority">10</field>
        </record>

        <!-- Server Actions for Personal Digital Twin -->
        <record id="action_create_personal_twin" model="ir.actions.server">
            <field name="name">Create Personal Digital Twin</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="binding_model_id" ref="base.model_res_users"/>
            <field name="state">code</field>
            <field name="code">
for user in records:
    existing_twin = env['bcm.personal.digital.twin'].search([('user_id', '=', user.id)])
    if not existing_twin:
        env['bcm.personal.digital.twin'].create_for_user(user.id)
        </field>
        </record>

        <!-- System Parameters -->
        <record id="param_personal_twin_auto_create" model="ir.config_parameter">
            <field name="key">bcm.personal_twin.auto_create</field>
            <field name="value">True</field>
        </record>

        <record id="param_personal_twin_sync_interval" model="ir.config_parameter">
            <field name="key">bcm.personal_twin.sync_interval_hours</field>
            <field name="value">6</field>
        </record>

        <record id="param_personal_twin_pattern_analysis_frequency" model="ir.config_parameter">
            <field name="key">bcm.personal_twin.pattern_analysis_frequency_days</field>
            <field name="value">1</field>
        </record>

        <record id="param_personal_twin_data_retention_default" model="ir.config_parameter">
            <field name="key">bcm.personal_twin.data_retention_days_default</field>
            <field name="value">365</field>
        </record>

        <record id="param_personal_twin_privacy_strict_mode" model="ir.config_parameter">
            <field name="key">bcm.personal_twin.privacy_strict_mode</field>
            <field name="value">False</field>
        </record>

        <!-- Email Templates for Personal Digital Twin -->
        <record id="email_template_twin_welcome" model="mail.template">
            <field name="name">Personal Digital Twin: Welcome</field>
            <field name="model_id" ref="model_bcm_personal_digital_twin"/>
            <field name="subject">Welcome to Your Personal Digital Twin</field>
            <field name="email_from">${(object.company_id.email or user.email)|safe}</field>
            <field name="email_to">${object.user_id.email|safe}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear ${object.user_id.name},</p>
                    <p>Welcome to your Personal Digital Twin on the BCM platform!</p>
                    <p>Your digital twin has been created and is ready to provide personalized insights based on your activities and preferences.</p>

                    <h3>What can your Personal Digital Twin do?</h3>
                    <ul>
                        <li>Track your activity patterns and engagement</li>
                        <li>Provide personalized recommendations</li>
                        <li>Analyze your workspace usage</li>
                        <li>Offer insights to improve your BCM experience</li>
                    </ul>

                    <p>You can access your digital twin dashboard at any time through the BCM platform.</p>
                    <p>Your privacy is important to us. You can review and update your privacy settings at any time.</p>

                    <p>Best regards,<br/>BCM Platform Team</p>
                </div>
            </field>
        </record>

        <record id="email_template_twin_insights_report" model="mail.template">
            <field name="name">Personal Digital Twin: Insights Report</field>
            <field name="model_id" ref="model_bcm_personal_digital_twin"/>
            <field name="subject">Your Personal BCM Insights Report</field>
            <field name="email_from">${(object.company_id.email or user.email)|safe}</field>
            <field name="email_to">${object.user_id.email|safe}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear ${object.user_id.name},</p>
                    <p>Here's your latest Personal Digital Twin insights report:</p>

                    <h3>Activity Summary</h3>
                    <ul>
                        <li>Twin Health Score: ${object.twin_health_score}%</li>
                        <li>Activity Score: ${object.activity_score}%</li>
                        <li>Total Sessions: ${object.total_sessions}</li>
                        <li>Average Session Duration: ${object.avg_session_duration} hours</li>
                    </ul>

                    % if object.activity_patterns:
                    <h3>Latest Insights</h3>
                    <p>Your digital twin has identified patterns in your platform usage and generated personalized recommendations for you.</p>
                    % endif

                    <p>Visit your personal dashboard to view detailed insights and recommendations.</p>

                    <p>Best regards,<br/>BCM Platform Team</p>
                </div>
            </field>
        </record>
    </data>
</odoo>