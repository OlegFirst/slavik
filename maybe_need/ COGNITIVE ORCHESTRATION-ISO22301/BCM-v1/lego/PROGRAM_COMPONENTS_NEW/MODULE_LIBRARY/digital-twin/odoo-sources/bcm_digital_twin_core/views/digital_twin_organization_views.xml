<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_digital_twin_organization_tree" model="ir.ui.view">
        <field name="name">bcm.digital.twin.organization.tree</field>
        <field name="model">bcm.digital.twin.organization</field>
        <field name="arch" type="xml">
            <list string="Digital Twin Organizations" decoration-success="twin_status=='active'"
                  decoration-warning="twin_status=='configuring'"
                  decoration-danger="twin_status=='error'">
                <field name="name"/>
                <field name="domain_type"/>
                <field name="industry_sector" optional="show"/>
                <field name="bcm_client_id"/>
                <field name="twin_status" widget="badge"/>
                <field name="twin_health_score" widget="progressbar"/>
                <field name="simulation_count"/>
                <field name="last_analysis_date" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_digital_twin_organization_form" model="ir.ui.view">
        <field name="name">bcm.digital.twin.organization.form</field>
        <field name="model">bcm.digital.twin.organization</field>
        <field name="arch" type="xml">
            <form string="Digital Twin Organization">
                <header>
                    <button name="action_create_digital_twin" type="object"
                            string="Create Digital Twin" class="oe_highlight"
                            invisible="twin_status not in ['draft', 'error']"/>
                    <button name="action_sync_with_bcm" type="object"
                            string="Sync with BCM"
                            invisible="twin_status not in ['active', 'simulation', 'analysis']"/>
                    <button name="action_run_ai_analysis" type="object"
                            string="Run AI Analysis" class="oe_highlight"
                            invisible="twin_status != 'active'"/>
                    <button name="action_view_simulations" type="object"
                            string="View Simulations"/>
                    <field name="twin_status" widget="statusbar"
                           statusbar_visible="draft,configuring,active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_simulations" icon="fa-cogs">
                            <field string="Simulations" name="simulation_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="action"
                                name="bcm_digital_twin_core.action_twin_package_wizard"
                                icon="fa-archive" context="{'default_twin_id': active_id}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Create Package</span>
                            </div>
                        </button>
                        <div class="oe_stat_button">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="twin_health_score" widget="percentage"/>
                                </span>
                                <span class="o_stat_text">Health Score</span>
                            </div>
                        </div>
                    </div>
                    <widget name="web_ribbon" title="Active"
                            invisible="twin_status != 'active'"/>
                    <widget name="web_ribbon" title="Error" bg_color="bg-danger"
                            invisible="twin_status != 'error'"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Organization Name"/>
                        </h1>
                        <h3>
                            <field name="domain_type" widget="badge"/>
                            <field name="industry_sector" widget="badge"
                                   invisible="not industry_sector"/>
                        </h3>
                    </div>

                    <group>
                        <group string="Organization Details">
                            <field name="description" widget="text"
                                   placeholder="Describe the organization..."/>
                            <field name="bcm_client_id"
                                   options="{'no_create': True}"/>
                            <field name="bcm_context_id"
                                   options="{'no_create': True}"
/>
                        </group>
                        <group string="Configuration">
                            <field name="auto_sync_bcm"/>
                            <field name="enable_ai_analysis"/>
                            <field name="enable_predictions"/>
                            <field name="last_analysis_date" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Configuration" name="config">
                            <group string="Twin Configuration">
                                <field name="twin_config" widget="ace"
                                       options="{'mode': 'json'}"
                                       placeholder='{"key": "value"}'/>
                            </group>
                        </page>

                        <page string="Simulation Results" name="results">
                            <group string="Latest Results">
                                <field name="simulation_results" widget="ace"
                                       options="{'mode': 'json'}" readonly="1"/>
                            </group>
                        </page>

                        <page string="AI Insights" name="insights">
                            <group string="AI Generated Insights">
                                <field name="ai_insights" widget="ace"
                                       options="{'mode': 'json'}" readonly="1"/>
                            </group>
                            <group string="Prediction Models">
                                <field name="prediction_models" widget="ace"
                                       options="{'mode': 'json'}"/>
                            </group>
                        </page>

                        <page string="Simulations" name="simulations">
                            <field name="simulation_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="scenario_type"/>
                                    <field name="state" widget="badge"/>
                                    <field name="execution_time"/>
                                    <field name="confidence_score" widget="progressbar"/>
                                    <field name="completion_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_digital_twin_organization_search" model="ir.ui.view">
        <field name="name">bcm.digital.twin.organization.search</field>
        <field name="model">bcm.digital.twin.organization</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="bcm_client_id"/>
                <field name="domain_type"/>
                <field name="industry_sector"/>

                <filter string="Active" name="active"
                        domain="[('twin_status', '=', 'active')]"/>
                <filter string="Error" name="error"
                        domain="[('twin_status', '=', 'error')]"/>

                <separator/>

                <filter string="Corporate" name="corporate"
                        domain="[('domain_type', '=', 'corporate')]"/>
                <filter string="Government" name="government"
                        domain="[('domain_type', '=', 'government')]"/>
                <filter string="NPO" name="npo"
                        domain="[('domain_type', '=', 'npo')]"/>
                <filter string="Infrastructure" name="infrastructure"
                        domain="[('domain_type', '=', 'infrastructure')]"/>

                <separator/>

                <filter string="AI Enabled" name="ai_enabled"
                        domain="[('enable_ai_analysis', '=', True)]"/>

                <group expand="0" string="Group By">
                    <filter string="Domain Type" name="group_domain"
                            context="{'group_by': 'domain_type'}"/>
                    <filter string="Industry" name="group_industry"
                            context="{'group_by': 'industry_sector'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'twin_status'}"/>
                    <filter string="BCM Client" name="group_client"
                            context="{'group_by': 'bcm_client_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_digital_twin_organization_kanban" model="ir.ui.view">
        <field name="name">bcm.digital.twin.organization.kanban</field>
        <field name="model">bcm.digital.twin.organization</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="domain_type">
                <field name="name"/>
                <field name="domain_type"/>
                <field name="twin_status"/>
                <field name="twin_health_score"/>
                <field name="simulation_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted o_kanban_record_subtitle">
                                    <field name="bcm_client_id"/>
                                </div>
                                <div class="o_kanban_tags_section">
                                    <field name="twin_status" widget="label_selection"
                                           options="{'classes': {'active': 'success', 'error': 'danger'}}"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="twin_health_score" widget="progressbar"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span class="badge badge-pill">
                                            <i class="fa fa-cogs" title="Simulations"/> <field name="simulation_count"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_digital_twin_organization" model="ir.actions.act_window">
        <field name="name">Digital Twin Organizations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">bcm.digital.twin.organization</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Digital Twin Organization
            </p>
            <p>
                Digital Twins provide comprehensive modeling and simulation capabilities
                for organizations across different domains.
            </p>
        </field>
    </record>

    <!-- Domain-specific Actions -->
    <record id="action_digital_twin_organization_corporate" model="ir.actions.act_window">
        <field name="name">Corporate Organizations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">bcm.digital.twin.organization</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('domain_type', '=', 'corporate')]</field>
        <field name="context">{'default_domain_type': 'corporate'}</field>
    </record>

    <record id="action_digital_twin_organization_government" model="ir.actions.act_window">
        <field name="name">Government Organizations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">bcm.digital.twin.organization</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('domain_type', '=', 'government')]</field>
        <field name="context">{'default_domain_type': 'government'}</field>
    </record>

    <record id="action_digital_twin_organization_npo" model="ir.actions.act_window">
        <field name="name">NPO Organizations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">bcm.digital.twin.organization</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('domain_type', '=', 'npo')]</field>
        <field name="context">{'default_domain_type': 'npo'}</field>
    </record>

    <record id="action_digital_twin_organization_infrastructure" model="ir.actions.act_window">
        <field name="name">Infrastructure Organizations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">bcm.digital.twin.organization</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('domain_type', '=', 'infrastructure')]</field>
        <field name="context">{'default_domain_type': 'infrastructure'}</field>
    </record>
</odoo>