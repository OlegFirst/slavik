<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
        <!-- Sequence for Digital Twin Organizations -->
        <record id="sequence_bcm_digital_twin_organization" model="ir.sequence">
            <field name="name">BCM Digital Twin Organization</field>
            <field name="code">bcm.digital.twin.organization</field>
            <field name="prefix">BCMDT/ORG/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Simulations -->
        <record id="sequence_bcm_digital_twin_simulation" model="ir.sequence">
            <field name="name">BCM Digital Twin Simulation</field>
            <field name="code">bcm.digital.twin.simulation</field>
            <field name="prefix">BCMDT/SIM/</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for AI Analysis -->
        <record id="sequence_bcm_ai_twin_orchestrator" model="ir.sequence">
            <field name="name">BCM AI Twin Orchestrator</field>
            <field name="code">bcm.ai.twin.orchestrator</field>
            <field name="prefix">BCMDT/AI/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
</odoo>