<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="Defs_BIA_Sub"
             targetNamespace="http://example.org/bcm-bpmn-sub">
  <process id="BIA_Subprocess" name="BIA — Subprocess" isExecutable="false">
    <startEvent id="Start_BIA" name="BIA Start"/>
    <task id="Task_CollectSurvey" name="Collect BIA Survey (Dept)"/>
    <task id="Task_ComputeBIA" name="Compute (Ciw)"/>
    <endEvent id="End_BIA" name="BIA Done"/>
    <sequenceFlow id="F1" sourceRef="Start_BIA" targetRef="Task_CollectSurvey"/>
    <sequenceFlow id="F2" sourceRef="Task_CollectSurvey" targetRef="Task_ComputeBIA"/>
    <sequenceFlow id="F3" sourceRef="Task_ComputeBIA" targetRef="End_BIA"/>
  </process>
  <bpmndi:BPMNDiagram id="Dia_BIA">
    <bpmndi:BPMNPlane id="Plane_BIA" bpmnElement="BIA_Subprocess">
      <bpmndi:BPMNShape id="SH_SBStart" bpmnElement="Start_BIA"><dc:Bounds x="120" y="80" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_SBCollect" bpmnElement="Task_CollectSurvey"><dc:Bounds x="190" y="70" width="200" height="56"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_SBCompute" bpmnElement="Task_ComputeBIA"><dc:Bounds x="410" y="70" width="200" height="56"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_SBEnd" bpmnElement="End_BIA"><dc:Bounds x="630" y="80" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ED_SBF1" bpmnElement="F1"><di:waypoint x="156" y="98"/><di:waypoint x="190" y="98"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_SBF2" bpmnElement="F2"><di:waypoint x="390" y="98"/><di:waypoint x="410" y="98"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_SBF3" bpmnElement="F3"><di:waypoint x="610" y="98"/><di:waypoint x="630" y="98"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
