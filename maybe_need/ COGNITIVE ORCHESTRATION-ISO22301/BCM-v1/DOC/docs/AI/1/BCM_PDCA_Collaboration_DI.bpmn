<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             id="Defs_BCM_Collab_DI"
             targetNamespace="http://example.org/bcm-bpmn-collab-di">

  <collaboration id="Collab_BCM_PDCA">
    <participant id="Pool_ClientOrg" name="Client Organization" processRef="Proc_ClientOrg"/>
    <participant id="Pool_Auditor" name="Auditor / QA" processRef="Proc_Auditor"/>
    <participant id="Pool_Governance" name="Governance" processRef="Proc_Governance"/>
    <participant id="Pool_Orchestrator" name="AI Orchestrator" processRef="Proc_Orchestrator"/>
    <participant id="Pool_External" name="External Systems" processRef="Proc_External"/>

    <messageFlow id="MF1" name="bcm.context.updated" sourceRef="Task_ImportContext" targetRef="Evt_FromClient_ContextUpd"/>
    <messageFlow id="MF2" name="bcm.bia.completed" sourceRef="Task_ComputeBIA" targetRef="Evt_FromClient_BIACompleted"/>
    <messageFlow id="MF3" name="Draft BCP" sourceRef="Task_GenBCPDraft" targetRef="Task_ReviewApproveBCP"/>
    <messageFlow id="MF4" name="Incident (case_id)" sourceRef="Task_TheHiveIncident" targetRef="Evt_IncidentOpened"/>
    <messageFlow id="MF5" name="Response Draft" sourceRef="Task_SuggestIncidentResponse" targetRef="Task_ExecuteResponse"/>
    <messageFlow id="MF6" name="Simulation Metrics" sourceRef="Task_RunSimulation" targetRef="Task_CaptureLessons"/>
    <messageFlow id="MF7" name="Evidence Upload" sourceRef="Task_PortalEvidence" targetRef="Task_CollectEvidence"/>
    <messageFlow id="MF8" name="Evidence Summary" sourceRef="Task_SummarizeEvidence" targetRef="Task_PublishAuditReport"/>
    <messageFlow id="MF9" name="KPI Push" sourceRef="Task_UpdateKPI" targetRef="Task_GrafanaIngest"/>
  </collaboration>

  <!-- Processes (same as previous, compact) -->
  <process id="Proc_ClientOrg" name="Client Organization" isExecutable="false">
    <laneSet id="LaneSet_Client">
      <lane id="Lane_ClientAdmin" name="ClientAdmin">
        <flowNodeRef>Start_Onboarding</flowNodeRef>
        <flowNodeRef>Task_CreateClientPortal</flowNodeRef>
        <flowNodeRef>Task_ImportContext</flowNodeRef>
      </lane>
      <lane id="Lane_BCM" name="BCM Manager">
        <flowNodeRef>Sub_BIA</flowNodeRef>
        <flowNodeRef>Task_ReviewApproveBCP</flowNodeRef>
        <flowNodeRef>Evt_IncidentOpened</flowNodeRef>
        <flowNodeRef>Task_ExecuteResponse</flowNodeRef>
        <flowNodeRef>Task_ScheduleExercise</flowNodeRef>
        <flowNodeRef>Task_CaptureLessons</flowNodeRef>
      </lane>
      <lane id="Lane_Dept" name="Department Lead">
        <flowNodeRef>Task_CompleteTraining</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start_Onboarding" name="Client Onboarding"/>
    <task id="Task_CreateClientPortal" name="Create Client & Portal (SSO)"/>
    <task id="Task_ImportContext" name="Import Processes & Assets (ETL)"/>
    <subProcess id="Sub_BIA" name="BIA Subprocess">
      <startEvent id="Evt_BIA_Start" name="BIA Start"/>
      <task id="Task_CollectSurvey" name="Collect BIA Survey (Dept)"/>
      <task id="Task_ComputeBIA" name="Compute (Ciw)"/>
      <endEvent id="Evt_BIA_End" name="BIA Done"/>
      <sequenceFlow id="SB1" sourceRef="Evt_BIA_Start" targetRef="Task_CollectSurvey"/>
      <sequenceFlow id="SB2" sourceRef="Task_CollectSurvey" targetRef="Task_ComputeBIA"/>
      <sequenceFlow id="SB3" sourceRef="Task_ComputeBIA" targetRef="Evt_BIA_End"/>
    </subProcess>
    <task id="Task_ReviewApproveBCP" name="Review & Approve BCP (Draft)"/>
    <intermediateCatchEvent id="Evt_IncidentOpened" name="Incident Opened"><messageEventDefinition/></intermediateCatchEvent>
    <task id="Task_ExecuteResponse" name="Execute Response & Comms"/>
    <task id="Task_ScheduleExercise" name="Schedule Exercise (Scenario Hub)"/>
    <task id="Task_CaptureLessons" name="Capture Metrics & Lessons → CAPA"/>
    <task id="Task_CompleteTraining" name="Complete Training (LMS)"/>
    <sequenceFlow id="F1" sourceRef="Start_Onboarding" targetRef="Task_CreateClientPortal"/>
    <sequenceFlow id="F2" sourceRef="Task_CreateClientPortal" targetRef="Task_ImportContext"/>
    <sequenceFlow id="F3" sourceRef="Task_ImportContext" targetRef="Sub_BIA"/>
    <sequenceFlow id="F4" sourceRef="Sub_BIA" targetRef="Task_ReviewApproveBCP"/>
    <sequenceFlow id="F5" sourceRef="Task_ReviewApproveBCP" targetRef="Task_CompleteTraining"/>
    <sequenceFlow id="F6" sourceRef="Task_CompleteTraining" targetRef="Evt_IncidentOpened"/>
    <sequenceFlow id="F7" sourceRef="Evt_IncidentOpened" targetRef="Task_ExecuteResponse"/>
    <sequenceFlow id="F8" sourceRef="Task_ExecuteResponse" targetRef="Task_ScheduleExercise"/>
    <sequenceFlow id="F9" sourceRef="Task_ScheduleExercise" targetRef="Task_CaptureLessons"/>
  </process>

  <process id="Proc_Auditor" name="Auditor / QA" isExecutable="false">
    <laneSet id="LaneSet_Aud">
      <lane id="Lane_Auditor" name="Auditor">
        <flowNodeRef>Task_CollectEvidence</flowNodeRef>
        <flowNodeRef>Sub_Audit</flowNodeRef>
        <flowNodeRef>Task_PublishAuditReport</flowNodeRef>
      </lane>
    </laneSet>
    <task id="Task_CollectEvidence" name="Collect Evidence"/>
    <subProcess id="Sub_Audit" name="Audit Subprocess">
      <startEvent id="Evt_Audit_Start" name="Audit Start"/>
      <task id="Task_RunISOChecklist" name="Run ISO 22301 Checklist"/>
      <task id="Task_SummarizeEvidence" name="Summarize Evidence (AI)"/>
      <endEvent id="Evt_Audit_End" name="Audit Done"/>
      <sequenceFlow id="SA1" sourceRef="Evt_Audit_Start" targetRef="Task_RunISOChecklist"/>
      <sequenceFlow id="SA2" sourceRef="Task_RunISOChecklist" targetRef="Task_SummarizeEvidence"/>
      <sequenceFlow id="SA3" sourceRef="Task_SummarizeEvidence" targetRef="Evt_Audit_End"/>
    </subProcess>
    <task id="Task_PublishAuditReport" name="Publish Audit Report & CAPA"/>
  </process>

  <process id="Proc_Governance" name="Governance" isExecutable="false">
    <laneSet id="LaneSet_Gov">
      <lane id="Lane_Leadership" name="Leadership">
        <flowNodeRef>Task_UpdateKPI</flowNodeRef>
        <flowNodeRef>Task_ManagementReview</flowNodeRef>
        <flowNodeRef>Gateway_Improvements</flowNodeRef>
        <flowNodeRef>End_PDCA</flowNodeRef>
      </lane>
    </laneSet>
    <task id="Task_UpdateKPI" name="Update KPI Dashboards (Prom/Grafana)"/>
    <task id="Task_ManagementReview" name="Management Review (PDCA)"/>
    <exclusiveGateway id="Gateway_Improvements" name="Improvements Needed?"/>
    <endEvent id="End_PDCA" name="Cycle Continues"/>
    <sequenceFlow id="G1" sourceRef="Task_UpdateKPI" targetRef="Task_ManagementReview"/>
    <sequenceFlow id="G2" sourceRef="Task_ManagementReview" targetRef="Gateway_Improvements"/>
  </process>

  <process id="Proc_Orchestrator" name="AI Orchestrator" isExecutable="false">
    <laneSet id="LaneSet_AI">
      <lane id="Lane_AI" name="Orchestrator">
        <flowNodeRef>Evt_FromClient_ContextUpd</flowNodeRef>
        <flowNodeRef>Task_GenBCPDraft</flowNodeRef>
        <flowNodeRef>Evt_FromClient_BIACompleted</flowNodeRef>
        <flowNodeRef>Task_SuggestIncidentResponse</flowNodeRef>
      </lane>
    </laneSet>
    <intermediateCatchEvent id="Evt_FromClient_ContextUpd" name="from: context.updated"><messageEventDefinition/></intermediateCatchEvent>
    <task id="Task_GenBCPDraft" name="Generate BCP Draft (LLM)"/>
    <intermediateCatchEvent id="Evt_FromClient_BIACompleted" name="from: bia.completed"><messageEventDefinition/></intermediateCatchEvent>
    <task id="Task_SuggestIncidentResponse" name="Suggest Incident Response (LLM)"/>
    <sequenceFlow id="AI1" sourceRef="Evt_FromClient_ContextUpd" targetRef="Task_GenBCPDraft"/>
    <sequenceFlow id="AI2" sourceRef="Evt_FromClient_BIACompleted" targetRef="Task_GenBCPDraft"/>
  </process>

  <process id="Proc_External" name="External Systems" isExecutable="false">
    <laneSet id="LaneSet_Ext">
      <lane id="Lane_ITOps" name="IT/Ops (ETL)">
        <flowNodeRef>Task_PortalEvidence</flowNodeRef>
      </lane>
      <lane id="Lane_TheHive" name="TheHive">
        <flowNodeRef>Task_TheHiveIncident</flowNodeRef>
      </lane>
      <lane id="Lane_Sim" name="Simulation">
        <flowNodeRef>Task_RunSimulation</flowNodeRef>
      </lane>
      <lane id="Lane_LMS" name="LMS">
        <flowNodeRef>Task_LMSAssign</flowNodeRef>
      </lane>
      <lane id="Lane_Grafana" name="Grafana/Prometheus">
        <flowNodeRef>Task_GrafanaIngest</flowNodeRef>
      </lane>
    </laneSet>
    <task id="Task_TheHiveIncident" name="Create/Update Incident (case_id)"/>
    <task id="Task_RunSimulation" name="Run Scenario Simulation"/>
    <task id="Task_PortalEvidence" name="Portal: Upload Evidence"/>
    <task id="Task_LMSAssign" name="Assign Courses"/>
    <task id="Task_GrafanaIngest" name="Ingest KPI Samples"/>
  </process>

  <!-- Simple DI layout -->
  <bpmndi:BPMNDiagram id="Diagram_BCM">
    <bpmndi:BPMNPlane id="Plane_BCM" bpmnElement="Collab_BCM_PDCA">
      <!-- Participants frames -->
      <bpmndi:BPMNShape id="SH_Pool_ClientOrg" bpmnElement="Pool_ClientOrg">
        <dc:Bounds x="100" y="80" width="1400" height="340"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_Pool_Auditor" bpmnElement="Pool_Auditor">
        <dc:Bounds x="100" y="440" width="1400" height="200"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_Pool_Governance" bpmnElement="Pool_Governance">
        <dc:Bounds x="100" y="650" width="1400" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_Pool_Orchestrator" bpmnElement="Pool_Orchestrator">
        <dc:Bounds x="100" y="840" width="1400" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_Pool_External" bpmnElement="Pool_External">
        <dc:Bounds x="100" y="1010" width="1400" height="220"/>
      </bpmndi:BPMNShape>

      <!-- A few node shapes inside (minimal just to render) -->
      <bpmndi:BPMNShape id="SH_Start" bpmnElement="Start_Onboarding">
        <dc:Bounds x="150" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_CreatePortal" bpmnElement="Task_CreateClientPortal">
        <dc:Bounds x="220" y="110" width="160" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_Import" bpmnElement="Task_ImportContext">
        <dc:Bounds x="410" y="110" width="220" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_SubBIA" bpmnElement="Sub_BIA">
        <dc:Bounds x="660" y="100" width="260" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_ReviewBCP" bpmnElement="Task_ReviewApproveBCP">
        <dc:Bounds x="940" y="110" width="200" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_CompleteTraining" bpmnElement="Task_CompleteTraining">
        <dc:Bounds x="1170" y="190" width="200" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_Incident" bpmnElement="Evt_IncidentOpened">
        <dc:Bounds x="1170" y="110" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_Response" bpmnElement="Task_ExecuteResponse">
        <dc:Bounds x="1240" y="110" width="220" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_ScheduleEx" bpmnElement="Task_ScheduleExercise">
        <dc:Bounds x="990" y="190" width="160" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_Lessons" bpmnElement="Task_CaptureLessons">
        <dc:Bounds x="1170" y="270" width="220" height="56"/>
      </bpmndi:BPMNShape>

      <!-- Minimal Orchestrator nodes -->
      <bpmndi:BPMNShape id="SH_AIEventCtx" bpmnElement="Evt_FromClient_ContextUpd">
        <dc:Bounds x="220" y="880" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_AIGenBCP" bpmnElement="Task_GenBCPDraft">
        <dc:Bounds x="280" y="870" width="200" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_AIEventBIA" bpmnElement="Evt_FromClient_BIACompleted">
        <dc:Bounds x="520" y="880" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_AISuggest" bpmnElement="Task_SuggestIncidentResponse">
        <dc:Bounds x="580" y="870" width="240" height="56"/>
      </bpmndi:BPMNShape>

      <!-- External nodes -->
      <bpmndi:BPMNShape id="SH_TheHive" bpmnElement="Task_TheHiveIncident">
        <dc:Bounds x="220" y="1060" width="220" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_Sim" bpmnElement="Task_RunSimulation">
        <dc:Bounds x="470" y="1060" width="220" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_PortalEvidence" bpmnElement="Task_PortalEvidence">
        <dc:Bounds x="720" y="1060" width="220" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_LMSAssign" bpmnElement="Task_LMSAssign">
        <dc:Bounds x="970" y="1060" width="220" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SH_GrafanaIngest" bpmnElement="Task_GrafanaIngest">
        <dc:Bounds x="1220" y="1060" width="220" height="56"/>
      </bpmndi:BPMNShape>

      <!-- Message connectors (just a few to render lines) -->
      <bpmndi:BPMNEdge id="ED_MF1" bpmnElement="MF1">
        <di:waypoint x="620" y="138"/><di:waypoint x="238" y="898"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_MF2" bpmnElement="MF2">
        <di:waypoint x="780" y="138"/><di:waypoint x="538" y="898"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_MF3" bpmnElement="MF3">
        <di:waypoint x="380" y="898"/><di:waypoint x="1040" y="138"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_MF4" bpmnElement="MF4">
        <di:waypoint x="330" y="1088"/><di:waypoint x="1188" y="128"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_MF5" bpmnElement="MF5">
        <di:waypoint x="700" y="898"/><di:waypoint x="1350" y="138"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_MF6" bpmnElement="MF6">
        <di:waypoint x="580" y="1088"/><di:waypoint x="1280" y="298"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_MF7" bpmnElement="MF7">
        <di:waypoint x="830" y="1088"/><di:waypoint x="400" y="520"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_MF8" bpmnElement="MF8">
        <di:waypoint x="700" y="898"/><di:waypoint x="380" y="520"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ED_MF9" bpmnElement="MF9">
        <di:waypoint x="1310" y="1090"/><di:waypoint x="1340" y="720"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
