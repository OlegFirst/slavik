FROM odoo:18.0

USER root

# Install Python dependencies for BCM modules
RUN pip3 install --break-system-packages --ignore-installed \
    numpy pandas scikit-learn matplotlib scipy \
    PyJWT python-jose cryptography jwt \
    redis python-dotenv httpx pydantic fastapi

# Copy only BCM modules
COPY ./core/odoo-18.0/addons/bcm_* /mnt/extra-addons/

USER odoo

EXPOSE 8069

CMD ["odoo"]