# BCM Community Forum Analytics Service
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    ANALYTICS_PORT=8007

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create application directory
WORKDIR /app

# Create non-root user
RUN groupadd -r analyticsuser && useradd -r -g analyticsuser analyticsuser

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Additional analytics dependencies
RUN pip install --no-cache-dir \
    pandas==2.1.3 \
    matplotlib==3.8.2 \
    seaborn==0.13.0 \
    plotly==5.17.0 \
    numpy==1.25.2

# Copy application code
COPY analytics/ ./analytics/
COPY forum_service.py .
COPY config/ ./config/

# Create necessary directories
RUN mkdir -p data logs && \
    chown -R analyticsuser:analyticsuser /app

# Switch to non-root user
USER analyticsuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${ANALYTICS_PORT}/health || exit 1

# Expose port
EXPOSE ${ANALYTICS_PORT}

# Start analytics service
CMD ["python", "-m", "analytics.analytics_service"]
