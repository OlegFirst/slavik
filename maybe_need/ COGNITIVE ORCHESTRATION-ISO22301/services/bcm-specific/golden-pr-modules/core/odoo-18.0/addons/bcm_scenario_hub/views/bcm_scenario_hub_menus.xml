<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Main Menu -->
        <menuitem id="menu_bcm_scenario_hub_root" 
                  name="Scenario Hub" 
                  sequence="30"
                  web_icon="bcm_scenario_hub,static/description/icon.png"
                  groups="bcm_scenario_hub.group_scenario_user"/>

        <!-- Scenarios Section -->
        <menuitem id="menu_bcm_scenario_hub_scenarios" 
                  name="Scenarios" 
                  parent="menu_bcm_scenario_hub_root" 
                  sequence="10"/>

        <menuitem id="menu_bcm_scenario_catalog" 
                  name="📚 Scenario Catalog" 
                  parent="menu_bcm_scenario_hub_scenarios" 
                  action="action_bcm_scenario" 
                  sequence="10"/>

        <menuitem id="menu_bcm_scenario_my_scenarios" 
                  name="✍️ My Scenarios" 
                  parent="menu_bcm_scenario_hub_scenarios" 
                  action="action_bcm_scenario_my" 
                  sequence="20"/>

        <!-- Moderation Section -->
        <menuitem id="menu_bcm_scenario_hub_moderation" 
                  name="Moderation" 
                  parent="menu_bcm_scenario_hub_root" 
                  sequence="20"
                  groups="bcm_scenario_hub.group_scenario_reviewer"/>

        <menuitem id="menu_bcm_scenario_moderation" 
                  name="🔍 Scenario Moderation" 
                  parent="menu_bcm_scenario_hub_moderation" 
                  action="action_bcm_scenario_moderation" 
                  sequence="10"/>

        <menuitem id="menu_bcm_scenario_reviews" 
                  name="📝 Reviews" 
                  parent="menu_bcm_scenario_hub_moderation" 
                  action="action_bcm_scenario_review" 
                  sequence="20"/>

        <menuitem id="menu_bcm_scenario_pending_reviews" 
                  name="⏳ Pending Reviews" 
                  parent="menu_bcm_scenario_hub_moderation" 
                  action="action_bcm_scenario_review_pending" 
                  sequence="30"/>

        <!-- Management Section -->
        <menuitem id="menu_bcm_scenario_hub_management" 
                  name="Management" 
                  parent="menu_bcm_scenario_hub_root" 
                  sequence="30"
                  groups="bcm_scenario_hub.group_scenario_admin"/>

        <menuitem id="menu_bcm_domains" 
                  name="🏢 Business Domains" 
                  parent="menu_bcm_scenario_hub_management" 
                  action="action_bcm_domain" 
                  sequence="10"/>

        <menuitem id="menu_bcm_tags" 
                  name="🏷️ Tags" 
                  parent="menu_bcm_scenario_hub_management" 
                  action="action_bcm_tag" 
                  sequence="20"/>

        <!-- Analytics Section -->
        <menuitem id="menu_bcm_scenario_hub_analytics" 
                  name="Analytics" 
                  parent="menu_bcm_scenario_hub_root" 
                  sequence="40"
                  groups="bcm_scenario_hub.group_scenario_admin"/>

        <!-- Rating Views (no separate menu, accessed through scenarios) -->
        <record id="action_bcm_scenario_rating" model="ir.actions.act_window">
            <field name="name">Scenario Ratings</field>
            <field name="res_model">bcm.scenario.rating</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No ratings found.
                </p>
                <p>
                    Ratings appear when users rate published scenarios.
                </p>
            </field>
        </record>

    </data>
</odoo>
