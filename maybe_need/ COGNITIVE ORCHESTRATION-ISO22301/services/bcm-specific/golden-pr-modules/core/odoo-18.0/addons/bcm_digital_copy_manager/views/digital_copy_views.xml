<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Digital Copy Tree View -->
    <record id="view_digital_copy_tree" model="ir.ui.view">
        <field name="name">bcm.digital.copy.tree</field>
        <field name="model">bcm.digital.copy</field>
        <field name="arch" type="xml">
            <list string="Digital Copies" sample="1">
                <field name="name"/>
                <field name="digital_twin_id"/>
                <field name="copy_type"/>
                <field name="state" widget="badge"/>
                <field name="snapshot_date"/>
                <field name="size_kb" string="Size (KB)"/>
                <field name="is_expired" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- Digital Copy Form View -->
    <record id="view_digital_copy_form" model="ir.ui.view">
        <field name="name">bcm.digital.copy.form</field>
        <field name="model">bcm.digital.copy</field>
        <field name="arch" type="xml">
            <form string="Digital Copy">
                <header>
                    <button name="action_restore_snapshot" string="Restore" type="object"
                            class="btn-primary"/>
                    <button name="action_compare_snapshots" string="Compare" type="object"
                            class="btn-secondary"/>
                    <button name="action_archive_snapshot" string="Archive" type="object"
                            class="btn-warning"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="digital_twin_id"/>
                            <field name="bcm_client_id"/>
                            <field name="copy_type"/>
                            <field name="snapshot_date"/>
                        </group>
                        <group>
                            <field name="size_kb" string="Size (KB)"/>
                            <field name="valid_until"/>
                            <field name="is_expired"/>
                            <field name="parent_copy_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Tags">
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </page>
                        <page string="Child Copies">
                            <field name="child_copy_ids" readonly="1"/>
                        </page>
                        <page string="Comparisons">
                            <field name="comparison_ids" readonly="1"/>
                        </page>
                        <page string="Technical" groups="base.group_no_one">
                            <group>
                                <field name="metadata"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Digital Copy Search View -->
    <record id="view_digital_copy_search" model="ir.ui.view">
        <field name="name">bcm.digital.copy.search</field>
        <field name="model">bcm.digital.copy</field>
        <field name="arch" type="xml">
            <search string="Digital Copies">
                <field name="name"/>
                <field name="digital_twin_id"/>
                <field name="bcm_client_id"/>
                <separator/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Manual" name="manual" domain="[('copy_type', '=', 'manual')]"/>
                <filter string="Automatic" name="automatic" domain="[('copy_type', '=', 'automatic')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Digital Twin" name="group_twin" domain="[]" context="{'group_by': 'digital_twin_id'}"/>
                    <filter string="Type" name="group_type" domain="[]" context="{'group_by': 'copy_type'}"/>
                    <filter string="State" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_date" domain="[]" context="{'group_by': 'snapshot_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_digital_copy" model="ir.actions.act_window">
        <field name="name">Digital Copies</field>
        <field name="res_model">bcm.digital.copy</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_digital_copy_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Digital Copy!
            </p>
            <p>
                Digital Copies allow you to create snapshots of your Digital Twin state
                and restore to previous versions when needed.
            </p>
        </field>
    </record>

</odoo>