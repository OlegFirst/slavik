<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- BCM Scenario Hub Multi-tenant Rules -->
        
        <!-- Scenario Rules -->
        <record id="bcm_scenario_company_rule" model="ir.rule">
            <field name="name">BCM Scenario: Company Rule</field>
            <field name="model_id" ref="model_bcm_scenario"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <record id="bcm_scenario_public_rule" model="ir.rule">
            <field name="name">BCM Scenario: Public Access</field>
            <field name="model_id" ref="model_bcm_scenario"/>
            <field name="domain_force">[
                ('status', '=', 'approved'),
                ('is_public', '=', True)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        
        <!-- Scenario Review Rules -->
        <record id="bcm_scenario_review_company_rule" model="ir.rule">
            <field name="name">BCM Scenario Review: Company Rule</field>
            <field name="model_id" ref="model_bcm_scenario_review"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <record id="bcm_scenario_review_author_rule" model="ir.rule">
            <field name="name">BCM Scenario Review: Author Rule</field>
            <field name="model_id" ref="model_bcm_scenario_review"/>
            <field name="domain_force">[
                '|',
                ('user_id', '=', user.id),
                ('scenario_id.status', '=', 'approved')
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>
        
        <!-- Scenario Rating Rules -->
        <record id="bcm_scenario_rating_company_rule" model="ir.rule">
            <field name="name">BCM Scenario Rating: Company Rule</field>
            <field name="model_id" ref="model_bcm_scenario_rating"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <record id="bcm_scenario_rating_user_rule" model="ir.rule">
            <field name="name">BCM Scenario Rating: User Rule</field>
            <field name="model_id" ref="model_bcm_scenario_rating"/>
            <field name="domain_force">[
                ('user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
