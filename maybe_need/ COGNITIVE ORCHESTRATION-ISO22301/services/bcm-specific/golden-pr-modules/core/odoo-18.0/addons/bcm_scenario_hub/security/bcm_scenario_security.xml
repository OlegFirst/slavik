<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Security Groups for Scenario Hub -->
        <record id="group_scenario_user" model="res.groups">
            <field name="name">Scenario Hub User</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="comment">Can view and use published scenarios</field>
        </record>

        <record id="group_scenario_author" model="res.groups">
            <field name="name">Scenario Author</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="comment">Can create and submit scenarios for review</field>
            <field name="implied_ids" eval="[(4, ref('group_scenario_user'))]"/>
        </record>

        <record id="group_scenario_reviewer" model="res.groups">
            <field name="name">Scenario Reviewer</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="comment">Can review and moderate scenarios</field>
            <field name="implied_ids" eval="[(4, ref('group_scenario_author'))]"/>
        </record>

        <record id="group_scenario_admin" model="res.groups">
            <field name="name">Scenario Hub Administrator</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="comment">Full access to scenario hub administration</field>
            <field name="implied_ids" eval="[(4, ref('group_scenario_reviewer'))]"/>
        </record>

        <!-- Record Rules for Multi-tenancy and Visibility -->

        <!-- Scenario Visibility Rules -->
        <record id="scenario_visibility_rule" model="ir.rule">
            <field name="name">Scenario Visibility Rule</field>
            <field name="model_id" ref="model_bcm_scenario"/>
            <field name="domain_force">
                [
                    '|', '|', '|',
                    ('visibility', '=', 'public'),
                    '&amp;', ('visibility', '=', 'client_only'), ('author_user_id.company_id', '=', company_id),
                    ('author_user_id', '=', user.id),
                    ('status', '=', 'draft')
                ]
            </field>
            <field name="groups" eval="[(4, ref('group_scenario_user'))]"/>
        </record>

        <!-- Authors can edit their own scenarios -->
        <record id="scenario_author_edit_rule" model="ir.rule">
            <field name="name">Authors can edit own scenarios</field>
            <field name="model_id" ref="model_bcm_scenario"/>
            <field name="domain_force">[('author_user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="groups" eval="[(4, ref('group_scenario_author'))]"/>
        </record>

        <!-- Reviewers can access all scenarios for moderation -->
        <record id="scenario_reviewer_rule" model="ir.rule">
            <field name="name">Reviewers can access all scenarios</field>
            <field name="model_id" ref="model_bcm_scenario"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4, ref('group_scenario_reviewer'))]"/>
        </record>

        <!-- Scenario Review Rules -->
        <record id="scenario_review_visibility_rule" model="ir.rule">
            <field name="name">Review Visibility Rule</field>
            <field name="model_id" ref="model_bcm_scenario_review"/>
            <field name="domain_force">
                [
                    '|',
                    ('reviewer_id', '=', user.id),
                    ('scenario_id.author_user_id', '=', user.id)
                ]
            </field>
            <field name="groups" eval="[(4, ref('group_scenario_user'))]"/>
        </record>

        <!-- Only reviewers can create reviews -->
        <record id="scenario_review_create_rule" model="ir.rule">
            <field name="name">Only reviewers can create reviews</field>
            <field name="model_id" ref="model_bcm_scenario_review"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4, ref('group_scenario_reviewer'))]"/>
        </record>

        <!-- Rating Rules -->
        <record id="scenario_rating_user_rule" model="ir.rule">
            <field name="name">Users can rate published scenarios</field>
            <field name="model_id" ref="model_bcm_scenario_rating"/>
            <field name="domain_force">
                [
                    '|',
                    ('user_id', '=', user.id),
                    ('scenario_id.status', '=', 'published')
                ]
            </field>
            <field name="groups" eval="[(4, ref('group_scenario_user'))]"/>
        </record>

        <!-- Users can only edit their own ratings -->
        <record id="scenario_rating_edit_rule" model="ir.rule">
            <field name="name">Users can edit own ratings</field>
            <field name="model_id" ref="model_bcm_scenario_rating"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="groups" eval="[(4, ref('group_scenario_user'))]"/>
        </record>

        <!-- Tag and Domain Rules (Global) -->
        <record id="tag_global_rule" model="ir.rule">
            <field name="name">Tags are globally accessible</field>
            <field name="model_id" ref="model_bcm_tag"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_scenario_user'))]"/>
        </record>

        <record id="domain_global_rule" model="ir.rule">
            <field name="name">Domains are globally accessible</field>
            <field name="model_id" ref="model_bcm_domain"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_scenario_user'))]"/>
        </record>

        <!-- Mail Activity Types -->
        <record id="mail_activity_scenario_review" model="mail.activity.type">
            <field name="name">Scenario Review</field>
            <field name="summary">Review scenario for publication</field>
            <field name="category">default</field>
            <field name="delay_count">3</field>
            <field name="delay_unit">days</field>
            <field name="delay_from">current_date</field>
            <field name="icon">fa-search</field>
        </record>

        <record id="mail_activity_scenario_feedback" model="mail.activity.type">
            <field name="name">Scenario Feedback</field>
            <field name="summary">Provide feedback on scenario</field>
            <field name="category">default</field>
            <field name="delay_count">7</field>
            <field name="delay_unit">days</field>
            <field name="delay_from">current_date</field>
            <field name="icon">fa-comment</field>
        </record>

    </data>
</odoo>
