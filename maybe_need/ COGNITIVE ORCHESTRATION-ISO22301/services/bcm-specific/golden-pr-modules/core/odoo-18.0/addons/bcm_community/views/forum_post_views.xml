<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Forum Post Views -->

        <!-- Forum Post List View -->
        <record id="view_forum_post_list" model="ir.ui.view">
            <field name="name">bcm.forum.post.list</field>
            <field name="model">bcm.forum.post</field>
            <field name="arch" type="xml">
                <list string="Forum Posts">
                    <field name="content" string="Post Content"/>
                    <field name="author_id"/>
                    <field name="topic_id"/>
                    <field name="created_date"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Forum Post Form View -->
        <record id="view_forum_post_form" model="ir.ui.view">
            <field name="name">bcm.forum.post.form</field>
            <field name="model">bcm.forum.post</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="topic_id"/>
                            <field name="author_id"/>
                            <field name="active"/>
                        </group>
                        <field name="content"/>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>