<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_bcm_config_tree" model="ir.ui.view">
        <field name="name">bcm.config.tree</field>
        <field name="model">bcm.config</field>
        <field name="arch" type="xml">
            <tree string="BCM Configurations">
                <field name="name"/>
                <field name="key"/>
                <field name="value"/>
                <field name="config_type"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bcm_config_form" model="ir.ui.view">
        <field name="name">bcm.config.form</field>
        <field name="model">bcm.config</field>
        <field name="arch" type="xml">
            <form string="BCM Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="key"/>
                            <field name="config_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="value"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Webhook Tree View -->
    <record id="view_bcm_webhook_tree" model="ir.ui.view">
        <field name="name">bcm.webhook.tree</field>
        <field name="model">bcm.webhook</field>
        <field name="arch" type="xml">
            <tree string="BCM Webhooks">
                <field name="name"/>
                <field name="url"/>
                <field name="event_type"/>
                <field name="active"/>
                <field name="last_triggered"/>
            </tree>
        </field>
    </record>

    <!-- Webhook Form View -->
    <record id="view_bcm_webhook_form" model="ir.ui.view">
        <field name="name">bcm.webhook.form</field>
        <field name="model">bcm.webhook</field>
        <field name="arch" type="xml">
            <form string="BCM Webhook">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="url"/>
                            <field name="event_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="headers"/>
                            <field name="last_triggered"/>
                            <field name="trigger_count"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_bcm_config_root"
              name="Configuration"
              parent="bcm_core.menu_bcm_root"
              sequence="100"/>

    <menuitem id="menu_bcm_config_settings"
              name="Settings"
              parent="menu_bcm_config_root"
              action="action_bcm_config"
              sequence="10"/>

    <menuitem id="menu_bcm_config_webhooks"
              name="Webhooks"
              parent="menu_bcm_config_root"
              action="action_bcm_webhook"
              sequence="20"/>

    <!-- Actions -->
    <record id="action_bcm_config" model="ir.actions.act_window">
        <field name="name">BCM Settings</field>
        <field name="res_model">bcm.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_bcm_webhook" model="ir.actions.act_window">
        <field name="name">BCM Webhooks</field>
        <field name="res_model">bcm.webhook</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>