<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- BCM Core Multi-tenant Rules -->
        
        <!-- Scenario Instance Rules -->
        <record id="bcm_scenario_instance_company_rule" model="ir.rule">
            <field name="name">BCM Scenario Instance: Company Rule</field>
            <field name="model_id" ref="model_bcm_scenario_instance"/>
            <field name="domain_force">[
                '|',
                ('company_id', '=', False),
                ('company_id', 'in', company_ids)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <!-- Test Execution Rules -->
        <record id="bcm_test_execution_company_rule" model="ir.rule">
            <field name="name">BCM Test Execution: Company Rule</field>
