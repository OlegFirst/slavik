<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- AI Lifecycle Views -->
        <record id="view_bcm_ai_lifecycle_tree" model="ir.ui.view">
            <field name="name">bcm.ai.lifecycle.tree</field>
            <field name="model">bcm.ai.lifecycle</field>
            <field name="arch" type="xml">
                <list string="AI Organs Lifecycle">
                    <field name="organ_name"/>
                    <field name="organ_type"/>
                    <field name="status" decoration-success="status=='active'" decoration-warning="status=='learning'" decoration-danger="status=='error'"/>
                    <field name="health_score" widget="progressbar"/>
                    <field name="total_activations"/>
                    <field name="avg_response_time"/>
                    <field name="effectiveness_score" widget="progressbar"/>
                    <field name="last_health_check"/>
                </list>
            </field>
        </record>

        <record id="view_bcm_ai_lifecycle_form" model="ir.ui.view">
            <field name="name">bcm.ai.lifecycle.form</field>
            <field name="model">bcm.ai.lifecycle</field>
            <field name="arch" type="xml">
                <form string="AI Organ Lifecycle">
                    <header>
                        <button name="action_health_check" string="Health Check" type="object" class="oe_highlight"/>
                        <button name="action_trigger_evolution" string="Trigger Evolution" type="object"/>
                        <field name="status" widget="statusbar" statusbar_visible="dormant,learning,active,wise"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="organ_name"/>
                            </h1>
                            <h2>
                                <field name="organ_type"/>
                            </h2>
                        </div>
                        <group>
                            <group string="Performance Metrics">
                                <field name="health_score" widget="progressbar"/>
                                <field name="effectiveness_score" widget="progressbar"/>
                                <field name="learning_progress" widget="progressbar"/>
                                <field name="api_response_rate" widget="progressbar"/>
                            </group>
                            <group string="Activity">
                                <field name="activation_count"/>
                                <field name="total_activations"/>
                                <field name="avg_response_time"/>
                                <field name="integration_errors"/>
                                <field name="last_successful_call"/>
                            </group>
                        </group>
                        <group>
                            <group string="AI Configuration">
                                <field name="ai_model_used"/>
                                <field name="ai_provider"/>
                                <field name="memory_size_kb"/>
                                <field name="pattern_recognition_count"/>
                            </group>
                            <group string="Health Monitoring">
                                <field name="last_health_check"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Wisdom &amp; Learning">
                                <group>
                                    <field name="wisdom_accumulated" widget="text"/>
                                </group>
                            </page>
                            <page string="Health Trends">
                                <group>
                                    <field name="health_trends" widget="text"/>
                                </group>
                            </page>
                            <page string="Lifecycle Events">
                                <group>
                                    <field name="lifecycle_events" widget="text"/>
                                    <field name="evolution_milestones" widget="text"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_bcm_ai_lifecycle_kanban" model="ir.ui.view">
            <field name="name">bcm.ai.lifecycle.kanban</field>
            <field name="model">bcm.ai.lifecycle</field>
            <field name="arch" type="xml">
                <kanban default_group_by="status">
                    <field name="organ_name"/>
                    <field name="organ_type"/>
                    <field name="status"/>
                    <field name="health_score"/>
                    <field name="effectiveness_score"/>
                    <field name="total_activations"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="organ_name"/>
                                            </strong>
                                            <small class="o_kanban_record_subtitle text-muted">
                                                <field name="organ_type"/>
                                            </small>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <div class="o_kanban_tags">
                                            <span class="badge badge-info">
                                                Health: <field name="health_score"/>
                                            </span>
                                            <span class="badge badge-success">
                                                Activations: <field name="total_activations"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="action_bcm_ai_lifecycle" model="ir.actions.act_window">
            <field name="name">AI Organs Lifecycle</field>
            <field name="res_model">bcm.ai.lifecycle</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Monitor your AI Organs
                </p>
                <p>
                    Track the lifecycle and performance of your AI-powered BCM organs.
                </p>
            </field>
        </record>

        <menuitem id="menu_bcm_ai_lifecycle"
                  name="AI Organs Monitor"
                  parent="menu_bcm_core_section"
                  action="action_bcm_ai_lifecycle"
                  sequence="50"/>
    </data>
</odoo>