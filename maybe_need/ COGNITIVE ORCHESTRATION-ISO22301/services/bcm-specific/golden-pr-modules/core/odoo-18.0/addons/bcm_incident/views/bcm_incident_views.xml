<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Incident Tree View -->
        <record id="view_bcm_incident_tree" model="ir.ui.view">
            <field name="name">bcm.incident.tree</field>
            <field name="model">bcm.incident</field>
            <field name="arch" type="xml">
                <tree string="Incidents" 
                      decoration-danger="severity=='critical'" 
                      decoration-warning="severity=='high'"
                      decoration-info="status in ['detected', 'assessing']"
                      decoration-success="status=='resolved'"
                      decoration-muted="status=='closed'">
                    
                    <field name="incident_number"/>
                    <field name="title"/>
                    <field name="incident_type"/>
                    <field name="severity" widget="badge"/>
                    <field name="status" widget="badge"/>
                    <field name="priority" widget="priority"/>
                    <field name="crisis_level" widget="badge"/>
                    <field name="assigned_to"/>
                    <field name="detected_at"/>
                    <field name="ai_risk_score" widget="progressbar"/>
                    <field name="response_team_activated" widget="boolean_toggle"/>
                    <field name="escalation_level"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    
                </tree>
            </field>
        </record>
        
        <!-- Incident Form View -->
        <record id="view_bcm_incident_form" model="ir.ui.view">
            <field name="name">bcm.incident.form</field>
            <field name="model">bcm.incident</field>
            <field name="arch" type="xml">
                <form string="Incident Management">
                    
                    <header>
                        <button name="action_start_response" type="object" 
                                string="Start Response" 
                                class="btn-primary"
                                attrs="{'invisible': [('status', 'not in', ['detected', 'assessing'])]}"/>
                        
                        <button name="action_escalate" type="object" 
                                string="Escalate" 
                                class="btn-warning"
                                attrs="{'invisible': [('status', 'in', ['resolved', 'closed'])]}"/>
                        
                        <button name="action_resolve" type="object" 
                                string="Resolve" 
                                class="btn-success"
                                attrs="{'invisible': [('status', 'in', ['resolved', 'closed'])]}"/>
                        
                        <button name="action_close" type="object" 
                                string="Close" 
                                class="btn-secondary"
                                attrs="{'invisible': [('status', '!=', 'resolved')]}"/>
                        
                        <button name="action_reopen" type="object" 
                                string="Reopen" 
                                class="btn-warning"
                                attrs="{'invisible': [('status', 'not in', ['resolved', 'closed'])]}"/>
                        
                        <field name="status" widget="statusbar" 
                               statusbar_visible="draft,detected,assessing,responding,recovering,resolved,closed"/>
                    </header>
                    
                    <sheet>
                        
                        <!-- Status indicators and AI warnings -->
                        <div class="oe_button_box" name="button_box">
                            
                            <button class="oe_stat_button" type="object" 
                                    name="action_view_timeline" icon="fa-clock-o">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="actual_rto" widget="float_time"/>
                                    </span>
                                    <span class="o_stat_text">Actual RTO</span>
                                </div>
                            </button>
                            
                            <button class="oe_stat_button" type="object" 
                                    name="action_view_ai_recommendations" icon="fa-brain"
                                    attrs="{'invisible': [('ai_recommendations', '=', False)]}">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="ai_risk_score"/>
                                    </span>
                                    <span class="o_stat_text">AI Risk Score</span>
                                </div>
                            </button>
                            
                            <button class="oe_stat_button" type="object" 
                                    name="action_view_response_team" icon="fa-users"
                                    attrs="{'invisible': [('response_team_activated', '=', False)]}">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="response_team_members" widget="badge"/>
                                    </span>
                                    <span class="o_stat_text">Team Members</span>
                                </div>
                            </button>
                            
                            <button class="oe_stat_button" type="object" 
                                    name="action_view_similar_incidents" icon="fa-search"
                                    attrs="{'invisible': [('ai_similar_incidents', '=', False)]}">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="ai_similar_incidents" widget="badge"/>
                                    </span>
                                    <span class="o_stat_text">Similar</span>
                                </div>
                            </button>
                            
                        </div>
                        
                        <!-- AI Alert Banner -->
                        <div class="alert alert-warning" 
                             attrs="{'invisible': [('ai_escalation_prediction', '=', False)]}">
                            <strong>AI Alert:</strong> This incident is predicted to escalate. 
                            <field name="ai_escalation_prediction" invisible="1"/>
                        </div>
                        
                        <!-- Crisis Level Alert -->
                        <div class="alert alert-danger" 
                             attrs="{'invisible': [('crisis_level', 'not in', ['3', '4', '5'])]}">
                            <strong>Crisis Alert:</strong> 
                            Crisis Level <field name="crisis_level" readonly="1"/> activated. 
                            Executive attention required.
                        </div>
                        
                        <!-- Main Information -->
                        <div class="oe_title">
                            <h1>
                                <field name="incident_number" readonly="1"/>
                            </h1>
                            <h2>
                                <field name="title" placeholder="Incident Title"/>
                            </h2>
                        </div>
                        
                        <group>
                            <group name="basic_info" string="Basic Information">
                                <field name="incident_type"/>
                                <field name="severity"/>
                                <field name="priority" widget="priority"/>
                                <field name="crisis_level"/>
                                <field name="business_impact_level"/>
                                <field name="estimated_impact"/>
                                <field name="financial_impact" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                            
                            <group name="assignment" string="Assignment &amp; Teams">
                                <field name="reported_by"/>
                                <field name="assigned_to"/>
                                <field name="incident_commander"/>
                                <field name="response_team_activated" widget="boolean_toggle"/>
                                <field name="response_team_members" 
                                       widget="many2many_tags"
                                       attrs="{'invisible': [('response_team_activated', '=', False)]}"/>
                            </group>
                        </group>
                        
                        <group>
                            <group name="timeline" string="Timeline &amp; Metrics">
                                <field name="detected_at"/>
                                <field name="reported_at"/>
                                <field name="resolved_at" readonly="1"/>
                                <field name="target_rto"/>
                                <field name="actual_rto" readonly="1" widget="float_time"/>
                                <field name="target_rpo"/>
                            </group>
                            
                            <group name="escalation" string="Escalation &amp; AI">
                                <field name="escalation_level" readonly="1"/>
                                <field name="escalation_deadline" readonly="1"/>
                                <field name="auto_escalate" widget="boolean_toggle"/>
                                <field name="ai_risk_score" readonly="1" widget="progressbar"/>
                                <field name="ai_classification_confidence" readonly="1"/>
                                <field name="ai_escalation_prediction" readonly="1"/>
                            </group>
                        </group>
                        
                        <!-- Description -->
                        <notebook>
                            
                            <!-- Main Description Tab -->
                            <page string="Description &amp; Details" name="description">
                                <group>
                                    <field name="description" nolabel="1" 
                                           placeholder="Detailed description of the incident..."/>
                                </group>
                                
                                <group>
                                    <group string="Affected Areas">
                                        <field name="affected_systems" widget="text"/>
                                        <field name="affected_locations" widget="text"/>
                                    </group>
                                    
                                    <group string="Stakeholders &amp; Communication">
                                        <field name="stakeholders" widget="many2many_tags"/>
                                        <field name="media_attention" widget="boolean_toggle"/>
                                        <field name="public_statement_required" widget="boolean_toggle"/>
                                        <field name="crisis_communication_plan"/>
                                    </group>
                                </group>
                            </page>
                            
                            <!-- AI Commander Tab -->
                            <page string="AI Commander" name="ai_commander" 
                                  attrs="{'invisible': [('ai_recommendations', '=', False)]}">
                                
                                <group>
                                    <group string="AI Analysis">
                                        <field name="ai_risk_score" widget="gauge" 
                                               options="{'max_field': '100', 'style': 'width:160px; height: 120px;'}"/>
                                        <field name="ai_classification_confidence" widget="progressbar"/>
                                        <field name="ai_escalation_prediction"/>
                                    </group>
                                    
                                    <group string="Similar Incidents">
                                        <field name="ai_similar_incidents" widget="many2many_list"/>
                                    </group>
                                </group>
                                
                                <group string="AI Recommendations">
                                    <field name="ai_recommendations" nolabel="1" readonly="1" widget="html"/>
                                </group>
                                
                            </page>
                            
                            <!-- Response Team Tab -->
                            <page string="Response Team" name="response_team"
                                  attrs="{'invisible': [('response_team_activated', '=', False)]}">
                                
                                <group>
                                    <group string="Team Leadership">
                                        <field name="incident_commander"/>
                                        <field name="response_team_activated" readonly="1"/>
                                    </group>
                                    
                                    <group string="Team Status">
                                        <field name="escalation_level" readonly="1"/>
                                        <field name="escalation_deadline" readonly="1"/>
                                    </group>
                                </group>
                                
                                <group string="Team Members">
                                    <field name="response_team_members" nolabel="1">
                                        <tree editable="bottom">
                                            <field name="name"/>
                                            <field name="job_title"/>
                                            <field name="mobile_phone"/>
                                            <field name="email"/>
                                        </tree>
                                    </field>
                                </group>
                                
                            </page>
                            
                            <!-- Mobile Response Tab -->
                            <page string="Mobile Response" name="mobile_response"
                                  attrs="{'invisible': [('mobile_reporting_enabled', '=', False)]}">
                                
                                <group>
                                    <group string="Mobile Configuration">
                                        <field name="mobile_reporting_enabled" readonly="1"/>
                                        <field name="gps_tracking_enabled"/>
                                    </group>
                                </group>
                                
                                <group string="Field Updates">
                                    <field name="field_updates" nolabel="1">
                                        <tree editable="bottom">
                                            <field name="create_date" readonly="1"/>
                                            <field name="reporter_id"/>
                                            <field name="update_text"/>
                                            <field name="gps_location"/>
                                        </tree>
                                    </field>
                                </group>
                                
                            </page>
                            
                            <!-- Communications Tab -->
                            <page string="Communications" name="communications">
                                
                                <group>
                                    <group string="Crisis Communication">
                                        <field name="crisis_communication_plan"/>
                                        <field name="media_attention"/>
                                        <field name="public_statement_required"/>
                                    </group>
                                    
                                    <group string="Stakeholder Management">
                                        <field name="stakeholders" widget="many2many_tags"/>
                                    </group>
                                </group>
                                
                                <group string="Notifications">
                                    <field name="stakeholder_notifications" nolabel="1">
                                        <tree editable="bottom">
                                            <field name="notification_type"/>
                                            <field name="recipient"/>
                                            <field name="sent_at"/>
                                            <field name="status"/>
                                        </tree>
                                    </field>
                                </group>
                                
                            </page>
                            
                            <!-- Analysis & Learning Tab -->
                            <page string="Analysis &amp; Learning" name="analysis">
                                
                                <group>
                                    <group string="Root Cause Analysis">
                                        <field name="root_cause_analysis" widget="text"/>
                                    </group>
                                    
                                    <group string="Lessons Learned">
                                        <field name="lessons_learned" widget="text"/>
                                    </group>
                                </group>
                                
                                <group>
                                    <group string="Preventive Measures">
                                        <field name="preventive_measures" widget="text"/>
                                    </group>
                                    
                                    <group string="Post-Incident Review">
                                        <field name="post_incident_review_required"/>
                                        <field name="post_incident_review_completed"/>
                                    </group>
                                </group>
                                
                                <group string="Related Items">
                                    <field name="related_risks" widget="many2many_tags"/>
                                    <field name="related_bia_functions" widget="many2many_tags"/>
                                    <field name="triggered_plans" widget="many2many_tags"/>
                                </group>
                                
                            </page>
                            
                            <!-- Integrations Tab -->
                            <page string="Integrations" name="integrations" 
                                  groups="bcm_incident_unified.group_api_integration">
                                
                                <group>
                                    <group string="External Systems">
                                        <field name="external_ticket_number"/>
                                        <field name="thehive_case_id"/>
                                    </group>
                                    
                                    <group string="Integration Status">
                                        <field name="integration_data" widget="text"/>
                                    </group>
                                </group>
                                
                            </page>
                            
                        </notebook>
                        
                    </sheet>
                    
                    <!-- Chatter -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                    
                </form>
            </field>
        </record>
        
        <!-- Incident Kanban View -->
        <record id="view_bcm_incident_kanban" model="ir.ui.view">
            <field name="name">bcm.incident.kanban</field>
            <field name="model">bcm.incident</field>
            <field name="arch" type="xml">
                <kanban default_group_by="status" class="o_kanban_small_column">
                    <field name="incident_number"/>
                    <field name="title"/>
                    <field name="severity"/>
                    <field name="priority"/>
                    <field name="assigned_to"/>
                    <field name="ai_risk_score"/>
                    <field name="crisis_level"/>
                    <field name="color"/>
                    
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_card oe_kanban_global_click">
                                
                                <div class="o_dropdown_kanban dropdown">
                                    <a class="dropdown-toggle o-no-caret btn" role="button" data-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                        <span class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <a type="edit" class="dropdown-item">Edit</a>
                                        <a type="delete" class="dropdown-item">Delete</a>
                                        <a name="action_escalate" type="object" class="dropdown-item">Escalate</a>
                                    </div>
                                </div>
                                
                                <div class="oe_kanban_content">
                                    
                                    <!-- Header with incident number and severity -->
                                    <div class="o_kanban_record_top mb16">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="incident_number"/>
                                            </strong>
                                        </div>
                                        
                                        <div class="o_kanban_record_top_right">
                                            <div t-if="record.severity.raw_value == 'critical'" 
                                                 class="badge badge-danger">Critical</div>
                                            <div t-elif="record.severity.raw_value == 'high'" 
                                                 class="badge badge-warning">High</div>
                                            <div t-elif="record.severity.raw_value == 'medium'" 
                                                 class="badge badge-info">Medium</div>
                                            <div t-else="" class="badge badge-secondary">Low</div>
                                        </div>
                                    </div>
                                    
                                    <!-- Title -->
                                    <div class="o_kanban_record_title">
                                        <field name="title"/>
                                    </div>
                                    
                                    <!-- AI Risk Score -->
                                    <div t-if="record.ai_risk_score.raw_value" class="mb8">
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar" role="progressbar" 
                                                 t-attf-style="width: #{record.ai_risk_score.raw_value}%"
                                                 t-attf-aria-valuenow="#{record.ai_risk_score.raw_value}" 
                                                 aria-valuemin="0" aria-valuemax="100">
                                            </div>
                                        </div>
                                        <small class="text-muted">AI Risk: <field name="ai_risk_score"/>%</small>
                                    </div>
                                    
                                    <!-- Crisis Level Alert -->
                                    <div t-if="record.crisis_level.raw_value in ['3', '4', '5']" 
                                         class="alert alert-danger mb8">
                                        <i class="fa fa-exclamation-triangle"/> Crisis Level <field name="crisis_level"/>
                                    </div>
                                    
                                    <!-- Bottom info -->
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <div t-if="record.assigned_to.raw_value">
                                                <img t-att-src="kanban_image('res.users', 'avatar_128', record.assigned_to.raw_value)" 
                                                     t-att-title="record.assigned_to.value" 
                                                     t-att-alt="record.assigned_to.value" 
                                                     width="24" height="24" class="oe_kanban_avatar"/>
                                            </div>
                                        </div>
                                        
                                        <div class="oe_kanban_bottom_right">
                                            <div t-if="record.priority.raw_value != '0'" class="mr4">
                                                <field name="priority" widget="priority"/>
                                            </div>
                                        </div>
                                    </div>
                                    
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        
        <!-- Incident Search View -->
        <record id="view_bcm_incident_search" model="ir.ui.view">
            <field name="name">bcm.incident.search</field>
            <field name="model">bcm.incident</field>
            <field name="arch" type="xml">
                <search string="Search Incidents">
                    
                    <!-- Search fields -->
                    <field name="incident_number" string="Incident Number"/>
                    <field name="title" string="Title"/>
                    <field name="description" string="Description"/>
                    <field name="assigned_to" string="Assigned To"/>
                    <field name="reported_by" string="Reported By"/>
                    <field name="incident_commander" string="Incident Commander"/>
                    
                    <!-- Filters -->
                    <filter string="My Incidents" name="my_incidents" 
                            domain="['|', ('assigned_to', '=', uid), ('reported_by', '=', uid)]"/>
                    
                    <filter string="Active" name="active" 
                            domain="[('status', 'in', ['detected', 'assessing', 'responding', 'recovering'])]"/>
                    
                    <filter string="Critical" name="critical" 
                            domain="[('severity', '=', 'critical')]"/>
                    
                    <filter string="High Priority" name="high_priority" 
                            domain="[('priority', 'in', ['3', '4'])]"/>
                    
                    <filter string="Crisis Level" name="crisis" 
                            domain="[('crisis_level', 'in', ['3', '4', '5'])]"/>
                    
                    <filter string="Response Team Active" name="response_active" 
                            domain="[('response_team_activated', '=', True)]"/>
                    
                    <filter string="AI Escalation Predicted" name="ai_escalation" 
                            domain="[('ai_escalation_prediction', '=', True)]"/>
                    
                    <separator/>
                    
                    <filter string="Today" name="today" 
                            domain="[('detected_at', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                    
                    <filter string="This Week" name="this_week" 
                            domain="[('detected_at', '>=', (context_today() - timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    
                    <filter string="This Month" name="this_month" 
                            domain="[('detected_at', '>=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                    
                    <separator/>
                    
                    <filter string="Archived" name="archived" 
                            domain="[('active', '=', False)]"/>
                    
                    <!-- Group By -->
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                        <filter string="Severity" name="group_severity" context="{'group_by': 'severity'}"/>
                        <filter string="Type" name="group_type" context="{'group_by': 'incident_type'}"/>
                        <filter string="Assigned To" name="group_assigned" context="{'group_by': 'assigned_to'}"/>
                        <filter string="Detection Date" name="group_date" context="{'group_by': 'detected_at:month'}"/>
                        <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    </group>
                    
                </search>
            </field>
        </record>
        
        <!-- Incident Calendar View -->
        <record id="view_bcm_incident_calendar" model="ir.ui.view">
            <field name="name">bcm.incident.calendar</field>
            <field name="model">bcm.incident</field>
            <field name="arch" type="xml">
                <calendar string="Incident Timeline" 
                          date_start="detected_at" 
                          date_stop="resolved_at"
                          color="severity"
                          quick_add="False">
                    
                    <field name="title"/>
                    <field name="incident_number"/>
                    <field name="severity"/>
                    <field name="assigned_to"/>
                    <field name="status"/>
                    
                </calendar>
            </field>
        </record>
        
        <!-- Incident Pivot View -->
        <record id="view_bcm_incident_pivot" model="ir.ui.view">
            <field name="name">bcm.incident.pivot</field>
            <field name="model">bcm.incident</field>
            <field name="arch" type="xml">
                <pivot string="Incident Analysis">
                    
                    <field name="incident_type" type="row"/>
                    <field name="severity" type="row"/>
                    <field name="detected_at" type="col" interval="month"/>
                    <field name="actual_rto" type="measure"/>
                    <field name="financial_impact" type="measure"/>
                    <field name="ai_risk_score" type="measure"/>
                    
                </pivot>
            </field>
        </record>
        
        <!-- Incident Graph View -->
        <record id="view_bcm_incident_graph" model="ir.ui.view">
            <field name="name">bcm.incident.graph</field>
            <field name="model">bcm.incident</field>
            <field name="arch" type="xml">
                <graph string="Incident Trends" type="bar">
                    
                    <field name="detected_at" interval="month"/>
                    <field name="severity"/>
                    
                </graph>
            </field>
        </record>
        
    </data>
</odoo>