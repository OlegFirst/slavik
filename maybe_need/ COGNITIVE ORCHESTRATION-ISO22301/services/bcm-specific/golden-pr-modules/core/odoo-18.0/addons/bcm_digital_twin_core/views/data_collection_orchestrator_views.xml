<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Data Collection Orchestrator Tree View -->
        <record id="view_data_collection_orchestrator_tree" model="ir.ui.view">
            <field name="name">bcm.data.collection.orchestrator.tree</field>
            <field name="model">bcm.data.collection.orchestrator</field>
            <field name="arch" type="xml">
                <tree string="Data Collection Orchestrators" decoration-success="collection_status=='collecting'"
                      decoration-danger="collection_status=='error'" decoration-warning="collection_status=='paused'">
                    <field name="name"/>
                    <field name="orchestrator_id"/>
                    <field name="collection_status" widget="badge"
                           decoration-success="collection_status=='collecting'"
                           decoration-danger="collection_status=='error'"
                           decoration-warning="collection_status=='paused'"
                           decoration-info="collection_status=='idle'"/>
                    <field name="last_full_sync"/>
                    <field name="last_partial_sync"/>
                    <field name="next_scheduled_sync"/>
                    <field name="error_count"/>
                    <field name="enable_real_time"/>
                    <field name="max_concurrent_collections"/>
                </tree>
            </field>
        </record>

        <!-- Data Collection Orchestrator Form View -->
        <record id="view_data_collection_orchestrator_form" model="ir.ui.view">
            <field name="name">bcm.data.collection.orchestrator.form</field>
            <field name="model">bcm.data.collection.orchestrator</field>
            <field name="arch" type="xml">
                <form string="Data Collection Orchestrator">
                    <header>
                        <button name="start_real_time_collection" type="object" string="Start Collection"
                                class="btn-primary" attrs="{'invisible': [('collection_status', '!=', 'idle')]}"/>
                        <button name="stop_collection" type="object" string="Stop Collection"
                                class="btn-secondary" attrs="{'invisible': [('collection_status', '==', 'idle')]}"/>
                        <button name="pause_collection" type="object" string="Pause"
                                class="btn-warning" attrs="{'invisible': [('collection_status', '!=', 'collecting')]}"/>
                        <button name="resume_collection" type="object" string="Resume"
                                class="btn-success" attrs="{'invisible': [('collection_status', '!=', 'paused')]}"/>
                        <button name="force_full_sync" type="object" string="Force Full Sync"
                                class="btn-info"/>
                        <button name="health_check_all_services" type="object" string="Health Check"
                                class="btn-light"/>
                        <field name="collection_status" widget="statusbar"
                               statusbar_visible="idle,collecting,processing,paused,error"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object" name="get_collection_statistics" icon="fa-bar-chart">
                                <field string="Statistics" name="error_count" widget="statinfo"/>
                            </button>
                            <button class="oe_stat_button" type="action"
                                    name="bcm_digital_twin_core.action_service_registration_wizard"
                                    icon="fa-plus" context="{'default_orchestrator_id': active_id}">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Add Service</span>
                                </div>
                            </button>
                            <button class="oe_stat_button" type="action"
                                    name="bcm_digital_twin_core.action_collection_setup_wizard"
                                    icon="fa-cog" context="{'default_orchestrator_id': active_id}">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Setup Collection</span>
                                </div>
                            </button>
                        </div>

                        <group>
                            <group string="Basic Information">
                                <field name="name" required="1"/>
                                <field name="orchestrator_id" readonly="1"/>
                                <field name="collection_status" readonly="1"/>
                            </group>
                            <group string="Timing">
                                <field name="last_full_sync" readonly="1"/>
                                <field name="last_partial_sync" readonly="1"/>
                                <field name="next_scheduled_sync" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Service Configuration" name="service_config">
                                <group>
                                    <group string="Collection Settings">
                                        <field name="enable_real_time"/>
                                        <field name="enable_parallel_collection"/>
                                        <field name="max_concurrent_collections"/>
                                        <field name="rate_limit_requests_per_second"/>
                                        <field name="collection_timeout"/>
                                        <field name="max_retry_attempts"/>
                                    </group>
                                </group>

                                <separator string="Service Endpoints"/>
                                <field name="service_endpoints" widget="ace" options="{'mode': 'json'}"
                                       placeholder="Configure service endpoints in JSON format"/>

                                <separator string="Collection Schedule"/>
                                <field name="collection_schedule" widget="ace" options="{'mode': 'json'}"
                                       placeholder="Configure collection schedule in JSON format"/>
                            </page>

                            <page string="Real-time &amp; WebSockets" name="realtime">
                                <group>
                                    <field name="websocket_endpoints" widget="ace" options="{'mode': 'json'}"
                                           placeholder="WebSocket endpoint configurations"/>
                                </group>
                            </page>

                            <page string="Active Collections" name="active_collections">
                                <field name="active_collections" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                            </page>

                            <page string="Performance Metrics" name="performance">
                                <field name="performance_metrics" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                            </page>

                            <page string="Data Validation" name="validation">
                                <field name="data_validation_rules" widget="ace" options="{'mode': 'json'}"
                                       placeholder="Configure data validation rules"/>
                            </page>

                            <page string="Error Log" name="errors">
                                <group>
                                    <field name="error_count" readonly="1"/>
                                </group>
                                <field name="error_log" readonly="1" placeholder="Error messages will appear here"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Data Collection Orchestrator Search View -->
        <record id="view_data_collection_orchestrator_search" model="ir.ui.view">
            <field name="name">bcm.data.collection.orchestrator.search</field>
            <field name="model">bcm.data.collection.orchestrator</field>
            <field name="arch" type="xml">
                <search string="Search Data Collection Orchestrators">
                    <field name="name" string="Name"/>
                    <field name="orchestrator_id" string="Orchestrator ID"/>
                    <field name="collection_status" string="Status"/>

                    <filter string="Active Collections" name="filter_active"
                            domain="[('collection_status', '=', 'collecting')]"/>
                    <filter string="Idle" name="filter_idle"
                            domain="[('collection_status', '=', 'idle')]"/>
                    <filter string="Error State" name="filter_error"
                            domain="[('collection_status', '=', 'error')]"/>
                    <filter string="Real-time Enabled" name="filter_realtime"
                            domain="[('enable_real_time', '=', True)]"/>

                    <separator/>
                    <filter string="Recent Sync" name="filter_recent_sync"
                            domain="[('last_partial_sync', '>=', (context_today() - datetime.timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S'))]"/>
                    <filter string="Overdue Sync" name="filter_overdue"
                            domain="[('next_scheduled_sync', '&lt;', context_today())]"/>

                    <group expand="0" string="Group By">
                        <filter string="Status" name="groupby_status" context="{'group_by': 'collection_status'}"/>
                        <filter string="Real-time Enabled" name="groupby_realtime" context="{'group_by': 'enable_real_time'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Data Collection Orchestrator Kanban View -->
        <record id="view_data_collection_orchestrator_kanban" model="ir.ui.view">
            <field name="name">bcm.data.collection.orchestrator.kanban</field>
            <field name="model">bcm.data.collection.orchestrator</field>
            <field name="arch" type="xml">
                <kanban string="Data Collection Orchestrators" default_group_by="collection_status">
                    <field name="name"/>
                    <field name="orchestrator_id"/>
                    <field name="collection_status"/>
                    <field name="last_partial_sync"/>
                    <field name="error_count"/>
                    <field name="enable_real_time"/>
                    <field name="performance_metrics"/>

                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="oe_kanban_card_header">
                                        <div class="oe_kanban_card_header_title">
                                            <div class="o_dropdown_kanban dropdown" groups="base.group_user">
                                                <a class="dropdown-toggle o-no-caret btn" data-toggle="dropdown" href="#" role="button" aria-label="Dropdown menu" title="Dropdown menu">
                                                    <span class="fa fa-ellipsis-v"/>
                                                </a>
                                                <div class="dropdown-menu" role="menu">
                                                    <a t-if="record.collection_status.raw_value == 'idle'" name="start_real_time_collection" type="object" class="dropdown-item">Start Collection</a>
                                                    <a t-if="record.collection_status.raw_value == 'collecting'" name="stop_collection" type="object" class="dropdown-item">Stop Collection</a>
                                                    <a t-if="record.collection_status.raw_value == 'collecting'" name="pause_collection" type="object" class="dropdown-item">Pause</a>
                                                    <a t-if="record.collection_status.raw_value == 'paused'" name="resume_collection" type="object" class="dropdown-item">Resume</a>
                                                    <div class="dropdown-divider"/>
                                                    <a name="force_full_sync" type="object" class="dropdown-item">Force Full Sync</a>
                                                    <a name="health_check_all_services" type="object" class="dropdown-item">Health Check</a>
                                                </div>
                                            </div>
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                        <div class="oe_kanban_card_header_right">
                                            <span t-if="record.enable_real_time.raw_value" class="badge badge-success">Real-time</span>
                                            <span t-if="!record.enable_real_time.raw_value" class="badge badge-secondary">Scheduled</span>
                                        </div>
                                    </div>

                                    <div class="oe_kanban_card_body">
                                        <div class="row">
                                            <div class="col-6">
                                                <strong>ID:</strong> <field name="orchestrator_id"/>
                                            </div>
                                            <div class="col-6">
                                                <strong>Errors:</strong> <field name="error_count"/>
                                            </div>
                                        </div>
                                        <div class="row mt-2">
                                            <div class="col-12">
                                                <strong>Last Sync:</strong> <field name="last_partial_sync"/>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="oe_kanban_card_footer">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="collection_status" widget="priority"/>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <img t-att-src="kanban_image('res.users', 'image_128', record.create_uid.raw_value)"
                                                 t-att-title="record.create_uid.value" t-att-alt="record.create_uid.value" class="oe_kanban_avatar"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Performance Dashboard View -->
        <record id="view_data_collection_orchestrator_dashboard" model="ir.ui.view">
            <field name="name">bcm.data.collection.orchestrator.dashboard</field>
            <field name="model">bcm.data.collection.orchestrator</field>
            <field name="arch" type="xml">
                <graph string="Collection Performance">
                    <field name="name" type="row"/>
                    <field name="error_count" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- Actions -->
        <record id="action_data_collection_orchestrator" model="ir.actions.act_window">
            <field name="name">Data Collection Orchestrators</field>
            <field name="res_model">bcm.data.collection.orchestrator</field>
            <field name="view_mode">kanban,tree,form,graph</field>
            <field name="view_id" ref="view_data_collection_orchestrator_kanban"/>
            <field name="search_view_id" ref="view_data_collection_orchestrator_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Data Collection Orchestrator!
                </p>
                <p>
                    Data Collection Orchestrators manage automated real-time data collection
                    from your entire BCM platform ecosystem including backend services,
                    microservices, integrations, and adapters.
                </p>
                <p>
                    Features include:
                    <ul>
                        <li>Real-time WebSocket connections</li>
                        <li>Parallel collection from 70+ services</li>
                        <li>Automatic error recovery and retry logic</li>
                        <li>Performance monitoring and analytics</li>
                        <li>Service health checking</li>
                    </ul>
                </p>
            </field>
        </record>

        <!-- Menu Items -->
        <menuitem id="menu_data_collection_orchestrator"
                  name="Data Collection"
                  parent="menu_bcm_digital_twin_root"
                  action="action_data_collection_orchestrator"
                  sequence="15"/>

        <!-- Service Management Submenu -->
        <menuitem id="menu_data_collection_services"
                  name="Service Configuration"
                  parent="menu_data_collection_orchestrator"
                  sequence="10"/>

        <!-- Performance Monitoring Submenu -->
        <menuitem id="menu_data_collection_performance"
                  name="Performance Monitoring"
                  parent="menu_data_collection_orchestrator"
                  sequence="20"/>

    </data>
</odoo>