<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Groups -->
    <record id="bcm_project_group_user" model="res.groups">
        <field name="name">BCM Project User</field>
        <field name="category_id" ref="base.module_category_project_management"/>
        <field name="comment">User can view and edit BCM projects and tasks</field>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <record id="bcm_project_group_manager" model="res.groups">
        <field name="name">BCM Project Manager</field>
        <field name="category_id" ref="base.module_category_project_management"/>
        <field name="comment">Full access to BCM projects, including AI configuration</field>
        <field name="implied_ids" eval="[(4, ref('bcm_project_group_user')), (4, ref('project.group_project_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Record Rules -->

    <!-- Project Rules -->
    <record id="bcm_project_rule_user" model="ir.rule">
        <field name="name">BCM Project: User can see projects they're involved in</field>
        <field name="model_id" ref="base.model_project_project"/>
        <field name="domain_force">[
            '|', '|',
            ('user_id', '=', user.id),
            ('member_ids', 'in', user.id),
            ('task_ids.user_ids', 'in', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('bcm_project_group_user'))]"/>
    </record>

    <record id="bcm_project_rule_manager" model="ir.rule">
        <field name="name">BCM Project: Manager can see all projects</field>
        <field name="model_id" ref="base.model_project_project"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('bcm_project_group_manager'))]"/>
    </record>

    <!-- Task Rules -->
    <record id="bcm_task_rule_user" model="ir.rule">
        <field name="name">BCM Task: User can see assigned tasks or project tasks</field>
        <field name="model_id" ref="base.model_project_task"/>
        <field name="domain_force">[
            '|', '|', '|',
            ('user_ids', 'in', user.id),
            ('project_id.user_id', '=', user.id),
            ('project_id.member_ids', 'in', user.id),
            ('create_uid', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('bcm_project_group_user'))]"/>
    </record>

    <record id="bcm_task_rule_manager" model="ir.rule">
        <field name="name">BCM Task: Manager can see all tasks</field>
        <field name="model_id" ref="base.model_project_task"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('bcm_project_group_manager'))]"/>
    </record>

    <!-- AI Local Rules -->
    <record id="bcm_ai_local_rule_manager" model="ir.rule">
        <field name="name">BCM AI Local: Only managers can access AI</field>
        <field name="model_id" ref="model_bcm_project_ai_local"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('bcm_project_group_manager'))]"/>
    </record>

    <!-- AI Connector Rules -->
    <record id="bcm_ai_connector_rule_manager" model="ir.rule">
        <field name="name">BCM AI Connector: Only managers can access AI connectors</field>
        <field name="model_id" ref="model_bcm_ai_connector"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('bcm_project_group_manager'))]"/>
    </record>

    <!-- Company Rules -->
    <record id="bcm_project_company_rule" model="ir.rule">
        <field name="name">BCM Project: Multi-company</field>
        <field name="model_id" ref="base.model_project_project"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="bcm_task_company_rule" model="ir.rule">
        <field name="name">BCM Task: Multi-company</field>
        <field name="model_id" ref="base.model_project_task"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <!-- Folder security for documents (if documents module is present) -->
    <record id="bcm_project_folder_rule" model="ir.rule">
        <field name="name">BCM Project Folders: Access Control</field>
        <field name="model_id" ref="documents.model_documents_folder"/>
        <field name="domain_force">[
            '|',
            ('name', 'not ilike', 'BCM%'),
            ('user_ids', 'in', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('bcm_project_group_user'))]"/>
    </record>
</odoo>