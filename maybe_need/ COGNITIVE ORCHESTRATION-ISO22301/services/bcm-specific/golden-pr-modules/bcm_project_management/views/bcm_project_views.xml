<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Enhanced Project Form View -->
    <record id="view_bcm_project_form" model="ir.ui.view">
        <field name="name">bcm.project.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <!-- Add BCM badge in header -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_view_health_dashboard"
                        type="object" icon="fa-heartbeat"
                        attrs="{'invisible': [('bcm_type', '=', False)]}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="health_score" widget="percentage"/>
                        </span>
                        <span class="o_stat_text">
                            <field name="health_status" widget="badge"
                                   decoration-success="health_status == 'healthy'"
                                   decoration-warning="health_status == 'warning'"
                                   decoration-danger="health_status == 'critical'"/>
                        </span>
                    </div>
                </button>

                <button class="oe_stat_button" name="action_view_risks"
                        type="object" icon="fa-exclamation-triangle"
                        attrs="{'invisible': [('bcm_type', '=', False)]}">
                    <field name="ai_risk_score" widget="statinfo" string="Risk Score"/>
                </button>

                <button class="oe_stat_button" name="action_view_overdue_tasks"
                        type="object" icon="fa-clock-o"
                        attrs="{'invisible': [('tasks_overdue_count', '=', 0)]}">
                    <field name="tasks_overdue_count" widget="statinfo" string="Overdue"/>
                </button>
            </xpath>

            <!-- Add BCM Type selection at top -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="bcm_type" placeholder="Select BCM Project Type..."
                       class="oe_inline"
                       attrs="{'required': [('bcm_type', '!=', False)]}"
                       options="{'no_create': True}"/>
            </xpath>

            <!-- Add BCM tab in notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="BCM Configuration" attrs="{'invisible': [('bcm_type', '=', False)]}">
                    <group>
                        <group string="Project Criticality">
                            <field name="criticality_level" widget="selection_badge"/>
                            <field name="criticality_score" widget="progressbar"
                                   options="{'current_value': 'criticality_score', 'max_value': 10, 'editable': false}"/>
                            <field name="smart_deadline" widget="remaining_days"
                                   attrs="{'invisible': [('smart_deadline', '=', False)]}"/>
                        </group>
                        <group string="Recovery Objectives" attrs="{'invisible': [('bcm_type', '!=', 'recovery')]}">
                            <label for="recovery_time_objective"/>
                            <div class="o_row">
                                <field name="recovery_time_objective" widget="float_time"/>
                                <span>hours</span>
                            </div>
                            <label for="recovery_point_objective"/>
                            <div class="o_row">
                                <field name="recovery_point_objective" widget="float_time"/>
                                <span>hours</span>
                            </div>
                            <label for="maximum_tolerable_downtime"/>
                            <div class="o_row">
                                <field name="maximum_tolerable_downtime" widget="float_time"/>
                                <span>hours</span>
                            </div>
                        </group>
                    </group>

                    <group string="Automation Settings">
                        <field name="auto_escalate"/>
                        <field name="auto_assign"/>
                        <field name="auto_notify"/>
                    </group>

                    <group string="Project Metrics" class="o_group_col_6">
                        <field name="overall_progress" widget="progressbar"/>
                        <field name="tasks_at_risk_count"/>
                        <field name="health_score" widget="gauge"
                               options="{'style': 'width:120px; height: 90px;',
                                        'max_value': 100,
                                        'color_field': 'health_status'}"/>
                    </group>
                </page>

                <page string="AI Insights" attrs="{'invisible': [('ai_insights', '=', False)]}">
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-lightbulb-o"/> AI-powered insights and recommendations
                    </div>
                    <field name="ai_insights" widget="html" readonly="1"/>

                    <group string="AI Recommendations" attrs="{'invisible': [('ai_recommendations', '=', False)]}">
                        <field name="ai_recommendations" widget="json_viewer" readonly="1"/>
                    </group>
                </page>
            </notebook>

            <!-- Add quick actions in header -->
            <xpath expr="//header" position="inside">
                <button name="action_generate_recovery_plan" string="Generate Recovery Plan"
                        type="object" class="btn-primary"
                        attrs="{'invisible': [('bcm_type', '!=', 'recovery')]}"/>
                <button name="action_run_health_check" string="Health Check"
                        type="object" class="btn-info"/>
                <button name="action_escalate" string="Escalate"
                        type="object" class="btn-warning"
                        attrs="{'invisible': [('health_status', 'not in', ['critical', 'blocked'])]}"/>
            </xpath>
        </field>
    </record>

    <!-- BCM Project Kanban View -->
    <record id="view_bcm_project_kanban" model="ir.ui.view">
        <field name="name">bcm.project.kanban</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="default_order">health_score asc, criticality_score desc</attribute>
            </xpath>

            <xpath expr="//templates" position="inside">
                <t t-name="bcm_project_card">
                    <div class="oe_kanban_global_click">
                        <div class="o_kanban_card_header">
                            <div class="o_kanban_card_header_title">
                                <div class="o_primary">
                                    <field name="name"/>
                                    <field name="bcm_type" widget="badge" class="ml-2"/>
                                </div>
                            </div>
                            <div class="o_kanban_manage_button_section">
                                <a class="o_kanban_manage_toggle_button" href="#"><i class="fa fa-ellipsis-v"/></a>
                            </div>
                        </div>

                        <div class="o_kanban_card_content">
                            <div class="row">
                                <div class="col-6">
                                    <span class="text-muted">Health:</span>
                                    <field name="health_status" widget="badge"
                                           decoration-success="health_status == 'healthy'"
                                           decoration-warning="health_status == 'warning'"
                                           decoration-danger="health_status == 'critical'"/>
                                </div>
                                <div class="col-6 text-right">
                                    <field name="health_score" widget="percentage"/>
                                </div>
                            </div>

                            <div class="mt-2">
                                <field name="overall_progress" widget="progressbar"/>
                            </div>

                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span t-if="record.tasks_overdue_count.raw_value > 0"
                                          class="badge badge-danger">
                                        <i class="fa fa-warning"/> <t t-esc="record.tasks_overdue_count.value"/> overdue
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </xpath>
        </field>
    </record>

    <!-- BCM Project Tree View -->
    <record id="view_bcm_project_tree" model="ir.ui.view">
        <field name="name">bcm.project.tree</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-danger">health_status == 'critical'</attribute>
                <attribute name="decoration-warning">health_status == 'warning'</attribute>
                <attribute name="decoration-success">health_status == 'healthy'</attribute>
            </xpath>

            <xpath expr="//field[@name='name']" position="after">
                <field name="bcm_type" optional="show"/>
                <field name="criticality_level" widget="badge" optional="show"/>
                <field name="health_status" widget="badge" optional="show"/>
                <field name="health_score" widget="percentage" optional="show"/>
                <field name="overall_progress" widget="progressbar" optional="show"/>
                <field name="tasks_overdue_count" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- BCM Dashboard View -->
    <record id="view_bcm_project_dashboard" model="ir.ui.view">
        <field name="name">BCM Projects Dashboard</field>
        <field name="model">project.project</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <dashboard>
                <view type="graph"/>
                <view type="pivot"/>
                <group>
                    <group>
                        <aggregate name="total_projects" string="Active BCM Projects"
                                  field="id" group_operator="count"
                                  domain="[('bcm_type', '!=', False)]"/>
                        <aggregate name="critical_projects" string="Critical Projects"
                                  field="id" group_operator="count"
                                  domain="[('health_status', '=', 'critical')]"
                                  widget="integer"
                                  value_color="danger"/>
                    </group>
                    <group>
                        <aggregate name="avg_health" string="Avg Health Score"
                                  field="health_score" group_operator="avg"
                                  widget="percentage"/>
                        <aggregate name="overdue_tasks_total" string="Total Overdue Tasks"
                                  field="tasks_overdue_count" group_operator="sum"
                                  widget="integer"/>
                    </group>
                </group>
                <view type="kanban" ref="view_bcm_project_kanban"/>
            </dashboard>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_bcm_project_search" model="ir.ui.view">
        <field name="name">bcm.project.search</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="BCM Projects" name="bcm_projects"
                        domain="[('bcm_type', '!=', False)]"/>
                <separator/>
                <filter string="Critical" name="critical"
                        domain="[('health_status', '=', 'critical')]"/>
                <filter string="At Risk" name="at_risk"
                        domain="[('health_status', '=', 'warning')]"/>
                <filter string="Healthy" name="healthy"
                        domain="[('health_status', '=', 'healthy')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="BCM Type" name="group_bcm_type"
                            context="{'group_by': 'bcm_type'}"/>
                    <filter string="Health Status" name="group_health"
                            context="{'group_by': 'health_status'}"/>
                    <filter string="Criticality" name="group_criticality"
                            context="{'group_by': 'criticality_level'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>