<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- BCM Admin Modules Management Template -->
    <template id="admin_modules_template" name="BCM Admin Modules">
        <t t-call="website.layout">
            <t t-set="title">BCM Modules Management</t>

            <!-- Embedded CSS -->
            <style>
                .bcm-admin-modules {
                    background-color: #f8f9fa;
                    min-height: 100vh;
                }

                .admin-header {
                    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
                }

                .module-card-link {
                    text-decoration: none;
                    color: inherit;
                }

                .module-card-link:hover .card {
                    transform: translateY(-5px);
                    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
                }

                .module-icon {
                    width: 60px;
                    height: 60px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 1.5rem;
                    border-radius: 12px;
                }
            </style>

            <div id="wrap" class="bcm-admin-modules">
                <!-- Header -->
                <div class="admin-header bg-primary text-white py-4">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h1 class="mb-0">
                                    <i class="fa fa-cubes me-3"></i>
                                    BCM Modules Management
                                </h1>
                                <p class="mb-0 mt-2">Manage all 22 Business Continuity Management modules</p>
                            </div>
                            <div class="col-md-4 text-end">
                                <a href="/bcm/admin" class="btn btn-light">
                                    <i class="fa fa-arrow-left me-1"></i>Back to Dashboard
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Content -->
                <div class="container my-4">
                    <!-- All Modules Grid -->
                    <div class="row">
                        <t t-foreach="modules" t-as="module">
                            <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
                                <a t-attf-href="/bcm/admin/module/#{module.get('name', '')}" class="module-card-link">
                                    <div t-attf-class="card border-#{module.get('color', 'primary')} h-100">
                                        <div class="card-body text-center">
                                            <div t-attf-class="module-icon bg-#{module.get('color', 'primary')} text-white rounded-circle mb-3 mx-auto">
                                                <i t-attf-class="fa #{module.get('icon', 'fa-cube')}"></i>
                                            </div>
                                            <h6 class="card-title"><t t-esc="module.get('title', '')"/></h6>
                                            <p class="card-text text-muted small">
                                                <t t-esc="module.get('description', '')"/>
                                            </p>
                                            <div class="module-stats">
                                                <span class="badge bg-light text-dark">
                                                    <t t-esc="module.get('records_count', 0)"/> records
                                                </span>
                                                <span t-attf-class="badge bg-#{module.get('color', 'primary')} ms-1">
                                                    <t t-esc="module.get('status', 'active')"/>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>