<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- BCM Admin Dashboard Template -->
    <template id="admin_dashboard_template" name="BCM Admin Dashboard">
        <t t-call="website.layout">
            <t t-set="title">BCM Admin Dashboard</t>

            <!-- Embedded CSS Styles -->
            <style>
                .bcm-admin-dashboard {
                    background-color: #f8f9fa;
                    min-height: 100vh;
                }

                .admin-header {
                    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
                }

                .admin-nav .nav-link {
                    color: rgba(255, 255, 255, 0.8);
                    border-radius: 6px;
                    margin-right: 0.5rem;
                }

                .admin-nav .nav-link:hover,
                .admin-nav .nav-link.active {
                    color: white;
                    background-color: rgba(255, 255, 255, 0.1);
                }

                .stat-card {
                    transition: transform 0.2s ease, box-shadow 0.2s ease;
                }

                .stat-card:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15) !important;
                }

                .stat-icon {
                    width: 50px;
                    height: 50px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 1.2rem;
                }

                .activity-icon {
                    width: 35px;
                    height: 35px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 0.9rem;
                    flex-shrink: 0;
                }

                .quick-action-card {
                    text-decoration: none;
                    color: inherit;
                }

                .quick-action-card .card {
                    transition: transform 0.2s ease, box-shadow 0.2s ease;
                }

                .quick-action-card:hover .card {
                    transform: translateY(-3px);
                    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
                    text-decoration: none;
                    color: inherit;
                }

                .progress {
                    height: 8px;
                    border-radius: 4px;
                }

                .health-item {
                    padding: 0.5rem 0;
                    border-bottom: 1px solid #f0f0f0;
                }

                .health-item:last-child {
                    border-bottom: none;
                }
            </style>

            <div id="wrap" class="bcm-admin-dashboard">
                <!-- Header -->
                <div class="admin-header bg-primary text-white py-4">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h1 class="mb-0">
                                    <i class="fa fa-shield-alt me-3"></i>
                                    BCM Admin Dashboard
                                </h1>
                                <p class="mb-0 mt-2">Business Continuity Management System Administration</p>
                            </div>
                            <div class="col-md-4 text-end">
                                <div class="admin-user-info">
                                    <span class="me-3">
                                        <i class="fa fa-user me-1"></i>
                                        <t t-esc="user.name"/>
                                    </span>
                                    <span class="badge bg-light text-dark">
                                        <i class="fa fa-clock me-1"></i>
                                        <span id="current-time"></span>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Navigation -->
                <div class="admin-nav bg-dark py-2">
                    <div class="container">
                        <ul class="nav nav-pills">
                            <li class="nav-item">
                                <a class="nav-link active" href="/bcm/admin">
                                    <i class="fa fa-tachometer-alt me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/bcm/admin/modules">
                                    <i class="fa fa-cubes me-1"></i>Modules
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/bcm/admin/ai">
                                    <i class="fa fa-robot me-1"></i>AI Organs
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/bcm/admin/users">
                                    <i class="fa fa-users me-1"></i>Users
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Main Content -->
                <div class="container my-4">
                    <!-- Statistics Cards -->
                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="stat-card card border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="stat-icon bg-danger text-white rounded-circle me-3">
                                            <i class="fa fa-exclamation-triangle"></i>
                                        </div>
                                        <div>
                                            <h4 class="mb-0"><t t-esc="stats.get('open_incidents', 3)"/></h4>
                                            <p class="text-muted mb-0">Open Incidents</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card card border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="stat-icon bg-warning text-white rounded-circle me-3">
                                            <i class="fa fa-shield-alt"></i>
                                        </div>
                                        <div>
                                            <h4 class="mb-0"><t t-esc="stats.get('high_risks', 7)"/></h4>
                                            <p class="text-muted mb-0">High Risks</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card card border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="stat-icon bg-success text-white rounded-circle me-3">
                                            <i class="fa fa-file-alt"></i>
                                        </div>
                                        <div>
                                            <h4 class="mb-0"><t t-esc="stats.get('active_plans', 12)"/></h4>
                                            <p class="text-muted mb-0">Active Plans</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card card border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex align-items-center">
                                        <div class="stat-icon bg-info text-white rounded-circle me-3">
                                            <i class="fa fa-users"></i>
                                        </div>
                                        <div>
                                            <h4 class="mb-0"><t t-esc="stats.get('total_users', 24)"/></h4>
                                            <p class="text-muted mb-0">Total Users</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- System Health -->
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-white border-bottom">
                                    <h5 class="mb-0">
                                        <i class="fa fa-heartbeat me-2 text-success"></i>
                                        System Health
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="health-indicators">
                                        <div class="health-item d-flex justify-content-between align-items-center mb-2">
                                            <span>
                                                <i class="fa fa-database me-2"></i>Database
                                            </span>
                                            <span class="badge bg-success">Healthy</span>
                                        </div>
                                        <div class="health-item d-flex justify-content-between align-items-center mb-2">
                                            <span>
                                                <i class="fa fa-server me-2"></i>Redis Cache
                                            </span>
                                            <span class="badge bg-success">Healthy</span>
                                        </div>
                                        <div class="health-item d-flex justify-content-between align-items-center mb-2">
                                            <span>
                                                <i class="fa fa-robot me-2"></i>AI Services
                                            </span>
                                            <span class="badge bg-success">Healthy</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Actions -->
                        <div class="col-md-6 mb-4">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-white border-bottom">
                                    <h5 class="mb-0">
                                        <i class="fa fa-bolt me-2 text-warning"></i>
                                        Quick Actions
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-6 mb-3">
                                            <a href="/bcm/admin/modules" class="quick-action-card">
                                                <div class="card text-center border-primary">
                                                    <div class="card-body">
                                                        <i class="fa fa-cubes fa-2x text-primary mb-2"></i>
                                                        <h6>Manage Modules</h6>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <a href="/bcm/admin/ai" class="quick-action-card">
                                                <div class="card text-center border-dark">
                                                    <div class="card-body">
                                                        <i class="fa fa-robot fa-2x text-dark mb-2"></i>
                                                        <h6>AI Organs</h6>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Embedded JavaScript -->
            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    // Update current time
                    function updateTime() {
                        const now = new Date();
                        const timeString = now.toLocaleTimeString();
                        const timeElement = document.getElementById('current-time');
                        if (timeElement) {
                            timeElement.textContent = timeString;
                        }
                    }

                    updateTime();
                    setInterval(updateTime, 1000);
                });
            </script>
        </t>
    </template>
</odoo>