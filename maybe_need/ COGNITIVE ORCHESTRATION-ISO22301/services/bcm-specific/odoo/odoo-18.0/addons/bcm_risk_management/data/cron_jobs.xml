<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Real-time Risk Monitoring (Every 15 minutes) -->
        <record id="cron_risk_monitoring" model="ir.cron">
            <field name="name">BCM Risk: Real-time Monitoring</field>
            <field name="model_id" ref="model_bcm_risk_monitor"/>
            <field name="state">code</field>
            <field name="code">model.monitor_risks_realtime()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">3</field>
        </record>
        
        <!-- Daily Risk Assessment Update -->
        <record id="cron_risk_assessment_update" model="ir.cron">
            <field name="name">BCM Risk: Daily Assessment Update</field>
            <field name="model_id" ref="model_bcm_risk_assessment"/>
            <field name="state">code</field>
            <field name="code">model.update_risk_assessments()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">6</field>
        </record>
        
        <!-- Weekly Risk Report Generation -->
        <record id="cron_risk_report_generation" model="ir.cron">
            <field name="name">BCM Risk: Weekly Report Generation</field>
            <field name="model_id" ref="model_bcm_risk_register"/>
            <field name="state">code</field>
            <field name="code">model.generate_weekly_risk_report()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
            <field name="priority">15</field>
        </record>
        
        <!-- Risk Mitigation Deadline Alerts (Daily) -->
        <record id="cron_mitigation_deadline_alerts" model="ir.cron">
            <field name="name">BCM Risk: Mitigation Deadline Alerts</field>
            <field name="model_id" ref="model_bcm_risk_mitigation"/>
            <field name="state">code</field>
            <field name="code">model.check_mitigation_deadlines()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="priority">7</field>
        </record>
    </data>
</odoo>
