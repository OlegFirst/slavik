<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Extend Portal Layout -->
        <template id="portal_layout_bcm" inherit_id="portal.portal_layout">
            <xpath expr="//div[@id='wrap']" position="inside">
                <t t-if="page_name and 'bcm' in page_name">
                    <div class="alert alert-info d-none d-md-block mt-3">
                        <i class="fa fa-shield"/> 
                        <strong>BCM Portal:</strong> Business Continuity Management Dashboard
                        <t t-if="client">
                            for <strong t-esc="client.name"/>
                        </t>
                    </div>
                </t>
            </xpath>
        </template>

        <!-- Portal Menu Extension -->
        <template id="portal_my_home_bcm" inherit_id="portal.portal_my_home">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
                <t t-set="bcm_client" t-value="request.env['bcm.client.contact'].search([('user_id', '=', request.env.user.id)], limit=1).client_id"/>
                <t t-if="bcm_client">
                    <div class="col-lg-6">
                        <div class="card">
                            <div class="card-header">
                                <h5><i class="fa fa-shield"/> Business Continuity</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-6">
                                        <a href="/my/bcm" class="btn btn-primary btn-block">
                                            <i class="fa fa-dashboard"/> BCM Dashboard
                                        </a>
                                    </div>
                                    <div class="col-6">
                                        <a href="/my/bcm/bia" class="btn btn-outline-primary btn-block">
                                            <i class="fa fa-chart-line"/> BIA Analysis
                                        </a>
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-6">
                                        <a href="/my/bcm/plans" class="btn btn-outline-primary btn-block">
                                            <i class="fa fa-file-text"/> Plans
                                        </a>
                                    </div>
                                    <div class="col-6">
                                        <a href="/my/bcm/exercises" class="btn btn-outline-primary btn-block">
                                            <i class="fa fa-play-circle"/> Exercises
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </xpath>
        </template>

        <!-- No Client Access Template -->
        <template id="no_client_access" name="No BCM Client Access">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="card">
                                <div class="card-body text-center">
                                    <div class="mb-4">
                                        <i class="fa fa-exclamation-triangle fa-5x text-warning"/>
                                    </div>
                                    <h3>Access Restricted</h3>
                                    <p class="lead">
                                        <span t-esc="error_message or 'You do not have access to BCM client data.'"/>
                                    </p>
                                    <div class="mt-4">
                                        <p>To gain access to the BCM Portal:</p>
                                        <ol class="text-left">
                                            <li>Contact your BCM Administrator</li>
                                            <li>Request to be added as a BCM Client Contact</li>
                                            <li>Ensure your user account is properly configured</li>
                                        </ol>
                                    </div>
                                    <div class="mt-4">
                                        <a href="/my" class="btn btn-primary">
                                            <i class="fa fa-arrow-left"/> Back to Portal
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- BCM Portal Navigation -->
        <template id="bcm_portal_nav" name="BCM Portal Navigation">
            <div class="bcm-portal-nav">
                <ul class="nav nav-pills nav-justified">
                    <li class="nav-item">
                        <a class="nav-link" t-attf-class="{{'active' if page_name == 'bcm_dashboard' else ''}}" 
                           href="/my/bcm">
                            <i class="fa fa-dashboard"/> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" t-attf-class="{{'active' if page_name == 'bia' else ''}}"
                           href="/my/bcm/bia">
                            <i class="fa fa-chart-line"/> BIA
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" t-attf-class="{{'active' if page_name == 'plans' else ''}}"
                           href="/my/bcm/plans">
                            <i class="fa fa-file-text"/> Plans
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" t-attf-class="{{'active' if page_name == 'incidents' else ''}}"
                           href="/my/bcm/incidents">
                            <i class="fa fa-exclamation-circle"/> Incidents
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" t-attf-class="{{'active' if page_name == 'exercises' else ''}}"
                           href="/my/bcm/exercises">
                            <i class="fa fa-play-circle"/> Exercises
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" t-attf-class="{{'active' if page_name == 'audit' else ''}}"
                           href="/my/bcm/audit">
                            <i class="fa fa-search"/> Audit
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" t-attf-class="{{'active' if page_name == 'training' else ''}}"
                           href="/my/bcm/training">
                            <i class="fa fa-graduation-cap"/> Training
                        </a>
                    </li>
                </ul>
            </div>
        </template>

        <!-- BCM Portal Base Layout -->
        <template id="bcm_portal_base" name="BCM Portal Base">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                
                <div class="container-fluid">
                    <!-- Navigation -->
                    <t t-call="bcm_portal.bcm_portal_nav"/>
                    
                    <!-- Client Info Header -->
                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="card bg-primary text-white">
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-md-8">
                                            <h4 class="mb-1">
                                                <i class="fa fa-building"/> 
                                                <span t-esc="client.name"/>
                                            </h4>
                                            <p class="mb-0">
                                                <span class="badge badge-light mr-2" t-esc="client.sector"/>
                                                <span class="badge badge-light mr-2" t-esc="client.region"/>
                                                <span class="badge badge-success" t-if="client.status == 'active'">Active</span>
                                                <span class="badge badge-warning" t-if="client.status == 'suspended'">Suspended</span>
                                            </p>
                                        </div>
                                        <div class="col-md-4 text-right">
                                            <p class="mb-1">
                                                <strong>Onboarding Stage:</strong><br/>
                                                <span class="badge badge-light" t-esc="client.onboarding_stage"/>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Page Content -->
                    <div class="mt-3">
                        <t t-raw="0"/>
                    </div>
                </div>
            </t>
        </template>

    </data>
</odoo>
