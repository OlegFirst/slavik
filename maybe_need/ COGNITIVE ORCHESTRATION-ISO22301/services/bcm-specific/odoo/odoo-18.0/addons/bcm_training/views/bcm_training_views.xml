<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- BCM Training Views -->

        <!-- Training List View -->
        <record id="view_bcm_training_list" model="ir.ui.view">
            <field name="name">bcm.training.list</field>
            <field name="model">bcm.training</field>
            <field name="arch" type="xml">
                <list string="BCM Training Records">
                    <field name="name"/>
                    <field name="active"/>
                    <field name="company_id"/>
                </list>
            </field>
        </record>

        <!-- Training Form View -->
        <record id="view_bcm_training_form" model="ir.ui.view">
            <field name="name">bcm.training.form</field>
            <field name="model">bcm.training</field>
            <field name="arch" type="xml">
                <form string="BCM Training Record">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="notes"/>
                            <field name="company_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Training Actions -->
        <record id="action_bcm_training" model="ir.actions.act_window">
            <field name="name">BCM Training Records</field>
            <field name="res_model">bcm.training</field>
            <field name="view_mode">list,form</field>
            <field name="help">Manage BCM training and competency records</field>
        </record>

        <!-- Training Menu -->
        <record id="menu_bcm_training" model="ir.ui.menu">
            <field name="name">Training</field>
            <field name="parent_id" ref="bcm_core.menu_bcm_root"/>
            <field name="action" ref="action_bcm_training"/>
            <field name="sequence">15</field>
        </record>

    </data>
</odoo>