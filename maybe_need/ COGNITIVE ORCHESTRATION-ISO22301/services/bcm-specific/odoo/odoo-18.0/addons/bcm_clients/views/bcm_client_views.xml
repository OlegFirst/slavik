<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- BCM Client Tree View -->
        <record id="bcm_client_view_tree" model="ir.ui.view">
            <field name="name">bcm.client.tree</field>
            <field name="model">bcm.client</field>
            <field name="arch" type="xml">
                <list string="BCM Clients" decoration-success="status=='active'" 
                      decoration-muted="status=='archived'" decoration-warning="status=='suspended'">
                    <field name="name"/>
                    <field name="sector"/>
                    <field name="region"/>
                    <field name="onboarding_stage"/>
                    <field name="status"/>
                    <field name="dpa_signed"/>
                    <field name="data_residency"/>
                    <field name="contact_count"/>
                    <field name="bia_coverage"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <!-- BCM Client Form View -->
        <record id="bcm_client_view_form" model="ir.ui.view">
            <field name="name">bcm.client.form</field>
            <field name="model">bcm.client</field>
            <field name="arch" type="xml">
                <form string="BCM Client">
                    <header>
                        <field name="status" widget="statusbar" 
                               statusbar_visible="onboarding,active,suspended,archived"/>
                        <button name="action_reindex_context" type="object" 
                                string="Reindex Context" class="btn-primary"
                                confirm="This will reindex all client context in the AI system. Continue?"/>
                        <button name="action_archive_client" type="object" 
                                string="Archive" class="btn-secondary"
                                invisible="status == 'archived'"
                                confirm="Are you sure you want to archive this client?"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object" 
                                    name="action_view_contacts" icon="fa-users">
                                <field string="Contacts" name="contact_count" widget="statinfo"/>
                            </button>
                            <button class="oe_stat_button" type="object" 
                                    name="action_view_vault" icon="fa-database">
                                <field string="Context" name="vault_count" widget="statinfo"/>
                            </button>
                            <button class="oe_stat_button" type="object" 
                                    name="action_view_appkeys" icon="fa-key">
                                <field string="API Keys" name="appkey_count" widget="statinfo"/>
                            </button>
                            <button class="oe_stat_button" type="object" 
                                    name="action_view_processes" icon="fa-cogs">
                                <field string="Processes" name="process_count" widget="statinfo"/>
                            </button>
                            <button class="oe_stat_button" type="object" 
                                    name="action_view_bia" icon="fa-chart-line">
                                <field string="BIA" name="bia_count" widget="statinfo"/>
                            </button>
                            <button class="oe_stat_button" type="object" 
                                    name="action_view_plans" icon="fa-shield-alt">
                                <field string="Plans" name="plan_count" widget="statinfo"/>
                            </button>
                            <button class="oe_stat_button" type="object" 
                                    name="action_view_incidents" icon="fa-exclamation-triangle">
                                <field string="Incidents" name="incident_count" widget="statinfo"/>
                            </button>
                        </div>
                        
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Organization Name"/>
                            </h1>
                        </div>
                        
                        <notebook>
                            <page string="General Information" name="general">
                                <group>
                                    <group string="Organization Details">
                                        <field name="sector"/>
                                        <field name="region"/>
                                        <field name="company_id" groups="base.group_multi_company"/>
                                    </group>
                                    <group string="Onboarding &amp; Status">
                                        <field name="onboarding_stage"/>
                                        <field name="dpa_signed"/>
                                        <field name="data_residency"/>
                                    </group>
                                </group>
                                <group string="Notes">
                                    <field name="notes" nolabel="1"/>
                                </group>
                            </page>
                            
                            <page string="BCM Metrics" name="metrics">
                                <group>
                                    <group string="Coverage Metrics">
                                        <field name="bia_coverage" widget="percentage"/>
                                        <field name="plans_freshness"/>
                                        <field name="open_findings"/>
                                    </group>
                                    <group string="Activity">
                                        <!-- TODO: Add activity metrics -->
                                    </group>
                                </group>
                            </page>
                            
                            <page string="Contacts" name="contacts">
                                <field name="contact_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="email"/>
                                        <field name="role"/>
                                        <field name="is_primary"/>
                                        <field name="last_login"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                            </page>
                            
                            <page string="Context Vault" name="vault">
                                <field name="vault_ids">
                                    <list>
                                        <field name="context_type"/>
                                        <field name="name"/>
                                        <field name="sensitivity_level"/>
                                        <field name="indexed"/>
                                        <field name="updated_at"/>
                                    </list>
                                </field>
                            </page>
                            
                            <page string="API Keys" name="api_keys">
                                <field name="appkey_ids">
                                    <list decoration-danger="revoked" decoration-warning="is_expired">
                                        <field name="name"/>
                                        <field name="status_display"/>
                                        <field name="valid_until"/>
                                        <field name="last_used"/>
                                        <field name="usage_count"/>
                                        <field name="revoked" invisible="1"/>
                                        <field name="is_expired" invisible="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- BCM Client Kanban View -->
        <record id="bcm_client_view_kanban" model="ir.ui.view">
            <field name="name">bcm.client.kanban</field>
            <field name="model">bcm.client</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name"/>
                    <field name="sector"/>
                    <field name="onboarding_stage"/>
                    <field name="status"/>
                    <field name="contact_count"/>
                    <field name="bia_coverage"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                        <div class="o_kanban_record_body">
                                            <field name="sector" widget="badge"/>
                                            <br/>
                                            <field name="onboarding_stage" widget="badge"/>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="status" widget="label_selection"/>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <span title="Contacts"><i class="fa fa-users"/> <field name="contact_count"/></span>
                                            <span title="BIA Coverage"><i class="fa fa-chart-pie"/> <field name="bia_coverage"/>%</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- BCM Client Search View -->
        <record id="bcm_client_view_search" model="ir.ui.view">
            <field name="name">bcm.client.search</field>
            <field name="model">bcm.client</field>
            <field name="arch" type="xml">
                <search string="Search BCM Clients">
                    <field name="name" string="Organization" 
                           filter_domain="['|', ('name', 'ilike', self), ('notes', 'ilike', self)]"/>
                    <field name="sector"/>
                    <field name="region"/>
                    <field name="onboarding_stage"/>
                    
                    <separator/>
                    <filter string="Active" name="active" 
                            domain="[('status', '=', 'active')]"/>
                    <filter string="Onboarding" name="onboarding" 
                            domain="[('status', '=', 'onboarding')]"/>
                    <filter string="DPA Signed" name="dpa_signed" 
                            domain="[('dpa_signed', '=', True)]"/>
                    <filter string="Live Clients" name="live" 
                            domain="[('onboarding_stage', '=', 'live')]"/>
                    
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_status" 
                                domain="[]" context="{'group_by': 'status'}"/>
                        <filter string="Sector" name="group_sector" 
                                domain="[]" context="{'group_by': 'sector'}"/>
                        <filter string="Onboarding Stage" name="group_onboarding" 
                                domain="[]" context="{'group_by': 'onboarding_stage'}"/>
                        <filter string="Data Residency" name="group_residency" 
                                domain="[]" context="{'group_by': 'data_residency'}"/>
                        <filter string="Company" name="group_company" 
                                domain="[]" context="{'group_by': 'company_id'}" 
                                groups="base.group_multi_company"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- BCM Client Action -->
        <record id="bcm_client_action" model="ir.actions.act_window">
            <field name="name">BCM Clients</field>
            <field name="res_model">bcm.client</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first BCM Client!
                </p>
                <p>
                    Add client organizations to start their Business Continuity Management journey.
                    Each client will have isolated data and dedicated BCM resources.
                </p>
            </field>
        </record>

    </data>
</odoo>
