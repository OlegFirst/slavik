<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- BCM Plan List View -->
        <record id="view_bcm_plan_tree" model="ir.ui.view">
            <field name="name">bcm.plan.tree</field>
            <field name="model">bcm.plan</field>
            <field name="arch" type="xml">
                <list string="BCM Plans">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="plan_type"/>
                    <field name="status" decoration-success="status=='active'" decoration-info="status=='approved'" decoration-muted="status=='draft'"/>
                    <field name="rto_hours"/>
                    <field name="rpo_hours"/>
                    <field name="last_review_date"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <!-- BCM Plan Form View -->
        <record id="view_bcm_plan_form" model="ir.ui.view">
            <field name="name">bcm.plan.form</field>
            <field name="model">bcm.plan</field>
            <field name="arch" type="xml">
                <form string="BCM Plan">
                    <header>
                        <field name="status" widget="statusbar" statusbar_visible="draft,under_review,approved,active"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Plan Name..."/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="plan_type"/>
                                <field name="sequence"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group>
                                <field name="rto_hours"/>
                                <field name="rpo_hours"/>
                                <field name="estimated_cost"/>
                            </group>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                        <notebook>
                            <page string="Procedures">
                                <group>
                                    <field name="recovery_procedures" widget="html"/>
                                </group>
                            </page>
                            <page string="Activation">
                                <group>
                                    <field name="activation_criteria" widget="html"/>
                                </group>
                            </page>
                            <page string="Contacts">
                                <group>
                                    <field name="contact_list" widget="html"/>
                                </group>
                            </page>
                            <page string="Business Processes">
                                <field name="business_process_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="criticality"/>
                                        <field name="rto_target"/>
                                        <field name="rpo_target"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Incidents">
                                <field name="incident_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="severity"/>
                                        <field name="status"/>
                                        <field name="reported_date"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Compliance">
                                <group>
                                    <group>
                                        <field name="iso_clause"/>
                                        <field name="compliance_status"/>
                                    </group>
                                    <group>
                                        <field name="last_review_date"/>
                                        <field name="next_review_date"/>
                                    </group>
                                </group>
                                <group>
                                    <field name="tag_ids" widget="many2many_tags"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- BCM Plan Search View -->
        <record id="view_bcm_plan_search" model="ir.ui.view">
            <field name="name">bcm.plan.search</field>
            <field name="model">bcm.plan</field>
            <field name="arch" type="xml">
                <search string="Search BCM Plans">
                    <field name="name"/>
                    <field name="plan_type"/>
                    <field name="status"/>
                    <filter string="Draft" name="draft" domain="[('status','=','draft')]"/>
                    <filter string="Active" name="active" domain="[('status','=','active')]"/>
                    <filter string="Approved" name="approved" domain="[('status','=','approved')]"/>
                    <separator/>
                    <filter string="Recovery Plans" name="recovery" domain="[('plan_type','=','recovery')]"/>
                    <filter string="Emergency Response" name="emergency" domain="[('plan_type','=','emergency')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Plan Type" name="group_type" context="{'group_by':'plan_type'}"/>
                        <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- BCM Plan Action -->
        <record id="action_bcm_plan" model="ir.actions.act_window">
            <field name="name">BCM Plans</field>
            <field name="res_model">bcm.plan</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_bcm_plan_search"/>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first BCM Plan
                </p>
                <p>
                    BCM Plans define the procedures and steps to take during a business continuity event.
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_bcm_plans"
                  name="Plans"
                  parent="menu_bcm_root"
                  action="action_bcm_plan"
                  sequence="20"/>
    </data>
</odoo>