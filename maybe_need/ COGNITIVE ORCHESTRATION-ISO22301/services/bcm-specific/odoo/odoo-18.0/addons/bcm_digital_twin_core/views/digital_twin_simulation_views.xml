<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_digital_twin_simulation_tree" model="ir.ui.view">
        <field name="name">bcm.digital.twin.simulation.tree</field>
        <field name="model">bcm.digital.twin.simulation</field>
        <field name="arch" type="xml">
            <list string="Digital Twin Simulations">
                <field name="name"/>
                <field name="organization_id"/>
                <field name="scenario_type"/>
                <field name="state" widget="badge"/>
                <field name="confidence_score" widget="progressbar"/>
                <field name="execution_time"/>
                <field name="completion_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_digital_twin_simulation_form" model="ir.ui.view">
        <field name="name">bcm.digital.twin.simulation.form</field>
        <field name="model">bcm.digital.twin.simulation</field>
        <field name="arch" type="xml">
            <form string="Digital Twin Simulation">
                <header>
                    <button name="action_prepare_simulation" type="object" string="Prepare" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_run_simulation" type="object" string="Run Simulation" class="oe_highlight" invisible="state not in ['prepared', 'draft']"/>
                    <button name="action_rerun_simulation" type="object" string="Rerun" invisible="state not in ['completed', 'failed']"/>
                    <button name="action_run_simulation" type="object"
                            string="Run Simulation" class="oe_highlight"
                            invisible="state not in ['draft', 'prepared']"/>
                    <button name="action_rerun_simulation" type="object"
                            string="Rerun Simulation"
                            invisible="state not in ['completed', 'failed']"/>
                    <button name="action_prepare_simulation" type="object"
                            string="Prepare"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,running,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Simulation Name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Simulation Details">
                            <field name="organization_id" required="1"/>
                            <field name="scenario_type" required="1"/>
                            <field name="simulation_mode"/>
                            <field name="execution_type"/>
                        </group>
                        <group string="Configuration">
                            <field name="parameters" widget="text"/>
                            <field name="confidence_score" widget="progressbar"/>
                            <field name="execution_time"/>
                        </group>
                    </group>

                    <group string="Results">
                        <field name="results" widget="ace"
                               options="{'mode': 'json'}" readonly="1"/>
                    </group>

                    <group string="Dates">
                        <group>
                            <field name="start_date" readonly="1"/>
                            <field name="completion_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="write_date" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_digital_twin_simulation_search" model="ir.ui.view">
        <field name="name">bcm.digital.twin.simulation.search</field>
        <field name="model">bcm.digital.twin.simulation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="organization_id"/>
                <field name="scenario_type"/>

                <filter string="Running" name="running"
                        domain="[('state', '=', 'running')]"/>
                <filter string="Completed" name="completed"
                        domain="[('state', '=', 'completed')]"/>
                <filter string="Failed" name="failed"
                        domain="[('state', '=', 'failed')]"/>

                <separator/>

                <filter string="Crisis Response" name="crisis"
                        domain="[('scenario_type', '=', 'crisis_response')]"/>
                <filter string="Business Continuity" name="bcp"
                        domain="[('scenario_type', '=', 'business_continuity')]"/>
                <filter string="Risk Assessment" name="risk"
                        domain="[('scenario_type', '=', 'risk_assessment')]"/>

                <group expand="0" string="Group By">
                    <filter string="Organization" name="group_organization"
                            context="{'group_by': 'organization_id'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Scenario Type" name="group_scenario"
                            context="{'group_by': 'scenario_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_digital_twin_simulation" model="ir.actions.act_window">
        <field name="name">Digital Twin Simulations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">bcm.digital.twin.simulation</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Digital Twin Simulation
            </p>
            <p>
                Run simulations to test various scenarios and analyze
                their impact on your organization's business continuity.
            </p>
        </field>
    </record>
</odoo>