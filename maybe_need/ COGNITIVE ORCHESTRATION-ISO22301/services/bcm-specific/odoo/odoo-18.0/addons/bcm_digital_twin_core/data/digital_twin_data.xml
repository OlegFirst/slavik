<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

        <!-- Digital Twin Configuration Parameters -->
        <record id="default_twin_simulation_frequency" model="ir.config_parameter">
            <field name="key">bcm_digital_twin.default_simulation_frequency</field>
            <field name="value">monthly</field>
        </record>

        <record id="default_twin_analysis_depth" model="ir.config_parameter">
            <field name="key">bcm_digital_twin.default_analysis_depth</field>
            <field name="value">standard</field>
        </record>

        <record id="default_twin_prediction_horizon" model="ir.config_parameter">
            <field name="key">bcm_digital_twin.default_prediction_horizon</field>
            <field name="value">12</field>
        </record>

        <record id="enable_twin_auto_sync" model="ir.config_parameter">
            <field name="key">bcm_digital_twin.enable_auto_sync</field>
            <field name="value">True</field>
        </record>

        <record id="enable_twin_ai_analysis" model="ir.config_parameter">
            <field name="key">bcm_digital_twin.enable_ai_analysis</field>
            <field name="value">True</field>
        </record>

        <record id="enable_twin_predictions" model="ir.config_parameter">
            <field name="key">bcm_digital_twin.enable_predictions</field>
            <field name="value">True</field>
        </record>

        <!-- Digital Twin Bridge Configuration -->
        <record id="digital_twin_service_url" model="ir.config_parameter">
            <field name="key">bcm_digital_twin.service_url</field>
            <field name="value">http://localhost:3000</field>
        </record>

        <record id="digital_twin_service_timeout" model="ir.config_parameter">
            <field name="key">bcm_digital_twin.service_timeout</field>
            <field name="value">30</field>
        </record>

        <record id="digital_twin_retry_attempts" model="ir.config_parameter">
            <field name="key">bcm_digital_twin.retry_attempts</field>
            <field name="value">3</field>
        </record>

</odoo>