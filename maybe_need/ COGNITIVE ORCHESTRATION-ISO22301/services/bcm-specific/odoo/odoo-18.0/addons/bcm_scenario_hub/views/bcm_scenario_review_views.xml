<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Scenario Review Tree View -->
        <record id="view_bcm_scenario_review_tree" model="ir.ui.view">
            <field name="name">bcm.scenario.review.tree</field>
            <field name="model">bcm.scenario.review</field>
            <field name="arch" type="xml">
                <list string="Reviews" decoration-success="decision == 'approve'" 
                      decoration-danger="decision == 'reject'">
                    <field name="scenario_id"/>
                    <field name="reviewer_id"/>
                    <field name="decision"/>
                    <field name="content_quality"/>
                    <field name="technical_accuracy"/>
                    <field name="compliance_iso22301"/>
                    <field name="created_at"/>
                </list>
            </field>
        </record>

        <!-- Scenario Review Form View -->
        <record id="view_bcm_scenario_review_form" model="ir.ui.view">
            <field name="name">bcm.scenario.review.form</field>
            <field name="model">bcm.scenario.review</field>
            <field name="arch" type="xml">
                <form string="Scenario Review">
                    <header>
                        <field name="decision" widget="statusbar" statusbar_visible="draft,approve,reject"/>
                    </header>
                    
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <span>Review for: </span>
                                <field name="scenario_id" readonly="1" class="oe_inline"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group>
                                <field name="reviewer_id" readonly="1"/>
                                <field name="created_at" readonly="1"/>
                            </group>
                            <group>
                                <field name="decision" readonly="1"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Review Criteria">
                                <group>
                                    <group string="Quality Assessment">
                                        <field name="content_quality" widget="selection"/>
                                        <field name="technical_accuracy" widget="selection"/>
                                    </group>
                                    <group string="Compliance &amp; Standards">
                                        <field name="compliance_iso22301" widget="selection"/>
                                    </group>
                                </group>
                            </page>
                            
                            <page string="Comments &amp; Feedback">
                                <group>
                                    <field name="notes" widget="html" placeholder="Detailed review notes..."/>
                                    <field name="improvement_suggestions" widget="html" placeholder="Suggestions for improvement..."/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Review Search View -->
        <record id="view_bcm_scenario_review_search" model="ir.ui.view">
            <field name="name">bcm.scenario.review.search</field>
            <field name="model">bcm.scenario.review</field>
            <field name="arch" type="xml">
                <search string="Search Reviews">
                    <field name="scenario_id" string="Scenario"/>
                    <field name="reviewer_id" string="Reviewer"/>
                    <field name="notes" string="Notes"/>
                    
                    <filter string="My Reviews" name="my_reviews" domain="[('reviewer_id', '=', uid)]"/>
                    <filter string="Approved" name="approved" domain="[('decision', '=', 'approve')]"/>
                    <filter string="Rejected" name="rejected" domain="[('decision', '=', 'reject')]"/>
                    <filter string="Pending" name="pending" domain="[('decision', '=', 'draft')]"/>
                    
                    <separator/>
                    <filter string="ISO 22301 Compliant" name="iso_compliant" domain="[('compliance_iso22301', '>=', 4)]"/>
                    
                    <group expand="0" string="Group By">
                        <filter string="Decision" name="group_decision" context="{'group_by': 'decision'}"/>
                        <filter string="Reviewer" name="group_reviewer" context="{'group_by': 'reviewer_id'}"/>
                        <filter string="Review Date" name="group_date" context="{'group_by': 'created_at'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Actions -->
        <record id="action_bcm_scenario_review" model="ir.actions.act_window">
            <field name="name">Scenario Reviews</field>
            <field name="res_model">bcm.scenario.review</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No reviews found.
                </p>
                <p>
                    Reviews appear here when scenarios are submitted for moderation.
                </p>
            </field>
        </record>

        <record id="action_bcm_scenario_review_pending" model="ir.actions.act_window">
            <field name="name">Pending Reviews</field>
            <field name="res_model">bcm.scenario.review</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_pending': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No pending reviews.
                </p>
                <p>
                    All submitted scenarios have been reviewed!
                </p>
            </field>
        </record>

    </data>
</odoo>
