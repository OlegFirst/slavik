<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Forum Category Views -->

        <!-- Forum Category List View -->
        <record id="view_forum_category_tree" model="ir.ui.view">
            <field name="name">bcm.forum.category.tree</field>
            <field name="model">bcm.forum.category</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="topic_count"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Forum Category Form View -->
        <record id="view_forum_category_form" model="ir.ui.view">
            <field name="name">bcm.forum.category.form</field>
            <field name="model">bcm.forum.category</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="sequence"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="icon"/>
                                <field name="color"/>
                                <field name="topic_count" readonly="1"/>
                            </group>
                        </group>
                        <field name="description"/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Forum Category Action -->
        <record id="action_forum_category" model="ir.actions.act_window">
            <field name="name">Forum Categories</field>
            <field name="res_model">bcm.forum.category</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>