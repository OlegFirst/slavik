<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- BCM Incident Form View -->
        <record id="view_bcm_incident_form" model="ir.ui.view">
            <field name="name">bcm.incident.form</field>
            <field name="model">bcm.incident</field>
            <field name="arch" type="xml">
                <form string="BCM Incident">
                    <header>
                        <field name="status" widget="statusbar"
                               statusbar_visible="open,in_progress,resolved"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="incident_type"/>
                                <field name="severity"/>
                            </group>
                            <group>
                                <field name="assigned_to"/>
                                <field name="reported_date"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <field name="notes"/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- BCM Incident List View -->
        <record id="view_bcm_incident_list" model="ir.ui.view">
            <field name="name">bcm.incident.list</field>
            <field name="model">bcm.incident</field>
            <field name="arch" type="xml">
                <list string="BCM Incidents">
                    <field name="name"/>
                    <field name="incident_type"/>
                    <field name="severity"/>
                    <field name="status"/>
                    <field name="assigned_to"/>
                    <field name="reported_date"/>
                </list>
            </field>
        </record>

        <!-- BCM Incident Action -->
        <record id="action_bcm_incident" model="ir.actions.act_window">
            <field name="name">Incidents</field>
            <field name="res_model">bcm.incident</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>