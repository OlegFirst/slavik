# Moodle-BCM Bridge Service Dockerfile
FROM python:3.11-slim

LABEL maintainer="BCM Platform Team"
LABEL description="Moodle LMS integration bridge for BCM Platform"

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Set work directory
WORKDIR /app

# Install Python dependencies
COPY requirements.bridge.txt .
RUN pip install --no-cache-dir -r requirements.bridge.txt

# Copy application code
COPY moodle_client.py .
COPY bridge_service.py .
COPY config/ ./config/

# Create logs directory
RUN mkdir -p /app/logs

# Non-root user for security
RUN adduser --disabled-password --gecos '' --uid 1000 bridgeuser
RUN chown -R bridgeuser:bridgeuser /app
USER bridgeuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8092/health || exit 1

# Expose port
EXPOSE 8092

# Run the bridge service
CMD ["python", "bridge_service.py"]
