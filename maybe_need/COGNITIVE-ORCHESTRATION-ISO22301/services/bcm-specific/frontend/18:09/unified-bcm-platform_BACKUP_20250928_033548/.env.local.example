# Unified BCM Platform Environment Configuration
# Copy this file to .env.local and update with your actual values

# ====================
# KEYCLOAK SSO CONFIGURATION
# ====================
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=bcm-platform
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=bcm-frontend

# ====================
# ODOO BACKEND CONFIGURATION
# ====================
NEXT_PUBLIC_ODOO_URL=http://localhost:8069
NEXT_PUBLIC_ODOO_DB=bcm_production
ODOO_ADMIN_USERNAME=admin
ODOO_ADMIN_PASSWORD=your_secure_password

# ====================
# SUPABASE AI/REALTIME CONFIGURATION
# ====================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ====================
# REDIS CACHE/MESSAGE BROKER
# ====================
NEXT_PUBLIC_REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# ====================
# API ENDPOINTS
# ====================
NEXT_PUBLIC_API_URL=http://localhost:8069
NEXT_PUBLIC_AI_API_URL=http://localhost:8000
NEXT_PUBLIC_BIA_API_URL=http://localhost:8082

# ====================
# SECURITY CONFIGURATION
# ====================
JWT_SECRET=your_super_secure_jwt_secret_key_here
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3002

# ====================
# DATABASE CONFIGURATION
# ====================
# PostgreSQL (used by Odoo)
DATABASE_URL=postgresql://user:password@localhost:5432/bcm_production

# ====================
# ENTERPRISE FEATURES
# ====================
# Enterprise license key
ENTERPRISE_LICENSE_KEY=your_enterprise_license_key

# Multi-tenancy settings
MULTI_TENANT_MODE=true
DEFAULT_TENANT_ID=1

# LDAP/Active Directory integration (optional)
LDAP_URL=ldap://your-ldap-server:389
LDAP_BIND_DN=cn=admin,dc=yourcompany,dc=com
LDAP_BIND_PASSWORD=your_ldap_password
LDAP_SEARCH_BASE=dc=yourcompany,dc=com

# ====================
# MONITORING & LOGGING
# ====================
# Application monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Performance monitoring
NEW_RELIC_LICENSE_KEY=your_newrelic_license_key
NEW_RELIC_APP_NAME=BCM-Platform-Frontend

# Logging level
LOG_LEVEL=info

# ====================
# EMAIL CONFIGURATION
# ====================
# SMTP for notifications
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your-email@yourcompany.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@yourcompany.com

# ====================
# FILE STORAGE
# ====================
# S3-compatible storage for documents
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=bcm-platform-documents
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_REGION=us-east-1

# ====================
# DEVELOPMENT CONFIGURATION
# ====================
NODE_ENV=development
DEBUG=true
ENABLE_DEVTOOLS=true

# Development database (if different from production)
DEV_DATABASE_URL=postgresql://dev:dev@localhost:5432/bcm_dev

# ====================
# PRODUCTION CONFIGURATION
# ====================
# Only for production deployments
# NODE_ENV=production
# DEBUG=false
# ENABLE_DEVTOOLS=false

# SSL Configuration
# SSL_CERT_PATH=/path/to/ssl/cert.pem
# SSL_KEY_PATH=/path/to/ssl/key.pem

# ====================
# BACKUP CONFIGURATION
# ====================
# Backup storage
BACKUP_S3_BUCKET=bcm-platform-backups
BACKUP_SCHEDULE=0 2 * * * # Daily at 2 AM
BACKUP_RETENTION_DAYS=90

# ====================
# INTEGRATION APIS
# ====================
# Microsoft Graph (for Office 365 integration)
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=your_microsoft_tenant_id

# Google Workspace integration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Slack integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your_slack_signing_secret

# ====================
# AI/ML CONFIGURATION
# ====================
# OpenAI API (if using)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4

# Custom AI endpoints
AI_RISK_ANALYSIS_URL=http://localhost:8001/analyze
AI_RECOMMENDATION_URL=http://localhost:8001/recommend

# ====================
# COMPLIANCE & AUDIT
# ====================
# Compliance frameworks
ENABLE_GDPR_MODE=true
ENABLE_SOX_COMPLIANCE=true
ENABLE_ISO27001_MODE=true

# Audit logging
AUDIT_LOG_RETENTION_DAYS=2555 # 7 years for SOX compliance
AUDIT_LOG_S3_BUCKET=bcm-audit-logs

# ====================
# FEATURE FLAGS
# ====================
# Enable/disable features
FEATURE_AI_ASSISTANT=true
FEATURE_DIGITAL_TWIN=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_MOBILE_APP=false
FEATURE_API_V2=true