<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Personal Digital Twin Views -->

    <!-- Tree View -->
    <record id="personal_digital_twin_tree_view" model="ir.ui.view">
        <field name="name">bcm.personal.digital.twin.tree</field>
        <field name="model">bcm.personal.digital.twin</field>
        <field name="arch" type="xml">
            <tree string="Personal Digital Twins" sample="1">
                <field name="display_name"/>
                <field name="user_id"/>
                <field name="organization_twin_id"/>
                <field name="sync_status" widget="badge"
                       decoration-success="sync_status == 'active'"
                       decoration-info="sync_status == 'syncing'"
                       decoration-warning="sync_status == 'offline'"
                       decoration-danger="sync_status == 'error'"/>
                <field name="twin_health_score" widget="progressbar"/>
                <field name="activity_score" widget="progressbar"/>
                <field name="last_sync"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="personal_digital_twin_form_view" model="ir.ui.view">
        <field name="name">bcm.personal.digital.twin.form</field>
        <field name="model">bcm.personal.digital.twin</field>
        <field name="arch" type="xml">
            <form string="Personal Digital Twin">
                <header>
                    <button name="action_sync_personal_data" string="Sync Data"
                            type="object" class="btn-primary"
                            attrs="{'invisible': [('sync_status', '=', 'syncing')]}"/>
                    <button name="action_analyze_patterns" string="Analyze Patterns"
                            type="object" class="btn-secondary"
                            attrs="{'invisible': [('ai_insights_enabled', '=', False)]}"/>
                    <button name="action_update_workspace" string="Update Workspace"
                            type="object" class="btn-secondary"/>
                    <button name="action_privacy_settings" string="Privacy Settings"
                            type="object" class="btn-secondary"/>
                    <field name="sync_status" widget="statusbar"
                           statusbar_visible="active,syncing,offline"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_dashboard" type="object"
                                class="oe_stat_button" icon="fa-dashboard">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Personal</span>
                                <span class="o_stat_text">Dashboard</span>
                            </div>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="My Twin" bg_color="bg-info"
                            attrs="{'invisible': [('user_id', '!=', uid)]}"/>

                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Identity">
                            <field name="user_id" options="{'no_create': True}"/>
                            <field name="organization_twin_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Status">
                            <field name="twin_health_score" widget="progressbar"/>
                            <field name="activity_score" widget="progressbar"/>
                            <field name="last_sync"/>
                            <field name="next_sync"/>
                            <field name="last_activity"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Personal Metrics" name="metrics">
                            <group>
                                <group string="Session Statistics">
                                    <field name="total_sessions"/>
                                    <field name="avg_session_duration"/>
                                </group>
                                <group string="Integration Status">
                                    <field name="bcm_integration_active"/>
                                    <field name="ai_insights_enabled"/>
                                    <field name="real_time_sync"/>
                                    <field name="is_public"/>
                                </group>
                            </group>

                            <separator string="Detailed Metrics"/>
                            <field name="personal_metrics" widget="ace" options="{'mode': 'json'}"
                                   attrs="{'readonly': [('sync_status', '=', 'syncing')]}"/>
                        </page>

                        <page string="Activity Patterns" name="patterns">
                            <field name="activity_patterns" widget="ace" options="{'mode': 'json'}"
                                   readonly="1"/>
                        </page>

                        <page string="Workspace Configuration" name="workspace">
                            <field name="workspace_config" widget="ace" options="{'mode': 'json'}"/>
                        </page>

                        <page string="Privacy Settings" name="privacy">
                            <field name="privacy_settings" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="personal_digital_twin_kanban_view" model="ir.ui.view">
        <field name="name">bcm.personal.digital.twin.kanban</field>
        <field name="model">bcm.personal.digital.twin</field>
        <field name="arch" type="xml">
            <kanban string="Personal Digital Twins" class="o_kanban_dashboard" sample="1">
                <field name="display_name"/>
                <field name="user_id"/>
                <field name="sync_status"/>
                <field name="twin_health_score"/>
                <field name="activity_score"/>
                <field name="last_sync"/>
                <field name="organization_twin_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('res.users', 'avatar_128', record.user_id.raw_value)"
                                     t-att-alt="record.user_id.value"/>
                            </div>
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="display_name"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle text-muted">
                                            <field name="user_id"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="o_kanban_record_body">
                                    <div class="row">
                                        <div class="col-6">
                                            <span class="badge badge-pill"
                                                  t-attf-class="badge-{{record.sync_status.raw_value == 'active' ? 'success' : (record.sync_status.raw_value == 'syncing' ? 'info' : (record.sync_status.raw_value == 'offline' ? 'warning' : 'danger'))}}">
                                                <field name="sync_status"/>
                                            </span>
                                        </div>
                                        <div class="col-6">
                                            <small class="text-muted">
                                                Health: <field name="twin_health_score"/>%
                                            </small>
                                        </div>
                                    </div>

                                    <div class="mt8">
                                        <div class="progress mb-1" style="height: 8px;">
                                            <div class="progress-bar bg-success" role="progressbar"
                                                 t-attf-style="width: {{record.twin_health_score.raw_value}}%"/>
                                        </div>
                                        <small class="text-muted">Twin Health</small>
                                    </div>

                                    <div class="mt8">
                                        <div class="progress mb-1" style="height: 8px;">
                                            <div class="progress-bar bg-info" role="progressbar"
                                                 t-attf-style="width: {{record.activity_score.raw_value}}%"/>
                                        </div>
                                        <small class="text-muted">Activity Score</small>
                                    </div>
                                </div>

                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <t t-if="record.organization_twin_id.raw_value">
                                            <i class="fa fa-building-o"/> Org Twin
                                        </t>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <small class="text-muted">
                                            <i class="fa fa-clock-o"/>
                                            <t t-if="record.last_sync.raw_value">
                                                <field name="last_sync" widget="relative"/>
                                            </t>
                                            <t t-else="">Never synced</t>
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="personal_digital_twin_search_view" model="ir.ui.view">
        <field name="name">bcm.personal.digital.twin.search</field>
        <field name="model">bcm.personal.digital.twin</field>
        <field name="arch" type="xml">
            <search string="Search Personal Digital Twins">
                <field name="display_name" string="Name"/>
                <field name="user_id" string="User"/>
                <field name="organization_twin_id" string="Organization"/>

                <filter name="my_twin" string="My Twin"
                        domain="[('user_id', '=', uid)]"/>
                <filter name="active_sync" string="Active Sync"
                        domain="[('sync_status', '=', 'active')]"/>
                <filter name="syncing" string="Syncing"
                        domain="[('sync_status', '=', 'syncing')]"/>
                <filter name="offline" string="Offline"
                        domain="[('sync_status', '=', 'offline')]"/>
                <filter name="errors" string="Sync Errors"
                        domain="[('sync_status', '=', 'error')]"/>

                <separator/>
                <filter name="high_health" string="High Health (>80%)"
                        domain="[('twin_health_score', '>=', 80)]"/>
                <filter name="medium_health" string="Medium Health (50-80%)"
                        domain="[('twin_health_score', '>=', 50), ('twin_health_score', '<', 80)]"/>
                <filter name="low_health" string="Low Health (<50%)"
                        domain="[('twin_health_score', '<', 50)]"/>

                <separator/>
                <filter name="ai_enabled" string="AI Insights Enabled"
                        domain="[('ai_insights_enabled', '=', True)]"/>
                <filter name="real_time" string="Real-time Sync"
                        domain="[('real_time_sync', '=', True)]"/>
                <filter name="public_profile" string="Public Profile"
                        domain="[('is_public', '=', True)]"/>

                <separator/>
                <filter name="recent_sync" string="Synced Today"
                        domain="[('last_sync', '>=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="stale_sync" string="Stale Sync (>7 days)"
                        domain="['|', ('last_sync', '=', False), ('last_sync', '<=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 23:59:59'))]"/>

                <group expand="0" string="Group By">
                    <filter name="group_sync_status" string="Sync Status"
                            context="{'group_by': 'sync_status'}"/>
                    <filter name="group_organization" string="Organization"
                            context="{'group_by': 'organization_twin_id'}"/>
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="personal_digital_twin_action" model="ir.actions.act_window">
        <field name="name">Personal Digital Twins</field>
        <field name="res_model">bcm.personal.digital.twin</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="personal_digital_twin_search_view"/>
        <field name="context">{
            'search_default_my_twin': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Personal Digital Twin
            </p>
            <p>
                Personal Digital Twins provide personalized insights and workspace management
                based on your activity patterns and preferences.
            </p>
            <p>
                Start by synchronizing your personal data to create your digital twin profile.
            </p>
        </field>
    </record>

    <!-- My Personal Twin Action (for current user only) -->
    <record id="my_personal_twin_action" model="ir.actions.act_window">
        <field name="name">My Digital Twin</field>
        <field name="res_model">bcm.personal.digital.twin</field>
        <field name="view_mode">form,kanban</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{
            'create': False,
            'search_default_my_twin': 1,
        }</field>
        <field name="limit">1</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Your Personal Digital Twin will be created automatically
            </p>
            <p>
                Your personal digital twin will be created when you first access the BCM platform
                and will continuously learn from your activities and preferences.
            </p>
        </field>
    </record>

    <!-- Dashboard Action -->
    <record id="personal_twin_dashboard_action" model="ir.actions.act_window">
        <field name="name">Personal Twins Dashboard</field>
        <field name="res_model">bcm.personal.digital.twin</field>
        <field name="view_mode">kanban,tree</field>
        <field name="context">{
            'search_default_active_sync': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Personal Digital Twins found
            </p>
            <p>
                Personal Digital Twins are created automatically for users who interact with the BCM platform.
                They provide personalized insights and workspace management.
            </p>
        </field>
    </record>
</odoo>