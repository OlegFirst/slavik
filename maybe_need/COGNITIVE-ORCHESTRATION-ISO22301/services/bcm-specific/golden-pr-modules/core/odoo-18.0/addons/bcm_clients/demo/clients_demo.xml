<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Demo BCM Clients -->
        <record id="demo_client_healthcare" model="bcm.client">
            <field name="name">Metropolitan General Hospital</field>
            <field name="sector">hospital</field>
            <field name="region">North America - East</field>
            <field name="onboarding_stage">live</field>
            <field name="dpa_signed">True</field>
            <field name="data_residency">us</field>
            <field name="status">active</field>
            <field name="notes">Large hospital system with 500 beds, emergency department, and multiple specialty clinics.</field>
        </record>

        <record id="demo_client_manufacturing" model="bcm.client">
            <field name="name">TechCorp Manufacturing Inc.</field>
            <field name="sector">manufacturing</field>
            <field name="region">North America - West</field>
            <field name="onboarding_stage">plans</field>
            <field name="dpa_signed">True</field>
            <field name="data_residency">us</field>
            <field name="status">active</field>
            <field name="notes">Electronics manufacturing company with global supply chain operations.</field>
        </record>

        <record id="demo_client_financial" model="bcm.client">
            <field name="name">Regional Credit Union</field>
            <field name="sector">financial</field>
            <field name="region">Europe - Central</field>
            <field name="onboarding_stage">bia_ready</field>
            <field name="dpa_signed">True</field>
            <field name="data_residency">eu</field>
            <field name="status">active</field>
            <field name="notes">Mid-size credit union serving 50,000 members across three states.</field>
        </record>

        <!-- Demo Client Contacts -->
        <record id="demo_contact_hospital_bcm_lead" model="bcm.client.contact">
            <field name="client_id" ref="demo_client_healthcare"/>
            <field name="role">bcm_lead</field>
            <field name="is_primary">True</field>
            <field name="notify_prefs">{"incidents": true, "exercises": true, "audits": true}</field>
        </record>

        <record id="demo_contact_hospital_cio" model="bcm.client.contact">
            <field name="client_id" ref="demo_client_healthcare"/>
            <field name="role">cio</field>
            <field name="notify_prefs">{"system_alerts": true, "dr_tests": true}</field>
        </record>

        <record id="demo_contact_manufacturing_admin" model="bcm.client.contact">
            <field name="client_id" ref="demo_client_manufacturing"/>
            <field name="role">admin</field>
            <field name="is_primary">True</field>
            <field name="notify_prefs">{"all": true}</field>
        </record>

        <record id="demo_contact_financial_auditor" model="bcm.client.contact">
            <field name="client_id" ref="demo_client_financial"/>
            <field name="role">auditor</field>
            <field name="notify_prefs">{"compliance": true, "findings": true}</field>
        </record>

        <!-- Demo Context Vault Records -->
        <record id="demo_vault_hospital_er" model="bcm.client.vault">
            <field name="client_id" ref="demo_client_healthcare"/>
            <field name="context_type">business_process</field>
            <field name="name">Emergency Department Operations</field>
            <field name="description">Critical emergency department operations including triage, trauma response, and patient flow management. Requires 24/7 availability with RTO of 0 minutes.</field>
            <field name="sensitivity_level">critical</field>
            <field name="tags">emergency, patient_care, 24x7, critical_care</field>
            <field name="source">manual</field>
            <field name="external_refs">{"his_id": "ED_001", "epic_module": "emergency", "pacs_system": "radiology_er"}</field>
            <field name="indexed">True</field>
        </record>

        <record id="demo_vault_manufacturing_supply_chain" model="bcm.client.vault">
            <field name="client_id" ref="demo_client_manufacturing"/>
            <field name="context_type">business_process</field>
            <field name="name">Global Supply Chain Management</field>
            <field name="description">End-to-end supply chain operations including supplier relationships, inventory management, and logistics coordination across 15 countries.</field>
            <field name="sensitivity_level">high</field>
            <field name="tags">supply_chain, logistics, global, inventory</field>
            <field name="source">api</field>
            <field name="external_refs">{"erp_module": "SCM_001", "sap_system": "supply_chain", "wms_id": "warehouse_global"}</field>
            <field name="indexed">True</field>
        </record>

        <record id="demo_vault_financial_core_banking" model="bcm.client.vault">
            <field name="client_id" ref="demo_client_financial"/>
            <field name="context_type">system</field>
            <field name="name">Core Banking System</field>
            <field name="description">Primary banking system handling member accounts, transactions, loans, and deposits. Critical for all banking operations with strict regulatory requirements.</field>
            <field name="sensitivity_level">critical</field>
            <field name="tags">core_banking, financial, regulated, member_data</field>
            <field name="source">import</field>
            <field name="external_refs">{"core_system": "CBS_MAIN", "backup_site": "DR_SITE_02", "regulatory_id": "NCUA_001"}</field>
            <field name="indexed">False</field>
        </record>

        <!-- Demo API Keys -->
        <record id="demo_appkey_hospital_integration" model="bcm.client.appkey">
            <field name="client_id" ref="demo_client_healthcare"/>
            <field name="name">HIS Integration Key</field>
            <field name="description">API key for hospital information system integration</field>
            <field name="valid_until" eval="(DateTime.now() + timedelta(days=365)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="rate_limit">5000</field>
            <field name="allowed_ips">10.0.0.100,10.0.0.101</field>
            <field name="scope_ids" eval="[(6, 0, [ref('bcm_clients.scope_read'), ref('bcm_clients.scope_bia'), ref('bcm_clients.scope_plans')])]"/>
        </record>

        <record id="demo_appkey_manufacturing_monitoring" model="bcm.client.appkey">
            <field name="client_id" ref="demo_client_manufacturing"/>
            <field name="name">Production Monitoring</field>
            <field name="description">API key for production line monitoring and alerts</field>
            <field name="valid_until" eval="(DateTime.now() + timedelta(days=180)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="rate_limit">2000</field>
            <field name="scope_ids" eval="[(6, 0, [ref('bcm_clients.scope_read'), ref('bcm_clients.scope_incidents')])]"/>
        </record>

    </data>
</odoo>
