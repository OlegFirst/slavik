FROM odoo:18.0

USER root

# Install additional dependencies and PostgreSQL client
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-dev \
    build-essential \
    postgresql-client \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Copy BCM modules with fixed dependencies
COPY ./addons/bcm_* /mnt/extra-addons/

# Copy custom entrypoint with BCM module auto-installation
COPY docker-entrypoint-bcm.sh /docker-entrypoint-bcm.sh
RUN chmod +x /docker-entrypoint-bcm.sh

# Environment variables for BCM Platform
ENV BCM_MODULES_AUTO_INSTALL=true \
    DB_HOST=postgres \
    DB_PORT=5432 \
    DB_USER=odoo \
    DB_PASSWORD=bcm_secure_2024 \
    DB_NAME=bcm_platform \
    ADMIN_PASSWD=admin123

# Set proper permissions
RUN chown -R odoo:odoo /mnt/extra-addons

USER odoo

ENTRYPOINT ["/docker-entrypoint-bcm.sh"]
CMD ["odoo"]