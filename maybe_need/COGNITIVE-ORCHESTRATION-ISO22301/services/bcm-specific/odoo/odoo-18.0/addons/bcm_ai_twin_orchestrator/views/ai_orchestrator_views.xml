<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- AI Twin Orchestrator Form View -->
    <record id="view_ai_orchestrator_form" model="ir.ui.view">
        <field name="name">bcm.ai.twin.orchestrator.form</field>
        <field name="model">bcm.ai.twin.orchestrator</field>
        <field name="arch" type="xml">
            <form string="AI Twin Orchestrator">
                <header>
                    <button name="action_run_analysis" type="object" string="Run Analysis"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_apply_recommendations" type="object" string="Apply Recommendations"
                            class="btn-secondary" invisible="state != 'completed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,processing,synthesizing,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Analysis Name"/>
                        </h1>
                    </div>

                    <group>
                        <group name="basic_info">
                            <field name="organization_id" required="1"/>
                            <field name="simulation_id"/>
                            <field name="analysis_type"/>
                            <field name="priority"/>
                        </group>
                        <group name="metrics">
                            <field name="confidence_score" widget="progressbar"/>
                            <field name="organs_used"/>
                            <field name="execution_time"/>
                        </group>
                    </group>

                    <group name="timestamps" string="Execution Timeline">
                        <field name="start_time"/>
                        <field name="completion_time"/>
                    </group>

                    <notebook>
                        <page string="AI Organs Status" name="organs_status">
                            <field name="organs_status" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                        </page>

                        <page string="AI Results" name="ai_results">
                            <field name="ai_results" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                        </page>

                        <page string="Synthesized Insights" name="insights">
                            <field name="synthesized_insights" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                        </page>

                        <page string="Recommendations" name="recommendations">
                            <field name="recommendations" widget="ace" options="{'mode': 'json'}" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- AI Twin Orchestrator Tree View -->
    <record id="view_ai_orchestrator_tree" model="ir.ui.view">
        <field name="name">bcm.ai.twin.orchestrator.tree</field>
        <field name="model">bcm.ai.twin.orchestrator</field>
        <field name="arch" type="xml">
            <list string="AI Analyses" decoration-success="state=='completed'" decoration-danger="state=='failed'" decoration-info="state=='running'">
                <field name="name"/>
                <field name="organization_id"/>
                <field name="analysis_type"/>
                <field name="priority" widget="badge"/>
                <field name="state" widget="badge"/>
                <field name="confidence_score" widget="progressbar"/>
                <field name="organs_used"/>
                <field name="execution_time"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- AI Twin Orchestrator Search View -->
    <record id="view_ai_orchestrator_search" model="ir.ui.view">
        <field name="name">bcm.ai.twin.orchestrator.search</field>
        <field name="model">bcm.ai.twin.orchestrator</field>
        <field name="arch" type="xml">
            <search string="AI Analyses">
                <field name="name"/>
                <field name="organization_id"/>
                <field name="analysis_type"/>
                <field name="state"/>

                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Running" name="running" domain="[('state', '=', 'running')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>

                <separator/>
                <filter string="High Priority" name="high_priority" domain="[('priority', 'in', ['high', 'critical'])]"/>
                <filter string="My Analyses" name="my_analyses" domain="[('create_uid', '=', uid)]"/>

                <group expand="0" string="Group By">
                    <filter string="Organization" name="group_organization" context="{'group_by': 'organization_id'}"/>
                    <filter string="Analysis Type" name="group_analysis_type" context="{'group_by': 'analysis_type'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- AI Twin Orchestrator Kanban View -->
    <record id="view_ai_orchestrator_kanban" model="ir.ui.view">
        <field name="name">bcm.ai.twin.orchestrator.kanban</field>
        <field name="model">bcm.ai.twin.orchestrator</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="organization_id"/>
                <field name="analysis_type"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="confidence_score"/>
                <field name="organs_used"/>
                <field name="execution_time"/>
                <field name="create_date"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <div class="o_kanban_manage_button_section">
                                        <a class="o_kanban_manage_toggle_button" href="#">
                                            <i class="fa fa-ellipsis-v" role="img" aria-label="Manage" title="Manage"/>
                                        </a>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div class="o_kanban_record_subtitle">
                                        <field name="organization_id"/>
                                    </div>
                                    <div>
                                        <t t-if="record.analysis_type.raw_value">
                                            <span class="badge badge-pill">
                                                <field name="analysis_type"/>
                                            </span>
                                        </t>
                                        <t t-if="record.priority.raw_value">
                                            <span class="badge badge-pill" t-attf-class="badge-{{record.priority.raw_value}}">
                                                <field name="priority"/>
                                            </span>
                                        </t>
                                    </div>
                                    <div t-if="record.confidence_score.raw_value">
                                        Confidence: <field name="confidence_score"/>%
                                    </div>
                                    <div t-if="record.organs_used.raw_value">
                                        AI Organs: <field name="organs_used"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="create_date" widget="date"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>