{
  "name": "digital-twin-standalone",
  "version": "2.0.0",
  "description": "Standalone Digital Twin Module for NPO Organizations",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "jest",
    "web": "node web-server.js",
    "simple": "node simple-web-server.js",
    "mcp:start": "node mcp-server/digital-twin-mcp-server.js",
    "mcp:dev": "node --watch mcp-server/digital-twin-mcp-server.js",
    "mcp:install": "cd mcp-server && npm install",
    "inspector": "npx @modelcontextprotocol/inspector",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false"
  },
  "keywords": [
    "digital-twin",
    "npo",
    "simulation",
    "analytics",
    "standalone"
  ],
  "author": "Digital Twin Development Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.3",
    "@supabase/supabase-js": "^2.55.0",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "isomorphic-dompurify": "^2.26.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.18.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.3",
    "rate-limiter-flexible": "^7.2.0",
    "validator": "^13.15.15",
    "winston": "^3.11.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0"
  }
}
