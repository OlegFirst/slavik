# Moodle-BCM Integration Environment Configuration

# Moodle Database Settings
MOODLE_DB_PASSWORD=moodle_secure_password_change_in_production
MOODLE_REDIS_PASSWORD=redis_secure_password_change_in_production

# Moodle Admin Settings
MOODLE_ADMIN_PASSWORD=Admin_Secure_123!
MOODLE_ADMIN_EMAIL=admin@your-company.com

# Moodle URLs
MOODLE_URL=http://localhost:8080
MOODLE_MOBILE_URL=http://localhost:8081

# Moodle API Integration
MOODLE_API_TOKEN=your_moodle_webservice_token_here
MOODLE_TOKEN=your_moodle_webservice_token_here

# BCM Platform Integration
BCM_API_URL=http://localhost:8069
BCM_API_KEY=your_bcm_platform_api_key
BCM_WEBHOOK_URL=http://host.docker.internal:8069/api/integrations/moodle

# Bridge Service Configuration
BRIDGE_API_KEY=your_bridge_service_api_key_change_in_production

# Webhook Configuration
MOODLE_WEBHOOK_SECRET=your_webhook_secret_key_change_in_production

# Security Settings
VERIFY_SSL=false
MOODLE_PASSWORD_SALT=your_password_salt_change_in_production

# Email Configuration (optional)
SMTP_HOST=smtp.your-domain.com
SMTP_SECURE=tls
SMTP_USER=noreply@your-company.com
SMTP_PASSWORD=your_smtp_password
MOODLE_NOREPLY_EMAIL=noreply@your-company.com

# Search Configuration (optional - for Elasticsearch)
MOODLE_SEARCH_ENGINE=elasticsearch

# Debug Settings (set to false in production)
MOODLE_DEBUG=false

# Additional Integrations
THEHIVE_INTEGRATION_ENABLED=true

# Logging
LOG_LEVEL=info