<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <!-- Main Knowledge Base Portal Template -->
    <template id="knowledge_base_portal" name="BCM Knowledge Base Portal">
        <t t-call="website.layout">
            <div id="wrap" class="knowledge-base-portal">
                <!-- Hero Section -->
                <section class="hero-section bg-primary text-white py-5">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-8 offset-lg-2 text-center">
                                <h1 class="display-4 mb-3">
                                    <i class="fas fa-book-open mr-3"></i>
                                    BCM Knowledge Base
                                </h1>
                                <p class="lead">AI-powered knowledge repository for Business Continuity Management</p>

                                <!-- Search Bar -->
                                <div class="search-container mt-4">
                                    <form method="get" action="/bcm/community/knowledge/search" class="search-form">
                                        <div class="input-group input-group-lg">
                                            <input type="text"
                                                   id="knowledge-search"
                                                   name="q"
                                                   class="form-control"
                                                   t-att-value="search_query"
                                                   placeholder="Search knowledge articles, best practices, procedures..."
                                                   autocomplete="off"/>
                                            <div class="input-group-append">
                                                <button class="btn btn-light" type="submit">
                                                    <i class="fas fa-search"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <!-- Search Suggestions Dropdown -->
                                        <div id="search-suggestions" class="search-suggestions"></div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Quick Stats -->
                <section class="stats-section py-4 bg-light">
                    <div class="container">
                        <div class="row text-center">
                            <div class="col-md-3">
                                <div class="stat-item">
                                    <div class="stat-icon mb-2">
                                        <i class="fas fa-file-text text-primary fa-2x"></i>
                                    </div>
                                    <h3 class="stat-number"><t t-esc="total_articles"/></h3>
                                    <p class="stat-label">Knowledge Articles</p>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="stat-item">
                                    <div class="stat-icon mb-2">
                                        <i class="fas fa-robot text-success fa-2x"></i>
                                    </div>
                                    <h3 class="stat-number"><t t-esc="ai_generated_articles"/></h3>
                                    <p class="stat-label">AI Generated</p>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="stat-item">
                                    <div class="stat-icon mb-2">
                                        <i class="fas fa-dumbbell text-info fa-2x"></i>
                                    </div>
                                    <h3 class="stat-number"><t t-esc="exercise_derived_articles"/></h3>
                                    <p class="stat-label">From Exercises</p>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="stat-item">
                                    <div class="stat-icon mb-2">
                                        <i class="fas fa-users text-warning fa-2x"></i>
                                    </div>
                                    <h3 class="stat-number"><t t-esc="community_articles"/></h3>
                                    <p class="stat-label">Community Created</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Main Content -->
                <section class="main-content py-5">
                    <div class="container">
                        <div class="row">
                            <!-- Sidebar - Categories &amp; Filters -->
                            <div class="col-md-3">
                                <div class="knowledge-sidebar">
                                    <!-- Categories -->
                                    <div class="category-section mb-4">
                                        <h5 class="sidebar-title">
                                            <i class="fas fa-folder mr-2"></i>
                                            Categories
                                        </h5>
                                        <div class="category-list">
                                            <t t-foreach="categories" t-as="category">
                                                <a t-attf-href="/bcm/community/knowledge?category=#{category['code']}"
                                                   class="category-link d-block p-2 mb-2"
                                                   t-attf-class="category-link #{current_category == category['code'] and 'active' or ''}">
                                                    <i t-attf-class="#{category['icon']} mr-2"></i>
                                                    <t t-esc="category['name']"/>
                                                    <span class="article-count float-right">
                                                        (<t t-esc="category['article_count']"/>)
                                                    </span>
                                                </a>
                                            </t>
                                        </div>
                                    </div>

                                    <!-- Popular Tags -->
                                    <div class="tags-section mb-4">
                                        <h5 class="sidebar-title">
                                            <i class="fas fa-tags mr-2"></i>
                                            Popular Tags
                                        </h5>
                                        <div class="tag-cloud">
                                            <t t-foreach="popular_tags[:15]" t-as="tag">
                                                <a t-attf-href="/bcm/community/knowledge?tag=#{tag['name']}"
                                                   class="tag-pill badge badge-secondary mr-1 mb-2"
                                                   t-attf-style="background-color: hsl(#{tag['color'] * 37}, 70%, 50%);">
                                                    <t t-esc="tag['name']"/>
                                                    (<t t-esc="tag['article_count']"/>)
                                                </a>
                                            </t>
                                        </div>
                                    </div>

                                    <!-- ISO 22301 Clauses -->
                                    <div class="iso-clauses-section">
                                        <h5 class="sidebar-title">
                                            <i class="fas fa-clipboard-check mr-2"></i>
                                            ISO 22301 Clauses
                                        </h5>
                                        <div class="iso-list">
                                            <t t-foreach="iso_clauses" t-as="clause">
                                                <a t-attf-href="/bcm/community/knowledge?iso_clause=#{clause['name']}"
                                                   class="iso-link d-block p-2 mb-1">
                                                    <strong><t t-esc="clause['name']"/>:</strong>
                                                    <t t-esc="clause['title']"/>
                                                    <span class="article-count float-right">
                                                        (<t t-esc="clause['article_count']"/>)
                                                    </span>
                                                </a>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Main Content Area -->
                            <div class="col-md-9">
                                <!-- Current Filters Display -->
                                <t t-if="search_query or current_category or current_tag or current_iso_clause">
                                    <div class="current-filters mb-4">
                                        <h6>Active Filters:</h6>
                                        <t t-if="search_query">
                                            <span class="filter-badge badge badge-primary mr-2">
                                                Search: "<t t-esc="search_query"/>"
                                                <a href="/bcm/community/knowledge" class="text-white ml-1">×</a>
                                            </span>
                                        </t>
                                        <t t-if="current_category">
                                            <span class="filter-badge badge badge-info mr-2">
                                                Category: <t t-esc="current_category"/>
                                                <a href="/bcm/community/knowledge" class="text-white ml-1">×</a>
                                            </span>
                                        </t>
                                        <t t-if="current_tag">
                                            <span class="filter-badge badge badge-success mr-2">
                                                Tag: <t t-esc="current_tag"/>
                                                <a href="/bcm/community/knowledge" class="text-white ml-1">×</a>
                                            </span>
                                        </t>
                                        <t t-if="current_iso_clause">
                                            <span class="filter-badge badge badge-warning mr-2">
                                                ISO Clause: <t t-esc="current_iso_clause"/>
                                                <a href="/bcm/community/knowledge" class="text-white ml-1">×</a>
                                            </span>
                                        </t>
                                    </div>
                                </t>

                                <!-- Featured Articles (show only if no filters) -->
                                <t t-if="not (search_query or current_category or current_tag or current_iso_clause)">
                                    <div class="featured-articles mb-5">
                                        <h4 class="section-title">
                                            <i class="fas fa-star mr-2"></i>
                                            Featured Articles
                                        </h4>
                                        <div class="row">
                                            <t t-foreach="featured_articles" t-as="article">
                                                <div class="col-md-6 mb-3">
                                                    <div class="article-card featured card h-100">
                                                        <div class="card-header d-flex justify-content-between">
                                                            <span class="category-badge badge"
                                                                  t-attf-class="badge-#{article.category}">
                                                                <t t-esc="dict(article._fields['category'].selection)[article.category]"/>
                                                            </span>
                                                            <t t-if="article.article_type == 'ai_generated'">
                                                                <span class="ai-badge badge badge-success">
                                                                    <i class="fas fa-robot"></i> AI
                                                                </span>
                                                            </t>
                                                        </div>
                                                        <div class="card-body">
                                                            <h5 class="card-title">
                                                                <a t-attf-href="/bcm/community/knowledge/article/#{article.id}"
                                                                   class="text-decoration-none">
                                                                    <t t-esc="article.name"/>
                                                                </a>
                                                            </h5>
                                                            <p class="card-text">
                                                                <t t-esc="article.summary[:150]"/>
                                                                <t t-if="len(article.summary) > 150">...</t>
                                                            </p>
                                                            <div class="article-meta small text-muted">
                                                                <i class="fas fa-eye"></i> <t t-esc="article.view_count"/> views
                                                                <span class="mx-2">•</span>
                                                                <i class="fas fa-star"></i> <t t-esc="article.usefulness_score" t-options="{'precision': 1}"/> rating
                                                                <span class="mx-2">•</span>
                                                                <i class="fas fa-bookmark"></i> <t t-esc="article.bookmark_count"/> bookmarks
                                                            </div>
                                                        </div>
                                                        <div class="card-footer">
                                                            <a t-attf-href="/bcm/community/knowledge/article/#{article.id}"
                                                               class="btn btn-primary btn-sm">
                                                                <i class="fas fa-arrow-right"></i> Read Article
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </t>

                                <!-- Articles List -->
                                <div class="articles-section">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h4 class="section-title">
                                            <t t-if="search_query or current_category or current_tag or current_iso_clause">
                                                Search Results
                                            </t>
                                            <t t-else="">
                                                Recent Articles
                                            </t>
                                            <span class="text-muted">(<t t-esc="pagination['total_items']"/> articles)</span>
                                        </h4>
                                    </div>

                                    <div class="article-list">
                                        <t t-foreach="articles" t-as="article">
                                            <div class="article-item card mb-3">
                                                <div class="card-body">
                                                    <div class="row">
                                                        <div class="col-md-8">
                                                            <div class="article-info">
                                                                <h6 class="article-title">
                                                                    <a t-attf-href="/bcm/community/knowledge/article/#{article.id}"
                                                                       class="text-decoration-none">
                                                                        <t t-esc="article.name"/>
                                                                    </a>
                                                                </h6>
                                                                <p class="article-summary text-muted mb-2">
                                                                    <t t-esc="article.summary[:200]"/>
                                                                    <t t-if="len(article.summary) > 200">...</t>
                                                                </p>
                                                                <div class="article-meta">
                                                                    <span class="badge"
                                                                          t-attf-class="badge-#{article.category} mr-2">
                                                                        <t t-esc="dict(article._fields['category'].selection)[article.category]"/>
                                                                    </span>

                                                                    <t t-if="article.article_type == 'ai_generated'">
                                                                        <span class="badge badge-success mr-2">
                                                                            <i class="fas fa-robot"></i> AI
                                                                        </span>
                                                                    </t>

                                                                    <small class="text-muted">
                                                                        Added <t t-esc="article.create_date.strftime('%B %d, %Y')"/>
                                                                    </small>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-4 text-right">
                                                            <div class="article-stats mb-2">
                                                                <small class="text-muted d-block">
                                                                    <i class="fas fa-eye"></i> <t t-esc="article.view_count"/> views
                                                                </small>
                                                                <small class="text-muted d-block">
                                                                    <i class="fas fa-star text-warning"></i>
                                                                    <t t-esc="article.usefulness_score" t-options="{'precision': 1}"/>/10 rating
                                                                </small>
                                                            </div>
                                                            <div class="article-actions">
                                                                <button class="btn btn-sm btn-outline-primary"
                                                                        t-attf-onclick="bookmarkArticle(#{article.id})"
                                                                        title="Bookmark this article">
                                                                    <i class="fas fa-bookmark"></i>
                                                                </button>
                                                                <a t-attf-href="/bcm/community/knowledge/article/#{article.id}"
                                                                   class="btn btn-sm btn-primary ml-2">
                                                                    Read
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>

                                        <!-- No Results Message -->
                                        <t t-if="not articles">
                                            <div class="no-results text-center py-5">
                                                <i class="fas fa-search fa-3x text-muted mb-3"></i>
                                                <h5>No articles found</h5>
                                                <p class="text-muted">
                                                    Try adjusting your search terms or browse by category.
                                                </p>
                                                <a href="/bcm/community/knowledge" class="btn btn-primary">
                                                    <i class="fas fa-arrow-left"></i> Browse All Articles
                                                </a>
                                            </div>
                                        </t>
                                    </div>

                                    <!-- Pagination -->
                                    <t t-if="pagination['total_pages'] > 1">
                                        <nav aria-label="Article pagination" class="mt-4">
                                            <ul class="pagination justify-content-center">
                                                <li t-attf-class="page-item #{not pagination['has_prev'] and 'disabled' or ''}">
                                                    <a class="page-link"
                                                       t-attf-href="#{pagination['has_prev'] and '?page=' + str(pagination['prev_page']) or '#'}"
                                                       aria-label="Previous">
                                                        <span aria-hidden="true">«</span>
                                                    </a>
                                                </li>

                                                <t t-set="start_page" t-value="max(1, pagination['current_page'] - 2)"/>
                                                <t t-set="end_page" t-value="min(pagination['total_pages'], pagination['current_page'] + 2)"/>

                                                <t t-foreach="range(start_page, end_page + 1)" t-as="page_num">
                                                    <li t-attf-class="page-item #{page_num == pagination['current_page'] and 'active' or ''}">
                                                        <a class="page-link" t-attf-href="?page=#{page_num}">
                                                            <t t-esc="page_num"/>
                                                        </a>
                                                    </li>
                                                </t>

                                                <li t-attf-class="page-item #{not pagination['has_next'] and 'disabled' or ''}">
                                                    <a class="page-link"
                                                       t-attf-href="#{pagination['has_next'] and '?page=' + str(pagination['next_page']) or '#'}"
                                                       aria-label="Next">
                                                        <span aria-hidden="true">»</span>
                                                    </a>
                                                </li>
                                            </ul>
                                        </nav>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <!-- Include Knowledge Search JavaScript -->
            <script type="text/javascript" src="/bcm_community/static/src/js/knowledge_search.js"></script>
        </t>
    </template>

    <!-- Individual Article Detail Template -->
    <template id="knowledge_article_detail" name="Knowledge Article Detail">
        <t t-call="website.layout">
            <div id="wrap" class="knowledge-article-detail">
                <!-- Article Header -->
                <section class="article-header bg-light py-4">
                    <div class="container">
                        <div class="row">
                            <div class="col-md-8">
                                <nav aria-label="breadcrumb">
                                    <ol class="breadcrumb">
                                        <li class="breadcrumb-item">
                                            <a href="/bcm/community/knowledge">Knowledge Base</a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a t-attf-href="/bcm/community/knowledge?category=#{article.category}">
                                                <t t-esc="dict(article._fields['category'].selection)[article.category]"/>
                                            </a>
                                        </li>
                                        <li class="breadcrumb-item active" aria-current="page">
                                            <t t-esc="article.name"/>
                                        </li>
                                    </ol>
                                </nav>

                                <h1 class="article-title"><t t-esc="article.name"/></h1>

                                <div class="article-meta mb-3">
                                    <span class="badge badge-primary mr-2">
                                        <t t-esc="dict(article._fields['category'].selection)[article.category]"/>
                                    </span>

                                    <t t-if="article.article_type == 'ai_generated'">
                                        <span class="badge badge-success mr-2">
                                            <i class="fas fa-robot"></i> AI Generated
                                        </span>
                                    </t>

                                    <small class="text-muted">
                                        <i class="fas fa-calendar"></i>
                                        Published <t t-esc="article.create_date.strftime('%B %d, %Y')"/>
                                        <span class="mx-2">•</span>
                                        <i class="fas fa-eye"></i> <t t-esc="article.view_count"/> views
                                        <span class="mx-2">•</span>
                                        <i class="fas fa-star text-warning"></i>
                                        <t t-esc="article.usefulness_score" t-options="{'precision': 1}"/>/10 rating
                                    </small>
                                </div>

                                <p class="article-summary lead">
                                    <t t-esc="article.summary"/>
                                </p>
                            </div>

                            <div class="col-md-4 text-right">
                                <div class="article-actions">
                                    <button class="btn btn-outline-primary mr-2"
                                            t-attf-onclick="bookmarkArticle(#{article.id})"
                                            title="Bookmark this article">
                                        <i class="fas fa-bookmark"></i> Bookmark
                                    </button>

                                    <div class="dropdown d-inline">
                                        <button class="btn btn-outline-secondary dropdown-toggle"
                                                type="button" data-toggle="dropdown">
                                            <i class="fas fa-share-alt"></i> Share
                                        </button>
                                        <div class="dropdown-menu">
                                            <a class="dropdown-item" href="#" onclick="copyToClipboard(window.location.href)">
                                                <i class="fas fa-link"></i> Copy Link
                                            </a>
                                            <a class="dropdown-item"
                                               t-attf-href="mailto:?subject=#{article.name}&amp;body=Check out this knowledge article: #{request.httprequest.url}">
                                                <i class="fas fa-envelope"></i> Email
                                            </a>
                                        </div>
                                    </div>
                                </div>

                                <!-- Article Navigation -->
                                <div class="article-navigation mt-3">
                                    <t t-if="prev_article">
                                        <a t-attf-href="/bcm/community/knowledge/article/#{prev_article.id}"
                                           class="btn btn-sm btn-outline-secondary mr-2"
                                           title="Previous Article">
                                            <i class="fas fa-chevron-left"></i> Previous
                                        </a>
                                    </t>

                                    <t t-if="next_article">
                                        <a t-attf-href="/bcm/community/knowledge/article/#{next_article.id}"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="Next Article">
                                            Next <i class="fas fa-chevron-right"></i>
                                        </a>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Article Content -->
                <section class="article-content py-5">
                    <div class="container">
                        <div class="row">
                            <div class="col-md-8">
                                <!-- Main Article Content -->
                                <div class="content-body">
                                    <t t-raw="article.content"/>
                                </div>

                                <!-- Article Tags -->
                                <t t-if="article.tags">
                                    <div class="article-tags mt-4">
                                        <h6>Tags:</h6>
                                        <t t-foreach="article.tags" t-as="tag">
                                            <a t-attf-href="/bcm/community/knowledge?tag=#{tag.name}"
                                               class="badge badge-secondary mr-2 mb-2">
                                                <t t-esc="tag.name"/>
                                            </a>
                                        </t>
                                    </div>
                                </t>

                                <!-- ISO Clauses -->
                                <t t-if="article.iso_clauses">
                                    <div class="iso-clauses mt-3">
                                        <h6>Related ISO 22301 Clauses:</h6>
                                        <t t-foreach="article.iso_clauses" t-as="clause">
                                            <a t-attf-href="/bcm/community/knowledge?iso_clause=#{clause.name}"
                                               class="badge badge-info mr-2 mb-2">
                                                <t t-esc="clause.name"/>: <t t-esc="clause.title"/>
                                            </a>
                                        </t>
                                    </div>
                                </t>
                            </div>

                            <!-- Sidebar -->
                            <div class="col-md-4">
                                <!-- Related Articles -->
                                <t t-if="related_articles">
                                    <div class="related-articles card mb-4">
                                        <div class="card-header">
                                            <h6 class="mb-0">
                                                <i class="fas fa-link mr-2"></i>
                                                Related Articles
                                            </h6>
                                        </div>
                                        <div class="card-body">
                                            <t t-foreach="related_articles" t-as="related">
                                                <div class="related-item mb-3">
                                                    <h6 class="related-title">
                                                        <a t-attf-href="/bcm/community/knowledge/article/#{related.id}"
                                                           class="text-decoration-none">
                                                            <t t-esc="related.name"/>
                                                        </a>
                                                    </h6>
                                                    <p class="related-summary small text-muted">
                                                        <t t-esc="related.summary[:100]"/>
                                                        <t t-if="len(related.summary) > 100">...</t>
                                                    </p>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </t>

                                <!-- Source Information -->
                                <t t-if="article.source_exercise_id or article.source_scenario_id">
                                    <div class="source-info card mb-4">
                                        <div class="card-header">
                                            <h6 class="mb-0">
                                                <i class="fas fa-info-circle mr-2"></i>
                                                Source Information
                                            </h6>
                                        </div>
                                        <div class="card-body">
                                            <t t-if="article.source_exercise_id">
                                                <p>
                                                    <strong>Source Exercise:</strong><br/>
                                                    <t t-esc="article.source_exercise_id.name"/>
                                                </p>
                                            </t>

                                            <t t-if="article.source_scenario_id">
                                                <p>
                                                    <strong>Related Scenario:</strong><br/>
                                                    <t t-esc="article.source_scenario_id.title"/>
                                                </p>
                                            </t>

                                            <t t-if="article.article_type == 'ai_generated'">
                                                <p class="text-muted small">
                                                    <i class="fas fa-robot"></i>
                                                    This article was generated using AI analysis
                                                    with <t t-esc="int(article.ai_confidence * 100)"/>% confidence.
                                                </p>
                                            </t>
                                        </div>
                                    </div>
                                </t>

                                <!-- Table of Contents (if article has sections) -->
                                <div class="table-of-contents card">
                                    <div class="card-header">
                                        <h6 class="mb-0">
                                            <i class="fas fa-list mr-2"></i>
                                            Quick Actions
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="d-grid gap-2">
                                            <a href="/bcm/community/knowledge" class="btn btn-outline-primary btn-sm">
                                                <i class="fas fa-arrow-left"></i> Back to Knowledge Base
                                            </a>

                                            <button class="btn btn-outline-success btn-sm"
                                                    onclick="window.print()">
                                                <i class="fas fa-print"></i> Print Article
                                            </button>

                                            <t t-if="article.source_exercise_id">
                                                <a t-attf-href="/web#id=#{article.source_exercise_id.id}&amp;model=bcm.exercise"
                                                   class="btn btn-outline-info btn-sm">
                                                    <i class="fas fa-dumbbell"></i> View Source Exercise
                                                </a>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <!-- Include Knowledge Search JavaScript -->
            <script type="text/javascript" src="/bcm_community/static/src/js/knowledge_search.js"></script>
        </t>
    </template>

    <!-- Search Results Template -->
    <template id="knowledge_search_results" name="Knowledge Search Results">
        <t t-call="website.layout">
            <div id="wrap" class="knowledge-search-results">
                <section class="search-header bg-light py-4">
                    <div class="container">
                        <h2>Search Results</h2>
                        <p class="lead">
                            Found <strong><t t-esc="total_results"/></strong> articles
                            for "<strong><t t-esc="search_query"/></strong>"
                        </p>

                        <!-- Search Again -->
                        <form method="get" action="/bcm/community/knowledge/search" class="search-form mt-3">
                            <div class="input-group">
                                <input type="text"
                                       name="q"
                                       class="form-control"
                                       t-att-value="search_query"
                                       placeholder="Search knowledge articles..."/>
                                <div class="input-group-append">
                                    <button class="btn btn-primary" type="submit">
                                        <i class="fas fa-search"></i> Search Again
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </section>

                <section class="search-results py-5">
                    <div class="container">
                        <t t-if="articles">
                            <!-- Results by Category -->
                            <t t-foreach="results_by_category.items()" t-as="category_group">
                                <div class="category-results mb-5">
                                    <h4 class="category-title mb-3">
                                        <t t-esc="dict(articles[0]._fields['category'].selection)[category_group[0]]"/>
                                        <span class="text-muted">(<t t-esc="len(category_group[1])"/> articles)</span>
                                    </h4>

                                    <div class="articles-list">
                                        <t t-foreach="category_group[1]" t-as="article">
                                            <div class="search-result-item card mb-3">
                                                <div class="card-body">
                                                    <h5 class="card-title">
                                                        <a t-attf-href="/bcm/community/knowledge/article/#{article.id}">
                                                            <t t-esc="article.name"/>
                                                        </a>
                                                    </h5>
                                                    <p class="card-text">
                                                        <t t-esc="article.summary"/>
                                                    </p>
                                                    <div class="article-meta">
                                                        <small class="text-muted">
                                                            <i class="fas fa-eye"></i> <t t-esc="article.view_count"/> views
                                                            <span class="mx-2">•</span>
                                                            <i class="fas fa-star text-warning"></i>
                                                            <t t-esc="article.usefulness_score" t-options="{'precision': 1}"/> rating
                                                            <span class="mx-2">•</span>
                                                            <t t-esc="article.create_date.strftime('%B %d, %Y')"/>
                                                        </small>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </t>

                        <t t-else="">
                            <div class="no-results text-center py-5">
                                <i class="fas fa-search fa-3x text-muted mb-3"></i>
                                <h4>No articles found</h4>
                                <p class="text-muted">
                                    No articles match your search for "<strong><t t-esc="search_query"/></strong>".
                                    Try different keywords or browse our categories.
                                </p>
                                <a href="/bcm/community/knowledge" class="btn btn-primary">
                                    <i class="fas fa-arrow-left"></i> Browse All Articles
                                </a>
                            </div>
                        </t>
                    </div>
                </section>
            </div>
        </t>
    </template>
    </data>
</odoo>