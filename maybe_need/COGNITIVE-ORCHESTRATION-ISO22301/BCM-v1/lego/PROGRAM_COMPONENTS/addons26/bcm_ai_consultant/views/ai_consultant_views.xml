<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- AI Consultant Tree View -->
    <record id="view_ai_consultant_tree" model="ir.ui.view">
        <field name="name">bcm.ai.consultant.tree</field>
        <field name="model">bcm.ai.consultant</field>
        <field name="arch" type="xml">
            <list string="AI Consultants" sample="1">
                <field name="name"/>
                <field name="ai_type"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="languages"/>
                <field name="bcm_client_id"/>
                <field name="total_consultations"/>
                <field name="average_rating" widget="progressbar"/>
            </list>
        </field>
    </record>

    <!-- AI Consultant Form View -->
    <record id="view_ai_consultant_form" model="ir.ui.view">
        <field name="name">bcm.ai.consultant.form</field>
        <field name="model">bcm.ai.consultant</field>
        <field name="arch" type="xml">
            <form string="AI Consultant">
                <header>
                    <button name="action_start_consultation" string="Start Consultation" type="object"
                            class="btn-primary"/>
                    <button name="action_view_knowledge_base" string="Knowledge Base" type="object"
                            class="btn-info"/>
                    <button name="action_consultation_history" string="History" type="object"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="ai_type"/>
                            <field name="languages"/>
                            <field name="bcm_client_id"/>
                            <field name="is_active"/>
                            <field name="auto_learn"/>
                        </group>
                        <group>
                            <field name="total_consultations"/>
                            <field name="average_rating"/>
                            <field name="last_consultation_date"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Configuration">
                            <group>
                                <field name="ai_config" widget="text"/>
                                <field name="context_data" widget="text"/>
                                <field name="response_template" widget="text"/>
                            </group>
                        </page>
                        <page string="Knowledge Base">
                            <field name="knowledge_base_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Sessions">
                            <field name="consultation_session_ids" readonly="1"/>
                        </page>
                        <page string="Statistics">
                            <group>
                                <field name="total_consultations"/>
                                <field name="average_rating"/>
                                <field name="last_consultation_date"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- AI Consultant Search View -->
    <record id="view_ai_consultant_search" model="ir.ui.view">
        <field name="name">bcm.ai.consultant.search</field>
        <field name="model">bcm.ai.consultant</field>
        <field name="arch" type="xml">
            <search string="AI Consultants">
                <field name="name"/>
                <field name="ai_type"/>
                <field name="languages"/>
                <field name="bcm_client_id"/>
                <separator/>
                <filter string="Active" name="active" domain="[('is_active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('is_active', '=', False)]"/>
                <filter string="ChatGPT" name="chatgpt" domain="[('ai_type', '=', 'chatgpt4')]"/>
                <filter string="Claude" name="claude" domain="[('ai_type', '=', 'claude')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="AI Type" name="group_type" domain="[]" context="{'group_by': 'ai_type'}"/>
                    <filter string="Language" name="group_language" domain="[]" context="{'group_by': 'languages'}"/>
                    <filter string="Active" name="group_active" domain="[]" context="{'group_by': 'is_active'}"/>
                    <filter string="Client" name="group_client" domain="[]" context="{'group_by': 'bcm_client_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_ai_consultant" model="ir.actions.act_window">
        <field name="name">AI Consultants</field>
        <field name="res_model">bcm.ai.consultant</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ai_consultant_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first AI Consultant!
            </p>
            <p>
                AI Consultants provide intelligent guidance and recommendations
                for your Business Continuity Management processes.
            </p>
        </field>
    </record>

</odoo>