<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- BCM Reporting Cron Jobs will be defined here -->

        <!-- Daily Analytics Report Generation -->
        <record id="cron_daily_analytics_report" model="ir.cron">
            <field name="name">BCM Daily Analytics Report</field>
            <field name="model_id" ref="model_bcm_analytics"/>
            <field name="state">code</field>
            <field name="code">model.generate_daily_report()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>