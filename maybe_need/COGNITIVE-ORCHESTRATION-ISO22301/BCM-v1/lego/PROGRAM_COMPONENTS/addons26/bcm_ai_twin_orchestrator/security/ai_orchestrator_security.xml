<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- AI Twin Orchestrator Security Groups -->
        <record id="group_ai_orchestrator_user" model="res.groups">
            <field name="name">AI Orchestrator User</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can view and create AI analyses</field>
        </record>

        <record id="group_ai_orchestrator_analyst" model="res.groups">
            <field name="name">AI Orchestrator Analyst</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('group_ai_orchestrator_user'))]"/>
            <field name="comment">Can manage AI analyses and access advanced features</field>
        </record>

        <record id="group_ai_orchestrator_manager" model="res.groups">
            <field name="name">AI Orchestrator Manager</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('group_ai_orchestrator_analyst'))]"/>
            <field name="comment">Can configure AI orchestration and manage all analyses</field>
        </record>

        <record id="group_ai_orchestrator_admin" model="res.groups">
            <field name="name">AI Orchestrator Administrator</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="implied_ids" eval="[(4, ref('group_ai_orchestrator_manager'))]"/>
            <field name="comment">Full administrative access to AI orchestration system</field>
        </record>

        <!-- Record Rules for AI Twin Orchestrator -->
        <record id="ai_orchestrator_rule_user" model="ir.rule">
            <field name="name">AI Orchestrator: User Access</field>
            <field name="model_id" ref="model_bcm_ai_twin_orchestrator"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ai_orchestrator_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="ai_orchestrator_rule_analyst" model="ir.rule">
            <field name="name">AI Orchestrator: Analyst Access</field>
            <field name="model_id" ref="model_bcm_ai_twin_orchestrator"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ai_orchestrator_analyst'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="ai_orchestrator_rule_manager" model="ir.rule">
            <field name="name">AI Orchestrator: Manager Access</field>
            <field name="model_id" ref="model_bcm_ai_twin_orchestrator"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ai_orchestrator_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="ai_orchestrator_rule_admin" model="ir.rule">
            <field name="name">AI Orchestrator: Admin Access</field>
            <field name="model_id" ref="model_bcm_ai_twin_orchestrator"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ai_orchestrator_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>