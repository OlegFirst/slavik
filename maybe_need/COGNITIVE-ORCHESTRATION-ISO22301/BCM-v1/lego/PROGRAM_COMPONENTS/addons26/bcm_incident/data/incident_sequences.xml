<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Incident Number Sequences -->
        <record id="seq_bcm_incident" model="ir.sequence">
            <field name="name">Incident Number</field>
            <field name="code">bcm.incident</field>
            <field name="prefix">INC-</field>
            <field name="suffix">-%(year)s</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Crisis Communication Sequence -->
        <record id="seq_crisis_communication" model="ir.sequence">
            <field name="name">Crisis Communication</field>
            <field name="code">bcm.crisis.communication</field>
            <field name="prefix">CC-</field>
            <field name="suffix">-%(year)s</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Response Team Operation Sequence -->
        <record id="seq_response_operation" model="ir.sequence">
            <field name="name">Response Operation</field>
            <field name="code">bcm.response.operation</field>
            <field name="prefix">RO-</field>
            <field name="suffix">-%(year)s</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Field Update Reference Sequence -->
        <record id="seq_field_update" model="ir.sequence">
            <field name="name">Field Update</field>
            <field name="code">bcm.field.update</field>
            <field name="prefix">FU-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
        
    </data>
</odoo>