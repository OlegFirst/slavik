<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- BCM Client Vault Tree View -->
        <record id="bcm_client_vault_view_tree" model="ir.ui.view">
            <field name="name">bcm.client.vault.tree</field>
            <field name="model">bcm.client.vault</field>
            <field name="arch" type="xml">
                <list string="Client Context Vault" decoration-success="indexed" decoration-danger="index_error">
                    <field name="client_id"/>
                    <field name="context_type"/>
                    <field name="name"/>
                    <field name="sensitivity_level" widget="badge"/>
                    <field name="source"/>
                    <field name="indexed" widget="boolean_toggle"/>
                    <field name="updated_at"/>
                    <field name="index_error" invisible="1"/>
                </list>
            </field>
        </record>

        <!-- BCM Client Vault Form View -->
        <record id="bcm_client_vault_view_form" model="ir.ui.view">
            <field name="name">bcm.client.vault.form</field>
            <field name="model">bcm.client.vault</field>
            <field name="arch" type="xml">
                <form string="Client Context">
                    <header>
                        <button name="action_reindex" type="object" 
                                string="Reindex in AI" class="btn-primary"
                                confirm="This will reindex this context in the AI system. Continue?"/>
                        <field name="indexed" widget="statusbar" 
                               statusbar_visible="False,True"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Context Name"/>
                            </h1>
                        </div>
                        
                        <group>
                            <group string="Context Information">
                                <field name="client_id"/>
                                <field name="context_type"/>
                                <field name="sensitivity_level"/>
                                <field name="source"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group string="AI Indexing Status">
                                <field name="indexed"/>
                                <field name="embedding_model"/>
                                <field name="created_at"/>
                                <field name="updated_at"/>
                            </group>
                        </group>
                        
                        <group string="Description">
                            <field name="description" nolabel="1"/>
                        </group>
                        
                        <notebook>
                            <page string="External References" name="external_refs">
                                <group string="System Integration References">
                                    <p>External system IDs and references (JSON format):</p>
                                </group>
                                <field name="external_refs" widget="ace" options="{'mode': 'json'}"/>
                            </page>
                            
                            <page string="Tags &amp; Categorization" name="tags">
                                <group>
                                    <field name="tags"/>
                                    <field name="process_ids" widget="many2many_tags"/>
                                </group>
                            </page>
                            
                            <page string="AI Embedding" name="embedding">
                                <group string="Vector Representation">
                                    <p>AI-generated vector embedding for semantic search (read-only):</p>
                                </group>
                                <field name="embedding" widget="text" readonly="1"/>
                                <group string="Indexing Errors" invisible="index_error == False">
                                    <field name="index_error" nolabel="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- BCM Client Vault Kanban View -->
        <record id="bcm_client_vault_view_kanban" model="ir.ui.view">
            <field name="name">bcm.client.vault.kanban</field>
            <field name="model">bcm.client.vault</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name"/>
                    <field name="context_type"/>
                    <field name="sensitivity_level"/>
                    <field name="indexed"/>
                    <field name="client_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                            <br/>
                                            <small><field name="client_id"/></small>
                                        </div>
                                        <div class="o_kanban_record_body">
                                            <field name="context_type" widget="badge"/>
                                            <br/>
                                            <field name="sensitivity_level" widget="badge"/>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <span t-if="record.indexed.raw_value" class="badge badge-success">
                                                <i class="fa fa-check"/> Indexed
                                            </span>
                                            <span t-else="" class="badge badge-warning">
                                                <i class="fa fa-clock-o"/> Pending
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- BCM Client Vault Search View -->
        <record id="bcm_client_vault_view_search" model="ir.ui.view">
            <field name="name">bcm.client.vault.search</field>
            <field name="model">bcm.client.vault</field>
            <field name="arch" type="xml">
                <search string="Search Client Context">
                    <field name="name" string="Context" 
                           filter_domain="['|', ('name', 'ilike', self), ('description', 'ilike', self)]"/>
                    <field name="client_id"/>
                    <field name="context_type"/>
                    <field name="tags"/>
                    
                    <separator/>
                    <filter string="Active" name="active" 
                            domain="[('active', '=', True)]"/>
                    <filter string="Indexed" name="indexed" 
                            domain="[('indexed', '=', True)]"/>
                    <filter string="Pending Index" name="pending_index" 
                            domain="[('indexed', '=', False)]"/>
                    <filter string="High Sensitivity" name="high_sensitivity" 
                            domain="[('sensitivity_level', 'in', ['high', 'critical'])]"/>
                    <filter string="Index Errors" name="index_errors" 
                            domain="[('index_error', '!=', False)]"/>
                    
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Client" name="group_client" 
                                domain="[]" context="{'group_by': 'client_id'}"/>
                        <filter string="Context Type" name="group_type" 
                                domain="[]" context="{'group_by': 'context_type'}"/>
                        <filter string="Sensitivity" name="group_sensitivity" 
                                domain="[]" context="{'group_by': 'sensitivity_level'}"/>
                        <filter string="Source" name="group_source" 
                                domain="[]" context="{'group_by': 'source'}"/>
                        <filter string="Company" name="group_company" 
                                domain="[]" context="{'group_by': 'company_id'}" 
                                groups="base.group_multi_company"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- BCM Client Vault Action -->
        <record id="bcm_client_vault_action" model="ir.actions.act_window">
            <field name="name">Client Context Vault</field>
            <field name="res_model">bcm.client.vault</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create Client Context Records!
                </p>
                <p>
                    Store and manage client-specific context information that will be 
                    indexed by the AI system for intelligent recommendations and analysis.
                </p>
            </field>
        </record>

    </data>
</odoo>
