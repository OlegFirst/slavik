<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- BCM Client Security Groups -->
        <record id="group_bcm_manager" model="res.groups">
            <field name="name">BCM Internal</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="comment">Internal BCM platform administrators with access to all companies</field>
        </record>

        <record id="group_bcm_client_admin" model="res.groups">
            <field name="name">BCM Client Administrator</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="comment">Client administrators with full access within their company</field>
        </record>

        <record id="group_bcm_client_user" model="res.groups">
            <field name="name">BCM Client User</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="comment">Client users with limited access to assigned tasks</field>
        </record>

        <record id="group_bcm_partner_auditor" model="res.groups">
            <field name="name">BCM Partner Auditor</field>
            <field name="category_id" ref="base.module_category_administration"/>
            <field name="comment">External auditors with read-only access to audit materials</field>
        </record>

        <!-- Record Rules for Multi-tenancy -->

        <!-- BCM Client Record Rules -->
        <record id="bcm_client_multi_company_rule" model="ir.rule">
            <field name="name">BCM Client Multi-Company Rule</field>
            <field name="model_id" ref="model_bcm_client"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_bcm_client_admin')), (4, ref('group_bcm_client_user')), (4, ref('base.group_portal'))]"/>
        </record>

        <record id="bcm_client_internal_rule" model="ir.rule">
            <field name="name">BCM Client Internal Access</field>
            <field name="model_id" ref="model_bcm_client"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_bcm_manager'))]"/>
        </record>

        <!-- BCM Client Contact Record Rules -->
        <record id="bcm_client_contact_multi_company_rule" model="ir.rule">
            <field name="name">BCM Client Contact Multi-Company Rule</field>
            <field name="model_id" ref="model_bcm_client_contact"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_bcm_client_admin')), (4, ref('group_bcm_client_user')), (4, ref('base.group_portal'))]"/>
        </record>

        <record id="bcm_client_contact_internal_rule" model="ir.rule">
            <field name="name">BCM Client Contact Internal Access</field>
            <field name="model_id" ref="model_bcm_client_contact"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_bcm_manager'))]"/>
        </record>

        <!-- BCM Client Vault Record Rules -->
        <record id="bcm_client_vault_multi_company_rule" model="ir.rule">
            <field name="name">BCM Client Vault Multi-Company Rule</field>
            <field name="model_id" ref="model_bcm_client_vault"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_bcm_client_admin')), (4, ref('group_bcm_client_user')), (4, ref('base.group_portal'))]"/>
        </record>

        <record id="bcm_client_vault_internal_rule" model="ir.rule">
            <field name="name">BCM Client Vault Internal Access</field>
            <field name="model_id" ref="model_bcm_client_vault"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_bcm_manager'))]"/>
        </record>

        <!-- BCM Client API Key Record Rules -->
        <record id="bcm_client_appkey_multi_company_rule" model="ir.rule">
            <field name="name">BCM Client API Key Multi-Company Rule</field>
            <field name="model_id" ref="model_bcm_client_appkey"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_bcm_client_admin'))]"/>
        </record>

        <record id="bcm_client_appkey_internal_rule" model="ir.rule">
            <field name="name">BCM Client API Key Internal Access</field>
            <field name="model_id" ref="model_bcm_client_appkey"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_bcm_manager'))]"/>
        </record>

        <!-- Partner Auditor Rules (Read-only access) -->
        <record id="bcm_client_auditor_rule" model="ir.rule">
            <field name="name">BCM Client Auditor Access</field>
            <field name="model_id" ref="model_bcm_client"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[(4, ref('group_bcm_partner_auditor'))]"/>
        </record>

        <!-- Default API Scopes -->
        <record id="scope_read" model="bcm.scope">
            <field name="name">read</field>
            <field name="description">Read access to client data</field>
        </record>

        <record id="scope_write" model="bcm.scope">
            <field name="name">write</field>
            <field name="description">Write access to client data</field>
        </record>

        <record id="scope_bia" model="bcm.scope">
            <field name="name">bia</field>
            <field name="description">Access to Business Impact Analysis</field>
        </record>

        <record id="scope_plans" model="bcm.scope">
            <field name="name">plans</field>
            <field name="description">Access to Business Continuity Plans</field>
        </record>

        <record id="scope_incidents" model="bcm.scope">
            <field name="name">incidents</field>
            <field name="description">Access to Incident Management</field>
        </record>

        <record id="scope_audit" model="bcm.scope">
            <field name="name">audit</field>
            <field name="description">Access to Audit and Compliance</field>
        </record>

        <record id="scope_exercises" model="bcm.scope">
            <field name="name">exercises</field>
            <field name="description">Access to Exercises and Simulations</field>
        </record>

        <record id="scope_training" model="bcm.scope">
            <field name="name">training</field>
            <field name="description">Access to Training and Awareness</field>
        </record>

    </data>
</odoo>
