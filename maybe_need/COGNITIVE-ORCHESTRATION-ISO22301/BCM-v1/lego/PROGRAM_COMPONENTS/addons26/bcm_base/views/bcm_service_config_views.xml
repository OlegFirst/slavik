<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_bcm_service_config_tree" model="ir.ui.view">
            <field name="name">bcm.service.config.tree</field>
            <field name="model">bcm.service.config</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="service_type"/>
                    <field name="base_url"/>
                    <field name="port"/>
                    <field name="health_status" widget="badge"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        
        <!-- Form View -->
        <record id="view_bcm_service_config_form" model="ir.ui.view">
            <field name="name">bcm.service.config.form</field>
            <field name="model">bcm.service.config</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="service_type"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="base_url"/>
                                <field name="port"/>
                                <field name="timeout"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="api_key" password="True" groups="base.group_system"/>
                            </group>
                            <group>
                                <field name="health_status" readonly="1"/>
                                <field name="last_health_check" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Action -->
        <record id="action_bcm_service_config" model="ir.actions.act_window">
            <field name="name">AI Service Configuration</field>
            <field name="res_model">bcm.service.config</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>