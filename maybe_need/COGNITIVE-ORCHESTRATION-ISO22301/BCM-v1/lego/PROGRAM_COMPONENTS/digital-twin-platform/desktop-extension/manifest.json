{
  "schemaVersion": "0.1.0",
  "name": "nash-digital-twin",
  "displayName": "NASH 4.0 Digital Twin Platform",
  "description": "Advanced Digital Twin simulation platform with 30 experiments for organizational modeling and AI-driven optimization",
  "version": "3.0.0",
  "author": {
    "name": "NASH Platform Team",
    "email": "support@nash4.ai",
    "url": "https://nash4.ai"
  },
  
  "server": {
    "command": "node",
    "args": ["server/index.js"],
    "env": {
      "NODE_ENV": "production",
      "ENABLE_DEMO_MODE": "true"
    }
  },
  
  "configuration": {
    "properties": {
      "organization_name": {
        "type": "string",
        "title": "Organization Name",
        "description": "Name of your organization",
        "required": true,
        "default": "Demo Organization"
      },
      "api_key": {
        "type": "string",
        "title": "API Key",
        "description": "Your NASH platform API key (leave empty for demo mode)",
        "sensitive": true,
        "required": false
      },
      "supabase_url": {
        "type": "string",
        "title": "Supabase URL",
        "description": "Supabase project URL for data persistence (optional)",
        "required": false
      },
      "supabase_key": {
        "type": "string",
        "title": "Supabase Key",
        "description": "Supabase service key (optional)",
        "sensitive": true,
        "required": false
      },
      "enable_ai_analysis": {
        "type": "boolean",
        "title": "Enable AI Analysis",
        "description": "Enable AI-powered organizational analysis",
        "default": true
      },
      "simulation_adapters": {
        "type": "object",
        "title": "Simulation Adapters",
        "description": "External simulation engine endpoints",
        "properties": {
          "simpy_url": {
            "type": "string",
            "title": "SimPy Adapter URL",
            "default": "http://localhost:7001"
          },
          "mesa_url": {
            "type": "string",
            "title": "Mesa Adapter URL",
            "default": "http://localhost:7002"
          },
          "epinow2_url": {
            "type": "string",
            "title": "EpiNow2 Adapter URL",
            "default": "http://localhost:7003"
          },
          "anylogic_url": {
            "type": "string",
            "title": "AnyLogic Adapter URL",
            "default": "http://localhost:7004"
          }
        }
      }
    }
  },
  
  "capabilities": {
    "tools": true,
    "resources": true,
    "prompts": true,
    "notifications": false
  },
  
  "tools": [
    {
      "name": "create_digital_twin",
      "description": "Create a new digital twin of an organization"
    },
    {
      "name": "run_simulation",
      "description": "Run one of 30 available simulation experiments"
    },
    {
      "name": "analyze_organization",
      "description": "Perform AI-driven organizational analysis"
    },
    {
      "name": "predict_trends",
      "description": "Predict organizational trends and patterns"
    },
    {
      "name": "optimize_parameters",
      "description": "Optimize organizational parameters"
    },
    {
      "name": "generate_report",
      "description": "Generate comprehensive organizational reports"
    }
  ],
  
  "resources": [
    {
      "uri": "twin://documentation",
      "name": "Platform Documentation",
      "description": "Complete documentation for Digital Twin platform"
    },
    {
      "uri": "twin://templates",
      "name": "Organization Templates",
      "description": "Pre-built templates for different organization types"
    },
    {
      "uri": "twin://experiments",
      "name": "Experiment Catalog",
      "description": "List of all 30 available experiments"
    }
  ],
  
  "prompts": [
    {
      "name": "analyze_npo",
      "description": "Analyze non-profit organization efficiency"
    },
    {
      "name": "optimize_budget",
      "description": "Optimize budget allocation for maximum impact"
    },
    {
      "name": "crisis_planning",
      "description": "Create crisis response scenarios"
    }
  ],
  
  "metadata": {
    "homepage": "https://nash4.ai/digital-twin",
    "repository": "https://github.com/nash4/digital-twin-platform",
    "documentation": "https://docs.nash4.ai/digital-twin",
    "support": "support@nash4.ai",
    "license": "MIT",
    "tags": ["simulation", "digital-twin", "organizational-modeling", "ai", "optimization"],
    "category": "Business & Analytics",
    "minClaudeVersion": "1.0.0",
    "maxClaudeVersion": "*"
  },
  
  "permissions": {
    "network": ["http://localhost:*", "https://api.nash4.ai/*"],
    "filesystem": {
      "read": ["~/nash-digital-twin/data/*"],
      "write": ["~/nash-digital-twin/exports/*"]
    }
  },
  
  "icon": "assets/icon.png",
  "readme": "README.md",
  "changelog": "CHANGELOG.md"
}