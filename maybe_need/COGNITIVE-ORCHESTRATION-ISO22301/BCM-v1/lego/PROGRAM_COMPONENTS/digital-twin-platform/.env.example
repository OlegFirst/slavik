# Digital Twin Standalone Configuration
# Copy this file to .env and configure

# Server Configuration
NODE_ENV=production
PORT=3000

# Security Configuration
JWT_SECRET=generate-strong-secret-here-minimum-32-chars
SESSION_SECRET=generate-another-strong-secret-here
ENCRYPTION_KEY=base64-encoded-32-byte-key

# Database Configuration (Choose one)
DATABASE_TYPE=postgresql  # Options: postgresql, mongodb, redis, memory

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=digital_twin
POSTGRES_USER=dt_user
POSTGRES_PASSWORD=secure_password
POSTGRES_SSL=true

# MongoDB Configuration (Alternative)
MONGODB_URI=mongodb://localhost:27017/digital_twin
MONGODB_USER=dt_user
MONGODB_PASSWORD=secure_password

# Redis Configuration (For caching/sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0

# AI Configuration
OPENAI_API_KEY=your-api-key-here
ANTHROPIC_API_KEY=your-api-key-here
AI_MODEL=gpt-4  # or claude-3

# MCP Integration
MCP_ENABLED=true
MCP_SERVER_URL=http://localhost:8080
MCP_AUTH_TOKEN=mcp-auth-token

# Security Settings
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
HTTPS_ENABLED=true
FORCE_SSL=true

# Monitoring
ENABLE_MONITORING=true
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true