<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

        <!-- Digital Twin Organization Sequence -->
        <record id="seq_digital_twin_organization" model="ir.sequence">
            <field name="name">Digital Twin Organization</field>
            <field name="code">bcm.digital.twin.organization</field>
