<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_digital_twin_config_tree" model="ir.ui.view">
        <field name="name">bcm.digital.twin.config.tree</field>
        <field name="model">bcm.digital.twin.config</field>
        <field name="arch" type="xml">
            <list string="Digital Twin Configurations">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="service_url"/>
                <field name="timeout"/>
                <field name="enable_ai_analysis" widget="boolean_toggle"/>
                <field name="default_simulation_mode"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_digital_twin_config_form" model="ir.ui.view">
        <field name="name">bcm.digital.twin.config.form</field>
        <field name="model">bcm.digital.twin.config</field>
        <field name="arch" type="xml">
            <form string="Digital Twin Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Configuration Name"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Connection Settings">
                            <field name="active"/>
                            <field name="service_url" required="1"/>
                            <field name="timeout"/>
                            <field name="retry_count"/>
                        </group>
                        <group string="Simulation Settings">
                            <field name="default_simulation_mode"/>
                            <field name="max_concurrent_simulations"/>
                            <field name="batch_processing_enabled"/>
                            <field name="batch_size" invisible="not batch_processing_enabled"/>
                        </group>
                    </group>

                    <group>
                        <group string="Caching">
                            <field name="enable_caching"/>
                            <field name="cache_duration" invisible="not enable_caching"/>
                        </group>
                        <group string="AI Analysis">
                            <field name="enable_ai_analysis"/>
                            <field name="ai_confidence_threshold" invisible="not enable_ai_analysis"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Advanced Configuration" name="advanced">
                            <group string="API Settings">
                                <field name="api_key" password="True"/>
                            </group>
                            <group string="Domain Configuration">
                                <field name="domain_configs" widget="text"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_digital_twin_config_search" model="ir.ui.view">
        <field name="name">bcm.digital.twin.config.search</field>
        <field name="model">bcm.digital.twin.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="service_url"/>

                <filter string="Active" name="active"
                        domain="[('active', '=', True)]"/>
                <filter string="AI Enabled" name="ai_enabled"
                        domain="[('enable_ai_analysis', '=', True)]"/>
                <filter string="Caching Enabled" name="cache_enabled"
                        domain="[('enable_caching', '=', True)]"/>

                <group expand="0" string="Group By">
                    <filter string="Simulation Mode" name="group_mode"
                            context="{'group_by': 'default_simulation_mode'}"/>
                    <filter string="Status" name="group_active"
                            context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_digital_twin_config" model="ir.actions.act_window">
        <field name="name">Digital Twin Configurations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">bcm.digital.twin.config</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Digital Twin Configuration
            </p>
            <p>
                Configure connection settings and parameters for
                your Digital Twin service integration.
            </p>
        </field>
    </record>
</odoo>