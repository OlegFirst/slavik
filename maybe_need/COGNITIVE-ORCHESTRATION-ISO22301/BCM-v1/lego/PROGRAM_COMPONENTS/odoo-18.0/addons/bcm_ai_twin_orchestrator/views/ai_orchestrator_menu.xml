<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- AI Twin Orchestrator Action -->
    <record id="action_ai_orchestrator" model="ir.actions.act_window">
        <field name="name">AI Orchestrator</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">bcm.ai.twin.orchestrator</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first AI Analysis
            </p>
            <p>
                Use AI Twin Orchestrator to coordinate multiple AI organs
                for comprehensive business continuity analysis.
            </p>
        </field>
    </record>

    <!-- Quick Actions -->
    <record id="action_ai_orchestrator_new_comprehensive" model="ir.actions.act_window">
        <field name="name">New Comprehensive Analysis</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">bcm.ai.twin.orchestrator</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_analysis_type': 'comprehensive'}</field>
    </record>

    <record id="action_ai_orchestrator_new_risk" model="ir.actions.act_window">
        <field name="name">New Risk Analysis</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">bcm.ai.twin.orchestrator</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_analysis_type': 'risk_focused'}</field>
    </record>

    <record id="action_ai_orchestrator_new_emergency" model="ir.actions.act_window">
        <field name="name">New Emergency Analysis</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">bcm.ai.twin.orchestrator</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_analysis_type': 'emergency', 'default_priority': 'critical'}</field>
    </record>

    <!-- Dashboard Action -->
    <record id="action_ai_orchestrator_dashboard" model="ir.actions.act_window">
        <field name="name">AI Analysis Dashboard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">bcm.ai.twin.orchestrator</field>
        <field name="view_mode">kanban,graph,pivot</field>
        <field name="context">{'search_default_my_analyses': 1}</field>
    </record>

    <!-- Main Menu -->
    <menuitem id="menu_ai_twin_orchestrator_root"
              name="AI Orchestrator"
              web_icon="bcm_ai_twin_orchestrator,static/description/icon.png"
              sequence="50"/>

    <!-- Sub Menus -->
    <menuitem id="menu_ai_orchestrator_main"
              name="AI Analyses"
              parent="menu_ai_twin_orchestrator_root"
              action="action_ai_orchestrator"
              sequence="10"/>

    <menuitem id="menu_ai_orchestrator_dashboard"
              name="Dashboard"
              parent="menu_ai_twin_orchestrator_root"
              action="action_ai_orchestrator_dashboard"
              sequence="20"/>

    <!-- Quick Create Submenu -->
    <menuitem id="menu_ai_orchestrator_create"
              name="Create Analysis"
              parent="menu_ai_twin_orchestrator_root"
              sequence="30"/>

    <menuitem id="menu_ai_orchestrator_new_comprehensive"
              name="Comprehensive"
              parent="menu_ai_orchestrator_create"
              action="action_ai_orchestrator_new_comprehensive"
              sequence="10"/>

    <menuitem id="menu_ai_orchestrator_new_risk"
              name="Risk Analysis"
              parent="menu_ai_orchestrator_create"
              action="action_ai_orchestrator_new_risk"
              sequence="20"/>

    <menuitem id="menu_ai_orchestrator_new_emergency"
              name="Emergency Analysis"
              parent="menu_ai_orchestrator_create"
              action="action_ai_orchestrator_new_emergency"
              sequence="30"/>

</odoo>