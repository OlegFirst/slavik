<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Business Process Views -->
        <record id="view_bcm_business_process_tree" model="ir.ui.view">
            <field name="name">bcm.business.process.tree</field>
            <field name="model">bcm.business.process</field>
            <field name="arch" type="xml">
                <list string="Business Processes">
                    <field name="name"/>
                    <field name="criticality" decoration-danger="criticality=='critical'" decoration-warning="criticality=='high'"/>
                    <field name="process_owner_id"/>
                    <field name="department_id"/>
                    <field name="rto_target"/>
                    <field name="rpo_target"/>
                    <field name="financial_impact_per_hour"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <record id="view_bcm_business_process_form" model="ir.ui.view">
            <field name="name">bcm.business.process.form</field>
            <field name="model">bcm.business.process</field>
            <field name="arch" type="xml">
                <form string="Business Process">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Process Name..."/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="criticality"/>
                                <field name="process_owner_id"/>
                                <field name="department_id"/>
                            </group>
                            <group>
                                <field name="rto_target"/>
                                <field name="rpo_target"/>
                                <field name="financial_impact_per_hour"/>
                            </group>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                        <notebook>
                            <page string="Dependencies">
                                <field name="dependency_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="criticality"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Compliance">
                                <group>
                                    <group>
                                        <field name="iso_clause"/>
                                        <field name="compliance_status"/>
                                    </group>
                                    <group>
                                        <field name="risk_level"/>
                                        <field name="last_review_date"/>
                                        <field name="next_review_date"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_bcm_business_process" model="ir.actions.act_window">
            <field name="name">Business Processes</field>
            <field name="res_model">bcm.business.process</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Business Process
                </p>
                <p>
                    Business processes are the core activities that drive your organization.
                </p>
            </field>
        </record>

        <menuitem id="menu_bcm_business_processes"
                  name="Business Processes"
                  parent="menu_bcm_core_section"
                  action="action_bcm_business_process"
                  sequence="40"/>
    </data>
</odoo>