<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- BCM Core Sequences -->
        <record id="sequence_bcm_organization" model="ir.sequence">
            <field name="name">BCM Organization</field>
            <field name="code">bcm.organization</field>
            <field name="prefix">ORG</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
        </record>
        
        <record id="sequence_bcm_business_unit" model="ir.sequence">
            <field name="name">BCM Business Unit</field>
            <field name="code">bcm.business.unit</field>
            <field name="prefix">BU</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
        </record>
    </data>
</odoo>