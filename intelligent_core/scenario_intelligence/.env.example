# ===================================================
# Scenario Intelligence - Environment Configuration
# ===================================================

# === Database Configuration ===
# PostgreSQL connection for persistent storage
DATABASE_URL=postgresql://user:password@host:5432/database

# === LLM Configuration ===
# For L4 Workflow Generator
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# LLM Provider (anthropic, openai, or both comma-separated)
LLM_PROVIDER=anthropic

# LLM Model selection
LLM_MODEL_ANTHROPIC=claude-3-5-sonnet-20241022
LLM_MODEL_OPENAI=gpt-4-turbo-preview

# === Qdrant Configuration ===
# Vector database for semantic search
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=  # Optional, for Qdrant Cloud

# Qdrant collection name
QDRANT_COLLECTION=scenario_intelligence

# Embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# === EventBus Configuration ===
# For integration with platform EventBus
EVENTBUS_HOST=localhost
EVENTBUS_PORT=6379  # Redis backend
EVENTBUS_ENABLED=true

# EventBus channels
EVENTBUS_CHANNEL_CATALOG_UPDATES=catalog.service.updated
EVENTBUS_CHANNEL_SCENARIO_GENERATED=scenario.generated
EVENTBUS_CHANNEL_SCENARIO_EXECUTED=scenario.executed

# === Service Configuration ===
# Scenario Orchestrator API
API_HOST=0.0.0.0
API_PORT=8060

# === Storage Configuration ===
# Which storage backends to use (comma-separated)
# Options: memory, postgres, qdrant
STORAGE_BACKENDS=memory,postgres

# Default storage for writes
DEFAULT_STORAGE=postgres

# === Generation Configuration ===
# Auto-regeneration settings
AUTO_REGENERATION_ENABLED=true
AUTO_REGENERATION_BATCH_WINDOW_SECONDS=30
AUTO_REGENERATION_MAX_BATCH_SIZE=50

# Generation timeout
GENERATION_TIMEOUT_SECONDS=300

# === Execution Configuration ===
# Scenario execution settings
EXECUTION_TIMEOUT_SECONDS=300
EXECUTION_MAX_RETRIES=3
EXECUTION_SAVE_TO_DB=true

# Mock actions (for testing)
EXECUTION_MOCK_ACTIONS=false

# === Monitoring Configuration ===
# MIO Manager integration
MIO_MANAGER_HOST=localhost
MIO_MANAGER_PORT=8020
MIO_MANAGER_ENABLED=true

# Metrics endpoint
METRICS_PORT=9090
METRICS_PATH=/metrics

# === Logging Configuration ===
LOG_LEVEL=INFO
LOG_FORMAT=json  # json or text
LOG_FILE=logs/scenario-intelligence.log

# === Feature Flags ===
# Enable/disable features
FEATURE_L4_GENERATION=true
FEATURE_SEMANTIC_SEARCH=true
FEATURE_AUTO_REGENERATION=true
FEATURE_EXECUTION_ENGINE=true

# === Development Settings ===
# Only for local development
DEBUG=false
RELOAD=false
ENVIRONMENT=production  # production, staging, development
