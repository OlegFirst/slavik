# Notification Service Configuration

# Service
PORT=8035
ENV=production

# Redis (Upstash for production, local for development)
UPSTASH_REDIS_URL=redis://default:your_password@region.upstash.io:6379
# Or for local development:
# REDIS_URL=redis://localhost:6379/2

# RabbitMQ (Optional - can use EventBus instead)
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# EventBus (for async notifications)
EVENTBUS_URL=http://localhost:8001

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@yourdomain.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=notifications@yourdomain.com
SMTP_FROM_NAME=BCM Platform Notifications

# SMS Provider (Optional - Twilio example)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Push Notifications (Optional - Firebase example)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Auth (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_JWT_SECRET=your_jwt_secret

# Monitoring
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
