FROM python:3.11-slim

LABEL maintainer="BCM Platform Team"
LABEL description="Qdrant Vector DB Prometheus Exporter"

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy exporter script
COPY qdrant_exporter.py .

# Expose metrics port
EXPOSE 9122

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:9122/metrics || exit 1

# Run exporter
CMD ["python", "qdrant_exporter.py"]
