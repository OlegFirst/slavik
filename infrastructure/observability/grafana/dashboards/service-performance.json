{
  "dashboard": {
    "id": null,
    "uid": "service-performance",
    "title": "Service Performance Dashboard",
    "tags": ["services", "performance", "bcm", "monitoring"],
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "templating": {
      "list": [
        {
          "name": "service_name",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(http_requests_total, job)",
          "multi": true,
          "includeAll": true,
          "refresh": 1,
          "allValue": ".*"
        },
        {
          "name": "endpoint",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(http_requests_total{job=~\"$service_name\"}, endpoint)",
          "multi": true,
          "includeAll": true,
          "refresh": 1,
          "allValue": ".*"
        },
        {
          "name": "time_range",
          "type": "interval",
          "query": "5m,15m,30m,1h,6h,12h,1d",
          "auto": false,
          "current": {
            "text": "5m",
            "value": "5m"
          }
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "name": "Service Deployments",
          "datasource": "Prometheus",
          "enable": true,
          "expr": "changes(process_start_time_seconds{job=~\"$service_name\"}[5m]) > 0",
          "iconColor": "blue",
          "tagKeys": "deployment"
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Service Health Matrix",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "up{job=~\"$service_name\"}",
            "refId": "A",
            "legendFormat": "{{job}} ({{instance}})"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "DOWN",
                    "color": "red"
                  },
                  "1": {
                    "text": "UP",
                    "color": "green"
                  }
                }
              }
            ]
          }
        },
        "options": {
          "orientation": "horizontal",
          "textMode": "value_and_name",
          "colorMode": "background"
        }
      },
      {
        "id": 2,
        "title": "HTTP Request Rate by Service",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 6
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "sum(rate(http_requests_total{job=~\"$service_name\"}[$time_range])) by (job)",
            "refId": "A",
            "legendFormat": "{{job}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "Requests/sec",
              "axisPlacement": "auto"
            },
            "unit": "reqps"
          }
        }
      },
      {
        "id": 3,
        "title": "HTTP Error Rate (4xx, 5xx)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 6
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "sum(rate(http_requests_total{job=~\"$service_name\",status=~\"4..|5..\"}[$time_range])) by (job, status)",
            "refId": "A",
            "legendFormat": "{{job}} - {{status}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "Errors/sec",
              "axisPlacement": "auto"
            },
            "unit": "reqps"
          }
        }
      },
      {
        "id": 4,
        "title": "Response Time - p95 Latency",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 14
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=~\"$service_name\"}[$time_range])) by (job, le))",
            "refId": "A",
            "legendFormat": "{{job}} - p95"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "Latency",
              "axisPlacement": "auto"
            },
            "unit": "s"
          }
        }
      },
      {
        "id": 5,
        "title": "Response Time - p99 Latency",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 14
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=~\"$service_name\"}[$time_range])) by (job, le))",
            "refId": "A",
            "legendFormat": "{{job}} - p99"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "Latency",
              "axisPlacement": "auto"
            },
            "unit": "s"
          }
        }
      },
      {
        "id": 6,
        "title": "BCM Services - Odoo Platform",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 22
