{
  "dashboard": {
    "id": null,
    "uid": "infrastructure-health",
    "title": "Infrastructure Health Dashboard",
    "tags": ["infrastructure", "performance", "node-exporter", "cadvisor", "database"],
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "templating": {
      "list": [
        {
          "name": "instance",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(up, instance)",
          "multi": true,
          "includeAll": true,
          "refresh": 1,
          "allValue": ".*"
        },
        {
          "name": "container",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(container_memory_usage_bytes, name)",
          "multi": true,
          "includeAll": true,
          "refresh": 1,
          "allValue": ".*"
        },
        {
          "name": "time_range",
          "type": "interval",
          "query": "5m,15m,30m,1h,6h,12h,1d",
          "auto": false,
          "current": {
            "text": "5m",
            "value": "5m"
          }
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "name": "System Restarts",
          "datasource": "Prometheus",
          "enable": true,
          "expr": "changes(node_boot_time_seconds[5m]) > 0",
          "iconColor": "red",
          "tagKeys": "restart"
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "System CPU Usage",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$instance\"}[$time_range])) * 100)",
            "refId": "A",
            "legendFormat": "{{instance}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "CPU Usage %",
              "axisPlacement": "auto"
            },
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        }
      },
      {
        "id": 2,
        "title": "Memory Usage",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "(1 - (node_memory_MemAvailable_bytes{instance=~\"$instance\"} / node_memory_MemTotal_bytes{instance=~\"$instance\"})) * 100",
            "refId": "A",
            "legendFormat": "{{instance}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "Memory Usage %",
              "axisPlacement": "auto"
            },
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        }
      },
      {
        "id": 3,
        "title": "Disk Usage",
        "type": "gauge",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "100 - ((node_filesystem_avail_bytes{instance=~\"$instance\",mountpoint=\"/\",fstype!=\"tmpfs\"} * 100) / node_filesystem_size_bytes{instance=~\"$instance\",mountpoint=\"/\",fstype!=\"tmpfs\"})",
            "refId": "A",
            "legendFormat": "{{instance}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "unit": "percent",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 70
                },
                {
                  "color": "red",
                  "value": 90
                }
              ]
            }
          }
        },
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 4,
        "title": "Network Traffic",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 16,
          "x": 8,
          "y": 8
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "rate(node_network_receive_bytes_total{instance=~\"$instance\",device!=\"lo\"}[$time_range])",
            "refId": "A",
            "legendFormat": "{{instance}} - {{device}} RX"
          },
          {
            "datasource": "Prometheus",
            "expr": "rate(node_network_transmit_bytes_total{instance=~\"$instance\",device!=\"lo\"}[$time_range])",
            "refId": "B",
            "legendFormat": "{{instance}} - {{device}} TX"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "Bytes/sec",
              "axisPlacement": "auto"
            },
            "unit": "Bps"
          }
        }
      },
      {
        "id": 5,
        "title": "Docker Container CPU Usage",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "rate(container_cpu_usage_seconds_total{name=~\"$container\",name!=\"\"}[$time_range]) * 100",
            "refId": "A",
            "legendFormat": "{{name}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "CPU Usage %",
              "axisPlacement": "auto"
            },
            "unit": "percent"
          }
        }
      },
      {
        "id": 6,
        "title": "Docker Container Memory Usage",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "container_memory_usage_bytes{name=~\"$container\",name!=\"\"} / 1024 / 1024",
            "refId": "A",
            "legendFormat": "{{name}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "Memory Usage MB",
              "axisPlacement": "auto"
            },
            "unit": "decmbytes"
          }
        }
      },
      {
        "id": 7,
        "title": "Docker Container Status",
        "type": "table",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 24
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "container_up{name=~\"$container\"}",
            "refId": "A",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "__name__": true
              },
              "renameByName": {
                "name": "Container",
                "Value": "Status"
              }
            }
          }
        ]
      },
      {
        "id": 8,
        "title": "PostgreSQL Database Connections",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 32
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "pg_stat_database_numbackends",
            "refId": "A",
            "legendFormat": "{{datname}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "Connections",
              "axisPlacement": "auto"
            }
          }
        }
      },
      {
        "id": 9,
        "title": "PostgreSQL Query Performance",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 32
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "rate(pg_stat_database_xact_commit[$time_range])",
            "refId": "A",
            "legendFormat": "{{datname}} - commits"
          },
          {
            "datasource": "Prometheus",
            "expr": "rate(pg_stat_database_xact_rollback[$time_range])",
            "refId": "B",
            "legendFormat": "{{datname}} - rollbacks"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "Transactions/sec",
              "axisPlacement": "auto"
            }
          }
        }
      },
      {
        "id": 10,
        "title": "PostgreSQL Cache Hit Ratio",
        "type": "gauge",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 40
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "sum(pg_stat_database_blks_hit) / (sum(pg_stat_database_blks_hit) + sum(pg_stat_database_blks_read)) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "unit": "percent",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 90
                },
                {
                  "color": "green",
                  "value": 95
                }
              ]
            }
          }
        },
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 11,
        "title": "Redis Memory Usage",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 40
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "redis_memory_used_bytes / 1024 / 1024",
            "refId": "A",
            "legendFormat": "Used Memory MB"
          },
          {
            "datasource": "Prometheus",
            "expr": "redis_memory_max_bytes / 1024 / 1024",
            "refId": "B",
            "legendFormat": "Max Memory MB"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "Memory MB",
              "axisPlacement": "auto"
            },
            "unit": "decmbytes"
          }
        }
      },
      {
        "id": 12,
        "title": "Redis Operations per Second",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 40
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "rate(redis_commands_processed_total[$time_range])",
            "refId": "A",
            "legendFormat": "Commands/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "Ops/sec",
              "axisPlacement": "auto"
            }
          }
        }
      },
      {
        "id": 13,
        "title": "System Alerts",
        "type": "table",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 48
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "ALERTS{alertstate=\"firing\"}",
            "refId": "A",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "__name__": true,
                "alertstate": true
              },
              "renameByName": {
                "alertname": "Alert",
                "severity": "Severity",
                "instance": "Instance"
              }
            }
          }
        ]
      },
      {
        "id": 14,
        "title": "Prometheus Metrics Count",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 56
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "count(up)",
            "refId": "A"
          }
        ],
        "options": {
          "textMode": "value_and_name",
          "colorMode": "value"
        }
      },
      {
        "id": 15,
        "title": "Services Up",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 6,
          "y": 56
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "count(up == 1)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 5
                },
                {
                  "color": "green",
                  "value": 10
                }
              ]
            }
          }
        },
        "options": {
          "textMode": "value_and_name",
          "colorMode": "background"
        }
      },
      {
        "id": 16,
        "title": "System Load Average (1m)",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 12,
          "y": 56
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "node_load1{instance=~\"$instance\"}",
            "refId": "A",
            "legendFormat": "{{instance}}"
          }
        ],
        "options": {
          "textMode": "value_and_name",
          "colorMode": "value"
        }
      },
      {
        "id": 17,
        "title": "System Uptime",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 18,
          "y": 56
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "(time() - node_boot_time_seconds{instance=~\"$instance\"}) / 86400",
            "refId": "A",
            "legendFormat": "{{instance}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "days"
          }
        },
        "options": {
          "textMode": "value_and_name",
          "colorMode": "value"
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s",
    "schemaVersion": 36,
    "version": 1
  }
}
