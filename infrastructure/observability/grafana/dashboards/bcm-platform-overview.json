{
  "dashboard": {
    "id": null,
    "uid": "bcm-platform-overview",
    "title": "BCM Platform Overview",
    "tags": ["bcm", "business-continuity", "overview", "platform"],
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "templating": {
      "list": [
        {
          "name": "service_name",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(up, job)",
          "regex": ".*bcm.*|.*ai.*|.*planning.*|.*plans.*|.*bia.*|.*compliance.*",
          "multi": true,
          "includeAll": true,
          "refresh": 1,
          "allValue": ".*"
        },
        {
          "name": "time_range",
          "type": "interval",
          "query": "5m,15m,30m,1h,6h,12h,1d",
          "auto": false,
          "current": {
            "text": "5m",
            "value": "5m"
          }
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": "Prometheus",
          "enable": true,
          "expr": "changes(process_start_time_seconds{job=~\"$service_name\"}[5m]) > 0",
          "iconColor": "blue",
          "tagKeys": "deployment"
        },
        {
          "name": "Incidents",
          "datasource": "Prometheus",
          "enable": true,
          "expr": "bcm_incidents_total",
          "iconColor": "red",
          "tagKeys": "incident"
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Overall System Health Status",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 8,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "avg(up{job=~\"$service_name\"})",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 0.5
                },
                {
                  "color": "green",
                  "value": 0.8
                }
              ]
            },
            "unit": "percentunit",
            "mappings": []
          }
        },
        "options": {
          "orientation": "auto",
          "textMode": "value_and_name",
          "colorMode": "background",
          "graphMode": "area"
        }
      },
      {
        "id": 2,
        "title": "Service Availability Matrix",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 16,
          "x": 8,
          "y": 0
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "up{job=~\"$service_name\"}",
            "refId": "A",
            "legendFormat": "{{job}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "DOWN",
                    "color": "red"
                  },
                  "1": {
                    "text": "UP",
                    "color": "green"
                  }
                }
              }
            ]
          }
        },
        "options": {
          "orientation": "horizontal",
          "textMode": "value_and_name",
          "colorMode": "background"
        }
      },
      {
        "id": 3,
        "title": "Auto-Discovered Services",
        "type": "table",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 6
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "up{job=~\"$service_name\"}",
            "refId": "A",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "__name__": true
              },
              "renameByName": {
                "job": "Service",
                "instance": "Endpoint",
                "Value": "Status"
              }
            }
          }
        ]
      },
      {
        "id": 4,
        "title": "Request Rate (req/s)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 6
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "sum(rate(http_requests_total{job=~\"$service_name\"}[$time_range])) by (job)",
            "refId": "A",
            "legendFormat": "{{job}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "Requests/sec",
              "axisPlacement": "auto"
            },
            "unit": "reqps"
          }
        }
      },
      {
        "id": 5,
        "title": "Error Rate (4xx, 5xx)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 14
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "sum(rate(http_requests_total{job=~\"$service_name\",status=~\"4..|5..\"}[$time_range])) by (job, status)",
            "refId": "A",
            "legendFormat": "{{job}} - {{status}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "Errors/sec",
              "axisPlacement": "auto"
            },
            "unit": "reqps"
          }
        }
      },
      {
        "id": 6,
        "title": "Response Latency (p95)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 14
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=~\"$service_name\"}[$time_range])) by (job, le))",
            "refId": "A",
            "legendFormat": "{{job}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "Latency",
              "axisPlacement": "auto"
            },
            "unit": "s"
          }
        }
      },
      {
        "id": 7,
        "title": "AI Services Health",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 12,
          "x": 0,
          "y": 22
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "up{job=\"ai_orchestrator\"}",
            "refId": "A",
            "legendFormat": "AI Orchestrator (8000)"
          },
          {
            "datasource": "Prometheus",
            "expr": "up{job=\"unified_ai\"}",
            "refId": "B",
            "legendFormat": "Unified AI (8090)"
          },
          {
            "datasource": "Prometheus",
            "expr": "up{job=\"scenario_orchestrator\"}",
            "refId": "C",
            "legendFormat": "Scenario Engine (8085)"
          },
          {
            "datasource": "Prometheus",
            "expr": "up{job=\"pdca_assistant\"}",
            "refId": "D",
            "legendFormat": "PDCA Assistant (8010)"
          },
          {
            "datasource": "Prometheus",
            "expr": "up{job=\"mcp_server\"}",
            "refId": "E",
            "legendFormat": "MCP Server (8087)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "DOWN",
                    "color": "red"
                  },
                  "1": {
                    "text": "UP",
                    "color": "green"
                  }
                }
              }
            ]
          }
        },
        "options": {
          "orientation": "vertical",
          "textMode": "value_and_name",
          "colorMode": "background"
        }
      },
      {
        "id": 8,
        "title": "AI Request Volume (per minute)",
        "type": "timeseries",
        "gridPos": {
          "h": 6,
          "w": 12,
          "x": 12,
          "y": 22
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "rate(ai_requests_total[$time_range])",
            "refId": "A",
            "legendFormat": "{{service}} requests/min"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "Requests/min",
              "axisPlacement": "auto"
            }
          }
        }
      },
      {
        "id": 9,
        "title": "BCM Platform KPIs",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 8,
          "x": 0,
          "y": 28
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "bcm_bia_coverage_percentage",
            "refId": "A",
            "legendFormat": "BIA Coverage %"
          },
          {
            "datasource": "Prometheus",
            "expr": "bcm_plans_up_to_date_percentage",
            "refId": "B",
            "legendFormat": "Plans Up-to-Date %"
          },
          {
            "datasource": "Prometheus",
            "expr": "bcm_incidents_resolved_time_avg",
            "refId": "C",
            "legendFormat": "Avg Resolution Time (hrs)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 70
                },
                {
                  "color": "green",
                  "value": 90
                }
              ]
            }
          }
        },
        "options": {
          "orientation": "vertical",
          "textMode": "value_and_name",
          "colorMode": "value"
        }
      },
      {
        "id": 10,
        "title": "BCM Incidents",
        "type": "timeseries",
        "gridPos": {
          "h": 6,
          "w": 8,
          "x": 8,
          "y": 28
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "bcm_incidents_total",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "Incidents",
              "axisPlacement": "auto"
            }
          }
        }
      },
      {
        "id": 11,
        "title": "Training Completion Rate",
        "type": "gauge",
        "gridPos": {
          "h": 6,
          "w": 8,
          "x": 16,
          "y": 28
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "bcm_training_completion_rate",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "unit": "percent",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 70
                },
                {
                  "color": "green",
                  "value": 90
                }
              ]
            }
          }
        },
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 12,
        "title": "Risk Assessment Metrics",
        "type": "table",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 34
        },
        "targets": [
          {
            "datasource": "Prometheus",
            "expr": "bcm_risk_score",
            "refId": "A",
            "format": "table",
            "instant": true
          }
        ]
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s",
    "schemaVersion": 36,
    "version": 1
  }
}
