{
  "dashboard": {
    "id": null,
    "title": "BCM Services Monitoring",
    "tags": ["bcm", "services", "health"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Odoo BCM Platform",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "up{job=\"odoo\",instance=\"localhost:8069\"}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "AI Orchestrator",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 6,
          "y": 0
        },
        "targets": [
          {
            "expr": "up{job=\"ai-orchestrator\",instance=\"localhost:8000\"}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Notification Service",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "up{job=\"notification-service\",instance=\"localhost:8002\"}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Document Processor",
        "type": "stat",
        "gridPos": {
          "h": 6,
          "w": 6,
          "x": 18,
          "y": 0
        },
        "targets": [
          {
            "expr": "up{job=\"document-processor\",instance=\"localhost:8083\"}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Service Uptime",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 6
        },
        "targets": [
          {
            "expr": "up{job=~\"bcm-.*\"}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "Response Times",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 14
        },
        "targets": [
          {
            "expr": "http_request_duration_seconds{job=~\"bcm-.*\"}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "Error Rates",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 14
        },
        "targets": [
          {
            "expr": "rate(http_requests_total{job=~\"bcm-.*\",status=~\"5..\"}[5m])",
            "refId": "A"
          }
        ]
      }
    ],
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "refresh": "10s"
  }
}