{
  "dashboard": {
    "id": null,
    "uid": "intelligent-core-overview",
    "title": "Intelligent Core - Overview",
    "tags": ["intelligent-core", "ai", "bcm"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
        "type": "stat",
        "title": "💰 LLM Cost (USD/hour)",
        "targets": [
          {
            "expr": "sum(rate(ai_foundation_llm_cost_usd_total[1h])) * 3600",
            "legendFormat": "Total Cost",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value",
          "orientation": "auto",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2,
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 2,
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
        "type": "stat",
        "title": "🔍 RAG Searches (per minute)",
        "targets": [
          {
            "expr": "sum(rate(rag_search_duration_seconds_count[1m])) * 60",
            "legendFormat": "Searches/min",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 1
          }
        }
      },
      {
        "id": 3,
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
        "type": "stat",
        "title": "🤖 LLM Requests (per minute)",
        "targets": [
          {
            "expr": "sum(rate(llm_requests_total[1m])) * 60",
            "legendFormat": "Requests/min",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 1
          }
        }
      },
      {
        "id": 4,
        "gridPos": {"h": 9, "w": 12, "x": 0, "y": 8},
        "type": "graph",
        "title": "RAG Search Latency (P95)",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(rag_search_duration_seconds_bucket[5m]))",
            "legendFormat": "{{collection}} - {{query_type}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Latency"
          },
          {
            "format": "short"
          }
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2
      },
      {
        "id": 5,
        "gridPos": {"h": 9, "w": 12, "x": 12, "y": 8},
        "type": "graph",
        "title": "LLM Request Latency by Provider",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(llm_request_duration_seconds_bucket[5m])) by (provider)",
            "legendFormat": "{{provider}} P95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, rate(llm_request_duration_seconds_bucket[5m])) by (provider)",
            "legendFormat": "{{provider}} P50",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Latency"
          }
        ],
        "lines": true,
        "fill": 1
      },
      {
        "id": 6,
        "gridPos": {"h": 9, "w": 12, "x": 0, "y": 17},
        "type": "graph",
        "title": "💰 LLM Cost by Provider (cumulative)",
        "targets": [
          {
            "expr": "sum(ai_foundation_llm_cost_usd_total) by (provider)",
            "legendFormat": "{{provider}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "currencyUSD",
            "label": "Total Cost"
          }
        ],
        "lines": true,
        "fill": 2,
        "stack": true
      },
      {
        "id": 7,
        "gridPos": {"h": 9, "w": 12, "x": 12, "y": 17},
        "type": "graph",
        "title": "Token Usage (per minute)",
        "targets": [
          {
            "expr": "sum(rate(llm_tokens_used_total{type=\"prompt\"}[1m])) * 60",
            "legendFormat": "Prompt Tokens",
            "refId": "A"
          },
          {
            "expr": "sum(rate(llm_tokens_used_total{type=\"completion\"}[1m])) * 60",
            "legendFormat": "Completion Tokens",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Tokens/min"
          }
        ],
        "lines": true,
        "fill": 1
      },
      {
        "id": 8,
        "gridPos": {"h": 9, "w": 12, "x": 0, "y": 26},
        "type": "bargauge",
        "title": "Top 10 Analyzers (by calls)",
        "targets": [
          {
            "expr": "topk(10, sum(rate(expertise_center_analyzer_calls_total[5m])) by (analyzer_name))",
            "legendFormat": "{{analyzer_name}}",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 9,
        "gridPos": {"h": 9, "w": 12, "x": 12, "y": 26},
        "type": "graph",
        "title": "Analyzer Error Rate",
        "targets": [
          {
            "expr": "sum(rate(expertise_center_analyzer_errors_total[5m])) / sum(rate(expertise_center_analyzer_calls_total[5m]))",
            "legendFormat": "Error Rate",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "percentunit",
            "label": "Error Rate",
            "max": 0.1
          }
        ],
        "lines": true,
        "fill": 1,
        "alert": {
          "name": "High Analyzer Error Rate",
          "conditions": [
            {
              "evaluator": {"params": [0.05], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"type": "avg"}
            }
          ]
        }
      },
      {
        "id": 10,
        "gridPos": {"h": 9, "w": 8, "x": 0, "y": 35},
        "type": "graph",
        "title": "🌐 Community Contributions (per hour)",
        "targets": [
          {
            "expr": "sum(rate(community_contributions_total[1h])) * 3600",
            "legendFormat": "Contributions",
            "refId": "A"
          },
          {
            "expr": "sum(rate(community_reviews_total[1h])) * 3600",
            "legendFormat": "Reviews",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Count/hour"
          }
        ],
        "lines": true,
        "fill": 1
      },
      {
        "id": 11,
        "gridPos": {"h": 9, "w": 8, "x": 8, "y": 35},
        "type": "stat",
        "title": "Embedding Cache Hit Rate",
        "targets": [
          {
            "expr": "sum(rate(embedding_cache_hits_total[5m])) / (sum(rate(embedding_cache_hits_total[5m])) + sum(rate(embedding_cache_misses_total[5m])))",
            "legendFormat": "Hit Rate",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 0.5, "color": "yellow"},
                {"value": 0.8, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 12,
        "gridPos": {"h": 9, "w": 8, "x": 16, "y": 35},
        "type": "stat",
        "title": "Active Services",
        "targets": [
          {
            "expr": "count(up{job=~\"intelligent-core.*|ai-foundation|community-intelligence|ai-orchestration|coordination-center\"} == 1)",
            "legendFormat": "Services UP",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "none",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 3, "color": "yellow"},
                {"value": 5, "color": "green"}
              ]
            }
          }
        }
      }
    ]
  }
}
