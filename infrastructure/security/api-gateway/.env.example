# ============================================
# API GATEWAY - ENVIRONMENT CONFIGURATION
# ============================================
# Production-grade API Gateway with AI-powered management
# Copy this file to .env and fill in your values

# ============================================
# SERVICE INFO
# ============================================
APP_NAME="AI-Powered API Gateway"
VERSION="1.0.0"
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# SECURITY - JWT
# ============================================
# CRITICAL: Change in production! Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=your-super-secret-jwt-key-CHANGE-IN-PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# DATABASE - PostgreSQL (for audit logs)
# ============================================
# Local development:
# DATABASE_URL=postgresql://bcm:changeme@localhost:5432/bcm_platform

# Docker:
DATABASE_URL=postgresql://bcm:changeme@postgres:5432/bcm_platform

# Production (Supabase example):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres

# ============================================
# REDIS (for rate limiting & caching)
# ============================================
# Local development:
# REDIS_URL=redis://localhost:6379

# Docker:
REDIS_URL=redis://redis:6379

# Production (Upstash example):
# REDIS_URL=rediss://default:YOUR_TOKEN@xxxxx.upstash.io:6379
# REDIS_PASSWORD=your-redis-password

REDIS_PASSWORD=

# ============================================
# BACKEND SERVICES
# ============================================
# These are auto-discovered, but can be overridden

# Coordination Center
COORDINATION_URL=http://coordination-center:8004

# EventBus
EVENTBUS_URL=http://eventbus:8001

# AI Orchestration
AI_ORCHESTRATION_URL=http://ai-orchestration:8002

# BPMN Workflow
BPMN_URL=http://bpmn-workflow:8003

# AI Intelligence
AI_INTELLIGENCE_URL=http://ai-intelligence:8032

# Project Intelligence
PROJECT_INTELLIGENCE_URL=http://project-intelligence:8025

# Notification Service
NOTIFICATION_URL=http://notification-service:8035

# Process Mining
PROCESS_MINING_URL=http://process-mining:8040

# Monitoring Service
MONITORING_URL=http://monitoring-service:8045

# Realtime WebSocket
REALTIME_URL=http://realtime-websocket:8050

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BURST=20

# VIP Tier (higher limits)
VIP_RATE_LIMIT_REQUESTS=500
VIP_RATE_LIMIT_WINDOW=60

# ============================================
# CIRCUIT BREAKER
# ============================================
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30

# ============================================
# TIMEOUTS (seconds)
# ============================================
DEFAULT_TIMEOUT=30.0
AUTH_TIMEOUT=5.0
HEALTH_CHECK_TIMEOUT=3.0

# ============================================
# CONNECTION POOLING
# ============================================
MAX_CONNECTIONS=100
MAX_KEEPALIVE_CONNECTIONS=20
KEEPALIVE_EXPIRY=30.0

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_CREDENTIALS=true

# ============================================
# SERVICE DISCOVERY
# ============================================
ENABLE_SERVICE_DISCOVERY=true
SERVICE_DISCOVERY_INTERVAL=30

# ============================================
# AI GATEWAY MANAGER
# ============================================
AI_MANAGER_ENABLED=true
AI_MANAGER_URL=http://ai-intelligence:8032/colleagues/gateway-manager
AI_MANAGER_CHECK_INTERVAL=60

# AI API Keys (for AI Gateway Manager)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ============================================
# HEALTH CHECKS
# ============================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
UNHEALTHY_THRESHOLD=3

# ============================================
# AUDIT LOGGING
# ============================================
AUDIT_ENABLED=true
AUDIT_LOG_REQUESTS=true
AUDIT_LOG_RESPONSES=false
AUDIT_RETENTION_DAYS=90

# ============================================
# METRICS
# ============================================
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# ============================================
# CACHING
# ============================================
CACHE_ENABLED=true
CACHE_TTL_DEFAULT=300
CACHE_TTL_SHORT=60
CACHE_TTL_LONG=3600

# ============================================
# DEVELOPMENT / DEBUG
# ============================================
DEBUG=false
RELOAD=false

# ============================================
# NOTES
# ============================================
# 1. For production, ALWAYS change JWT_SECRET
# 2. Use strong passwords for DATABASE_URL and REDIS_PASSWORD
# 3. Enable HTTPS in production (use reverse proxy like nginx)
# 4. Set DEBUG=false in production
# 5. Configure proper CORS_ORIGINS for your frontend
