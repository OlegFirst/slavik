/**
 * 🤝 Collective Intelligence Smart Contract
 *
 * Partisia Blockchain MPC Contract for privacy-preserving
 * collective intelligence in BCM.
 *
 * PRIVACY ARCHITECTURE:
 * - Cases stored as secret shares (MPC)
 * - Computation on encrypted data
 * - Only aggregate results revealed
 * - Zero knowledge of source organizations
 *
 * INNOVATION:
 * Organizations help each other WITHOUT revealing identities!
 *
 * @author AI-Powered BCM Platform
 * @version 1.0.0
 */

// ================================================
// STATE VARIABLES
// ================================================

/**
 * BCM Case - Secret Shared Data
 *
 * Privacy:
 * - org_id: SECRET (never revealed)
 * - approach: SECRET (never revealed)
 * - metrics: SECRET (never revealed)
 * - problem_type: PUBLIC (for querying)
 * - industry: PUBLIC (for similarity)
 */
struct BCMCase {
    // SECRET FIELDS (encrypted via MPC)
    secret org_id: Bytes;           // Organization ID (NEVER revealed)
    secret approach: String;         // How they solved it (NEVER revealed)
    secret metrics: CaseMetrics;     // Their specific metrics (NEVER revealed)

    // PUBLIC FIELDS (for filtering/matching)
    problem_type: String;            // e.g., "supply_chain_complexity"
    industry: String;                // e.g., "healthcare"
    size_category: String;           // e.g., "medium_200-500"
    region: String;                  // e.g., "pacific_northwest"
    success_rate: u32;               // 0-100
    created_at: u64;                 // Unix timestamp
}

struct CaseMetrics {
    secret duration_days: u32;
    secret team_size: u8;
    secret external_help_used: bool;
}

/**
 * Pattern Frequency
 *
 * Aggregated pattern from multiple cases
 * NO individual case data included
 */
struct PatternFrequency {
    pattern_name: String;
    count: u32;
    total_cases: u32;
    confidence: u32;  // 0-100
}

/**
 * Collective Wisdom Result
 *
 * Aggregate intelligence from multiple organizations
 * Zero knowledge of source organizations
 */
struct CollectiveWisdom {
    patterns: Vector<PatternFrequency>;
    source_count: u32;
    median_duration: u32;
    confidence_score: u32;
    k_anonymity: u32;
    zk_proof_hash: Bytes;
}

// ================================================
// STATE STORAGE
// ================================================

// Secret-shared case storage
state cases: Vector<BCMCase>;

// Privacy configuration
const K_ANONYMITY: u32 = 5;        // Minimum organizations required
const MAX_RISK_SCORE: u32 = 70;    // Maximum re-identification risk (0-100)

// ================================================
// ACTIONS (Public Functions)
// ================================================

/**
 * Submit Case to Blockchain
 *
 * Organization submits their BCM case as secret shares.
 * Case is split across MPC nodes - NO single node can decrypt.
 *
 * @param case_data - Secret-shared case data
 * @param metadata - Public metadata for matching
 */
@action
fn submit_case(
    @secret_share case_data: BCMCaseData,
    metadata: CaseMetadata
) -> Result<Bytes, String> {

    // Validate metadata
    require(metadata.success_rate >= 70, "Success rate must be >= 70%");
    require(metadata.problem_type.len() > 0, "Problem type required");

    // Create secret-shared case
    let case = BCMCase {
        // SECRET fields - split across MPC nodes
        org_id: case_data.org_id,
        approach: case_data.approach,
        metrics: case_data.metrics,

        // PUBLIC fields - for querying
        problem_type: metadata.problem_type,
        industry: metadata.industry,
        size_category: metadata.size_category,
        region: metadata.region,
        success_rate: metadata.success_rate,
        created_at: current_timestamp()
    };

    // Store as secret shares
    cases.push(case);

    // Generate case ID (hash)
    let case_id = hash(case_data.org_id);

    Ok(case_id)
}

/**
 * Query Collective Wisdom
 *
 * Privacy-preserving query across cases.
 *
 * MPC COMPUTATION:
 * 1. Find matching cases (STILL ENCRYPTED)
 * 2. Aggregate patterns (STILL ENCRYPTED)
 * 3. Calculate statistics (STILL ENCRYPTED)
 * 4. Only reveal aggregate result
 *
 * PRIVACY:
 * - Minimum K_ANONYMITY (5) cases required
 * - NO individual case data revealed
 * - Source organizations: UNKNOWN
 *
 * @param problem_type - Type of problem to query
 * @param org_context - Requesting org context (for similarity)
 * @param min_cases - Minimum cases required (default: 5)
 */
@action
fn query_collective_wisdom(
    problem_type: String,
    org_context: OrgContext,
    min_cases: u32
) -> Result<CollectiveWisdom, String> {

    // Ensure privacy threshold
    let privacy_threshold = max(min_cases, K_ANONYMITY);

    // MPC: Find matching cases (computation on ENCRYPTED data)
    let matching_cases = mpc_filter_cases(|case| {
        // Filter criteria (can query on public fields)
        case.problem_type == problem_type &&
        case.success_rate >= 80 &&
        is_similar_org(case, org_context)
    });

    // Privacy check: Minimum k-anonymity
    if matching_cases.len() < privacy_threshold {
        return Err(format!(
            "Insufficient cases for privacy. Need {}, found {}",
            privacy_threshold,
            matching_cases.len()
        ));
    }

    // MPC: Aggregate patterns (STILL ON ENCRYPTED DATA)
    let patterns = mpc_aggregate_patterns(matching_cases);

    // MPC: Calculate median duration (ENCRYPTED)
    let median_duration = mpc_calculate_median(
        matching_cases,
        |case| case.metrics.duration_days
    );

    // MPC: Calculate confidence
    let confidence = calculate_confidence_score(matching_cases);

    // Generate zero-knowledge proof
    let zk_proof = generate_zk_proof(
        query_id: hash(problem_type),
        private_data: matching_cases,
        computation: patterns
    );

    // Return ONLY aggregate result
    // Individual cases: NEVER revealed
    Ok(CollectiveWisdom {
        patterns: patterns,
        source_count: matching_cases.len(),
        median_duration: median_duration,
        confidence_score: confidence,
        k_anonymity: matching_cases.len(),
        zk_proof_hash: zk_proof.hash()
    })
}

/**
 * Get Anonymous Benchmark
 *
 * Calculate aggregate benchmark from similar organizations.
 *
 * Privacy: Minimum 5 orgs, aggregate stats only.
 */
@action
fn get_benchmark(
    metric: String,
    org_context: OrgContext,
    min_orgs: u32
) -> Result<BenchmarkResult, String> {

    // Find similar organizations
    let similar_orgs = mpc_filter_cases(|case| {
        is_similar_org(case, org_context)
    });

    // Privacy check
    if similar_orgs.len() < max(min_orgs, K_ANONYMITY) {
        return Err("Insufficient organizations for privacy");
    }

    // MPC: Extract metric values (ENCRYPTED)
    let values = match metric.as_str() {
        "bia_duration_days" => {
            mpc_map(similar_orgs, |case| case.metrics.duration_days)
        },
        "team_size" => {
            mpc_map(similar_orgs, |case| case.metrics.team_size as u32)
        },
        _ => return Err("Unknown metric")
    };

    // MPC: Calculate statistics (ENCRYPTED COMPUTATION)
    let median = mpc_median(values);
    let mean = mpc_mean(values);
    let p25 = mpc_percentile(values, 25);
    let p75 = mpc_percentile(values, 75);

    // Return aggregate result
    Ok(BenchmarkResult {
        metric: metric,
        median: median,
        mean: mean,
        p25: p25,
        p75: p75,
        org_count: similar_orgs.len()
    })
}

/**
 * Verify Computation
 *
 * Verify collective wisdom computation using zero-knowledge proof.
 *
 * Proves computation was correct WITHOUT revealing source data.
 */
@action
fn verify_computation(
    query_id: Bytes,
    result: CollectiveWisdom
) -> Result<ZKProof, String> {

    // Retrieve computation log
    let computation = get_computation_log(query_id)?;

    // Generate zero-knowledge proof
    let proof = generate_zk_proof(
        claim: "Computation performed correctly",
        private_inputs: computation.matching_cases,
        public_output: result,
        computation_type: "mpc_aggregate_patterns"
    );

    // Verify proof
    if verify_zk_proof(proof) {
        Ok(proof)
    } else {
        Err("Proof verification failed")
    }
}

// ================================================
// HELPER FUNCTIONS (MPC Primitives)
// ================================================

/**
 * MPC: Filter Cases
 *
 * Filter cases based on predicate.
 * Computation happens on SECRET-SHARED data.
 */
@mpc
fn mpc_filter_cases<F>(predicate: F) -> Vector<BCMCase>
where
    F: Fn(&BCMCase) -> bool
{
    let mut result = Vector::new();

    for case in cases.iter() {
        // MPC: Evaluate predicate on encrypted data
        if predicate(case) {
            result.push(case.clone());
        }
    }

    result
}

/**
 * MPC: Aggregate Patterns
 *
 * Aggregate patterns from multiple cases.
 * Computation on ENCRYPTED approaches.
 */
@mpc
fn mpc_aggregate_patterns(cases: Vector<BCMCase>) -> Vector<PatternFrequency> {
    // Extract patterns from secret approaches
    let mut pattern_counts = Map::new();

    for case in cases.iter() {
        // MPC: Extract patterns from SECRET approach field
        let patterns = extract_patterns_from_approach(case.approach);

        for pattern in patterns {
            let count = pattern_counts.get(&pattern).unwrap_or(0);
            pattern_counts.insert(pattern, count + 1);
        }
    }

    // Convert to frequency structs
    let total = cases.len();
    let mut frequencies = Vector::new();

    for (pattern, count) in pattern_counts.iter() {
        frequencies.push(PatternFrequency {
            pattern_name: pattern.clone(),
            count: *count,
            total_cases: total,
            confidence: calculate_pattern_confidence(count, total)
        });
    }

    frequencies
}

/**
 * MPC: Calculate Median
 *
 * Calculate median of secret values.
 */
@mpc
fn mpc_calculate_median<F>(cases: Vector<BCMCase>, extractor: F) -> u32
where
    F: Fn(&BCMCase) -> secret u32
{
    // Extract values (STILL SECRET)
    let mut values = Vector::new();
    for case in cases.iter() {
        values.push(extractor(case));
    }

    // MPC: Sort secret values
    mpc_sort(values);

    // Return median (single aggregate value)
    let mid = values.len() / 2;
    values[mid]
}

/**
 * MPC: Calculate Mean
 */
@mpc
fn mpc_mean(values: Vector<secret u32>) -> u32 {
    let sum = values.iter().sum();
    sum / values.len()
}

/**
 * MPC: Calculate Percentile
 */
@mpc
fn mpc_percentile(values: Vector<secret u32>, percentile: u8) -> u32 {
    let sorted = mpc_sort(values);
    let index = (sorted.len() * percentile as usize) / 100;
    sorted[index]
}

/**
 * MPC: Sort secret values
 *
 * Sorting on encrypted data using MPC
 */
@mpc
fn mpc_sort(mut values: Vector<secret u32>) -> Vector<secret u32> {
    // MPC oblivious sort
    // (Implementation uses MPC comparison primitives)
    oblivious_sort(values)
}

// ================================================
// UTILITY FUNCTIONS
// ================================================

/**
 * Check if organization is similar
 *
 * Based on public metadata
 */
fn is_similar_org(case: &BCMCase, context: &OrgContext) -> bool {
    // Same industry
    if case.industry != context.industry {
        return false;
    }

    // Similar size
    if !is_similar_size(case.size_category, context.size_category) {
        return false;
    }

    // Region match (optional)
    // Same or adjacent regions OK

    true
}

fn is_similar_size(size1: &String, size2: &String) -> bool {
    // Size categories within one level
    let categories = vec![
        "small_<50",
        "medium_50-200",
        "medium_200-500",
        "large_500-1000",
        "large_1000+"
    ];

    let idx1 = categories.iter().position(|&s| s == size1).unwrap_or(0);
    let idx2 = categories.iter().position(|&s| s == size2).unwrap_or(0);

    (idx1 as i32 - idx2 as i32).abs() <= 1
}

fn calculate_pattern_confidence(count: u32, total: u32) -> u32 {
    // Confidence = frequency * 100
    (count * 100) / total
}

fn calculate_confidence_score(cases: Vector<BCMCase>) -> u32 {
    // Higher count = higher confidence
    // More diversity = lower confidence

    let base_confidence = min(90, 50 + cases.len() * 5);

    // Adjust for success rate variance
    let avg_success = mpc_mean(
        cases.iter().map(|c| c.success_rate).collect()
    );

    if avg_success >= 85 {
        base_confidence
    } else {
        base_confidence - (85 - avg_success)
    }
}

/**
 * Extract patterns from approach text
 *
 * NLP-based pattern extraction from secret approach field
 * (simplified for illustration)
 */
@mpc
fn extract_patterns_from_approach(approach: secret String) -> Vector<String> {
    // MPC: Pattern matching on encrypted text
    // In production: Use MPC-compatible NLP

    let mut patterns = Vector::new();

    // Check for common patterns (MPC string operations)
    if mpc_contains(approach, "stakeholder") {
        patterns.push("stakeholder_mapping".to_string());
    }

    if mpc_contains(approach, "phased") || mpc_contains(approach, "tier") {
        patterns.push("phased_approach".to_string());
    }

    if mpc_contains(approach, "workshop") {
        patterns.push("workshop_method".to_string());
    }

    if mpc_contains(approach, "questionnaire") {
        patterns.push("questionnaire_method".to_string());
    }

    patterns
}

/**
 * Generate Zero-Knowledge Proof
 *
 * Proves computation was performed correctly
 * WITHOUT revealing private inputs
 */
@mpc
fn generate_zk_proof(
    query_id: Bytes,
    private_data: Vector<BCMCase>,
    computation: Vector<PatternFrequency>
) -> ZKProof {
    // Use zk-SNARKs to prove:
    // "I computed aggregate patterns from N cases correctly"
    // WITHOUT revealing which cases or their content

    ZKProof {
        claim: "Collective wisdom computed correctly",
        proof_data: generate_snark_proof(private_data, computation),
        timestamp: current_timestamp()
    }
}

/**
 * Verify Zero-Knowledge Proof
 */
fn verify_zk_proof(proof: ZKProof) -> bool {
    // Verify zk-SNARK
    verify_snark(proof.proof_data)
}

// ================================================
// STRUCTS (Additional Types)
// ================================================

struct BCMCaseData {
    secret org_id: Bytes;
    secret approach: String;
    secret metrics: CaseMetrics;
}

struct CaseMetadata {
    problem_type: String;
    industry: String;
    size_category: String;
    region: String;
    success_rate: u32;
}

struct OrgContext {
    industry: String;
    size_category: String;
    region: String;
}

struct BenchmarkResult {
    metric: String;
    median: u32;
    mean: u32;
    p25: u32;
    p75: u32;
    org_count: u32;
}

struct ZKProof {
    claim: String;
    proof_data: Bytes;
    timestamp: u64;
}

// ================================================
// EVENTS
// ================================================

@event
struct CaseSubmitted {
    case_id: Bytes;
    problem_type: String;
    timestamp: u64;
}

@event
struct WisdomQueried {
    problem_type: String;
    source_count: u32;
    timestamp: u64;
}

@event
struct ComputationVerified {
    query_id: Bytes;
    verified: bool;
    timestamp: u64;
}
