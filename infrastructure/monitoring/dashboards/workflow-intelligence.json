        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 62},
        "targets": [{
          "expr": "sum(rate(http_requests_total{job=~\"planning-service|plans-service|bia-service|compliance-service|risk-service|response-service|validation-service|documents-service|learning-service|governance-service|file-service|community-service\"}[5m])) by (job)",
