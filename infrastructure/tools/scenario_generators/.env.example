# ===================================================
# Scenario Orchestrator API - Environment Configuration
# ===================================================

# === Service Configuration ===
PORT=8060
HOST=0.0.0.0
ENVIRONMENT=production  # production, staging, development
DEBUG=false
RELOAD=false

# === Scenario Intelligence Integration ===
# Path to scenario-intelligence root
SCENARIO_INTELLIGENCE_PATH=/app/intelligent-core/scenario-intelligence

# === Database Configuration ===
DATABASE_URL=postgresql://user:password@host:5432/database

# === LLM Configuration (for L4 Generator) ===
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
LLM_PROVIDER=anthropic

# === Storage Configuration ===
STORAGE_BACKENDS=memory,postgres
DEFAULT_STORAGE=postgres

# === EventBus Configuration ===
EVENTBUS_HOST=localhost
EVENTBUS_PORT=6379
EVENTBUS_ENABLED=true

# === Generation Configuration ===
AUTO_REGENERATION_ENABLED=true
AUTO_REGENERATION_BATCH_WINDOW_SECONDS=30
AUTO_REGENERATION_MAX_BATCH_SIZE=50
GENERATION_TIMEOUT_SECONDS=300

# === Monitoring Configuration ===
MIO_MANAGER_HOST=localhost
MIO_MANAGER_PORT=8020
MIO_MANAGER_ENABLED=true

# Prometheus metrics
METRICS_PORT=9090
METRICS_PATH=/metrics

# === Logging Configuration ===
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/scenario-orchestrator.log

# === Feature Flags ===
FEATURE_L4_GENERATION=true
FEATURE_AUTO_REGENERATION=true
