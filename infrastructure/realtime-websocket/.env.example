# Realtime WebSocket Service Configuration

# Service
PORT=8050
ENV=production

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT].supabase.co:5432/postgres

# Redis (Upstash for production, local for development)
UPSTASH_REDIS_URL=redis://default:your_password@region.upstash.io:6379
# Or for local development:
# REDIS_URL=redis://localhost:6379

# WebSocket Configuration
MAX_CONNECTIONS_PER_USER=5
MESSAGE_RETENTION_HOURS=24

# CORS (for production, specify origins)
CORS_ORIGINS=*

# Optional: EventBus integration
EVENTBUS_URL=http://localhost:8001

# Logging
LOG_LEVEL=INFO
