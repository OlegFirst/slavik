{
  "dashboard": {
    "id": null,
    "uid": "platform-integration",
    "title": "BCM Platform Integration - Graceful Choreography",
    "tags": ["bcm", "platform-integration", "graceful-choreography"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Intelligent Router - Event Routing Performance",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, intelligent_router_routing_time_ms)",
            "legendFormat": "P95 Routing Time",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, intelligent_router_routing_time_ms)",
            "legendFormat": "P50 Routing Time",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "ms",
            "label": "Routing Time"
          }
        ]
      },
      {
        "id": 2,
        "title": "Intelligent Router - SLA Compliance",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "intelligent_router_sla_compliance_rate",
            "refId": "A"
          }
        ],
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 0.95, "color": "yellow"},
                {"value": 0.99, "color": "green"}
              ]
            },
            "unit": "percentunit"
          }
        }
      },
      {
        "id": 3,
        "title": "Intelligent Router - Queue Depths by Priority",
        "type": "graph",
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "intelligent_router_queue_depth{priority='CRITICAL'}",
            "legendFormat": "CRITICAL",
            "refId": "A"
          },
          {
            "expr": "intelligent_router_queue_depth{priority='HIGH'}",
            "legendFormat": "HIGH",
            "refId": "B"
          },
          {
            "expr": "intelligent_router_queue_depth{priority='NORMAL'}",
            "legendFormat": "NORMAL",
            "refId": "C"
          },
          {
            "expr": "intelligent_router_queue_depth{priority='LOW'}",
            "legendFormat": "LOW",
            "refId": "D"
          }
        ]
      },
      {
        "id": 4,
        "title": "Saga Engine - Active Sagas",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "saga_active_count",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "text": {}
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 30, "color": "yellow"},
                {"value": 50, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Saga Engine - Success Rate",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 8},
        "targets": [
          {
            "expr": "(saga_completed_total / saga_started_total)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 0.90, "color": "yellow"},
                {"value": 0.95, "color": "green"}
              ]
            },
            "unit": "percentunit"
          }
        }
      },
      {
        "id": 6,
        "title": "Saga Engine - Execution Time",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, saga_duration_seconds)",
            "legendFormat": "P95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, saga_duration_seconds)",
            "legendFormat": "P50",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Duration"
          }
        ]
      },
      {
        "id": 7,
        "title": "Self-Aware Services - Health Scores",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "self_aware_health_score",
            "legendFormat": "{{service}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "percentunit",
            "label": "Health Score",
            "min": 0,
            "max": 1
          }
        ]
      },
      {
        "id": 8,
        "title": "Self-Aware Services - Load Distribution",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "self_aware_load_percent",
            "legendFormat": "{{service}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "percent",
            "label": "Load",
            "min": 0,
            "max": 100
          }
        ]
      },
      {
        "id": 9,
        "title": "CQRS - Cache Hit Rate",
        "type": "gauge",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "cqrs_cache_hit_rate",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 0.80, "color": "yellow"},
                {"value": 0.95, "color": "green"}
              ]
            },
            "unit": "percentunit"
          }
        }
      },
      {
        "id": 10,
        "title": "CQRS - Query Performance",
        "type": "graph",
        "gridPos": {"h": 8, "w": 18, "x": 6, "y": 24},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, cqrs_query_duration_seconds)",
            "legendFormat": "P95 Query Time",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, cqrs_query_duration_seconds)",
            "legendFormat": "P50 Query Time",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Query Duration"
          }
        ]
      },
      {
        "id": 11,
        "title": "Overall System Health",
        "type": "stat",
        "gridPos": {"h": 4, "w": 24, "x": 0, "y": 32},
        "targets": [
          {
            "expr": "up{app='orchestration'}",
            "legendFormat": "Orchestration",
            "refId": "A"
          },
          {
            "expr": "count(up{component='bcm-service'} == 1)",
            "legendFormat": "BCM Services Up",
            "refId": "B"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": "1", "text": "UP", "color": "green"},
              {"type": "value", "value": "0", "text": "DOWN", "color": "red"}
            ]
          }
        }
      }
    ]
  },
  "overwrite": true,
  "folderUid": "bcm-platform",
  "message": "BCM Platform Integration Dashboard - Graceful Choreography Monitoring"
}
