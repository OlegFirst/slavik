# DigitalOcean Spaces Credentials for Velero
# Copy this file to credentials-velero and fill in your actual values
#
# Create Spaces Access Keys from:
# https://cloud.digitalocean.com/account/api/tokens
# Navigate to "Spaces Keys" section
#
# Reference: https://github.com/digitalocean/velero-plugin

[default]
aws_access_key_id=DO00XXXXXXXXXXXXX
aws_secret_access_key=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
