# BCM Platform - Infrastructure Environment Variables
# ====================================================
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
#
# Or use root project .env (recommended)

# ============================================================================
# REQUIRED - Supabase (PostgreSQL Database)
# ============================================================================

SUPABASE_URL=https://tpdkhddtbhpoqzzgxfni.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_ANON_KEY=your-anon-key-here
DATABASE_URL=postgresql://postgres.tpdkhddtbhpoqzzgxfni:PASSWORD@aws-1-eu-north-1.pooler.supabase.com:5432/postgres

# ============================================================================
# REQUIRED - Redis (Caching & Sessions)
# ============================================================================

# Upstash Redis (Cloud)
REDIS_URL=redis://default:PASSWORD@redis-10023.c8.us-east-1-4.ec2.redns.redis-cloud.com:10023
UPSTASH_REDIS_URL=redis://default:PASSWORD@redis-10023.c8.us-east-1-4.ec2.redns.redis-cloud.com:10023

# Or local Redis
# REDIS_URL=redis://localhost:6379

# ============================================================================
# REQUIRED - Qdrant (Vector Database)
# ============================================================================

QDRANT_URL=https://fa9f6acd-aef9-4ebe-a3f5-f89c62bce378.eu-west-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# ============================================================================
# OPTIONAL - AI Services (for AI Office)
# ============================================================================

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# ============================================================================
# OPTIONAL - SMTP (for Notifications)
# ============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@bcm-platform.com
SMTP_FROM_NAME=BCM Platform Notifications

# ============================================================================
# OPTIONAL - GitHub Integration
# ============================================================================

GITHUB_TOKEN=ghp_your-token-here
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ============================================================================
# OPTIONAL - Temporal (Workflow Engine)
# ============================================================================

TEMPORAL_ADDRESS=europe-west3.gcp.api.temporal.io:7233
TEMPORAL_NAMESPACE=quickstart-maxdemch-73cb5509.r3gxp

# ============================================================================
# SERVICE PORTS (defaults, can override)
# ============================================================================

# Gateway
API_GATEWAY_PORT=8000

# Runtime
REALTIME_WEBSOCKET_PORT=8100

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
ALERTMANAGER_PORT=9093
NOTIFICATION_SERVICE_PORT=8035

# AI Office
ANALYTICS_SPECIALIST_PORT=8051
DB_INTELLIGENCE_PORT=8052
AI_EVENT_MANAGER_PORT=8053
MIO_MANAGER_PORT=8046

# Integration
GITHUB_INTEGRATION_PORT=8200

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================================================
# ENVIRONMENT
# ============================================================================

ENV=production
# Options: development, staging, production
