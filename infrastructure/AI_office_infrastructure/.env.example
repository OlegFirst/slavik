# AI Office Infrastructure - Environment Variables Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# GENERAL SETTINGS
# =============================================================================
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# =============================================================================
# DATABASE CONNECTIONS
# =============================================================================
# PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/bcm_platform
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Redis
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_URL=redis://:your-token@your-redis.upstash.io:6379

# Qdrant Vector DB
QDRANT_URL=https://your-cluster.eu-west-1.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# =============================================================================
# AI OFFICE SERVICES PORTS
# =============================================================================
MIO_MANAGER_PORT=8046
DB_INTELLIGENCE_PORT=8050
AI_EVENT_MANAGER_PORT=8055
ANALYTICS_SPECIALIST_PORT=8051
DEVOPS_AGENT_PORT=8058
DEVOPS_AGENT_API_PORT=8061
AGENT_ROUTER_PORT=8057
PROJECT_AGENT_PORT=8060
ORCHESTRATOR_PORT=8059

# =============================================================================
# EXTERNAL SERVICES URLs
# =============================================================================
# AI Office Services
MIO_MANAGER_URL=http://localhost:8046
DB_INTELLIGENCE_URL=http://localhost:8050
AI_EVENT_MANAGER_URL=http://localhost:8055
ANALYTICS_SPECIALIST_URL=http://localhost:8051
DEVOPS_AGENT_URL=http://localhost:8058
PROJECT_AGENT_URL=http://localhost:8060

# Runtime Services
SERVICE_DISCOVERY_URL=http://localhost:8500
REALTIME_WEBSOCKET_URL=http://localhost:8053

# Gateway & Security
API_GATEWAY_URL=http://localhost:8000
AUTH_SERVICE_URL=http://localhost:8001

# Integration Services
GITHUB_INTEGRATION_URL=http://localhost:8085
GITHUB_INTEGRATION_PORT=8085

# Policy & Balancer
POLICY_ENGINE_URL=http://localhost:9091
BALANCER_SERVICE_METRICS_PORT=9092

# Observability
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
LOKI_URL=http://localhost:3100

# Intelligent Core (if external)
WORKFLOW_INTELLIGENCE_URL=http://localhost:8020
AI_ORCHESTRATOR_URL=http://localhost:8000
PREDICTIVE_URL=http://localhost:8030
OPTIMIZER_URL=http://localhost:8035
COORDINATION_CENTER_URL=http://localhost:8004
COMPLIANCE_MONITORING_URL=http://localhost:8040

# =============================================================================
# AI/LLM CONFIGURATION
# =============================================================================
# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic Claude (if used)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# AI Foundation
AI_FOUNDATION_ENABLED=true
RAG_ENABLED=true
LLM_ENABLED=true

# =============================================================================
# EVENTBUS CONFIGURATION
# =============================================================================
EVENTBUS_BACKEND=redis  # or 'memory' for testing
EVENTBUS_REDIS_URL=redis://localhost:6379
EVENTBUS_CONSUMER_GROUP=ai-office

# =============================================================================
# SERVICE-SPECIFIC SETTINGS
# =============================================================================

# MIO Manager (EYES Observatory)
MIO_PHASE=2.1
MIO_EYES_ENABLED=true
MIO_METRICS_COVERAGE_INTERVAL=300  # 5 minutes
MIO_METRICS_HEALTH_INTERVAL=60     # 1 minute
MIO_SMART_SCHEDULER_ENABLED=true

# DB Intelligence
DB_INTELLIGENCE_QUERY_THRESHOLD_MS=1000
DB_INTELLIGENCE_SLOW_QUERY_ENABLED=true
DB_INTELLIGENCE_SECURITY_MONITORING=true

# AI Event Manager
AI_EVENT_MANAGER_VERSION=2.0.0
AI_EVENT_MANAGER_INFRASTRUCTURE_MONITORING=true
AI_EVENT_MANAGER_LEARNING_ENABLED=true

# Analytics Specialist
ANALYTICS_COMPETENCY_LEVEL=middle  # junior|middle|senior|expert
ANALYTICS_DAILY_HEALTH_CHECK_ENABLED=true
ANALYTICS_DAILY_HEALTH_CHECK_TIME=09:00
ANALYTICS_CONTINUOUS_IMPROVEMENT_ENABLED=true
ANALYTICS_CONTINUOUS_IMPROVEMENT_INTERVAL=3600  # 1 hour
PROCESS_ANALYTICS_URL=http://localhost:8070

# DevOps Agent
DEVOPS_AGENT_VERSION=2.0
DEVOPS_COMPLIANCE_ENABLED=true
DEVOPS_AUTO_REMEDIATION=false  # Set to true for auto-fix

# Project Agent (Code Quality)
PROJECT_AGENT_VERSION=2.0.0
PROJECT_AGENT_TESTING_ENABLED=true
PROJECT_AGENT_SECURITY_SCANNING=true
PROJECT_AGENT_DOMAIN_DETECTION=true

# =============================================================================
# MONITORING & METRICS
# =============================================================================
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_PUSH_GATEWAY=http://localhost:9091

# Service-specific metrics
MIO_MANAGER_METRICS_PORT=8046
DB_INTELLIGENCE_METRICS_PORT=8050
AI_EVENT_MANAGER_METRICS_PORT=8055

# =============================================================================
# SECURITY
# =============================================================================
# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440  # 24 hours

# API Keys
PLATFORM_API_KEY=your-platform-api-key

# CORS
CORS_ORIGINS=*  # Set specific origins in production

# =============================================================================
# GITHUB INTEGRATION
# =============================================================================
GITHUB_APP_ID=your-github-app-id
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_PRIVATE_KEY_PATH=/path/to/github-app-private-key.pem

# =============================================================================
# POLICY ENGINE
# =============================================================================
POLICY_ENGINE_FILE=/path/to/policies.yaml
POLICY_ENGINE_AUTO_RELOAD=true
POLICY_ENGINE_AUDIT_ENABLED=true

# =============================================================================
# BALANCER SERVICE (Phase 2.1)
# =============================================================================
BALANCER_SERVICE_VERSION=2.4.0
BALANCER_INFRASTRUCTURE_AWARE=true
BALANCER_EMERGENCY_MODE_ENABLED=true
BALANCER_CPU_THRESHOLD=0.85
BALANCER_METRICS_PORT=9092

# =============================================================================
# NOTIFICATION SERVICE
# =============================================================================
NOTIFICATION_SERVICE_PORT=8035
NOTIFICATION_SERVICE_URL=http://localhost:8035

# SMTP for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@bcm-platform.com

# RabbitMQ for async processing
RABBITMQ_URL=amqp://guest:guest@localhost:5673
RABBITMQ_ENABLED=false

# =============================================================================
# DOCKER & DEPLOYMENT
# =============================================================================
COMPOSE_PROJECT_NAME=ai-office-infrastructure
DOCKER_REGISTRY=your-registry.io
IMAGE_TAG=latest

# =============================================================================
# DEVELOPMENT FLAGS
# =============================================================================
HOT_RELOAD=true
AUTO_CREATE_TABLES=true
FAKE_DATA_ENABLED=false
TEST_MODE=false

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_EVENTBUS_INTEGRATION=true
FEATURE_PROMETHEUS_METRICS=true
FEATURE_AI_INTELLIGENCE=true
FEATURE_COMPLIANCE_CHECKS=true
FEATURE_AUTO_RECOVERY=false

# =============================================================================
# NOTES
# =============================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Update all "your-*" placeholders with actual values
# 3. Never commit .env to git (already in .gitignore)
# 4. For production, use environment-specific .env files:
#    - .env.development
#    - .env.staging
#    - .env.production
# 5. Consider using secrets management (HashiCorp Vault, AWS Secrets Manager)
