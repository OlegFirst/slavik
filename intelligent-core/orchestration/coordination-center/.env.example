# Coordination Center Configuration

# Server
COORDINATION_PORT=8004
COORDINATION_HOST=0.0.0.0
LOG_LEVEL=INFO

# Platform Gateway (старый PLATFORM)
PLATFORM_GATEWAY_URL=http://localhost:8000

# Intelligence Gateway (новый INTELLIGENCE)
INTELLIGENCE_GATEWAY_URL=http://localhost:8035

# Database (Platform DB)
DATABASE_URL=postgresql://postgres:password@localhost:5432/bcm_platform

# Redis (Rate limiting, cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security
MAX_REQUESTS_PER_MINUTE=100
REQUIRE_HUMAN_APPROVAL_FOR=delete,critical_update,activate_plan,escalate_incident

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Monitoring
PROMETHEUS_ENABLED=true
