# AI Intelligence Layer Configuration

# Anthropic Claude API
ANTHROPIC_API_KEY=your-api-key-here

# Service Configuration
SERVICE_PORT=8031
SERVICE_HOST=0.0.0.0
LOG_LEVEL=INFO

# Database
POSTGRES_URL=postgresql://bcm_user:bcm_password@postgres:5432/bcm_platform

# Redis (EventBus & Caching)
REDIS_URL=redis://redis:6379

# BCM Module URLs
GOVERNANCE_URL=http://governance:8020
BIA_URL=http://bia:8012
RISK_URL=http://risk:8013
PLANNING_URL=http://planning:8005
PLANS_URL=http://plans:8023
RESPONSE_URL=http://response:8007
COMPLIANCE_URL=http://compliance:8006
VALIDATION_URL=http://validation:8022
DOCUMENTS_URL=http://documents:8024
LEARNING_URL=http://learning:8021

# EventBus
EVENTBUS_URL=http://eventbus:8001

# AI Configuration
DEFAULT_MODEL=sonnet
MAX_TOKENS=4096
TEMPERATURE=0.7

# RAG Configuration
MAX_CONTEXT_ITEMS=10
CONTEXT_RETRIEVAL_TIMEOUT=10

# Colleague Configuration
ENABLE_ALL_COLLEAGUES=true
DEFAULT_COLLEAGUE=compliance_copilot
