# Database
DATABASE_URL=postgresql://bcm_user:bcm_password@host.docker.internal:5432/bcm_platform

# Redis (will use container if not specified)
REDIS_URL=redis://redis:6379

# RabbitMQ (will use container if not specified)
RABBITMQ_URL=amqp://bcm_platform:bcm_secure_2024@rabbitmq:5672/

# AI APIs
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
VOYAGE_API_KEY=your_voyage_key_here
COHERE_API_KEY=your_cohere_key_here

# Vector DB (Qdrant Cloud)
QDRANT_URL=https://your-cluster.eu-west-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_key_here

# Temporal Cloud
TEMPORAL_ADDRESS=your-namespace.tmprl.cloud:7233
TEMPORAL_NAMESPACE=your-namespace
