# System BCM Service - Environment Configuration
# Copy this file to .env and configure for your environment

# ============================================================================
# Service Configuration
# ============================================================================
SERVICE_NAME=system-bcm-service
SERVICE_VERSION=1.0.0
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8050

# ============================================================================
# EventBus Configuration (Redis Streams)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STREAM_PREFIX=platform

# EventBus fallback mode if Redis unavailable
EVENTBUS_FALLBACK=memory

# ============================================================================
# Scheduler Configuration
# ============================================================================
# BCM cycle interval in hours (default: 24)
CYCLE_INTERVAL_HOURS=24

# Run first cycle on startup (true/false)
RUN_FIRST_CYCLE_ON_STARTUP=true

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/system-bcm-service.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ============================================================================
# Monitoring Configuration
# ============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=8050
METRICS_PATH=/metrics

GRAFANA_URL=http://grafana:3000
GRAFANA_API_KEY=

# ============================================================================
# Recovery Configuration
# ============================================================================
# Auto-recovery enabled (true/false)
AUTO_RECOVERY_ENABLED=true

# Max recovery attempts before escalation
MAX_RECOVERY_ATTEMPTS=3

# Recovery timeout in seconds
RECOVERY_TIMEOUT=300

# ============================================================================
# Learning Configuration
# ============================================================================
# Auto-apply improvements (true/false)
AUTO_APPLY_IMPROVEMENTS=true

# Confidence threshold for auto-apply (0.0-1.0)
AUTO_APPLY_CONFIDENCE_THRESHOLD=0.7

# Priority threshold for auto-apply (critical,high,medium,low)
AUTO_APPLY_PRIORITY_THRESHOLD=high

# ============================================================================
# Platform Services Configuration
# ============================================================================
# API Gateway
API_GATEWAY_URL=http://api-gateway:8000
API_GATEWAY_TIMEOUT=30

# Workflow Intelligence
WORKFLOW_INTELLIGENCE_URL=http://workflow-intelligence:8001
WORKFLOW_INTELLIGENCE_TIMEOUT=30

# PostgreSQL
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_DB=platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# RAG System
RAG_SERVICE_URL=http://rag-service:8002
RAG_SERVICE_TIMEOUT=30

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_TIMEOUT=30

# ============================================================================
# Docker/Kubernetes Configuration
# ============================================================================
# Container orchestration (docker/kubernetes)
ORCHESTRATION=docker

# Docker socket path
DOCKER_SOCKET=/var/run/docker.sock

# Kubernetes namespace
K8S_NAMESPACE=platform

# ============================================================================
# Security Configuration
# ============================================================================
# API authentication (none/apikey/oauth2)
API_AUTH=none

# API key (if API_AUTH=apikey)
API_KEY=

# OAuth2 settings (if API_AUTH=oauth2)
OAUTH2_ISSUER=
OAUTH2_AUDIENCE=

# CORS settings
CORS_ENABLED=true
CORS_ORIGINS=*

# ============================================================================
# Feature Flags
# ============================================================================
# Enable experimental features
EXPERIMENTAL_FEATURES=false

# Enable debug mode
DEBUG_MODE=false

# Enable profiling
PROFILING_ENABLED=false

# ============================================================================
# Notifications Configuration
# ============================================================================
# Notification channels (comma-separated: slack,email,pagerduty)
NOTIFICATION_CHANNELS=

# Slack webhook URL
SLACK_WEBHOOK_URL=

# Email settings
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_FROM=
EMAIL_TO=

# PagerDuty integration key
PAGERDUTY_INTEGRATION_KEY=

# ============================================================================
# Advanced Configuration
# ============================================================================
# Worker threads for async tasks
WORKER_THREADS=4

# Max concurrent BCM cycles
MAX_CONCURRENT_CYCLES=1

# Scenario cache TTL in seconds
SCENARIO_CACHE_TTL=3600

# Enable scenario hot-reload
SCENARIO_HOT_RELOAD=true
