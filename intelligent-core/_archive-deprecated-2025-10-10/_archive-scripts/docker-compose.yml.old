version: '3.8'

services:
  # ============================================================================
  # MAIN INTELLIGENT CORE GATEWAY
  # ============================================================================

  intelligent-core-main:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: intelligent-core-main
    ports:
      - "9000:9000"
    environment:
      - PORT=9000
      - DATABASE_URL=${DATABASE_URL}
      - REDIS_URL=${REDIS_URL}
      - ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
      - OPENAI_API_KEY=${OPENAI_API_KEY}
      - VOYAGE_API_KEY=${VOYAGE_API_KEY}
      - QDRANT_URL=${QDRANT_URL:-http://qdrant:6333}
      - EVENTBUS_URL=${EVENTBUS_URL:-http://eventbus:8001}
    volumes:
      - .:/app
      - /app/__pycache__
    networks:
      - platform-network
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    labels:
      - "prometheus.scrape=true"
      - "prometheus.port=9000"
      - "prometheus.path=/metrics"

  # ============================================================================
  # AI FOUNDATION - LEARNING & KNOWLEDGE
  # ============================================================================

  ai-foundation:
    build:
      context: ./ai-foundation/learning-knowledge
      dockerfile: Dockerfile
    container_name: ai-foundation
    ports:
      - "8030:8030"
    environment:
      - PORT=8030
      - DATABASE_URL=${DATABASE_URL}
      - REDIS_URL=${REDIS_URL}
      - ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
      - OPENAI_API_KEY=${OPENAI_API_KEY}
      - VOYAGE_API_KEY=${VOYAGE_API_KEY}
      - QDRANT_URL=${QDRANT_URL:-http://qdrant:6333}
      - COHERE_API_KEY=${COHERE_API_KEY}
    volumes:
      - ./ai-foundation:/app/ai-foundation
      - /app/ai-foundation/__pycache__
    networks:
      - platform-network
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8030/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    labels:
      - "prometheus.scrape=true"
      - "prometheus.port=8030"
      - "prometheus.path=/metrics"

  # ============================================================================
  # COMMUNITY INTELLIGENCE
  # ============================================================================

  community-intelligence:
    build:
      context: ./community_intelligence
      dockerfile: Dockerfile
    container_name: community-intelligence
    ports:
      - "8031:8031"  # Changed from 8030 to avoid conflict
    environment:
      - COMMUNITY_PORT=8031
      - COMMUNITY_DATABASE_URL=${DATABASE_URL}
      - COMMUNITY_REDIS_URL=${REDIS_URL}
      - COMMUNITY_ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
      - COMMUNITY_EVENTBUS_URL=${EVENTBUS_URL:-http://eventbus:8001}
      - COMMUNITY_WORKFLOW_INTELLIGENCE_URL=http://intelligent-core-main:9000
    volumes:
      - ./community_intelligence:/app
      - /app/__pycache__
    networks:
      - platform-network
    depends_on:
      - intelligent-core-main
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8031/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    labels:
      - "prometheus.scrape=true"
      - "prometheus.port=8031"
      - "prometheus.path=/metrics"

  # ============================================================================
  # AI ORCHESTRATION
  # ============================================================================

  ai-orchestration:
    build:
      context: ./orchestration/ai-orchestration
      dockerfile: Dockerfile
    container_name: ai-orchestration
    ports:
      - "8002:8002"
    environment:
      - PORT=8002
      - DATABASE_URL=${DATABASE_URL}
      - REDIS_URL=${REDIS_URL}
      - ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
      - TEMPORAL_ADDRESS=${TEMPORAL_ADDRESS}
      - TEMPORAL_NAMESPACE=${TEMPORAL_NAMESPACE}
    volumes:
      - ./orchestration/ai-orchestration:/app
      - /app/__pycache__
    networks:
      - platform-network
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8002/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    labels:
      - "prometheus.scrape=true"
      - "prometheus.port=8002"
      - "prometheus.path=/metrics"

  # ============================================================================
  # COORDINATION CENTER
  # ============================================================================

  coordination-center:
    build:
      context: ./orchestration/coordination-center
      dockerfile: Dockerfile
    container_name: coordination-center
    ports:
      - "8004:8004"
    environment:
      - PORT=8004
      - DATABASE_URL=${DATABASE_URL}
      - REDIS_URL=${REDIS_URL}
      - INTELLIGENT_CORE_URL=http://intelligent-core-main:9000
    volumes:
      - ./orchestration/coordination-center:/app
      - /app/__pycache__
    networks:
      - platform-network
    depends_on:
      - intelligent-core-main
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8004/coordination/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    labels:
      - "prometheus.scrape=true"
      - "prometheus.port=8004"
      - "prometheus.path=/metrics"

  # ============================================================================
  # NOTE: Redis and RabbitMQ moved to centralized infrastructure
  # ============================================================================
  # Start centralized services: cd /Users/MD/AI-Platform-ISO/infrastructure/database && docker-compose up -d
  # Services available at:
  #   - Redis: platform-redis (localhost:6379)
  #   - RabbitMQ: platform-rabbitmq (localhost:5672, management: 15672)

networks:
  platform-network:
    external: true
    name: platform-network

# NOTE: Volumes moved to centralized infrastructure
# No local volumes needed - all data in centralized services
